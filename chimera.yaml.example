# chimera.yaml.example — minimal, public-safe starter config.
#
# Chimera boots from this file as-is: export at least DEEPSEEK_API_KEY and the
# `simple` formation works. It deliberately carries a tiny catalog and two
# standard providers. For the full operator reference — 40+ models with
# complete category maps, custom DAG formations, local-gateway and CLI-proxy
# providers, tuning knobs — see chimera.yaml.fleet in the repo root (kept in
# the checkout only; it is NOT shipped in the wheel).
#
# Every credential below is a ${ENV_VAR} reference, resolved at load time from
# the environment or a .env file next to your config. Never inline a real key.

api_keys:
  deepseek: ${DEEPSEEK_API_KEY}
  openrouter: ${OPENROUTER_API_KEY}
  zai: ${ZAI_API_KEY}

defaults:
  dispatcher: deepseek/deepseek-v4-flash
  default_worker: deepseek/deepseek-v4-pro
  default_aggregator: deepseek/deepseek-v4-flash
  lock_dispatcher: false
  lock_aggregator: true

formations:
  # CLI default (`chimera -f auto`): the dispatcher designs the DAG itself.
  auto:
    mode: auto
  simple:
    aggregator: default
    workers: 2
  debate:
    aggregators:
      - default
      - default
    merge: best_of_n
    workers: 2
  # Post-hoc auditor stage. The web-SSE integration battery posts
  # simple/debate/audit; CI runs against THIS file, so it must exist here.
  audit:
    audit: default
    aggregator: default
    workers: 2
# Public provider endpoints. Any OpenAI-compatible endpoint — local or remote —
# is another entry here plus matching catalog entries. Examples: chimera.yaml.fleet
# and docs/CONFIG.md ("Custom OpenAI-compatible endpoints").
providers:
  deepseek:
    base_url: https://api.deepseek.com/v1
  openrouter:
    base_url: https://openrouter.ai/api/v1
  zai:
    base_url: https://api.z.ai/api/coding/paas/v4

# Catalog the dispatcher and selector score against. Entries are required for
# every model referenced by defaults/formations (unknown ids are rejected at
# load). A real catalog gives each model a full category map — these are
# abridged; see chimera.yaml.fleet for fleet-scale entries.
models:
  deepseek/deepseek-v4-flash:
    categories:
      technology_code/code_generation/python: 88
      technology_code/code_generation/javascript: 85
      complex_reasoning_agency/multi_step_planning/task_decomposition: 68
      general_knowledge/reasoning/explanation: 75
      creative_conversational/creative_writing/storytelling: 60
    cost_tier: budget
    provider: deepseek
    enabled: true
  deepseek/deepseek-v4-pro:
    categories:
      technology_code/code_generation/python: 92
      technology_code/code_generation/javascript: 90
      complex_reasoning_agency/multi_step_planning/task_decomposition: 75
      general_knowledge/reasoning/explanation: 80
      creative_conversational/creative_writing/storytelling: 65
    cost_tier: standard
    provider: deepseek
    enabled: true
  zai-coding-plan/glm-5.2:
    categories:
      technology_code/code_generation/python: 94
      complex_reasoning_agency/multi_step_planning/task_decomposition: 90
      general_knowledge/reasoning/explanation: 90
      creative_conversational/creative_writing/storytelling: 88
    cost_tier: premium
    provider: zai
    enabled: true
  openrouter/anthropic/claude-fable-5:
    categories:
      technology_code/code_generation/python: 97
      complex_reasoning_agency/multi_step_planning/task_decomposition: 98
      general_knowledge/reasoning/explanation: 97
      creative_conversational/creative_writing/storytelling: 92
    cost_tier: premium
    provider: openrouter
    enabled: true
server:
  host: 0.0.0.0
  port: 8765

observability:
  log_level: warning
  use_stdout: false
  trace_enabled: true
  langfuse:
    enabled: false

selector:
  price_sensitivity: 0.0
provider_discovery: true

timeout:
  total_s: 600.0
  per_stage_s: 300.0
  idle_s: 30.0
  min_tokens_per_second: 0.0
  connect_s: 10.0
  read_s: 30.0
  retry_s: 60.0
