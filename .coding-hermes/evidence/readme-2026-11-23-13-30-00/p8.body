{"name":"chimera","description":"Dynamic multi-model deliberation gateway: one API call dispatches your prompt to a team of LLMs and an aggregator merges their outputs into one answer.","version":"0.3.0","url":"http://0.0.0.0:8765","capabilities":{"streaming":false,"mcp_tools":true,"openai_compatible":true},"skills":[{"id":"chimera_deliberate","name":"chimera_deliberate","description":"Run a full multi-model deliberation and return the merged answer + trace."},{"id":"chimera_formations","name":"chimera_formations","description":"List the available formation presets."},{"id":"chimera_models","name":"chimera_models","description":"List the available models with their category weights."}]}