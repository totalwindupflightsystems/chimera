#!/usr/bin/env bash
# bunker-qa.sh — QA FOREMAN pipeline: FULL fresh-system CI pass on a JIT bunker agent.
# The stand-in PM's sibling: where the PM finds work/gaps on boards, this finds
# BRITTLENESS by running the project on a CLEAN machine (Bane doctrine 08-24:
# "not just we have valid code but does that code give us things that are brittle").
#
# Cells: fresh install · ci-pass (act --bind) · docker-deploy · ui-probe · upgrade
#        chaos-disconnect · chaos-shutdown · chaos-corruption · chaos-resource · chaos-errorpath
#
# Architecture: ALL remote commands run from a generated script (qa-run.sh) shipped
# base64 to the agent — never nested shell strings through ssh layers (quoting hell
# observed 2026-08-27: PIPESTATUS eaten by inner pipes, $(..) expanded locally,
# syntax errors misread as "HANGS").
#
# Usage:
#   bunker-qa.sh run     <repo-dir> [--server X] [--ttl 4h] [--keep]
#                                             — SYNCHRONOUS compat mode: waits for
#                                               the whole battery, then pulls
#   bunker-qa.sh launch  <repo-dir> [--keep]  — PHASE A: preflights + spawn + sync +
#                                               START the battery DETACHED on the
#                                               agent (~60-120s). Writes $EVIDENCE.meta
#                                               and one launch cell. Waits on NO cells.
#   bunker-qa.sh collect --evidence <path>    — PHASE B: poll → sync → pull →
#                                               destroy. Idempotent; prints RUNNING
#                                               (rc=0, no destroy) while the battery
#                                               is alive, syncing its evidence rows
#                                               incrementally (QA-BUNKER-77). On a
#                                               FINISHED agent it pulls the per-cell
#                                               logs BEFORE destroy; an agent reaped
#                                               before the logs could be pulled is
#                                               graded agent-gone (rc=0) when its
#                                               rows were already synced. The
#                                               merged ledger + logs are persisted
#                                               to the DURABLE OUT-OF-TREE root
#                                               ~/.hermes/qa/evidence/<project>/
#                                               <tick>/ (BUNKER_QA_EVIDENCE_
#                                               PERSIST_ROOT overrides; LORE-
#                                               HYGIENE-20261122: never inside
#                                               the repo-under-test) with a
#                                               manifest.json digest of that exact
#                                               copy and ONE
#                                               `EVIDENCE-SHA256=<hex> EVIDENCE-ROWS=<n>`
#                                               line on stdout (QA-CRIER-066).
#   bunker-qa.sh verify-evidence <dir|evidence.jsonl> [--expect <hex>] [--event <json>]
#                                             — PURE LOCAL read-back: re-hash the
#                                               persisted evidence.jsonl, compare it
#                                               to manifest.json and/or --expect /
#                                               an audit-event JSON's
#                                               evidence_sha256, and print ONE
#                                               EVIDENCE-VERIFY=MATCH|MISMATCH line.
#                                               No agent, no server, no network —
#                                               usable long after the run is gone.
#   bunker-qa.sh resolve <repo-dir>           — SAFE PROBE (QA-BUNKER-REVIEW-3):
#                                               print the product root run/launch
#                                               would sync/grade for <repo-dir> —
#                                               stand-in board-symlink resolution,
#                                               explicit BUNKER_QA_SUBDIR override,
#                                               or the named refusal. NO agent, NO
#                                               battery, NO network.
#   bunker-qa.sh status
#
# TARGET BINDING (QA-CRIER-62): run/launch compare four identity claims BEFORE
# any cell is graded — scheduler target (CODING_HERMES_QA_TARGET or
# BUNKER_QA_TARGET), runner label (CODING_HERMES_PROJECT), the RESOLVED
# repository identity (git remote URL, else go.mod/pyproject/Cargo/package.json
# name — NEVER the checkout basename) and the evidence project this run stamps.
# A disagreement marks the battery target-invalid: no product cell is graded, no
# product finding is filed, the report is retained at $EVIDENCE.target-invalid,
# and the exit code is 4. BUNKER_QA_PROJECT_IDENTITY=<project> is the documented
# explicit scope field (it binds an identity-less checkout and must agree with a
# resolved one); `bunker-qa.sh __target-bind <repo-dir>` prints the verdict.
#
# WHY THE SPLIT (QA-HERMES-CANOPY-8, 2026-09-15): a full fresh-system battery
# (spawn, sync, toolchain bootstrap, act CI, native suite, compose, 4 chaos
# cells) takes 7-15 min, but a single Hermes terminal tool call is killed at
# ~420s. The synchronous form therefore killed the battery mid-run, the
# cleanup traps died with the call, and the resulting 0-byte evidence file
# reads as "no cells" = UNVERIFIED (143 of 751 /tmp/bunker-qa-evidence-*.jsonl
# on this box are 0 bytes — a systemic class, not a one-off). Every launch/
# collect tool call is designed to finish far under that cap.
# NOTE: NO `set -e` on purpose — every cell records its own status via RC echoes.
set -uo pipefail

# ── Docker lifecycle safety gate (QA-HARNESS-DOCKERGATE-001, 2026-11-16) ──────
# `docker-deploy` and `chaos-shutdown` run `docker compose up -d --build`,
# `stop`, `start`, `kill` and `down`. Dropped from the QA-BUNKER-REVIEW-3
# rewrite (2026-11-02) — the cells then fired UNCONDITIONALLY on any target with
# a compose file (measured: chimera-v2-qa-clone 2026-11-16 06:22 ran
# `docker compose up -d --build` with no opt-in). Restored here and repeated on
# the agent: the cells are opt-in for a DISPOSABLE target only.
BUNKER_QA_ENABLE_DOCKER_LIFECYCLE="${BUNKER_QA_ENABLE_DOCKER_LIFECYCLE:-0}"
case "$BUNKER_QA_ENABLE_DOCKER_LIFECYCLE" in
  0|1) ;;
  *) echo "ERROR: BUNKER_QA_ENABLE_DOCKER_LIFECYCLE must be 0 or 1" >&2; exit 2 ;;
esac

# A controller on the live Hermes host must never enable Compose lifecycle
# tests, even if an inherited environment sets the opt-in flag. Auto-detected
# (cwd under ~/.hermes, or an active hermes-gateway.service); an explicit
# BUNKER_QA_DOCKER_LIFECYCLE_HOST_BLOCK=0|1 overrides the detection — use 0
# ONLY for batteries whose compose cells target a disposable REMOTE agent.
if [ "${BUNKER_QA_DOCKER_LIFECYCLE_HOST_BLOCK:-auto}" = "auto" ]; then
  BUNKER_QA_DOCKER_LIFECYCLE_HOST_BLOCK=0
  if [ -f "$HOME/.hermes/state.db" ]; then
    _qa_controller_pwd=$(pwd -P)
    case "$_qa_controller_pwd/" in
      "$HOME/.hermes/"*) BUNKER_QA_DOCKER_LIFECYCLE_HOST_BLOCK=1 ;;
    esac
  fi
  if XDG_RUNTIME_DIR="/run/user/$(id -u)" systemctl --user is-active --quiet hermes-gateway.service 2>/dev/null; then
    BUNKER_QA_DOCKER_LIFECYCLE_HOST_BLOCK=1
  fi
fi
if [ "$BUNKER_QA_DOCKER_LIFECYCLE_HOST_BLOCK" = "1" ]; then
  BUNKER_QA_ENABLE_DOCKER_LIFECYCLE=0
fi

# Default server: bunker-las-03 was REMOVED from ~/.bunker/config.yaml
# (stale default produced 4 consecutive days of P1 "spawn failed" findings,
# 27+ re-files — QA-DAGGER-GUARD 2026-09-10), then re-registered 2026-09-10
# and live-probe-verified 2026-09-22 (spawn/exec/destroy green, tick 547
# QA-HERMES-CANOPY-19). bunker-las-02 remains the verified default.
# Override with BUNKER_QA_SERVER; BUNKER_QA_HOST is accepted as an alias
# (QA-BUNKER-B20, 2026-10-10) so callers that name the variable after the
# CONCEPT (host) rather than the bunker CLI's config key get the same lever.
SERVER="${BUNKER_QA_SERVER:-${BUNKER_QA_HOST:-bunker-mvp}}"
# QA-keyfix 2026-09-30: ~/.ssh/id_ed25519_bunker was clobbered by an ELF binary
# (2026-09-28), so any ssh carrying it as the ONLY IdentitiesOnly identity fails
# auth and every preflight graded its server "unreachable". BUNKER_QA_HOST_KEY
# (full path) injects a working host key ahead of every ssh the script makes;
# a replacement key for bunker-mvp lives at ~/.ssh/id_ed25519_bunker_mvp.
: "${BUNKER_QA_HOST_KEY:=$HOME/.ssh/id_ed25519_bunker_mvp}"
TTL="${BUNKER_QA_TTL:-4h}"
ACT_URL="https://github.com/nektos/act/releases/latest/download/act_Linux_x86_64.tar.gz"
# QA-H3-14 (2026-09-21): userspace GNU make bootstrap for make-less JIT agents
# (agentuid install into ~/tools/make; build.sh needs no preexisting make).
MAKE_URL="https://ftp.gnu.org/gnu/make/make-4.4.1.tar.gz"
EVIDENCE="${BUNKER_QA_EVIDENCE:-/tmp/bunker-qa-evidence.jsonl}"
# TR-085: the shared default evidence path is how one run's meta gets read by the
# next run's collect (dogfood 2026-09-20 probed a 2-day-old agent). Callers that
# accept the default get a per-run suffix unless they explicitly opt out —
# set BUNKER_QA_ALLOW_SHARED_EVIDENCE=1 to keep the historical path.
if [ -z "${BUNKER_QA_EVIDENCE:-}" ] && [ "${BUNKER_QA_ALLOW_SHARED_EVIDENCE:-0}" != "1" ]; then
  EVIDENCE="/tmp/bunker-qa-evidence-$(date -u +%Y%m%dT%H%M%SZ)-$$.jsonl"
fi

# ─── QA-BUNKER-60 (2026-10-07): slice sizing + repo-weight preflight ───
# JIT QA agents spawned with the DEFAULT slice (2 of 16 host cores, 4G) took
# ~5% CPU per rustc process on a heavy workspace (wasmtime + arrow + tree-sitter
# C parsers): the install leg ran 2h+ and the battery was salvaged at ~3h
# with cells unwritten — the TTL window cannot fit heavy workspaces on a 2-CPU
# slice. Three levers, all opt-in-by-shape (default slice preserved for light
# repos; nothing else about the spawn contract changes):
#   1. qa_slice_args(): BUNKER_QA_CPUS (default 4.0 ONLY for cargo/go
#      workspaces) + BUNKER_QA_MEM (bytes, only when set) → `bunker spawn
#      --cpu/--memory` (flags verified against internal/cli/spawn.go:369-370:
#      --cpu float64 cores, --memory uint64 bytes).
#   2. qa_repo_dep_count(): dependency weight for the preflight WARN
#      (Cargo.lock `name = ` rows; go.mod `=>` indirect arrows).
#   3. qa_repo_weight_warn(): fires the slice-too-small WARN (stderr + a
#      launch-evidence note cell) when the repo is heavy AND the resolved CPU
#      quota is still the 2-CPU host default.
# Both entry paths (run/launch) call qa_preflight_repo_weight() so a heavy repo
# warns BEFORE any spawn burns a TTL on an undersized slice.
qa_slice_cpus() { # stdout: resolved CPU quota string, "" = keep bunkerd default
  if [ -n "${BUNKER_QA_CPUS:-}" ]; then printf '%s' "$BUNKER_QA_CPUS"; return 0; fi
  # Only cargo/go workspaces get an automatic bump — the 2-CPU default slice is
  # the right size for everything else (npm/pip/make repos measured fine).
  if [ -f "$1/Cargo.toml" ] || [ -f "$1/go.mod" ]; then printf '4.0'; fi
  return 0
}
qa_slice_args() { # <repo-dir> — stdout: spawn flags ("" = none; keep contract)
  local cpus; cpus=$(qa_slice_cpus "$1")
  [ -n "$cpus" ] && printf -- '--cpu %s' "$cpus"
  [ -n "${BUNKER_QA_MEM:-}" ] && printf ' --memory %s' "$BUNKER_QA_MEM"
  return 0
}
qa_repo_dep_count() { # <repo-dir> — stdout: dependency count, "" = not counted
  if [ -f "$1/Cargo.lock" ]; then grep -c 'name = ' "$1/Cargo.lock" || true
  # go.mod direct+indirect: count tab-indented `module vX.Y.Z` require lines.
  # (A `grep -c '=>'` counts only `replace a => b` directives — near-zero on a
  # normal go.mod — so the WARN would never fire for go workspaces. The pattern
  # is ANSI-C quoted: glibc grep ERE treats a literal-backslash `\t` as `t`,
  # which matches nothing — probe-verified 2026-10-07, QA-BUNKER-60.)
  elif [ -f "$1/go.mod" ]; then grep -cE $'^\t\\S+ v[0-9]' "$1/go.mod" || true; fi
  return 0
}
qa_repo_weight_warn() { # <repo-dir> <evidence-file> — WARN when heavy AND 2-CPU default
  local repo="$1" evfile="$2" deps cpus
  deps=$(qa_repo_dep_count "$repo")
  [ -n "$deps" ] || return 0
  [ "$deps" -gt 200 ] || return 0
  cpus=$(qa_slice_cpus "$repo")
  # Warn only when the resolved quota is still the 2-CPU HOST default — an
  # explicit BUNKER_QA_CPUS (even 2.0) is an operator decision, not an oversight.
  [ -n "${BUNKER_QA_CPUS:-}" ] && return 0
  [ "$cpus" = "4.0" ] && return 0
  echo "WARN: slice too small for this workspace ($deps deps) — set BUNKER_QA_CPUS>=4" >&2
  if [ -n "$evfile" ] && [ -f "$evfile" ]; then
    printf '{"project":"%s","cell":"launch-note","status":"INFO","detail":"slice too small for this workspace (%s deps) — set BUNKER_QA_CPUS>=4 (cargo/go workspaces need more than the 2-CPU default slice; heavy rust builds measured 2h+ on install)","ts":"%s"}\n' \
      "$(basename "$repo")" "$deps" "$(date -u +%FT%TZ)" >> "$evfile"
  fi
  return 0
}
qa_preflight_repo_weight() { # <repo-dir> — evidence not yet open here: stderr only
  qa_repo_weight_warn "$1" ""
}

# ─── qa_run_summary (QA-BUNKER-B20, 2026-10-10) — the HONEST verdict line ───
# The old run printed ONLY wrapper-step counts, so "all steps passed" could
# coexist with "audited nothing" (the dropped-default-server class this task
# files): every fleet-side parser (dagger-role-report.py greps
# `Total time: .* | Passed: (\d+) | Failed: (\d+)` from pipeline logs) then
# reported SUCCESS over a run that audited zero cells. Pure (text in → text +
# rc out) so the regression test drives the REAL accounting without a host:
#   * audited  = AUDIT cells with an actual verdict: PASS/OK/FAIL + INFO
#                (ENV-BLOCKED/"agent lacks X" grades audit the ENVIRONMENT —
#                discarding them would re-open the audited-nothing hole);
#   * findings = FAIL verdicts on AUDIT cells (wrapper FAILs — spawn/sync/
#                collect refusals — are refusal bookkeeping, not repo
#                findings; they stay visible in the evidence file and, when
#                they leave zero audit cells, drive the NOTHING-AUDITED rc);
#   * wrapper cells (run_battery, launch, launch-note, collect,
#     destroy-verify) are excluded BY NAME — a wrapper-only evidence file is
#     exactly the "audited nothing" shape, whatever its statuses say;
#   * not-verified = UNVERIFIED/SKIP/unknown statuses (never findings, never
#                audited);
#   * ZERO audited rows ⇒ nonzero rc + the line still carries
#     "NOTHING AUDITED" — a caller that ignores the rc can no longer read a
#     success from the text. Additive format; "Passed:"/"Failed:" fields keep
#     their positions and meanings (existing consumers survive).
# Per-row cell+status extraction is line-scoped (cell() writes one JSON object
# per line; the collect merge re-serializes json.dumps → one line per row), so
# a status string quoted inside a detail of ANOTHER row can never cross rows.
# DG-005 (2026-11-17): evidence rows come in TWO JSON shapes. This script's own
# printf rows are compact ({"cell":"x","status":"OK"}), but the agent-side
# writer builds rows with python3 json.dumps, whose defaults put a space after
# every colon and comma ({"cell": "x", "status": "OK"}). Any grep/sed over an
# evidence file that hard-codes the compact shape silently misses every row the
# agent wrote — the whole battery then reads as "NOTHING AUDITED" and collect()
# never sees its own OK row. Both helpers below are shape-tolerant.
EVIDENCE_CELL_RE='[[:space:]]*:[[:space:]]*'

evidence_has_cell() { # <evidence-jsonl> <cell> <status> — 0 when the row exists
  local ev="$1" cell="$2" status="$3"
  [ -f "$ev" ] || return 1
  tr -d '\n' < "$ev" |
    grep -Eq "\"cell\"${EVIDENCE_CELL_RE}\"${cell}\"[^}]*\"status\"${EVIDENCE_CELL_RE}\"${status}\""
}

# ─── QA-CRIER-066 (2026-11-18): the evidence DIGEST + read-back path ─────────
# collect() persists the merged ledger INSIDE the repo under test, but nothing
# recorded a digest OF THAT COPY: the only sha256 surfaces were the two
# `EVIDENCE_SHA256=` lines (run/launch) which hash $EVIDENCE BEFORE the final
# rows are appended and name no persisted path. Field incident 2026-11-14: the
# audit event pinned evidence_sha256=b2f33303…, the surviving file hashed
# 7f1884da… at 26 rows, its mtime predated the event, and no 24/25-row prefix
# nor any canonicalization reproduced b2f33303 — so a foreman, judge or releng
# sweep could not verify the QA evidence it was told to trust.
# Three surfaces close that: a manifest written next to the persisted copy
# (persist_evidence), exactly ONE `EVIDENCE-SHA256=<hex> EVIDENCE-ROWS=<n>`
# stdout line, and `verify-evidence` — pure local file work, so it still works
# after the JIT agent (and its home directory) is long destroyed.
qa_sha256() { # <file> -> stdout: lowercase hex sha256; rc 1 = no hasher on PATH
  local f="$1"
  [ -f "$f" ] || return 1
  if command -v sha256sum >/dev/null 2>&1; then sha256sum "$f" | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then shasum -a 256 "$f" | awk '{print $1}'
  elif command -v openssl >/dev/null 2>&1; then openssl dgst -sha256 "$f" | awk '{print $NF}'
  else return 1
  fi
}

qa_evidence_rows() { # <file> -> COMPLETE JSON records (one object per line)
  awk '/^[[:space:]]*\{/ && /\}[[:space:]]*$/{n++} END{print n+0}' "$1" 2>/dev/null || echo 0
}

qa_json_str() { # <json-file> <key> -> first string value, "" when absent
  [ -f "$1" ] || return 0
  grep -o "\"$2\"[[:space:]]*:[[:space:]]*\"[^\"]*\"" "$1" 2>/dev/null | head -1 |
    sed -e "s/^\"$2\"[[:space:]]*:[[:space:]]*\"//" -e 's/"$//'
}

qa_json_num() { # <json-file> <key> -> first numeric value, "" when absent
  [ -f "$1" ] || return 0
  grep -oE "\"$2\"[[:space:]]*:[[:space:]]*[0-9]+" "$1" 2>/dev/null | head -1 |
    grep -oE '[0-9]+$'
}

# LORE-HYGIENE-20261122: the durable OUT-OF-TREE persist root for a battery's
# evidence. persist_evidence() used to copy the merged ledger + per-cell logs
# into <repo-under-test>/.coding-hermes/evidence/<tick>/ — 100-500K of untracked
# residue per battery that tripped every repo's release clean-tree precheck
# (lore measured it 3 runs in a row). Evidence is durable here, outside every
# checkout. Root override: BUNKER_QA_EVIDENCE_PERSIST_ROOT. Project segment
# mirrors write_evidence_manifest's proj resolution: the launch record's
# project= line, else BUNKER_QA_PROJECT_IDENTITY, else the repo basename.
qa_evidence_persist_root() { # <repo_root> <meta_file> -> stdout: <root>/<project>
  local proj
  proj=$(sed -n 's/^project=//p' "$2" 2>/dev/null | head -1)
  [ -n "$proj" ] || proj="${BUNKER_QA_PROJECT_IDENTITY:-}"
  [ -n "$proj" ] || proj=$(basename -- "$1" 2>/dev/null)
  [ -n "$proj" ] || proj="unknown-target"
  printf '%s/%s\n' "${BUNKER_QA_EVIDENCE_PERSIST_ROOT:-${HOME}/.hermes/qa/evidence}" "$proj"
}

# QA-CRIER-066 (4): the verifier a closeout runs instead of trusting the ledger.
# Accepts the tick DIRECTORY collect() printed as EVIDENCE-DIR= or the ledger
# file itself (manifest.json is read from its directory). The expectation comes
# from --expect (a hex digest a board row/audit event quotes), --event (any
# JSON/JSONL carrying "evidence_sha256" — first match wins), else the manifest.
# A MISSING MANIFEST IS A NAMED FAILURE when it is the only available
# expectation — never a silent pass. Exit 0 only on a full match; 1 mismatch;
# 2 usage. One line, always, so a caller can record it verbatim:
#   EVIDENCE-VERIFY=MATCH|MISMATCH expected=<hex|none> actual=<hex> rows=<n> …
verify_evidence() { # <dir|evidence.jsonl> [--expect <hex>] [--event <json-file>]
  local target="" expect="" event="" ev="" mf="" sha="" rows="" bytes="" want=""
  local want_src="" want_lc="" reasons="" msha="" mrows="" mbytes=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --expect)
        [ $# -ge 2 ] || { echo "ERROR: --expect requires a hex digest" >&2; exit 2; }
        expect="$2"; shift 2 ;;
      --expect=*) expect="${1#--expect=}"; shift ;;
      --event)
        [ $# -ge 2 ] || { echo "ERROR: --event requires a JSON file" >&2; exit 2; }
        event="$2"; shift 2 ;;
      --event=*) event="${1#--event=}"; shift ;;
      -h|--help)
        echo "usage: bunker-qa.sh verify-evidence <dir|evidence.jsonl> [--expect <hex>] [--event <json-file>]"
        exit 0 ;;
      -*) echo "ERROR: unknown verify-evidence flag: $1" >&2; exit 2 ;;
      *)
        if [ -n "$target" ]; then
          echo "ERROR: verify-evidence takes ONE path (got '$target' and '$1')" >&2
          exit 2
        fi
        target="$1"; shift ;;
    esac
  done
  if [ -z "$target" ]; then
    echo "usage: bunker-qa.sh verify-evidence <dir|evidence.jsonl> [--expect <hex>] [--event <json-file>]" >&2
    exit 2
  fi
  if [ -d "$target" ]; then
    ev="$target/evidence.jsonl"
    mf="$target/manifest.json"
  else
    ev="$target"
    mf="$(dirname -- "$target")/manifest.json"
  fi
  if [ ! -f "$ev" ]; then
    printf 'EVIDENCE-VERIFY=MISMATCH expected=%s actual=none rows=0 reason="no evidence file at %s"\n' \
      "${expect:-none}" "$ev"
    exit 1
  fi
  if ! sha=$(qa_sha256 "$ev"); then
    printf 'EVIDENCE-VERIFY=MISMATCH expected=%s actual=none rows=%s reason="no sha256 tool on PATH (sha256sum/shasum/openssl)"\n' \
      "${expect:-none}" "$(qa_evidence_rows "$ev")"
    exit 1
  fi
  rows=$(qa_evidence_rows "$ev")
  bytes=$(wc -c < "$ev" 2>/dev/null | tr -d '[:space:]')
  if [ -n "$expect" ]; then
    want="$expect"; want_src="--expect"
  fi
  if [ -z "$want" ] && [ -n "$event" ]; then
    if [ ! -f "$event" ]; then
      printf 'EVIDENCE-VERIFY=MISMATCH expected=none actual=%s rows=%s reason="event file not found: %s"\n' \
        "$sha" "$rows" "$event"
      exit 1
    fi
    want=$(grep -oE '"evidence_sha256"[[:space:]]*:[[:space:]]*"[0-9A-Fa-f]{64}"' "$event" 2>/dev/null |
      head -1 | grep -oE '[0-9A-Fa-f]{64}')
    want_src="--event $event"
    if [ -z "$want" ]; then
      printf 'EVIDENCE-VERIFY=MISMATCH expected=none actual=%s rows=%s reason="the given event JSON carries no evidence_sha256"\n' \
        "$sha" "$rows"
      exit 1
    fi
  fi
  if [ -z "$want" ]; then
    if [ ! -f "$mf" ]; then
      printf 'EVIDENCE-VERIFY=MISMATCH expected=none actual=%s rows=%s reason="no manifest"\n' "$sha" "$rows"
      exit 1
    fi
    want=$(qa_json_str "$mf" evidence_sha256)
    want_src="manifest"
    if [ -z "$want" ]; then
      printf 'EVIDENCE-VERIFY=MISMATCH expected=none actual=%s rows=%s reason="manifest has no evidence_sha256"\n' \
        "$sha" "$rows"
      exit 1
    fi
  fi
  want_lc=$(printf '%s' "$want" | tr 'A-F' 'a-f')
  if [ "$want_lc" != "$sha" ]; then
    reasons="digest expected=$want_lc ($want_src) actual=$sha"
  fi
  # Cross-check everything the manifest claims, even when the caller supplied an
  # expectation: a manifest that disagrees with its own copy is exactly the
  # unverifiable-closeout shape, whatever a board row quotes.
  if [ -f "$mf" ]; then
    msha=$(qa_json_str "$mf" evidence_sha256 | tr 'A-F' 'a-f')
    [ -n "$msha" ] && [ "$msha" != "$sha" ] && reasons="${reasons:+$reasons; }manifest digest $msha != actual $sha"
    mrows=$(qa_json_num "$mf" evidence_rows)
    [ -n "$mrows" ] && [ "$mrows" != "$rows" ] && reasons="${reasons:+$reasons; }manifest rows $mrows != actual $rows"
    mbytes=$(qa_json_num "$mf" evidence_bytes)
    [ -n "$mbytes" ] && [ "$mbytes" != "$bytes" ] && reasons="${reasons:+$reasons; }manifest bytes $mbytes != actual $bytes"
  fi
  if [ -n "$reasons" ]; then
    printf 'EVIDENCE-VERIFY=MISMATCH expected=%s actual=%s rows=%s reason="%s"\n' \
      "$want_lc" "$sha" "$rows" "$reasons"
    exit 1
  fi
  printf 'EVIDENCE-VERIFY=MATCH expected=%s actual=%s rows=%s source=%s\n' \
    "$want_lc" "$sha" "$rows" "$want_src"
  exit 0
}

qa_run_summary() { # <evidence-jsonl> — prints summary; rc 0 = honest PASS verdict
  local ev="$1" audited=0 findings=0 nv=0 tinvalid=0 line pair cell status
  while IFS= read -r line; do
    pair=$(printf '%s\n' "$line" | sed -nE 's/.*"cell"[[:space:]]*:[[:space:]]*"([a-z_-]+)"[^}]*"status"[[:space:]]*:[[:space:]]*"([A-Za-z-]+)".*/\1 \2/p' | head -1)
    [ -n "$pair" ] || continue
    cell="${pair%% *}"; status="${pair#* }"
    # QA-CRIER-62: a target-invalid battery never reads as a verdict — it is
    # flagged on the summary line and forces a nonzero rc so no consumer can
    # mistake "graded the wrong project" for a clean pass.
    [ "$status" = target-invalid ] && tinvalid=1
    case "$cell" in
      run_battery|launch|launch-note|collect|destroy-verify|target-binding) continue ;;
    esac
    case "$status" in
      FAIL) findings=$((findings+1)); audited=$((audited+1)) ;;
      PASS|OK|INFO) audited=$((audited+1)) ;;
      *) nv=$((nv+1)) ;;   # UNVERIFIED / SKIP / anything unknown: no verdict
    esac
  done < "$ev" 2>/dev/null
  printf 'Total time: ? | Passed: %d | Failed: %d | Audited: %d | Findings: %d | NotVerified: %d' \
    "$((audited - findings))" "$findings" "$audited" "$findings" "$nv"
  if [ "$tinvalid" -eq 1 ]; then
    printf ' — TARGET-INVALID (the battery is not bound to the project it claims; no product finding is filed)\n'
    return 1
  fi
  if [ "$audited" -eq 0 ]; then
    printf ' — NOTHING AUDITED (0 cells with a verdict; wrapper steps do not count)\n'
    return 1
  fi
  printf '\n'
  [ "$findings" -eq 0 ]
}

log()  { echo "→ $*"; }

# ─── qa_destroy_agent <id> <evidence-file|''> (QA-BUNKER-19 b+c, 2026-09-21) ───
# Destroy with SURFACING + post-destroy absence verify. Replaced the bare
# `bunker destroy … || true` swallow in the cleanup/collect paths, which
# defeated the destroy-failure escalation contract (QA-BUNKER-19: a failed
# cleanup destroy left agent 230abb5b running with no trace in any log).
# QA-BUNKER-39 (2026-09-30) hardened the whole path: on a loaded server the
# CLI destroy's short internal deadline expires (deadline_exceeded x3 on
# bunker-las-02, 2026-09-29 11:53-12:02Z), the temp agent survives, and its
# slot stays consumed until the ~4h TTL reaps it — one leaked slot is one
# dead lane launch ("capacity exhausted (8/8)"). Contract now:
#   * RETRY: up to 3 destroy attempts with backoff (10s after attempt 1,
#     30s after attempt 2; BUNKER_QA_DESTROY_BACKOFF overrides for tests).
#     Every failed attempt is logged on stderr.
#   * RE-CHECK: after the final attempt, one bounded `bunker list` probe is
#     the HONEST verdict — not the destroy rc. An id still listed after a
#     failed run of attempts (or with an unverifiable list) is a REAL leak:
#     stderr + one FAIL evidence row (cell destroy-verify) naming the agent
#     id, server, the ~4h TTL reap hint and the manual recovery command.
#     The destroy landing LATE (failed attempts, id gone from the list) is
#     teardown RECOVERED — logged, no failure row.
#   * STDOUT CONTRACT: exactly one final stdout line — "TEARDOWN-GONE" (clean
#     destroy), "TEARDOWN-RECOVERED" (late-landing destroy) or
#     "TEARDOWN-LEAK" (still listed / unverifiable after failed attempts) —
#     so callers (collect) can state a summary that matches reality.
# The list probe stays best-effort on the clean path: a failed/unparseable
# list after a clean destroy is silence, never a failure.
# Never fails the caller (returns 0 unconditionally) — a cleanup/verify probe
# must not become the run's verdict; the destroy rc is surfaced, not propagated.
# spawn_agent()'s pre-retry destroy stays inline (stderr only): no evidence file
# is open there yet, and the retry loop needs no extra list round-trip.
qa_destroy_agent() {
  local id="$1" evfile="$2" drc=0 lst="" row="" attempt list_rc=0 destroy_failed=0
  for attempt in 1 2 3; do
    drc=0
    bunker destroy "$id" --server "$SERVER" >/dev/null 2>&1 || drc=$?
    if [ "$drc" -eq 0 ]; then break; fi
    destroy_failed=1
    echo "destroy FAILED: agent $id rc=$drc server=$SERVER (attempt $attempt/3)" >&2
    if [ "$attempt" -lt 3 ]; then
      local backoff=$(( attempt == 1 ? 10 : 30 ))
      sleep "${BUNKER_QA_DESTROY_BACKOFF:-$backoff}"
    fi
  done
  # Honest verdict: re-check the server list whatever the destroy rc claimed —
  # a destroy may land late, after its client already reported failure.
  lst=$(timeout 10 bunker list --server "$SERVER" 2>/dev/null)
  list_rc=$?
  if [ "$list_rc" -eq 0 ] && printf '%s' "$lst" | grep -qF -- "$id"; then
    echo "STILL PRESENT AFTER DESTROY: agent $id on $SERVER" >&2
    row="STILL PRESENT AFTER DESTROY: agent=$id server=$SERVER — destroy still failing after 3 attempts (last rc=$drc) — temp agent holds a slot until the ~4h TTL reaps it; manual recovery: bunker destroy $id --server $SERVER"
  elif [ "$destroy_failed" -eq 1 ] && [ "$list_rc" -eq 0 ]; then
    echo "destroy reported failure (last rc=$drc) but agent=$id is GONE from the $SERVER list — teardown recovered (destroy landed late)" >&2
  elif [ "$destroy_failed" -eq 1 ]; then
    echo "destroy FAILED after 3 attempts (last rc=$drc) and the server list is unverifiable (list rc=$list_rc) — treating agent $id on $SERVER as LEAKED" >&2
    row="bunker destroy FAILED after 3 attempts (last rc=$drc); server list unverifiable (rc=$list_rc) — agent=$id server=$SERVER may hold a slot until the ~4h TTL reaps it; manual recovery: bunker destroy $id --server $SERVER"
  fi
  if [ -n "$row" ] && [ -n "$evfile" ]; then
    printf '{"cell":"destroy-verify","status":"FAIL","detail":"%s","ts":"%s"}\n' \
      "$(printf '%s' "$row" | tr '\n' ' ' | cut -c1-300)" "$(date -u +%FT%TZ)" >> "$evfile"
  fi
  if [ -n "$row" ]; then echo "TEARDOWN-LEAK"
  elif [ "$destroy_failed" -eq 1 ]; then echo "TEARDOWN-RECOVERED"
  else echo "TEARDOWN-GONE"; fi
  return 0
}

# ─── tick-death watchdog (QA-BUNKER-75) ─────────────────────────────────────
# launch() and run() persist a small controller-side lock as soon as the bunker
# returns an agent id.  The lock binds that agent to the process that owns the
# QA tick (BUNKER_QA_TICK_PID, or the invoking shell's PPID for compatibility).
# A detached qa-run.sh cannot tell whether its controller died, so collect()
# checks this lock before its first SSH probe.  Dead locks are also swept before
# every new battery starts.  The lock directory is deliberately outside the
# repository and mode 0700: it contains only lifecycle metadata, never secrets.
qa_orphan_lock_dir() {
  local dir="${BUNKER_QA_ORPHAN_LOCK_DIR:-/tmp/bunker-qa-orphans}"
  mkdir -p "$dir" 2>/dev/null || return 1
  chmod 700 "$dir" 2>/dev/null || return 1
  printf '%s\n' "$dir"
}

qa_agent_lock_path() {
  local id="$1" dir
  dir=$(qa_orphan_lock_dir) || return 1
  printf '%s/%s.lock\n' "$dir" "$id"
}

qa_write_agent_lock() { # <agent-id> <tick-pid> <server> <evidence> -> path
  local id="$1" tick_pid="${2:-${BUNKER_QA_TICK_PID:-$$}}" server="$3" evidence="$4" path tmp
  [[ "$id" =~ ^[a-z0-9-]{1,64}$ ]] || return 1
  [[ "$tick_pid" =~ ^[0-9]+$ ]] || return 1
  path=$(qa_agent_lock_path "$id") || return 1
  tmp=$(mktemp "${path}.tmp.XXXXXX") || return 1
  umask 077
  printf 'format=1\nagent=%s\ntick_pid=%s\nserver=%s\nevidence=%s\ncreated=%s\n' "$id" "$tick_pid" "$server" "$evidence" "$(date -u +%FT%TZ)" > "$tmp" || { rm -f "$tmp"; return 1; }
  chmod 600 "$tmp" 2>/dev/null || { rm -f "$tmp"; return 1; }
  mv -f "$tmp" "$path" || return 1
  printf '%s\n' "$path"
}

qa_remove_agent_lock() {
  local id="$1" path
  path=$(qa_agent_lock_path "$id") || return 1
  rm -f "$path"
}

# QA-CRIER-REVIEW-4 (2026-11-04): take ownership of a lock left by a dead tick.
# The atomic rewrite keeps every other field (server/evidence/created) so the
# collector inherits the launch handle; only tick_pid changes and the adoption
# is stamped. Returns the lock path on success, non-zero if any step fails.
qa_adopt_agent_lock() { # <agent-id> <new-tick-pid> -> path
  local id="$1" tick_pid="${2:-$$}" path tmp
  [[ "$id" =~ ^[a-z0-9-]{1,64}$ ]] || return 1
  [[ "$tick_pid" =~ ^[1-9][0-9]*$ ]] || return 1
  path=$(qa_agent_lock_path "$id") || return 1
  [ -f "$path" ] || return 1
  tmp=$(mktemp "${path}.tmp.XXXXXX") || return 1
  umask 077
  sed "s/^tick_pid=[0-9][0-9]*\$/tick_pid=$tick_pid/" "$path" > "$tmp" || { rm -f "$tmp"; return 1; }
  grep -q '^tick_pid=' "$tmp" 2>/dev/null || printf 'tick_pid=%s\n' "$tick_pid" >> "$tmp"
  printf 'adopted=%s\n' "$(date -u +%FT%TZ)" >> "$tmp" || { rm -f "$tmp"; return 1; }
  chmod 600 "$tmp" 2>/dev/null || { rm -f "$tmp"; return 1; }
  mv -f "$tmp" "$path" || return 1
  printf '%s\n' "$path"
}

qa_tick_pid_alive() {
  local pid="$1"
  [[ "$pid" =~ ^[1-9][0-9]*$ ]] && kill -0 "$pid" 2>/dev/null
}

qa_tick_watchdog_state() { # <agent-id>: 0=alive/legacy, 1=expired dead, 2=invalid, 3=recent dead
  local id="$1" path tick_pid now age ttl
  path=$(qa_agent_lock_path "$id") || return 2
  # No controller-side lock is the explicitly supported legacy shape. Older
  # launch records remain collectible because there is no tick ownership to
  # evaluate; only a present lock can impose the watchdog policy.
  [ -f "$path" ] || return 0
  tick_pid=$(sed -n 's/^tick_pid=//p' "$path" 2>/dev/null | head -1)
  [[ "$tick_pid" =~ ^[1-9][0-9]*$ ]] || return 2
  qa_tick_pid_alive "$tick_pid" && return 0
  now=$(date -u +%s)
  ttl=$(qa_watchdog_ttl_seconds) || return 2
  age=$(qa_lock_age_seconds "$path" "$now") || return 2
  [ "$age" -lt "$ttl" ] && return 3
  return 1
}

qa_lock_value() { # <lock> <key>
  sed -n "s/^$2=//p" "$1" 2>/dev/null | head -1
}

qa_watchdog_ttl_seconds() { # <ttl> -> seconds; invalid values are fail-closed
  local ttl="${1:-${BUNKER_QA_ORPHAN_TTL:-2h}}" n unit
  n="${ttl%[smhd]}"; unit="${ttl#$n}"
  [[ "$n" =~ ^[1-9][0-9]*$ ]] || return 1
  case "$unit" in
    s) printf '%s\n' "$n" ;;
    m) printf '%s\n' "$((n * 60))" ;;
    h) printf '%s\n' "$((n * 3600))" ;;
    d) printf '%s\n' "$((n * 86400))" ;;
    *) return 1 ;;
  esac
}

qa_lock_age_seconds() { # <lock> <now-epoch> -> age; invalid timestamps fail closed
  local lock="$1" now="$2" created created_epoch
  created=$(qa_lock_value "$lock" created)
  [ -n "$created" ] || return 1
  created_epoch=$(date -u -d "$created" +%s 2>/dev/null) || return 1
  [ "$created_epoch" -le "$now" ] || return 1
  printf '%s\n' "$((now - created_epoch))"
}

# Preserve the evidence before destroying an orphan. The command seam keeps the
# watchdog testable without a live bunker; production copies the agent's logs
# into the quarantine directory over SSH. A local evidence file is copied first
# because it survives even when the agent's SSH endpoint died with the tick.
# QA-CRIER-REVIEW-4 (2026-11-04): a bare rc=1 was indistinguishable from a dead
# SSH endpoint, so callers escalated an undiagnosable failure into "keep the
# lock and refuse". Every failure now names the step, the command and its rc.
# QA-HERMES-CANOPY-56: the root default lives in ONE constant so the pre-spawn
# writability preflight (qa_quarantine_prespawn_preflight) and the reap cannot
# drift apart on default or override precedence.
QA_QUARANTINE_ROOT_DEFAULT="/var/lib/bunker-qa/quarantine"
qa_quarantine_orphan_evidence() { # <agent-id> <server> <evidence> -> destination
  local id="$1" server="$2" evidence="${3:-}" root stamp destination port rc
  root="${BUNKER_QA_QUARANTINE_DIR:-$QA_QUARANTINE_ROOT_DEFAULT}"
  stamp=$(date -u +%Y%m%dT%H%M%SZ)
  destination="$root/${id}-${stamp}"
  mkdir -p "$destination" 2>/dev/null; rc=$?
  if [ "$rc" -ne 0 ]; then
    echo "QUARANTINE-FAIL agent=$id step=mkdir cmd=\"mkdir -p $destination\" rc=$rc" >&2
    return 1
  fi
  if [ -n "$evidence" ] && [ -f "$evidence" ]; then
    cp -p "$evidence" "$destination/evidence.jsonl" 2>/dev/null; rc=$?
    if [ "$rc" -ne 0 ]; then
      echo "QUARANTINE-FAIL agent=$id step=cp cmd=\"cp -p $evidence $destination/evidence.jsonl\" rc=$rc" >&2
      return 1
    fi
  fi
  if [ -n "${BUNKER_QA_QUARANTINE_CMD:-}" ]; then
    "$BUNKER_QA_QUARANTINE_CMD" "$id" "$server" "$destination" "$evidence"; rc=$?
    if [ "$rc" -ne 0 ]; then
      echo "QUARANTINE-FAIL agent=$id step=quarantine-cmd cmd=\"$BUNKER_QA_QUARANTINE_CMD $id $server $destination\" rc=$rc" >&2
      return 1
    fi
  else
    port="${BUNKER_QA_SSH_PORT:-2223}"
    timeout "${BUNKER_QA_QUARANTINE_TIMEOUT:-30}" ssh -p "$port" \
      -i "$BUNKER_QA_HOST_KEY" -o IdentitiesOnly=yes -o StrictHostKeyChecking=no \
      -o BatchMode=yes "bunker-$id@$server" \
      "set -eu; d=$(printf '%q' "$destination"); s=$(printf '%q' "/var/log/bunker-qa/$id"); mkdir -p \"\$d\"; found=0; for f in \"\$s\"/*.log; do [ -f \"\$f\" ] || continue; cp -p \"\$f\" \"\$d/\"; found=1; done; [ \"\$found\" -eq 1 ]" \
      >/dev/null 2>&1; rc=$?
    if [ "$rc" -ne 0 ]; then
      echo "QUARANTINE-FAIL agent=$id step=ssh cmd=\"ssh -p $port bunker-$id@$server (copy /var/log/bunker-qa/$id/*.log to $destination)\" timeout=${BUNKER_QA_QUARANTINE_TIMEOUT:-30}s rc=$rc" >&2
      return 1
    fi
  fi
  printf '%s\n' "$destination"
}

qa_orphan_lock_eligible() { # <lock> <now-epoch>: dead tick and older than watchdog TTL
  local lock="$1" now="$2" tick_pid age ttl
  tick_pid=$(qa_lock_value "$lock" tick_pid)
  qa_tick_pid_alive "$tick_pid" && return 1
  ttl=$(qa_watchdog_ttl_seconds) || return 1
  age=$(qa_lock_age_seconds "$lock" "$now") || return 1
  [ "$age" -ge "$ttl" ]
}

# ─── orphan watchdog sweep (QA-MUSTER-046 R2) ───────────────────────────────
# The sweep runs before every battery, so it must never reproduce the failure
# that made launches burn their whole budget: a stale or FOREIGN lock, whose
# agent belongs to another server, destroyed through an UNBOUNDED
# `bunker destroy` that wedged for minutes inside the launch window while the
# host was healthy (field evidence: two ESTAB destroy processes on a foreign
# server for >4min, launch killed, lane recorded SKIPPED-install).
#   Arm 1 (bounded): every destroy is wrapped in
#     `timeout ${BUNKER_QA_DESTROY_TIMEOUT:-60}`; rc=124 prints a timeout
#     notice NAMING the lock and retains it. Every WATCHDOG line names
#     lock=<path> and the agent id.
#   Arm 2 (daemon first): `bunker list --server S --status all` is asked BEFORE
#     any destroy. List failure => fail closed (retain, no destroy). Agent
#     absent from the list => the daemon PROVED absence, so the lock is dropped
#     and NO destroy is issued at all. status=running => a LIVE battery: the
#     destroy is refused and created= is renewed, so the TTL then measures
#     idleness rather than the length of a legitimate long run.
#   Arm 3 (server scoped): a sweep for server A skips — with a log line — every
#     lock recorded against server B: no list call and no destroy for B.
# QA-CRIER-REVIEW-4 (2026-11-04): evidence preservation stays best-effort and
# must never pin an orphan on disk — a quarantine failure is named in the
# receipt and the (now bounded) destroy still proceeds.
qa_renew_agent_lock() { # <lock-path> -> path; rewrites created= to now (atomic)
  local lock="$1" tmp now
  [ -f "$lock" ] || return 1
  now=$(date -u +%FT%TZ)
  tmp=$(mktemp "${lock}.tmp.XXXXXX") || return 1
  umask 077
  awk -v now="$now" '
    /^created=/ { print "created=" now; seen = 1; next }
    /^renewed=/  { next }
    { print }
    END { if (!seen) print "created=" now; print "renewed=" now }
  ' "$lock" > "$tmp" || { rm -f "$tmp"; return 1; }
  chmod 600 "$tmp" 2>/dev/null || { rm -f "$tmp"; return 1; }
  mv -f "$tmp" "$lock" || return 1
  printf '%s\n' "$lock"
}

qa_agent_list_state() { # <agent-id> <list-output> -> status token; rc 1 = not listed
  local id="$1" out="$2" row
  row=$(printf '%s\n' "$out" | awk -v id="$id" 'index($0, "Agent ID") { next } $1 == id { print; exit }')
  [ -n "$row" ] || return 1
  printf '%s\n' "$row" | awk '{ print $2 }'
}

qa_cleanup_orphan_agents() { # [server] — the server this launch targets (foreign locks skipped)
  local dir lock agent tick_pid server launch_server evidence listed list_rc now
  local quarantine qerr qrc qfail evidence_status destroy_rc state renewed
  launch_server="${1:-}"
  dir=$(qa_orphan_lock_dir) || return 0
  now=$(date -u +%s)
  for lock in "$dir"/*.lock; do
    [ -f "$lock" ] || continue
    agent=$(qa_lock_value "$lock" agent)
    tick_pid=$(qa_lock_value "$lock" tick_pid)
    server=$(qa_lock_value "$lock" server)
    evidence=$(qa_lock_value "$lock" evidence)
    [[ "$agent" =~ ^[a-z0-9-]{1,64}$ ]] || continue
    [[ "$server" != *$'\n'* ]] || continue
    qa_orphan_lock_eligible "$lock" "$now" || continue
    if [ -n "$launch_server" ] && [ "$server" != "$launch_server" ]; then
      echo "WATCHDOG: skip foreign-server orphan agent=$agent lock=$lock server=$server launch_server=$launch_server (no list, no destroy)" >&2
      continue
    fi
    list_rc=0
    listed=$(timeout "${BUNKER_QA_LIST_TIMEOUT:-10}" bunker list --server "$server" --status all 2>/dev/null) || list_rc=$?
    if [ "$list_rc" -ne 0 ]; then
      echo "WATCHDOG: retain orphan agent=$agent lock=$lock reason=server-list-unavailable list_rc=$list_rc" >&2
      continue
    fi
    state=$(qa_agent_list_state "$agent" "$listed") || state=""
    if [ -z "$state" ]; then
      rm -f "$lock"
      echo "WATCHDOG: drop stale handle agent=$agent lock=$lock reason=agent-absent (no destroy issued)" >&2
      continue
    fi
    case "$state" in
      running|live|active|starting)
        renewed=$(qa_renew_agent_lock "$lock" 2>/dev/null) || renewed=""
        echo "WATCHDOG: skip live battery agent=$agent lock=$lock state=$state renewed=${renewed:-FAILED}" >&2
        continue
        ;;
    esac
    echo "WATCHDOG: reaping tick-death-orphan agent=$agent server=$server tick_pid=$tick_pid lock=$lock state=$state" >&2
    # Keep the quarantine stderr so the receipt can name the failing command;
    # the helper's stdout (the destination) stays the success contract.
    qerr=$(mktemp)
    quarantine=$(qa_quarantine_orphan_evidence "$agent" "$server" "$evidence" 2>"$qerr") && qrc=0 || qrc=$?
    if [ "$qrc" -eq 0 ] && [ -n "$quarantine" ]; then
      evidence_status="quarantined"
      qfail=""
    else
      evidence_status="quarantine-failed"
      qfail=$(tail -1 "$qerr" 2>/dev/null | tr -d '\n')
      [ -n "$qfail" ] || qfail="quarantine-command-failed rc=$qrc"
      echo "WATCHDOG: evidence quarantine failed agent=$agent lock=$lock failure=\"$qfail\" — reaping anyway" >&2
    fi
    rm -f "$qerr"
    destroy_rc=0
    timeout "${BUNKER_QA_DESTROY_TIMEOUT:-60}" bunker destroy "$agent" --server "$server" >/dev/null 2>&1 || destroy_rc=$?
    if [ "$destroy_rc" -eq 124 ]; then
      echo "WATCHDOG: destroy timeout agent=$agent lock=$lock timeout=${BUNKER_QA_DESTROY_TIMEOUT:-60}s — retaining lock, launch proceeds" >&2
      continue
    fi
    list_rc=0
    listed=$(timeout "${BUNKER_QA_LIST_TIMEOUT:-10}" bunker list --server "$server" --status all 2>/dev/null) || list_rc=$?
    if [ "$list_rc" -eq 0 ] && ! printf '%s\n' "$listed" | awk -v id="$agent" 'index($0, "Agent ID") { next } $1 == id { found = 1 } END { exit !found }'; then
      rm -f "$lock"
      echo "WATCHDOG: orphan reaped agent=$agent lock=$lock destroy_rc=$destroy_rc evidence=${quarantine:-none} evidence_status=$evidence_status${qfail:+ quarantine_failure=\"$qfail\"}" >&2
    else
      echo "WATCHDOG: orphan remains agent=$agent lock=$lock destroy_rc=$destroy_rc list_rc=$list_rc evidence=${quarantine:-none} evidence_status=$evidence_status${qfail:+ quarantine_failure=\"$qfail\"} — retaining lock" >&2
    fi
  done
  return 0
}

spawn_agent() {
  # QA-HERMES-CANOPY-16 (2026-09-21): an agent that spawns server-side but is
  # unreachable for the launch is an ORPHAN (holds a slot until TTL, no
  # evidence points at it; field evidence agent cefd6920, bunker-las-02,
  # 2026-09-17). Contract: capture the id at spawn time; if the attempt cannot
  # be handed off (spawn produced no usable id, or the ssh reachability probe
  # fails), DESTROY that id before retrying or failing.
  # stdout contract unchanged: success prints ONLY the agent id, rc 0;
  # total failure prints nothing on stdout, rc 1.
  local out id drc slice_args spawn_file resolved_port alt_port
  # QA-BUNKER-60 (2026-10-07): a cargo/go workspace builds on 4 CPUs by default
  # (BUNKER_QA_CPUS/BUNKER_QA_MEM override; empty = the 2-CPU/4G host default,
  # flags omitted — see qa_slice_args()). stdout contract unchanged: success
  # still prints ONLY the agent id (spawn output is captured, never relayed).
  slice_args=$(qa_slice_args "$repo")
  for attempt in 1 2 3; do
    out=$(timeout "${BUNKER_QA_SPAWN_TIMEOUT:-45}" bunker spawn --server "$SERVER" --ttl "$TTL" $slice_args 2>&1)
    spawn_rc=$?
    if [ "$spawn_rc" -eq 124 ]; then
      echo "spawn attempt $attempt timed out after ${BUNKER_QA_SPAWN_TIMEOUT:-45}s on $SERVER" >&2
    fi
    # QA-CRIER-065 (2026-11-17): the bunker bundle can carry the agent API key
    # in cleartext. Redact at CAPTURE so every sink of $out is covered at once:
    # the .spawn transcript (written below — used to land mode 0664 with the
    # key in cleartext; 160 world-readable .spawn files were found in /tmp) and
    # the retry-ladder failure echo, whose tail -3 reaches launch()'s
    # err_detail and from there the evidence jsonl. The whole key line is
    # relabelled "api_key=[REDACTED]" — the greppable "API Key" label itself
    # must never reach disk (the board criterion greps the label). Id
    # extraction and port discovery are unaffected: the SSH Key / Agent
    # created / SSH Port / SSHFS Mount lines pass through verbatim and
    # agent_ssh_port() still parses them.
    out=$(printf '%s\n' "$out" \
      | sed -E 's/[Aa][Pp][Ii][-_ ]*[Kk]ey:.*/api_key=[REDACTED]/')
    # PERF-002 (2026-10-25): id extraction must survive CLI output changes.
    # Primary: the bundle's key-path line ("SSH Key: (saved to ~/.bunker/keys/<id> ...").
    # Charset widened from hex-only [a-f0-9]+ to the CLI's documented agent-id
    # charset ^[a-z0-9-]{1,64}$ — the old class SILENTLY TRUNCATED non-hex ids
    # (e.g. keys/dec-1 → "dec"), which ssh-probes a nonexistent id while the
    # REAL agent leaks to TTL: the exact orphan class QA-HERMES-CANOPY-16
    # guards. Fallbacks cover the same id reworded (no keys/ prefix, different
    # label) so a CLI phrasing change degrades to a retry/FAIL, never a
    # wrong-id handoff.
    id=$(echo "$out" | grep -oE 'keys/[a-z0-9-]+' | head -1 | cut -d/ -f2)
    if [ -z "$id" ]; then
      id=$(echo "$out" | grep -oE '\bAgent created: [a-z0-9-]+' | head -1 | awk '{print $3}')
    fi
    if [ -z "$id" ]; then
      id=$(echo "$out" | grep -oE '\bagent [a-z0-9-]+ (created|spawned)\b' | head -1 | awk '{print $2}')
    fi
    # Non-negotiable shape gate (bunker CLI: ^[a-z0-9-]{1,64}$): a reworded
    # output must never hand a garbage extraction to the ssh probe.
    [[ "$id" =~ ^[a-z0-9-]{1,64}$ ]] || id=""
    if [ -z "$id" ]; then
      [ $attempt -lt 3 ] && { echo "  spawn attempt $attempt failed: $(echo "$out" | tail -1)" >&2; sleep "${BUNKER_QA_RETRY_SLEEP:-5}"; }
      continue
    fi
    # Keep the spawn transcript as local spawn metadata. Newer daemon/CLI
    # versions may include the agent's SSH port there; agent_ssh_port() prefers
    # that per-agent value and keeps the environment/default fallback for older
    # output shapes. QA-CRIER-065: the file is created under umask 077 (mode
    # 0600 from the first byte — no world-readable window); the key material
    # was already relabelled at capture above.
    if [ -n "${EVIDENCE:-}" ]; then
      spawn_file="${EVIDENCE}.agent-${id}.spawn"
      ( umask 077 && printf '%s\n' "$out" > "$spawn_file" )
      # A stale transcript on the same (e.g. fixed-default) evidence path keeps
      # its old mode through a truncating redirect — repair it explicitly.
      chmod 600 "$spawn_file" 2>/dev/null || true
    fi
    # Reachability gate: the agent must answer ssh BEFORE it is handed off,
    # so an unreachable spawn never leaks to the caller as a "success".
    # QA-BUNKER-75: persist ownership immediately after spawn id extraction,
    # before the reachability probe. A controller death during that probe must
    # still leave enough metadata for the next battery to reap this agent.
    if ! qa_write_agent_lock "$id" "${BUNKER_QA_TICK_PID:-$PPID}" "$SERVER" "${EVIDENCE:-}" >/dev/null; then
      echo "spawn attempt $attempt could not write tick watchdog lock for agent $id — destroying before retry" >&2
      bunker destroy "$id" --server "$SERVER" >/dev/null 2>&1 || true
      [ "$attempt" -lt 3 ] && sleep "${BUNKER_QA_RETRY_SLEEP:-5}"
      continue
    fi
    # Reachability gate: the agent must answer ssh BEFORE it is handed off,
    # so an unreachable spawn never leaks to the caller as a "success".
    # A single probe must leave room for the launch failure path to record the
    # cause before the caller's 180s ceiling. The old 180s default could consume
    # that entire ceiling inside one attempt, before LAUNCHED or ERROR was
    # emitted. Operators can raise it explicitly when diagnosing slow hosts.
    probe_rc=0
    resolved_port=$(agent_ssh_port "$id")
    if timeout "${BUNKER_QA_PROBE_TIMEOUT:-30}" ssh -p "$resolved_port" -i "$BUNKER_QA_HOST_KEY" -i "$HOME/.bunker/keys/$id" -o IdentitiesOnly=yes -o ConnectTimeout=20 -o StrictHostKeyChecking=no -o BatchMode=yes "bunker-$id@$SERVER" true 2>/dev/null; then
      echo "$id"
      return 0
    else
      probe_rc=$?
      echo "spawn attempt $attempt produced agent $id but ssh reachability probe failed (rc=$probe_rc; timeout=${BUNKER_QA_PROBE_TIMEOUT:-30}s) — destroying before retry" >&2
    fi
    # CHT-176 rework: the RESOLVED port can be wrong for a healthy agent (a
    # normal bundle that omits the port resolves 22 while the daemon publishes
    # the agent sshd on the alternate port, or the reverse). Probe the other
    # candidate ONCE before destroying — a wrong port guess must never kill a
    # live agent, which is the whole class this resolver exists to prevent.
    # An explicit BUNKER_QA_SSH_PORT is the operator's assertion, not a guess:
    # honor it verbatim and do not second-guess it with a fallback probe.
    if [ -z "${BUNKER_QA_SSH_PORT:-}" ]; then
      alt_port=22
      [ "$resolved_port" = "22" ] && alt_port=2223
      if timeout "${BUNKER_QA_PROBE_TIMEOUT:-30}" ssh -p "$alt_port" -i "$BUNKER_QA_HOST_KEY" -i "$HOME/.bunker/keys/$id" -o IdentitiesOnly=yes -o ConnectTimeout=20 -o StrictHostKeyChecking=no -o BatchMode=yes "bunker-$id@$SERVER" true 2>/dev/null; then
        echo "spawn attempt $attempt agent $id answered on alternate ssh port $alt_port (resolved $resolved_port) — handing off" >&2
        echo "$id"
        return 0
      fi
      echo "spawn attempt $attempt agent $id unreachable on both ports ($resolved_port, $alt_port) — destroying before retry" >&2
    fi
    qa_remove_agent_lock "$id" >/dev/null 2>&1 || true
    # QA-BUNKER-19 b+c: surfaced, not swallowed — stderr only (no evidence file
    # is open inside spawn_agent, and the retry loop needs no extra list
    # round-trip); rc captured so `set -o pipefail` alone can never see it as
    # handled silence.
    drc=0
    bunker destroy "$id" --server "$SERVER" >/dev/null 2>&1 || drc=$?
    [ "$drc" -ne 0 ] && echo "destroy FAILED: agent $id rc=$drc server=$SERVER (pre-retry cleanup)" >&2
    [ $attempt -lt 3 ] && sleep "${BUNKER_QA_RETRY_SLEEP:-5}"
  done
  # $out was API-key-redacted at capture (QA-CRIER-065): this tail is what
  # launch() folds into err_detail and from there into the evidence jsonl,
  # so it must stay clean.
  echo "$out" | tail -3 >&2
  return 1
}

# agent_ssh_port <agent-id> — resolve the port for this agent's sshd.
# The spawn transcript is per-agent metadata: when it carries an explicit SSH
# port, use it. Current CLI bundles identify the agent's SSH connection but omit
# the port because it is the normal SSH port (22); recognize that shape too.
# BUNKER_QA_SSH_PORT is an explicit operator override and therefore wins over
# discovered metadata; the historical 2223 fallback remains for no metadata.
#
# QA-HERMES-CANOPY-54: the transcript path is <base>.agent-<id>.spawn, where
# <base> was the LAUNCH process's evidence path. collect() runs in a SEPARATE
# process whose $EVIDENCE defaults to a fresh per-run path (see line ~134) that
# the launch never wrote — so an adopted agent probed with the launch's real
# bundle present resolved 2223 and the collect died on a live agent answering
# on 22. QA_SPAWN_BASE is "the same spawn-file base the launch wrote" when the
# collector knows it (from --evidence / the launch record); launch-time callers
# fall back to $EVIDENCE unchanged.
agent_ssh_port() {
  local id="$1" base spawn_file port=""
  base="${QA_SPAWN_BASE:-${EVIDENCE:-}}"
  spawn_file="${base}.agent-${id}.spawn"
  if [ -n "${BUNKER_QA_SSH_PORT:-}" ]; then
    printf '%s\n' "$BUNKER_QA_SSH_PORT"
    return 0
  fi
  if [ -n "$base" ] && [ -f "$spawn_file" ]; then
    port=$(grep -ioE '(ssh[-_ ]*port|--ssh-port)[=: ]+[0-9]{1,5}' "$spawn_file" 2>/dev/null \
      | grep -oE '[0-9]{1,5}$' | head -1)
    # CHT-176: a port outside the TCP range (0, 65536+) is noise, not a port.
    # Drop it so the bundle grades as "omitted" — never hand it to ssh -p.
    case "$port" in
      ''|*[!0-9]*) port="" ;;
      *) if [ "$port" -lt 1 ] || [ "$port" -gt 65535 ]; then port=""; fi ;;
    esac
    # A normal spawn bundle is itself the per-agent transport record. Its
    # omitted port means the agent sshd is on the standard SSH port, 22 — not
    # the daemon's unrelated 2223 service port.
    if [ -z "$port" ] && grep -qE 'Agent created:|SSH Key:|SSHFS Mount:|Docker SSH:' "$spawn_file" 2>/dev/null; then
      port=22
    fi
  fi
  printf '%s\n' "${port:-2223}"
}

agent_ssh() {
  local port
  port=$(agent_ssh_port "$agent")
  timeout "${BUNKER_QA_SSH_TIMEOUT:-1800}" ssh -p "$port" -i "$BUNKER_QA_HOST_KEY" -i "$key" -o IdentitiesOnly=yes -o StrictHostKeyChecking=no -o BatchMode=yes "bunker-$agent@$SERVER" "$@"
}

status() {
  echo "BUNKER QA — $(date -u +%Y-%m-%dT%H:%M:%SZ) — server $SERVER"
  timeout 30 ssh -i "$BUNKER_QA_HOST_KEY" ${BUNKER_QA_HOST_KEY:+-o IdentitiesOnly=yes} -o ConnectTimeout=20 -o StrictHostKeyChecking=no -o BatchMode=yes "$SERVER" \
    'echo "bunkerd=$(systemctl is-active bunkerd) docker=$(command -v docker >/dev/null && echo yes || echo no) act=$(command -v act >/dev/null && echo yes || echo no) uidmap=$(command -v newuidmap >/dev/null && echo yes || echo no)"' 2>/dev/null \
    || echo "  $SERVER: UNREACHABLE"
}

# ─── bunker capacity probe (QA-OFF-BY-ONE-9, 2026-09-15) ───
# Once the pool is full, `bunker spawn` fails DETERMINISTICALLY, not
# transiently: either
#   "port range allocation: no free port ranges available"  (port-pool class)
#   "capacity full: C/C agents"                             (agent-ceiling class)
# so spawn_agent()'s 3x retry loop buys nothing but latency and turns one
# actionable finding into a retry ladder (triage reference:
# skills/verification/qa-foreman-interpretation/references/bunker-server-portpool-exhaustion.md).
#
# Source of truth is the CLI — bunkerd speaks connect/gRPC, raw HTTP probes
# against /api/v1/* 404 without proving anything:
#   bunker status --server <srv>            →  "  Agents:   N/MAX"
#   bunker list --server <srv> --status all →  "Total: N agents"
#
# parse_bunker_capacity <srv> <status-output> → "USED MAX" | "" (unparseable).
# Pure (text in, text out) so the parse is provable without a live host.
parse_bunker_capacity() {
  local srv="$1" out="$2" line used max
  [ -n "$out" ] || return 0
  # `status --all` prints one "── <name> ──" section per host — scope to ours
  # first, then fall back to a whole-output scan (status --server = one section).
  line=$(printf '%s\n' "$out" | awk -v s="$srv" '
    index($0, "──") && index($0, s) { inside=1; next }
    inside && index($0, "──") { inside=0 }
    inside && /Agents:[[:space:]]*[0-9]+[[:space:]]*\/[[:space:]]*[0-9]+/ { print; exit }')
  if [ -z "$line" ]; then
    # No section matched. Only trust a whole-output scan when there is exactly
    # ONE Agents line (status --server = a single section); with several
    # sections and none naming $srv, another host's numbers are not ours.
    if [ "$(printf '%s\n' "$out" | grep -cE 'Agents:[[:space:]]*[0-9]+[[:space:]]*\/[[:space:]]*[0-9]+')" = "1" ]; then
      line=$(printf '%s\n' "$out" | grep -m1 -E 'Agents:[[:space:]]*[0-9]+[[:space:]]*\/[[:space:]]*[0-9]+' || true)
    fi
  fi
  [ -n "$line" ] || return 0
  used=$(printf '%s' "$line" | sed -E 's/^[^0-9]*([0-9]+).*/\1/')
  max=$(printf '%s' "$line" | sed -E 's#.*/[[:space:]]*([0-9]+).*#\1#')
  case "$used" in ''|*[!0-9]*) return 0 ;; esac
  case "$max"  in ''|*[!0-9]*) return 0 ;; esac
  printf '%s %s\n' "$used" "$max"
}

# bunker_capacity <srv> → "USED MAX" | "USED -" (ceiling unreadable) | "" (unknown)
# At most TWO cheap bunkerd probes: `bunker status` first, `bunker list` only
# when status yielded no usable "Agents: N/MAX" pair. Callers must treat a
# missing ceiling as UNKNOWN, never as full — blocking the battery on a probe
# hiccup would wedge the QA lane for every project on that host.
bunker_capacity() {
  local srv="$1" out cap used max
  out=$(timeout "${BUNKER_QA_CAPACITY_TIMEOUT:-20}" bunker status --server "$srv" 2>/dev/null) || out=""
  cap=$(parse_bunker_capacity "$srv" "$out")
  if [ -n "$cap" ]; then printf '%s\n' "$cap"; return 0; fi
  # Fallback (used count only): `Total: N agents`, with the ceiling taken from
  # any "N/M" pair still present in the status output.
  used=$(printf '%s\n' "$(timeout "${BUNKER_QA_CAPACITY_TIMEOUT:-20}" bunker list --server "$srv" --status all 2>/dev/null)" \
           | sed -nE 's/^Total:[[:space:]]*([0-9]+)[[:space:]]*agents.*/\1/p' | head -1)
  max=$(printf '%s\n' "$out" | sed -nE 's#.*[^0-9]([0-9]+)[[:space:]]*/[[:space:]]*([0-9]+).*#\2#p' | head -1)
  case "$used" in ''|*[!0-9]*) return 0 ;; esac
  case "$max" in ''|*[!0-9]*) max="-" ;; esac
  printf '%s %s\n' "$used" "$max"
}

# ─── write_fail_if_empty — never leave a 0-byte evidence file ───
# Now top-level (2026-09-15) because run() AND launch() share it. Rationale
# unchanged from 2026-09-07 (QA-DEXDAT-CORE-1): a tool-level SIGTERM (Hermes
# terminal cap) or a sync-fail exit kills the battery mid-run leaving a 0-byte
# evidence file — parse_cells then sees cells:[] and the DAG reports
# UNVERIFIED silently, indistinguishable from "nothing to check".
# Idempotent: TERM + EXIT traps firing together produce exactly one line.
write_fail_if_empty() {
  local reason="${1:-battery terminated before any cell recorded}"
  if ! grep -q '^{' "$EVIDENCE" 2>/dev/null; then
    printf '{"cell":"run_battery","status":"FAIL","detail":"%s","ts":"%s"}\n' \
      "$reason" "$(date -u +%FT%TZ)" >> "$EVIDENCE"
  fi
}

# ─── shared preflights (extracted verbatim from run(), 2026-09-15) ───
# launch() needs the SAME deterministic-failure gates as run(), so they live
# here and both call preflights(). Contract (unchanged): record exactly ONE
# actionable FAIL row in $EVIDENCE and exit rc=2 — a removed/stale server, an
# unreachable host, or a full pool is a STATIC error, not transient congestion,
# so spawn_agent's 3x retry loop buys nothing but latency and turns one
# actionable finding into a retry ladder.
#   config  : BUNKER_QA_SERVER must exist in ~/.bunker/config.yaml (QA-DAGGER-GUARD 09-10)
#   ssh     : the host must answer over tailscale before any spawn
#   capacity: a FULL pool fails spawn deterministically (QA-OFF-BY-ONE-9 09-15);
#             BUNKER_QA_SKIP_PREFLIGHT=1 bypasses THIS probe only.
# QA-BUNKER-B20 (2026-10-10): the target-host gates (config + ssh) moved into
# qa_target_preflight() — a PURE function that PRINTS its named cause and
# returns nonzero on failure — so run()/launch() call ONE gate before any step
# and the regression test can exercise the real refusal logic without a live
# host. Cause strings (task-named, stable for parsers):
#   "target host <name> not configured in ~/.bunker/config.yaml"
#   "SSH probe failed: target host <name> unreachable (exit=N)"
qa_target_preflight() { # [server] — 0 = reachable; nonzero = refusal (cause on stdout)
  # PERF-002 (2026-10-25): the target binds to the canonical name ($SERVER,
  # arg-or-default) so the config gate is the literal `grep -qE "^ +$SERVER:"`
  # shape the PERF-002 criterion pins. The local shadows the global ONLY
  # inside this function; callers pass the host as $1 (tests) or rely on the
  # default, exactly as with the previous $srv binding.
  local SERVER="${1:-$SERVER}"
  # A missing/blank server name is the same refusal as an unknown one: there is
  # no target to probe, so continuing would be the QA-BUNKER-B20 silent-drift
  # class with no name to print.
  if [ -z "$SERVER" ]; then
    echo "target host <empty> not configured in ~/.bunker/config.yaml (set BUNKER_QA_SERVER)"
    return 1
  fi
  # The host must exist in the bunker CLI's config (or be passed explicitly) —
  # grep is anchored like the original preflights() arm: an indented `name:`
  # key, so comment/substring matches cannot sneak a dead name past the gate.
  # PERF-002 (2026-10-25): accept ANY leading indent on the YAML server key,
  # not the rigid 4-space form — a 2-space-indented ~/.bunker/config.yaml is
  # valid YAML and must not read as "not configured" (repro 2026-09-25).
  if ! grep -qE "^ +$SERVER:" "$HOME/.bunker/config.yaml" 2>/dev/null; then
    echo "target host $SERVER not configured in ~/.bunker/config.yaml"
    return 1
  fi
  # SSH probe: same invocation the harness has always used (IdentitiesOnly +
  # BatchMode + 20s ConnectTimeout, hard-bounded at 30s), so a configured-but-
  # dead box cannot eat the battery's TTL on retry ladders. rc is captured via
  # `|| prc=$?` — inside `if ! cmd; then`, `$?` would report the INVERTED
  # status (always 0) and the named cause would lie about the failure mode.
  local prc=0
  timeout 30 ssh -i "$BUNKER_QA_HOST_KEY" -o IdentitiesOnly=yes -o ConnectTimeout=20 -o StrictHostKeyChecking=no -o BatchMode=yes "$SERVER" 'true' 2>/dev/null || prc=$?
  if [ "$prc" -ne 0 ]; then
    echo "SSH probe failed: target host $SERVER unreachable (exit=$prc)"
    return 1
  fi
  return 0
}

# qa_disk_preflight [server] — reject a target host whose root filesystem is
# above the launch safety threshold before spawn/sync/compile can cascade into
# ENOSPC. The df command deliberately runs through the server SSH connection:
# the local controller's disk is not the bunker host that will run act/images.
# A missing or malformed reading is also a refusal; continuing would make the
# preflight claim protection it did not actually establish.
qa_disk_preflight() { # 0 = <=94%; nonzero = named refusal on stdout
  local SERVER="${1:-$SERVER}" disk_out="" usage="" prc=0
  disk_out=$(timeout "${BUNKER_QA_DISK_TIMEOUT:-30}" ssh -i "$BUNKER_QA_HOST_KEY" \
    -o IdentitiesOnly=yes -o ConnectTimeout=20 -o StrictHostKeyChecking=no \
    -o BatchMode=yes "$SERVER" 'df -P /' 2>/dev/null)
  prc=$?
  if [ "$prc" -ne 0 ]; then
    echo "target host $SERVER disk preflight failed (df -P exit=$prc)"
    return 1
  fi
  usage=$(printf '%s\n' "$disk_out" | awk '
    NR > 1 && $5 ~ /^[0-9]+%$/ { sub(/%$/, "", $5); print $5; exit }
  ')
  case "$usage" in
    ''|*[!0-9]*)
      echo "target host $SERVER disk preflight returned no usable df -P use%"
      return 1
      ;;
  esac
  if [ "$usage" -gt 94 ]; then
    echo "target host $SERVER disk usage ${usage}% exceeds 94% launch threshold"
    return 1
  fi
  echo "target host $SERVER disk usage ${usage}% is within 94% launch threshold"
  return 0
}

# QA-HERMES-CANOPY-56: the orphan reap (qa_quarantine_orphan_evidence) copies
# evidence under the quarantine root; when the controller user cannot create or
# write that root, EVERY reap prints "QUARANTINE-FAIL ... step=mkdir ... rc=1"
# and the agent is destroyed with evidence=none. A launch must therefore refuse
# BEFORE any spawn, not fail at reap time with the agent's logs already gone.
# Pure function (qa_target_preflight convention): prints the NAMED cause and
# returns nonzero on refusal; silent on success (preflights stay quiet unless
# failing). Same root as the reap: BUNKER_QA_QUARANTINE_DIR override, else the
# shared QA_QUARANTINE_ROOT_DEFAULT above.
qa_quarantine_prespawn_preflight() { # 0 = root usable; nonzero = refusal
  local root rc
  root="${BUNKER_QA_QUARANTINE_DIR:-$QA_QUARANTINE_ROOT_DEFAULT}"
  mkdir -p "$root" 2>/dev/null; rc=$?
  if [ "$rc" -ne 0 ] || ! [ -w "$root" ] || ! [ -x "$root" ]; then
    echo "QUARANTINE-DIR-UNWRITABLE root=$root rc=$rc — refusing pre-spawn: orphan evidence would be destroyed at reap time (QA-HERMES-CANOPY-56)" >&2
    return 1
  fi
  return 0
}

preflights() {
  # QA-BUNKER-B20: prove the target host exists AND answers BEFORE any step
  # runs — a dropped/stale default must be a NAMED refusal, never a silent
  # continuation onto a dead box (the harness audited nothing while printing
  # pass counts for wrapper steps). One FAIL row + exit 2, same contract as
  # the other deterministic gates.
  local tgt_err
  if ! tgt_err=$(qa_target_preflight); then
    printf '{"cell":"run_battery","status":"FAIL","detail":"%s — no spawn attempted","ts":"%s"}\n' \
      "$tgt_err" "$(date -u +%FT%TZ)" >> "$EVIDENCE"
    echo "ERROR: $tgt_err — refusing to run (deterministic config/reachability error)" >&2
    exit 2
  fi
  local disk_err
  if ! disk_err=$(qa_disk_preflight); then
    printf '{"cell":"launch","status":"FAIL","detail":"%s — no spawn attempted","ts":"%s"}\n' \
      "$disk_err" "$(date -u +%FT%TZ)" >> "$EVIDENCE"
    echo "PREFLIGHT FAIL: $disk_err" >&2
    exit 2
  fi
  # QA-HERMES-CANOPY-56: refuse pre-spawn when the quarantine root is absent or
  # unwritable — the reap would otherwise destroy the agent's orphan evidence
  # with QUARANTINE-FAIL step=mkdir. Cause is captured 2>&1 so the named
  # QUARANTINE-DIR-UNWRITABLE line lands in the FAIL row and the stderr echo.
  local q_err
  if ! q_err=$(qa_quarantine_prespawn_preflight 2>&1); then
    printf '{"cell":"launch","status":"FAIL","detail":"%s — no spawn attempted","ts":"%s"}\n' \
      "$q_err" "$(date -u +%FT%TZ)" >> "$EVIDENCE"
    echo "PREFLIGHT FAIL: $q_err" >&2
    exit 2
  fi
  # Capacity preflight: a FULL pool is a deterministic spawn failure, so the
  # retry loop in spawn_agent() would burn 3 attempts and report the
  # exhaustion as if it were transient congestion. Probe cost: at most 2 cheap
  # bunkerd CLI calls, no spawn, no polling.
  if [ "${BUNKER_QA_SKIP_PREFLIGHT:-0}" = "1" ]; then
    log "capacity preflight skipped (BUNKER_QA_SKIP_PREFLIGHT=1)"
  else
    local cap_used cap_max cap
    cap=$(bunker_capacity "$SERVER")
    if [ -z "$cap" ]; then
      # Probe failed / unparseable ≠ full. Warn and continue: refusing here
      # would wedge QA on any bunkerd hiccup.
      echo "WARN: bunker capacity unknown on $SERVER (capacity probe failed) — proceeding without capacity preflight" >&2
    else
      cap_used="${cap%% *}"; cap_max="${cap##* }"
      if [ "$cap_max" = "-" ]; then
        echo "WARN: bunker capacity ceiling unreadable on $SERVER ($cap_used agents live) — proceeding without capacity preflight" >&2
      elif [ "$cap_used" -ge "$cap_max" ]; then
        printf '{"cell":"run_battery","status":"FAIL","detail":"bunker capacity exhausted on %s (%s/%s agents) — pool full, no spawn attempted (capacity preflight). Hint (QA-BUNKER-39): a stale QA temp agent may still hold a slot; `bunker destroy <id> --server %s` frees it (temp agents reap after the ~4h TTL)","ts":"%s"}\n' \
          "$SERVER" "$cap_used" "$cap_max" "$SERVER" "$(date -u +%FT%TZ)" >> "$EVIDENCE"
        echo "PREFLIGHT FAIL: bunker capacity exhausted on $SERVER ($cap_used/$cap_max agents) — refusing to spawn (deterministic capacity error)" >&2
        echo "HINT (QA-BUNKER-39): a stale QA temp agent may still hold a slot — list with: bunker list --server $SERVER; free it with: bunker destroy <id> --server $SERVER (temp agents reap after the ~4h TTL)" >&2
        exit 2
      fi
    fi
  fi
}

# ─── detect_cmds <repo> <agent> → DETECT_INSTALL / DETECT_NATIVE / DETECT_CI / DETECT_BIN ───
# Extracted verbatim from run() (2026-09-15) so run() and launch() can never
# drift on the command set they ship to the agent. Globals, because
# build_remote_script() bakes them (and $agent) into the generated script.
# DETECT_BIN (QA-9ROUTER-22, 2026-09-21) is the HOST-side mirror of the start
# command the generated script re-detects on the agent AFTER the install (the
# agent-side ladder in build_remote_script is authoritative at runtime because
# start scripts may materialize console shims only once deps exist); DETECT_BIN
# exists so tests and callers can assert the ladder without spawning an agent.
# KEEP THE TWO LADDERS IN SYNC.
detect_cmds() {
  local repo="$1" agent="$2"
  local tpkg="" start_script="" gofirst=""
  # escape hatches when the auto-detect guesses wrong (e.g. suite needs extras)
  DETECT_INSTALL="${BUNKER_QA_INSTALL_CMD:-}"
  if [ -z "$DETECT_INSTALL" ]; then
  # QA-BUNKER-32 (2026-10-10): go.mod is checked BEFORE package.json/pnpm-lock
  # in both ladders below. A Go repo carrying any root package.json (docs
  # tooling, heredoc generators) is primarily Go; the npm manifest is
  # incidental. The old order graded such repos 'npm ci' + 'npm test' and the
  # real Go suite never ran (dexdat-memory: 479 _test.go files, native.log
  # 'npm error Missing script: "test"').
  if [ -f "$repo/go.mod" ]; then DETECT_INSTALL="go build ./..."
  elif [ -f "$repo/pnpm-lock.yaml" ]; then DETECT_INSTALL="corepack enable 2>/dev/null; corepack prepare --activate 2>/dev/null; pnpm install --frozen-lockfile"
  elif [ -f "$repo/package.json" ]; then
    # QA-9ROUTER-26 (2026-09-21): the old branch installed ONLY the root
    # package, so a repo with an INDEPENDENT test package (tests/ or test/
    # with its own package.json declaring dependencies/devDependencies —
    # 9router pins vitest ^4.0.0 in tests/ and documents the two-step
    # `npm install && cd tests && npm install`) never got its runner
    # installed: the suite died with "tests/node_modules is missing — vitest
    # cannot be resolved" and chaos-disconnect graded that rc as OK "fails
    # fast on disconnect" (a false PASS on a suite that never ran). Detect an
    # independent test package and install it too, keeping the repo's own npm
    # flags for both steps. The generated script runs the install with cwd at
    # the repo root (fresh-install/upgrade cells wrap it in a subshell), so
    # the relative `cd` is correct.
    DETECT_INSTALL="npm ci --ignore-scripts --no-audit --no-fund"
    for tpkg in tests test; do
      if [ -f "$repo/$tpkg/package.json" ] && jq -e '(.dependencies // {}) + (.devDependencies // {}) | length > 0' "$repo/$tpkg/package.json" >/dev/null 2>&1; then
        DETECT_INSTALL="npm ci --ignore-scripts --no-audit --no-fund && cd $tpkg && npm ci --ignore-scripts --no-audit --no-fund"
        break
      fi
    done
  elif [ -f "$repo/pyproject.toml" ]; then DETECT_INSTALL="pip install -e .[dev] 2>/dev/null || pip install -e ."
  elif [ -f "$repo/Cargo.toml" ]; then DETECT_INSTALL="cargo build --workspace"
  # QA-H3-14 (2026-09-21): a Makefile-only repo (no package manifest) gets a
  # make-based default only when make actually exists on the agent — JIT agents
  # ship WITHOUT make (measured: h3 battery 24dcbb04, all make-dependent cells
  # rc=127 'make: command not found'), and h3's Makefile itself has no build
  # target (verify-* only). `make verify` is the repo's one entry point that is
  # both real and dep-free (POSIX sh + coreutils + git; tick-chain degrades to
  # UNVERIFIED without jq/DuckBrain, qa-target self-validates on a re-inited
  # sync tree). Targets exist ⇒ call them; no targets and no make ⇒ the
  # toolchain-bootstrap leg below bootstraps GNU make into ~/tools first and the
  # verify cells still run; repo with make targets but agent lacking make AND
  # bootstrap failed ⇒ graded ENV-BLOCKED, never a repo defect.
  elif [ -f "$repo/Makefile" ]; then
    # QA-HERMES4FRIENDS-INFRA-008 (2026-11-25): `make verify` was an unconditional
    # fallback — Makefiles with real `test:`/`lint:` targets but no verify:/build:
    # graded fresh-install rc=2 on every JIT agent. Probe real targets first;
    # `make verify` survives only when some verify-form target actually exists.
    if grep -qE '^build:' "$repo/Makefile"; then DETECT_INSTALL="make build"
    elif grep -qE '^verify:' "$repo/Makefile"; then DETECT_INSTALL="make verify"
    elif grep -qE '^test:' "$repo/Makefile"; then DETECT_INSTALL="make test"
    elif grep -qE '^lint:' "$repo/Makefile"; then DETECT_INSTALL="make lint"
    elif grep -qE '^verify' "$repo/Makefile"; then DETECT_INSTALL="make verify"
    else DETECT_INSTALL="echo no-standard-install-path"; fi
  else DETECT_INSTALL="echo no-standard-install-path"
  fi
  fi
  local ci_cmd="" native_cmd="${BUNKER_QA_NATIVE_CMD:-}"
  DETECT_CI_FILES=""; DETECT_ACT_NOTE=""
  # The branch the agent's checkout will sit on: the CI cell simulates a push to
  # THE CHECKED-OUT BRANCH, so a workflow gated on other branches cannot fire.
  # sync_repo re-inits the synced tree (`git init -q`, no -b) so the branch name
  # there is whatever the AGENT's git defaults to — read it from the AGENT, not
  # from the host tree (they can differ: this host's git defaults to `master`,
  # but the doctrine is that the event the cell simulates is the one the agent
  # push would produce). Falls back to the host repo's branch, then to
  # BUNKER_QA_BRANCH, and an UNKNOWN branch keeps every workflow (fail-closed:
  # filtering on a guess could drop the workflow that regresses).
  branch_name="${BUNKER_QA_BRANCH:-$(git -C "$repo" rev-parse --abbrev-ref HEAD 2>/dev/null || true)}"
  [ "$branch_name" = "HEAD" ] && branch_name="master"
  [ -n "$branch_name" ] || branch_name="master"
  if [ -z "$native_cmd" ]; then
  # QA-BUNKER-32: same go-first precedence as the install ladder above — a
  # go.mod + package.json repo must get its Go suite, not an npm test that
  # doesn't exist.
  if [ -f "$repo/go.mod" ]; then native_cmd="go test ./... -count=1"
  elif [ -f "$repo/pnpm-lock.yaml" ]; then native_cmd="pnpm test"
  elif [ -f "$repo/package.json" ]; then
  # --runInBand is a Jest flag; vitest dies with CACError on it (proven 9router
  # 2026-09-15: `cd tests && npx vitest run --runInBand` rc=1, zero tests ran).
  # Detect vitest by the test script's own text or a root vitest config and use
  # vitest's serial flag instead. Note: this only fixes HARNESS-induced crashes;
  # if the repo's root `npm test` npx-resolves an unpinned vitest, that hazard
  # belongs to the project (file a board row, do not mask it here).
  if jq -r '.scripts.test // ""' "$repo/package.json" 2>/dev/null | grep -q vitest || ls "$repo"/vitest.config.* >/dev/null 2>&1; then
    native_cmd="npm test -- --no-file-parallelism"
  else
    native_cmd="npm test -- --runInBand"
  fi
  elif [ -f "$repo/pyproject.toml" ]; then
    # QA-DIGEST-022 (2026-10-03, digest chaos-resource): a pyproject repo whose
    # pytest lives in a PEP-735 dependency-group gets rc=127 'pytest: command
    # not found' from the agent's broken venv on EVERY leg. The toolchain-
    # bootstrap cell tops pytest into ~/tools/venv earlier in the same agent
    # run — use it when PATH has no pytest. If it is absent too, keep the bare
    # name: native_runner_missing grades UNVERIFIED honestly, and the bootstrap
    # cell already warned which leg will fail and why.
    if ! command -v pytest >/dev/null 2>&1 && [ -x "$HOME/tools/venv/bin/pytest" ]; then
      native_cmd="$HOME/tools/venv/bin/pytest -x -q"
    else
      native_cmd="pytest -x -q"
    fi
  # QA-HERMES4FRIENDS-INFRA-009 (2026-11-25): the Makefile arm previously sat
  # BELOW the pytest.ini/conftest.py arm, so a repo with a Makefile (test:/lint:)
  # that also carries pytest.ini never reached it — hermes4friends-infra
  # detected the bare `python3 -m pytest -q` (no pytest on a JIT agent) instead
  # of its self-provisioning `make test`. Makefile-first; pytest.ini arm is
  # untouched for pytest-ini-ONLY repos.
  elif [ -f "$repo/Makefile" ]; then
    # QA-H3-14: native leg mirrors the install-leg target probe — a Makefile
    # with no `test:` target (h3: verify-* only) gets `make verify` instead of
    # a guaranteed-fail `make test` on agents where make was bootstrapped.
    # QA-BUNKER-82 (2026-11-01): the bare `make verify` fallback is CHECKS-ONLY.
    # h3's verify runs docs+repo-consistency guards that legitimately run ZERO
    # tests, and the QA-AUGER-1 vacuity grader then graded that checks-only
    # pass as FAIL "native runner exited 0 but ZERO tests ran" while the
    # repo's real code-level suite (`make verify-roundtrip`, 6/6 PASSED on the
    # same agent) was never discovered — the default SUITE CHOICE was the
    # defect, not the vacuity grader. Probe the repo's real suite target,
    # most-conventional first: `test:`, then `check:` (the automake
    # convention), then an explicit named suite target like
    # `verify-roundtrip:` (h3's cross-language round-trip suite), and keep
    # checks-only `make verify` as the last resort for verify-only Makefiles
    # (backward compatible: h3's install leg and the QA-H3-14 no-test-target
    # guarantee are unchanged).
    if grep -qE '^test:' "$repo/Makefile"; then native_cmd="make test"
    elif grep -qE '^check:' "$repo/Makefile"; then native_cmd="make check"
    elif grep -qE '^verify-roundtrip:' "$repo/Makefile"; then native_cmd="make verify-roundtrip"
    else native_cmd="make verify"; fi
  # Mirror the pyproject arm (QA-BUNKER-24, 2026-10-07): the venv-pytest guard
  # must apply here too — a toolchain-bootstrap'd agent whose PATH lacks pytest
  # but has ~/tools/venv/bin/pytest otherwise gets no pytest at all, and the
  # cell grades FAIL/native-runner-missing for an environment gap the harness
  # already solved for pyproject repos.
  # QA-FOREMAN-2026-09-26 (auger): pytest.ini/conftest.py-only repos matched NO
  # shape and got the vacuous `echo no-test-path` — the battery graded
  # ci-pass OK in 57ms with zero tests run while the repo carries 210 tests.
  # If pytest itself is absent (both PATH and venv) the suite NEVER RAN
  # and native_runner_missing grades UNVERIFIED (honest), never OK.
  elif [ -f "$repo/pytest.ini" ] || [ -f "$repo/conftest.py" ]; then
    if ! command -v pytest >/dev/null 2>&1 && [ -x "$HOME/tools/venv/bin/pytest" ]; then
      native_cmd="$HOME/tools/venv/bin/pytest -x -q"
    else
      native_cmd="python3 -m pytest -q"
    fi
  elif [ -f "$repo/Cargo.toml" ]; then native_cmd="cargo test --workspace"
  else native_cmd="echo no-test-path"
  fi
  fi
  # QA-CRIER-20 (2026-09-18): unfiltered act runs EVERY workflow in the repo
  # under test, so infra-gated workflows (ghcr publish, pages deploys) that can
  # never pass inside act (no live bunker server, no ghcr credentials, no real
  # push event) give the ci-pass cell a PERMANENT red leg — crier's bunker-e2e
  # was 5/5 green on hosted CI at the same HEAD while act stayed red. The CI
  # workflow is the simulated-runner-relevant one; with no ci.yml keep the
  # unfiltered form, and with no workflows at all native suite remains the
  # fallback grade.
  #
  # QA-9ROUTER-19 (2026-09-23): the unfiltered fallback above was itself the
  # defect for a repo with NO ci.yml. 9router's `.github/workflows/` holds
  #   docker-publish.yml  on: push TAGS v* + workflow_dispatch
  #   gitbook-pages.yml   on: push branches [main, master] paths gitbook/**
  #   tests.yml           on: push branches [federation, master]
  # so a branch push to `federation` can NEVER trigger the first two, yet act
  # ran them and the cell graded FAIL — QA-9ROUTER-19 records the false board
  # row ("Test Suite/test SKIP: tests/node_modules missing", "-  Install test
  # dependencies  Success  up to date, audited 1 package", plus red
  # build-and-push and build-deploy legs). Hosted CI was GREEN at the same HEAD.
  # The `-W .github/workflows/ci.yml` arm above (QA-CRIER-20) exists for exactly
  # this class; this arm supplies the same effect for repos without a ci.yml by
  # staging ONLY the workflows that can fire on a branch push into a temp
  # directory and pointing -W at it.
  #
  # MECHANISM (measured 2026-09-23 on this host, act = the same static tarball
  # ACT_URL pins): act MERGES several -W targets in argv order, a DIRECTORY
  # target recurses, and an external directory of symlinks to the repo's
  # workflows resolves correctly — so `-W <staging dir OUTSIDE the synced tree>`
  # runs exactly the selected workflows, in the repo's real checkout (cwd), with
  # the synced tree left untouched (no in-tree write ⇒ nothing can contaminate
  # the install/e2e cells or the audit payload). The staging dir MUST be both
  # symlink-resolvable AND outside the repo: the cell runs with the repo as cwd,
  # so a repo-relative -W target resolves fine too, but an EXTERNAL dir keeps
  # the synced tree byte-clean, which the "accept the hostile event" doctrine
  # (itertools, 2026-09-22 — the synthetic tree is the payload under audit)
  # requires.
  #
  # STAGING IS DONE IN A SUBSHELL, NOT IN THE GENERATED SCRIPT, because the
  # cell's workdir IS the synced tree: every directory and file this arm creates
  # is created by a subshell the cell `cd`s into first, and the staging dir is
  # an EXTERNAL absolute path, so the synced tree gains no new top-level entry.
  # When nothing is triggerable the arm keeps native as the grade — a repo whose
  # only workflows are dispatch/tag-gated has no branch-push CI, and "act could
  # not find any stages" is not a product result.
  #
  # Triggerability is decided by QA_CI_TRIGGER_RE (overridable), matched
  # line-wise against each workflow, and the base-branch name comes from the
  # agent's own checkout (QA_BRANCH): a push push to the checked-out branch is
  # the event the cell simulates, so a workflow gated on other branches is not
  # a product failure.
  if ls "$repo"/.github/workflows/*.yml >/dev/null 2>&1; then
    if [ -f "$repo/.github/workflows/ci.yml" ]; then
      # FIX (QA-9ROUTER-28 follow-up, 2026-09-22): the -W path must be the AGENT's
      # checkout (~/qa-$proj), not the host repo path — $repo does not exist on the
      # agent, so act died rc=1 "stat /home/kara/<repo>/.github/workflows/ci.yml:
      # permission denied" (the same harness artifact recorded in the 09-20/09-21
      # dagger QA ledgers). The remote script cd's to ~/qa-$proj before the ci-pass
      # cell, so a RELATIVE workflow path resolves inside the agent's checkout.
      # FIX (QA foreman 2026-09-24, live-proven on pulse): the ci.yml fast-path
      # previously baked the -W path INTO ci_cmd and left DETECT_CI_FILES empty —
      # but the generated remote script stages workflows ONLY from QA_CI_SELECT
      # (ACT_WF_COUNT gate), so act was NEVER RUN for ci.yml repos: the cell took
      # the skip branch and reported "no triggerable workflow" (or failed over to
      # native as the grade) while a triggerable ci.yml sat in the synced tree.
      # Measured twice on pulse 2026-09-24 (agents 882dc470 / 2a8a8dbd): cell said
      # "no triggerable workflow" while `act -W .github/workflows/ci.yml` run by
      # hand on the same agent, same tree, completed the job. The -W now comes
      # from the shared staging block like every other workflow: select ci.yml,
      # keep ci_cmd bare, let ACT_WF_DIR staging supply the single -W target.
      # QA-GUARD-008 (2026-11-22): step stdout must reach ci.log so an act-red names the failing test.
      ci_cmd="DOCKER_HOST=unix:///run/bunker/$agent/docker.sock ~/bin/act --pull"
      DETECT_CI_FILES=" .github/workflows/ci.yml"
    else
      # Select the workflows whose `on:` can fire for a push to the branch the
      # agent will have checked out. Parsing happens HOST-side (the agent needs
      # no YAML parser) but the SELECTION is baked as repo-relative paths and
      # the staging itself runs on the agent (see QA_CI_SELECT in
      # build_remote_script).
      #
      # MEASURED on this host 2026-09-23 (act = the tarball ACT_URL pins), which
      # is why the shape is a STAGED DIRECTORY and not a list of -W files:
      #   `-W a.yml -W b.yml`      → act runs ONLY b.yml (the last -W wins; the
      #                              targets do NOT merge — a partial selection
      #                              would silently DROP the workflow that can
      #                              regress, strictly worse than today)
      #   `-W dirA -W dirB`        → both directories merge
      #   `-W <external dir of symlinks to the repo's workflows>` → resolved and
      #     run, and act still executes the repo's OWN checkout as the cwd
      #     (`docker cp src=<repo>/.`), so a staged -W costs the cell nothing.
      # ⇒ stage every selected workflow into ONE directory and pass that single
      #   -W target.
      #
      # PREDICATE — scan the top-level `on:` block and decide triggerability
      # from the KEYS, never from prose: `branches:` gates a push (any entry may
      # be a literal branch, a wildcard, or an expression), `tags:` without
      # `branches:` makes it TAG-ONLY (a push to the branch under test can never
      # fire it), and a push with NEITHER key fires on every branch. `paths:`
      # filters are deliberately ignored — they describe which CHANGES fire the
      # workflow, not which branch can, and reading them as branch patterns was
      # the first shape of this loop: it matched gitbook-pages.yml's
      # `- "gitbook/**"` entry and kept exactly the workflow QA-9ROUTER-19 says
      # must not be run. Entries containing `*` or `$` (a wildcard or a GitHub
      # expression) are kept — they cannot be proven non-matching (fail-closed);
      # everything else is compared literally against the branch under test.
      # A workflow with NO `on:` at all is kept (odd/unparseable file — act must
      # see it and report, never be silently dropped).
      local wf rel keep on_seen push_seen branch_key tags_key in_branches lhs rhs ci_select=""
      for wf in "$repo"/.github/workflows/*.yml; do
        [ -f "$wf" ] || continue
        rel="${wf#$repo/}"
        keep=0; on_seen=0; push_seen=0; branch_key=0; tags_key=0; in_branches=0
        while IFS= read -r line; do
          case "$line" in *$'\t'*) continue ;; esac            # block-scalar body
          case "$line" in
            ""|"#"*) continue ;;
            "on:"|'"on":') on_seen=1; continue ;;
          esac
          case "$line" in [!\ ]*) [ "$on_seen" = 1 ] && break ;; esac   # next top-level key
          [ "$on_seen" = 1 ] || continue
          lhs="${line#"${line%%[![:space:]]*}"}"                # left-trim
          case "$lhs" in
            "- "*)
              [ "$in_branches" = 1 ] || continue
              rhs="${lhs#- }"
              case "$rhs" in "'"*"'") rhs="${rhs#\'}"; rhs="${rhs%\'}" ;; '"'*'"') rhs="${rhs#\"}"; rhs="${rhs%\"}" ;; esac
              case "$rhs" in *"*"*|*'$'*) keep=1; break ;; esac          # wildcard / expression
              case "$rhs" in *"#"*) rhs="${rhs%%#*}"; : ;; esac
              # shellcheck disable=SC2254
              case "$rhs" in "$branch_name") keep=1; break ;; esac
              ;;
            "push:"|"push: "*|'"push":'*) push_seen=1; in_branches=0 ;;
            "branches:"|"branches: "*|"branches-ignore:"|"branches-ignore: "*)
              branch_key=1; in_branches=1
              rhs="${lhs#*:}"
              case "$rhs" in *"$branch_name"*) keep=1; break ;; esac
              case "$rhs" in *"*"*|*'$'*) keep=1; break ;; esac
              ;;
            "tags:"|"tags: "*|"tags-ignore:"|"tags-ignore: "*)
              tags_key=1; in_branches=0 ;;
            *":") in_branches=0 ;;                                # any other key
            *) continue ;;
          esac
        done < "$wf"
        # verdict
        if [ "$on_seen" = 0 ]; then keep=1
        elif [ "$keep" = 1 ]; then :
        elif [ "$push_seen" = 1 ] && [ "$tags_key" = 0 ] && [ "$branch_key" = 0 ]; then keep=1
        fi
        [ "$keep" = 1 ] || continue
        ci_select="$ci_select $rel"
      done
      if [ -n "$ci_select" ]; then
        DETECT_CI_FILES="$ci_select"           # baked, leading space, repo-relative
        ci_cmd="DOCKER_HOST=unix:///run/bunker/$agent/docker.sock ~/bin/act --pull"
      else
        # No workflow can fire on a push to this branch ⇒ act has nothing that
        # says anything about the repo, and its unfiltered run grades the
        # non-triggerable legs red (the QA-9ROUTER-19 false FAIL). The native
        # suite is already the documented authoritative fallback; make it the
        # grade here and SAY so, so the cell reports a real suite result rather
        # than an act artifact. QA_ACT_NOTE rides into every ci-pass cell text.
        ci_cmd="$native_cmd"
        DETECT_ACT_NOTE=" no workflow in .github/workflows can fire on a push to '$branch_name' (all are tag-only / other-branch / workflow_dispatch-only) — act skipped, the native suite is the authoritative grade"
      fi
    fi
  else
    ci_cmd="$native_cmd"  # no workflow → native IS the CI pass
  fi
  DETECT_NATIVE="$native_cmd"
  DETECT_CI="$ci_cmd"
  # QA-9ROUTER-22 (2026-09-21): host-side mirror of the agent-side start
  # command ladder (build_remote_script). Same precedence: custom-server.js >
  # server.js > start.sh > package.json .scripts.start > src/index.js (only if
  # the file exists) > empty. Never a bare guess — "node src/index.js" for a
  # package.json repo whose src/index.js does not exist is what made
  # chaos-corruption/chaos-errorpath grade vacuous rc=1 verdicts on 9router.
  DETECT_BIN=""
  if [ -f "$repo/custom-server.js" ]; then
    DETECT_BIN="node custom-server.js"
  elif [ -f "$repo/server.js" ]; then
    DETECT_BIN="node server.js"
  elif [ -f "$repo/start.sh" ] && [ -x "$repo/start.sh" ]; then
    DETECT_BIN="sh start.sh"
  elif [ -f "$repo/package.json" ]; then
    start_script="$(jq -r '.scripts.start // ""' "$repo/package.json" 2>/dev/null)"
    case "$start_script" in
      # npm lifecycle no-ops are not a start command; and a start script that
      # is literally "node server.js" is exactly what the server.js arm above
      # already covers (keeps one canonical form instead of duplicating it).
      ""|"echo "*|"exit "*|":") : ;;
      "node server.js") DETECT_BIN="node server.js" ;;
      *) DETECT_BIN="npm start" ;;
    esac
    # No real start script? Fall through the ladder (it is not the end of it):
    # src/index.js is the LAST resort and only when the file actually exists —
    # the old code guessed it for EVERY package.json repo (9router has none,
    # so both chaos cells started "Cannot find module" and graded the refusal).
    if [ -z "$DETECT_BIN" ] && [ -f "$repo/src/index.js" ]; then
      DETECT_BIN="node src/index.js"
    fi
  elif [ -f "$repo/src/index.js" ]; then
    DETECT_BIN="node src/index.js"
  fi
  # Mirror the agent-side interpreter-resolvability guard: an interpreter that
  # cannot be resolved here means "not observable", same as empty.
  if [ -n "$DETECT_BIN" ] && ! command -v "${DETECT_BIN%% *}" >/dev/null 2>&1; then
    DETECT_BIN=""
  fi
  detect_upgrade_inputs "$repo"
}

# ─── npm package coordinates: publishable beats private (QA-9ROUTER-20) ───
# QA-9ROUTER-20 (2026-09-23): the upgrade cell installed the ROOT package.json
# name, but a repo can be a private workspace whose only PUBLISHED artifact is a
# nested package. 9router's root is `"name": "9router-app", "private": true`
# (upstream identical — never published) while `cli/package.json` is
# `"name": "9router"` (npm dist-tag latest 0.5.75). The cell therefore FAILed
# with a FALSE product verdict on the previous release:
#   cell upgrade FAIL "previous release 9router-app@0.5.69 would not install
#   (tag v0.5.69): rc=1 … E404 Not Found - GET https://registry.npmjs.org/9router-app"
# while the clean-agent probe `npm install -g 9router@0.5.69` returned rc=0.
# The upgrade path stayed UNVERIFIED because the harness named the wrong package.
# Rule: the ROOT name wins whenever the root is publishable (every repo that
# works today must keep byte-identical behaviour); otherwise take the first
# publishable NESTED candidate, and fall back to the root name when no
# publishable candidate exists at all — so a root-only repo is unchanged and a
# genuinely unpublished package still reports the real registry error.
# "Publishable" = non-empty `name` and not `"private": true` (npm's own rule).
npm_pkg_name() { # <package.json> — print the "name" field, or nothing
  [ -f "$1" ] || return 0
  sed -n 's/.*"name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$1" | head -1
}

npm_pkg_publishable() { # <package.json> — 0 when it has a name and is not private
  local npf="$1" npn
  [ -f "$npf" ] || return 1
  npn=$(npm_pkg_name "$npf"); [ -n "$npn" ] || return 1
  if command -v jq >/dev/null 2>&1; then
    jq -e '(.private // false) != true' "$npf" >/dev/null 2>&1
  else
    ! grep -qE '"private"[[:space:]]*:[[:space:]]*true' "$npf"
  fi
}

detect_publish_pkg_name() { # <repo> — publishable package name, root name as the fallback
  local dpr="$1" dpf="" dpname="" rel
  if npm_pkg_publishable "$dpr/package.json"; then npm_pkg_name "$dpr/package.json"; return 0; fi
  # Explicit candidates first (deterministic priority for the common layouts),
  # then a bounded scan of any other nested package.json. Build/VCS dirs are
  # pruned so vendored copies cannot win; AMBIGUITY IS NOT GUESSED — two
  # distinct publishable nested candidates and no explicit candidate means the
  # function returns NOTHING, and the upgrade cell reports the honest
  # "no installable previous release detected" instead of picking one.
  for rel in cli packages/cli app packages/app packages/npm server desktop pkg npm; do
    if npm_pkg_publishable "$dpr/$rel/package.json"; then npm_pkg_name "$dpr/$rel/package.json"; return 0; fi
  done
  local -a scan_names=()
  while IFS= read -r dpf; do
    npm_pkg_publishable "$dpf" || continue
    dpname=$(npm_pkg_name "$dpf"); [ -n "$dpname" ] || continue
    scan_names+=("$dpname")
  done < <(find "$dpr" -maxdepth 4 -name package.json \
             -not -path '*/node_modules/*' -not -path '*/.git/*' \
             -not -path '*/.next*' -not -path '*/dist/*' -not -path '*/build/*' \
             -not -path '*/vendor/*' -not -path '*/coverage/*' 2>/dev/null | sort)
  # Ambiguity is NOT guesswork: 2+ distinct publishable nested candidates with no
  # explicit candidate => return NOTHING, and the caller reports "no installable
  # previous release detected" (the honest UNVERIFIED grade) instead of picking
  # one at random.
  local first_name="" seen_other=0 sn
  for sn in "${scan_names[@]+"${scan_names[@]}"}"; do
    if [ -z "$first_name" ]; then first_name="$sn"; continue; fi
    if [ "$sn" != "$first_name" ]; then seen_other=1; fi
  done
  if [ -n "$first_name" ] && [ "$seen_other" = 0 ]; then printf '%s\n' "$first_name"; return 0; fi
  if [ "$seen_other" = 1 ]; then return 0; fi
  # No publishable candidate at all → the ROOT name (legacy behaviour): the
  # registry error that follows is the honest verdict, never a silent skip.
  npm_pkg_name "$dpr/package.json"
}

# ─── detect_upgrade_inputs <repo> — inputs the upgrade cell cannot detect itself ───
# QA-GITREINS-POC-004 (2026-09-17): the upgrade cell used to run `git tag` INSIDE
# the battery, but sync_repo ships the tree with `.git` excluded and then re-inits
# a synthetic single-commit repo on the agent, so `git tag` there is ALWAYS empty.
# The cell therefore reported `upgrade N/A "no release tags in repo"` for repos
# that do have tags — gitreins-poc (40 tags, latest v0.13.0) and
# coding-hermes-boardctl (3) on the 2026-09-12 cycle — and the upgrade path was
# silently recorded as not-applicable instead of untested. Detect the tag list
# HERE, where `.git` really exists, and bake the values into the generated script
# along with the previous release's package coordinates so the cell can install
# that release and re-install HEAD over it on the agent.
# Sets global: DETECT_TAG_COUNT / DETECT_PREV_TAG / DETECT_PREV_VERSION /
# DETECT_PKG_NAME / DETECT_PKG_ECOSYSTEM / DETECT_GO_URL
# ("" when unknown — never guessed).
detect_upgrade_inputs() {
  local repo="$1"
  DETECT_TAG_COUNT=0; DETECT_PREV_TAG=""; DETECT_PREV_VERSION=""
  DETECT_PKG_NAME=""; DETECT_PKG_ECOSYSTEM=""; DETECT_GO_URL=""
  # QA-WARPFS-QA (2026-09-25): initialized here, not only in the npm branch —
  # under set -u an unset DETECT_UP_PREV_DIR aborts the build_remote_script
  # heredoc for non-npm repos (Rust/Go/pip with tags) and ships a 0-byte
  # qa-run.sh, so the whole battery exits instantly with zero cells.
  DETECT_UP_PREV_DIR=""
  [ -d "$repo/.git" ] || return 0
  DETECT_TAG_COUNT=$(git -C "$repo" tag 2>/dev/null | grep -c . || true)
  [ "${DETECT_TAG_COUNT:-0}" = "0" ] && return 0
  DETECT_PREV_TAG=$(git -C "$repo" tag 2>/dev/null | sort -V | tail -2 | head -1)
  DETECT_PREV_VERSION="${DETECT_PREV_TAG#v}"
  # Package coordinates for the index-install half of the upgrade test. Only the
  # two ecosystems whose install command the battery already runs are wired;
  # anything else stays "" and the cell reports the gap instead of guessing.
  if [ -f "$repo/pyproject.toml" ]; then
    DETECT_PKG_ECOSYSTEM="pip"
    DETECT_PKG_NAME=$(sed -n 's/^[[:space:]]*name[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' "$repo/pyproject.toml" | head -1)
    [ -z "$DETECT_PKG_NAME" ] && DETECT_PKG_NAME=$(sed -n "s/^[[:space:]]*name[[:space:]]*=[[:space:]]*'\([^']*\)'.*/\1/p" "$repo/pyproject.toml" | head -1)
    # QA-TERMINAL-JAIL-19 (2026-10-12): a pip repo that is NOT published to PyPI
    # has NO registry artifact — the pip arm's `pip install <name>==<prev>` can
    # only ever die "No matching distribution found", a harness premise failure
    # graded as a product verdict (terminal-jail: versions: none, upgrade cell
    # FAIL with the tag v1.0.0 present). Mirror the QA-HEADING-009 npm shape:
    # mark the repo for the tree-upgrade arm; ship_prev_tag_tree streams the
    # previous tag's tree and the cell upgrades the checked-out tree.
    DETECT_UP_PREV_DIR=""
    if [ -n "$DETECT_PREV_TAG" ] && [ -n "$DETECT_PKG_NAME" ]; then
      if ! curl -fsS --max-time 10 "https://pypi.org/pypi/${DETECT_PKG_NAME}/json" >/dev/null 2>&1; then
        DETECT_UP_PREV_DIR="~/qa-up-prev-pip"
      fi
    fi
  elif [ -f "$repo/package.json" ]; then
    # QA-9ROUTER-20: publishable name, not the private root name.
    DETECT_PKG_ECOSYSTEM="npm"
    DETECT_PKG_NAME=$(detect_publish_pkg_name "$repo")
    # QA-HEADING-009 (2026-09-25): a NON-publishable npm repo (private:true root,
    # no publishable nested candidate) has NO registry artifact — the registry
    # arm can only ever die ETARGET/E404, a harness premise failure graded as a
    # product verdict. Mark the repo for the tree-upgrade arm: the host streams
    # the previous tag's tree (ship_prev_tag_tree) and the cell upgrades the
    # checked-out tree, same shape as the Go-binary arm (QA-OFF-BY-ONE-22).
    DETECT_UP_PREV_DIR=""
    if [ -n "$DETECT_PREV_TAG" ] && ! npm_pkg_publishable "$repo/package.json"; then
      DETECT_UP_PREV_DIR="~/qa-up-prev-npm"
    fi
  elif [ -f "$repo/go.mod" ]; then
    # QA-OFF-BY-ONE-22 (2026-09-22): Go-binary repos have no index package.
    # The upgrade cell upgrades the checked-out TREE from the previous
    # release tag instead; ship_prev_tag_tree streams that tree to the agent
    # (git archive over the sync channel) and DETECT_GO_URL is the agent-side
    # clone fallback for public URLs.
    DETECT_PKG_ECOSYSTEM="go"
    DETECT_GO_URL=$(git -C "$repo" remote get-url origin 2>/dev/null || true)
  elif [ -f "$repo/Cargo.toml" ]; then
    # QA-WARPFS-QA-2 (2026-09-25): Rust repos were unwired — the host detected
    # tags but the cell had no ecosystem for cargo, so a tagged Rust repo graded
    # upgrade FAIL "no installable previous release" while the tree-stream arm
    # (cargo build of the previous tag's tree) is already ecosystem-agnostic
    # (QA-OFF-BY-ONE-22 shape). Wire the ecosystem; ship_prev_tag_tree streams
    # the previous tag's tree; the cell's UP_PREV arm builds it. Cargo has no
    # index package — PKG_NAME stays "".
    DETECT_PKG_ECOSYSTEM="rust"
  fi
  # The value is interpolated into the generated script inside single quotes.
  DETECT_PKG_NAME=${DETECT_PKG_NAME//\'/}
  DETECT_PREV_TAG=${DETECT_PREV_TAG//\'/}
  return 0
}

# ─── ship_prev_tag_tree <repo> <proj> — stream the previous tag's tree ───
# QA-OFF-BY-ONE-22 (2026-09-22): the upgrade cell for Go-binary repos needs
# the PREVIOUS release's tree, but the synced tree carries no history
# (sync_repo excludes .git). Stream the previous tag's full tree to
# ~/qa-up-prev via git archive over the SAME channel sync_repo uses — no
# clone, no auth on the agent (bunker agents carry no GitHub keys). No-op
# when the repo has no go-ecosystem previous tag. On failure, mark
# ~/qa-up-prev.absent so the cell FAILs with the real reason instead of
# silently skipping the upgrade leg. QA-HEADING-009 (2026-09-25): also streams
# for NON-publishable npm repos (DETECT_UP_PREV_DIR set by detect_upgrade_inputs)
# — same tree-stream, agent dir ~/qa-up-prev-npm, verified by package.json.
ship_prev_tag_tree() {
  local repo="$1" proj="$2" agent_dir verify_path
  if [ "$DETECT_PKG_ECOSYSTEM" = "go" ] && [ -n "$DETECT_PREV_TAG" ]; then
    agent_dir="~/qa-up-prev"; verify_path="go.mod"
  elif [ "$DETECT_PKG_ECOSYSTEM" = "rust" ] && [ -n "$DETECT_PREV_TAG" ]; then
    # QA-WARPFS-QA-2: previous tag's tree for the cargo build arm — verified by
    # Cargo.toml. Cargo has no installable index package, so the tree-stream is
    # the only real previous->HEAD upgrade path for Rust repos.
    agent_ssh "rm -rf ~/qa-up-prev ~/qa-up-prev.absent" >/dev/null 2>&1 || true
    agent_dir="~/qa-up-prev"; verify_path="Cargo.toml"
  elif [ "$DETECT_PKG_ECOSYSTEM" = "npm" ] && [ -n "$DETECT_UP_PREV_DIR" ] && [ -n "$DETECT_PREV_TAG" ]; then
    # QA-HEADING-009: agents are SHARED across projects — clear any stale tree
    # (or an absent-marker from a previous failed stream) before shipping, so
    # the generated script's package.json check cannot false-positive on a
    # foreign repo's leftovers.
    agent_ssh "rm -rf ~/qa-up-prev-npm ~/qa-up-prev-npm.absent" >/dev/null 2>&1 || true
    agent_dir="$DETECT_UP_PREV_DIR"; verify_path="package.json"
  elif [ "$DETECT_PKG_ECOSYSTEM" = "pip" ] && [ -n "$DETECT_UP_PREV_DIR" ] && [ -n "$DETECT_PREV_TAG" ]; then
    # QA-TERMINAL-JAIL-19: previous tag's tree for the pip arm when the package
    # is NOT on PyPI — verified by pyproject.toml. Same shared-agent hygiene.
    agent_ssh "rm -rf ~/qa-up-prev-pip ~/qa-up-prev-pip.absent" >/dev/null 2>&1 || true
    agent_dir="$DETECT_UP_PREV_DIR"; verify_path="pyproject.toml"
  else
    return 0
  fi
  if git -C "$repo" archive --format=tar "$DETECT_PREV_TAG" 2>/dev/null \
      | agent_ssh "mkdir -p $agent_dir && tar -C $agent_dir -xf -" >/dev/null 2>&1 \
      && agent_ssh "test -f $agent_dir/$verify_path" >/dev/null 2>&1; then
    log "CELL upgrade-prep: previous release tree $DETECT_PREV_TAG -> $agent_dir"
  else
    agent_ssh "rm -rf $agent_dir; touch ${agent_dir}.absent" >/dev/null 2>&1 || true
  fi
}

# sync_repo <repo> <proj> — sync the repo to ~/qa-<proj> over SSH
# TWO payload paths (2026-09-23, QA-TERMINAL-JAIL-9):
#   DEFAULT — a FROZEN `git archive HEAD` stream: the audited tree is exactly
#     the pushed HEAD commit, immune to workdir-mid-edit drift (staged worker
#     files, generated caches, untracked dagger.db-style artifacts never ship).
#   LEGACY (BUNKER_QA_SYNC_EXCLUDES set) — the old tracked+untracked file list
#     tar, kept for projects that must exclude tracked-heavy DATA dirs from the
#     payload (git archive cannot exclude tracked paths). This path tars the
#     LIVE workdir non-atomically and carries the documented drift risk.
# Verdict comes from the REMOTE's SYNC-OK echo, not the local stream's exit
# code. GNU tar exits non-zero on "file changed as we read it" even with
# --warning=no-file-changed, and with `set -o pipefail` that would abort the
# whole battery although the remote extraction succeeded. Live repos (actively
# written during tar) trip this constantly.
# BUNKER_QA_SYNC_EXCLUDES: extra --exclude args for monster repos whose
# tracked-but-heavy DATA dirs (generated images, fixtures) would stall the SSH
# pipe past the 1800s agent_ssh timeout (proven wojons-mythos 2026-08-31:
# 6.4G repo / 845M projects/ + 482M packages/backend/projects at ~600KB/s).
# BUNKER_QA_SYNC_MAX_BYTES: payload byte guard, default 300 MB.
# Returns 1 on failure with the remote's last 2 lines in SYNC_ERR.
sync_repo() {
  local repo="$1" proj="$2"
  local sync_excludes="${BUNKER_QA_SYNC_EXCLUDES:-}"
  local sync_max="${BUNKER_QA_SYNC_MAX_BYTES:-314572800}"
  local sync_list sync_bytes sync_out sync_ok sync_oversize sync_readd_b64
  local -a sync_excl=()
  if [ -n "$sync_excludes" ]; then read -ra sync_excl <<< "$sync_excludes"; fi

  # QA-DIGEST-20260933: the agent-side snapshot is a fresh `git init && git add -A`,
  # which RE-APPLIES the repo's own .gitignore — files that are tracked at HEAD but
  # match an ignore rule (e.g. digest's digests/*.md archives, tracked since before
  # .gitignore:41) ship in the payload but never re-enter the snapshot index, so
  # `git ls-files` on the agent loses them and every cell that asserts the tracked
  # archive (tests / ci-pass / chaos-resource) false-reds together. Compute the
  # tracked-but-ignored set controller-side; the agent force-adds exactly those
  # paths (existence-filtered — a BUNKER_QA_SYNC_EXCLUDES arm may have dropped the
  # file from the payload) before the qa-sync commit. Transport: newline-joined
  # paths base64'd into the SSH command line (paths containing NUL/newline are
  # pathological and unsupported here). Empty set → no re-add, behavior unchanged.
  sync_readd_b64=$(git -C "$repo" ls-files --cached --ignored --exclude-standard -z 2>/dev/null |
    while IFS= read -r -d '' f; do [ -e "$repo/$f" ] && printf '%s\n' "$f"; done | base64 | tr -d '\n')

  if [ -z "$sync_excludes" ]; then
    # FROZEN path: payload = exactly HEAD. Measure the real stream for the
    # byte guard, then re-stream it through the SSH pipe.
    if ! sync_bytes=$(git -C "$repo" archive HEAD | wc -c); then
      SYNC_ERR="SYNC-ARCHIVE-ERROR: git archive HEAD failed for $repo (empty repo?)"
      return 1
    fi
    if [ "${sync_bytes:-0}" -le 0 ]; then
      SYNC_ERR="SYNC-ARCHIVE-ERROR: git archive HEAD produced no bytes for $repo"
      return 1
    fi
    if [ "$sync_bytes" -gt "$sync_max" ]; then
      sync_oversize="SYNC-OVERSIZE: $sync_bytes > $sync_max (set BUNKER_QA_SYNC_MAX_BYTES to override)"
      printf '%s\n' "$sync_oversize" >&2
      SYNC_ERR="$sync_oversize"
      return 1
    fi
    sync_out=$(git -C "$repo" archive HEAD |
      agent_ssh "mkdir -p ~/qa-$proj && tar -C ~/qa-$proj -xf - && cd ~/qa-$proj && git init -q && git -c user.name='qa-bot' -c user.email='qa@bunker' add -A && if [ -n '$sync_readd_b64' ]; then printf %s '$sync_readd_b64' | base64 -d | tr '\n' '\0' | while IFS= read -r -d '' f; do [ -e \"\$f\" ] && printf '%s\0' \"\$f\"; done | xargs -0 -r git add -f --; fi && git -c user.name='qa-bot' -c user.email='qa@bunker' commit -q -m 'qa-sync' && echo SYNC-OK" 2>&1)
    sync_ok=$(printf '%s' "$sync_out" | grep -c 'SYNC-OK')
    if [ "$sync_ok" -eq 0 ]; then
      SYNC_ERR=$(printf '%s' "$sync_out" | tail -2)
      return 1
    fi
    return 0
  fi

  sync_list=$(mktemp) || { SYNC_ERR='SYNC-LIST-ERROR: could not create file list'; return 1; }
  if ! git -C "$repo" ls-files -z --cached --others --exclude-standard > "$sync_list"; then
    SYNC_ERR="SYNC-LIST-ERROR: git ls-files failed for $repo"
    rm -f "$sync_list"
    return 1
  fi
  # Index entries whose worktree copy was deleted (git status 'D' — e.g. rotated
  # gitreins guard logs) break `du --files0-from` and `tar -T`; keep only paths
  # that actually exist on disk. (2026-09-22, off-by-one SYNC-SIZE-ERROR.)
  local sync_list2
  sync_list2=$(mktemp) || { SYNC_ERR='SYNC-LIST-ERROR: could not create filtered list'; return 1; }
  while IFS= read -r -d '' f; do
    [ -e "$repo/$f" ] && printf '%s\0' "$f"
  done < "$sync_list" > "$sync_list2"
  mv -f "$sync_list2" "$sync_list"
  case "$sync_max" in
    ''|*[!0-9]*)
      SYNC_ERR="SYNC-LIMIT-ERROR: BUNKER_QA_SYNC_MAX_BYTES is not an integer: $sync_max"
      rm -f "$sync_list"
      return 1
      ;;
  esac
  if ! sync_bytes=$(cd "$repo" && du -cb --files0-from="$sync_list" | awk 'END {print $1}'); then
    SYNC_ERR="SYNC-SIZE-ERROR: could not measure payload for $repo"
    rm -f "$sync_list"
    return 1
  fi
  sync_bytes=${sync_bytes:-0}
  if [ "$sync_bytes" -gt "$sync_max" ]; then
    sync_oversize="SYNC-OVERSIZE: $sync_bytes > $sync_max (set BUNKER_QA_SYNC_MAX_BYTES to override)"
    printf '%s\n' "$sync_oversize" >&2
    SYNC_ERR="$sync_oversize"
    rm -f "$sync_list"
    return 1
  fi

  sync_out=$(tar --warning=no-file-changed --null --verbatim-files-from -C "$repo" \
      "${sync_excl[@]}" -T "$sync_list" -cf - |
    agent_ssh "mkdir -p ~/qa-$proj && tar -C ~/qa-$proj -xf - && cd ~/qa-$proj && git init -q && git -c user.name='qa-bot' -c user.email='qa@bunker' add -A && if [ -n '$sync_readd_b64' ]; then printf %s '$sync_readd_b64' | base64 -d | tr '\n' '\0' | while IFS= read -r -d '' f; do [ -e \"\$f\" ] && printf '%s\0' \"\$f\"; done | xargs -0 -r git add -f --; fi && git -c user.name='qa-bot' -c user.email='qa@bunker' commit -q -m 'qa-sync' && echo SYNC-OK" 2>&1)
  rm -f "$sync_list"
  sync_ok=$(printf '%s' "$sync_out" | grep -c 'SYNC-OK')
  if [ "$sync_ok" -eq 0 ]; then
    SYNC_ERR=$(printf '%s' "$sync_out" | tail -2)
    return 1
  fi
  return 0
}

# ─── artifact expectation (QA-BUNKER-078) ───
# artifact_expectation <install-command> — WHAT the fresh-install leg must leave
# behind, derived from the install shape instead of a literal tool name:
#   binary  the leg packages/installs an executable, so fresh-install FAILs when
#           nothing new appears in a bin dir;
#   none    the leg only compiles or installs dependencies (`go build ./...`,
#           `npm ci`, `pip install -e .`, `cargo build`, `make verify`) — a
#           compile/verify leg PROMISES NO BINARY, so the cell says "no artifact
#           expected for [<cmd>]" instead of failing on a name it never
#           mentioned (the QA-BUNKER-078 defect: `go build ./...` graded FAIL
#           "no artifact found (toolsd ...)" on every Go repo);
#   name:<t> the operator opted in with QA_EXPECTED_ARTIFACT=<t> — assert that
#           exact executable was installed (works for any repo shape).
# Only an explicit packaging target is required to produce an artifact: `make
# build|install|all|…` and `go/cargo/pipx install`, `npm i -g`.  A make target
# that only tests/verifies (make verify/test/check/lint/fmt/vet/docs) installs
# nothing by contract, so it is graded 'none' — QA-BUNKER-81's arm was reaching
# for a binary a `make verify` never promised.
artifact_expectation() {
  local cmd="${1//\'/}"
  if [ -n "${QA_EXPECTED_ARTIFACT:-}" ]; then printf 'name:%s' "$QA_EXPECTED_ARTIFACT"; return 0; fi
  case "$cmd" in
    make|make\ *)
      case "$cmd" in
        *test*|*check*|*verify*|*lint*|*fmt*|*vet*|*doc*|*clean*) printf 'none' ;;
        *) printf 'binary' ;;
      esac ;;
    *"go install"*|*"cargo install"*|*"pipx install"*|*"npm install -g"*|*"npm i -g"*|*"pnpm add -g"*|*"yarn global add"*)
      printf 'binary' ;;
    *) printf 'none' ;;
  esac
}

# ─── build the remote cell script (all quoting handled HERE, once) ───
build_remote_script() { # args: proj install_cmd ci_cmd native_cmd
  local proj="$1" install_cmd="$2" ci_cmd="$3" native_cmd="$4"
  local artifact_expect artifact_cmd
  artifact_expect="$(artifact_expectation "$install_cmd")"
  # Messaging copy of the install command: quotes stripped (it is interpolated
  # into a single-quoted assignment below) and truncated — it is a label, never
  # something the generated script executes.
  artifact_cmd="$(printf '%s' "$install_cmd" | tr -d "'" | cut -c1-160)"
  # QA-HARNESS-DOCKERGATE-001: the compose lifecycle opt-in and the controller's
  # host veto are resolved HERE (controller scope) and baked into the body below.
  local qa_docker_lifecycle_enabled="${BUNKER_QA_ENABLE_DOCKER_LIFECYCLE:-0}"
  local qa_docker_lifecycle_host_block="${BUNKER_QA_DOCKER_LIFECYCLE_HOST_BLOCK:-0}"
  cat <<EOF
#!/usr/bin/env bash
# qa-run.sh — generated by bunker-qa.sh for $proj (do not edit)
PROJ='$proj'
QAREPO="\$HOME/qa-\$PROJ"
# QA-BUNKER-078: the install command and its DERIVED artifact expectation are
# baked here by the generator.  The previous form read them from a shell
# variable the generated script never defines, so the check was inert.
ARTIFACT_EXPECT='$artifact_expect'
ARTIFACT_CMD='$artifact_cmd'
EVID=~/qa-evidence.jsonl
# Per-run log dir in HOME — /tmp/*.log is shared across agents and the
# sticky bit makes a fresh agent uid unable to overwrite a previous
# agent's files (Permission denied + stale content read-back). A
# run-unique dir sidesteps both.
LOGD=~/qa-logs-\$\$
mkdir -p \$LOGD
: > \$EVID
# Completion marker (QA-HERMES-CANOPY-8): collect()'s cheap probe — present ⇒
# the battery is DONE (whichever exit path it took), absent + no live process
# ⇒ the agent/process is gone. The EXIT trap guarantees the marker even on the
# early "no repo dir" bail; the explicit touch after CELLS-DONE is the normal path.
trap 'touch ~/qa-run.finished' EXIT
cell() { # <cell> <status> <detail> [<extra-json-object>]
  # QA-CRIER-59: the optional 4th argument is a compact JSON object of extra
  # machine-readable fields (chaos-resource passes its failing_packages /
  # failing_tests attribution here). It is merged into the row so a verdict
  # NAMES what died instead of hiding it in prose; every 3-arg caller keeps the
  # pre-change row shape byte-for-byte.
  local extra="\${4:-}"
  if command -v python3 >/dev/null 2>&1; then
    python3 -c 'import json,sys,datetime
row={"project":"'\$PROJ'","cell":sys.argv[1],"status":sys.argv[2],"detail":sys.argv[3],"ts":datetime.datetime.now(datetime.timezone.utc).isoformat()}
if len(sys.argv) > 4 and sys.argv[4]:
    try:
        extra=json.loads(sys.argv[4])
        if isinstance(extra, dict):
            row.update(extra)
    except Exception:
        row["extra_raw"]=sys.argv[4]
print(json.dumps(row))' "\$1" "\$2" "\$3" "\$extra" >> \$EVID
  else
    local d extra_frag extra_body; d=\$(printf '%s' "\$3" | tr '\n\t\r' '   ' | sed 's/"/'"'"'/g')
    # splice the extra object's CONTENT by dropping exactly ONE outer brace pair
    # (never all braces: the payload may nest, e.g. "cap":{...}) so both writers
    # emit the same top-level fields.
    extra_frag=""
    if [ -n "\$extra" ]; then
      extra_body="\${extra#\{}"; extra_body="\${extra_body%\}}"
      extra_frag=",\${extra_body}"
    fi
    # QA-CRIER-62: the fallback row is written through an UNQUOTED heredoc so
    # the shipped script carries the bound identity as plain double-quoted JSON
    # around the \$PROJ expansion — no backslash-hidden quotes, so any grep of
    # qa-run.sh can prove which project the battery stamps.
    cat >>\$EVID <<QAROWJSON
{"project":"\$PROJ","cell":"\$1","status":"\$2","detail":"\$d"\$extra_frag,"ts":"\$(date -u +%FT%TZ)"}
QAROWJSON
  fi
}
fail_detail() { # <rc> <logfile> <cmd...> — ACTIONABLE-FAILURE CONTRACT
  local frc="\$1" flog="\$2"; shift 2
  printf 'rc=%s cmd=[%s] — %s' "\$frc" "\$*" "\$(grep -v '^[[:space:]]*\$' "\$flog" 2>/dev/null | head -40 | tr '\n' '|' | cut -c1-1500)"
}
tests_fail_detail() { # <rc> <logfile> <cmd...> — QA-H3-031: tests-cell FAIL excerpt
  # A real suite log carries its failure at the END (make prints the failing
  # recipe + rc right after the runner's own failure summary) and run() collects
  # ONLY qa-evidence.jsonl, so the excerpt is the only trace of the failing
  # command's own output. fail_detail's head-anchored 40-line/1500-char window
  # drops that failure from any log longer than the window (reproduced: a
  # 62-line forced-fail log graded a detail cut mid-preamble with the failing
  # recipe's own output + make's Error 2 both absent). The tests-cell excerpt is
  # END-anchored (tail -c) with a raised char budget, so the failure summary
  # always survives a long preamble; short logs still land in full. Only the
  # tests cell uses this helper — lint/inst/docker/upgrade keep fail_detail's
  # original budget and anchors.
  local trc="\$1" tlog="\$2"; shift 2
  local texc="\${BUNKER_QA_TESTS_EXCERPT_CHARS:-12000}"
  local tjoin texc_text tlead
  tjoin="\$(grep -v '^[[:space:]]*\$' "\$tlog" 2>/dev/null | tr '\n' '|')"
  texc_text="\$(printf '%s' "\$tjoin" | tail -c "\$texc")"
  tlead=""
  [ "\${#tjoin}" -gt "\$texc" ] && tlead="…"
  printf 'rc=%s cmd=[%s] — %s%s' "\$trc" "\$*" "\$tlead" "\$texc_text"
}
qa_lint_skipped_declared_golangci() { # <lint command> <repo tree> <log>
  local qa_lcmd="\$1" qa_tree="\$2" qa_log="\$3"
  case "\$qa_lcmd" in *golangci-lint*|*make\ lint*) ;; *) return 1 ;; esac
  # QA-ASCE-11: also catch the make-level missing-binary shape — "make:
  # golangci-lint: No such file or directory" / ": command not found" — which
  # previously slipped past the Makefile-echo-only pattern and graded the repo
  # FAIL on an agent env gap.
  grep -qiE 'golangci-lint.*(not installed|not found).*skipping|golangci-lint not installed|golangci-lint: *(command not found|no such file or directory)' "\$qa_log" 2>/dev/null || return 1
  [ -f "\$qa_tree/.golangci.yml" ] || [ -f "\$qa_tree/.golangci.yaml" ] && return 0
  if [ -f "\$qa_tree/Makefile" ] && awk '/^lint[[:space:]]*:/ { in_lint=1; next } in_lint && /^[^[:space:]#][^:]*:/ { exit } in_lint && /golangci-lint/ && ! /^[[:space:]]*@?(echo|printf)[[:space:]]/ && ! /^[[:space:]]*#/ { found=1 } END { exit !found }' "\$qa_tree/Makefile"; then return 0; fi
  if find "\$qa_tree/.github/workflows" -maxdepth 1 -type f -exec grep -E '^[[:space:]]*(run:[[:space:]].*golangci-lint|uses:[[:space:]]*golangci/golangci-lint-action)' {} + 2>/dev/null | grep -q .; then return 0; fi
  return 1
}
# DF-CRIER-498 (2026-11-03 bunker-las-03 evidence): on a fresh agent the docker
# cells raced the rootless daemon — bare \`docker build\` fell back to the
# /run/user/<uid>/docker.sock guess ("no such file or directory") and docker_build
# graded FAIL as a closed-pipe tar abort before any daemon was up.
# qa_docker_endpoint_wait resolves + WAITS for an ANSWERING endpoint (pre-set
# DOCKER_HOST -> bunker agent socket -> /run/user/<uid> -> /var/run/docker.sock)
# BEFORE the first daemon contact; qa_resolve_port_expr resolves compose
# \${VAR:-default} port interpolations for the docker-deploy probe loop
# (environment first, then the repo .env, then the :- default).
qa_docker_endpoint_wait() { # -> 0 iff DOCKER_HOST ends up pointing at an ANSWERING daemon
  qa_docker_endpoint_note=""
  if [ -n "\${DOCKER_HOST:-}" ]; then
    if docker version --format '{{.Server.Version}}' >/dev/null 2>&1; then
      qa_docker_endpoint_note="DOCKER_HOST preset and answering (\$DOCKER_HOST)"
      return 0
    fi
    qa_docker_endpoint_note="DOCKER_HOST preset (\$DOCKER_HOST) but daemon silent"
    return 1
  fi
  local qa_w=0 qa_wmax=\$(( \${BUNKER_QA_DOCKER_WAIT_SECS:-60} / 3 ))
  [ "\$qa_wmax" -lt 1 ] && qa_wmax=1
  while [ "\$qa_w" -lt "\$qa_wmax" ]; do
    for qa_cand in "/run/bunker/$agent/docker.sock" "/run/user/\$(id -u)/docker.sock" "/var/run/docker.sock"; do
      [ -S "\$qa_cand" ] || continue
      if DOCKER_HOST="unix://\$qa_cand" docker version --format '{{.Server.Version}}' >/dev/null 2>&1; then
        export DOCKER_HOST="unix://\$qa_cand"
        qa_docker_endpoint_note="endpoint \$qa_cand answering after ~\$(( qa_w * 3 ))s"
        return 0
      fi
      qa_docker_endpoint_note="\$qa_docker_endpoint_note \$qa_cand(socket-present-daemon-silent)"
    done
    sleep 3
    qa_w=\$(( qa_w + 1 ))
  done
  qa_docker_endpoint_note="no answering docker socket at /run/bunker/$agent/docker.sock, /run/user/\$(id -u)/docker.sock or /var/run/docker.sock within \${BUNKER_QA_DOCKER_WAIT_SECS:-60}s"
  return 1
}
qa_resolve_port_expr() { # <expr like \${VAR:-8767} or \$VAR> -> resolved port on stdout
  local qa_e="\$1" qa_inner="" qa_var="" qa_def="" qa_val=""
  case "\$qa_e" in
    '\${'*) qa_inner="\${qa_e:2}"; qa_inner="\${qa_inner%\}}" ;;
    '$'*)   qa_inner="\${qa_e:1}" ;;
    *)      printf '%s' "\$qa_e"; return 0 ;;
  esac
  case "\$qa_inner" in
    *':-'*) qa_var="\${qa_inner%%:-*}"; qa_def="\${qa_inner#*:-}" ;;
    *)      qa_var="\$qa_inner"; qa_def="" ;;
  esac
  qa_val="\$(printenv "\$qa_var" 2>/dev/null || true)"
  if [ -z "\$qa_val" ] && [ -f .env ]; then
    qa_val="\$(grep -E "^\${qa_var}=" .env 2>/dev/null | head -1 | cut -d= -f2-)"
  fi
  [ -n "\$qa_val" ] || qa_val="\$qa_def"
  printf '%s' "\$qa_val"
}
# QA-CRIER-REVIEW-7-R4 (2026-11-16) — docker-deploy ATTRIBUTION helpers.
# A host:container mapping in a compose YAML is a CLAIM about the port the
# deploy will publish. The probe loop trusted that claim and credited ANY
# answer on the port to the deploy, so a leftover native binary or a previous
# container answering it turned a dead stack into an OK cell. These helpers
# make the claim checkable and name the process that actually answered:
#   qa_compose_service_for_mapping — best-effort service name for a mapping
#                                    token, so \`docker compose port <svc>
#                                    <cport>\` can resolve the CONTAINER-owned
#                                    host port instead of the YAML's guess
#   qa_port_owner                  — pid + cmdline of the listening socket
#   qa_compose_published_ports     — host ports this compose project publishes
#                                    (the same container-owned bindings
#                                    \`docker compose port\` reports per service)
#   qa_compose_container_pids      — State.Pid of this project's containers
#   qa_deploy_attribution          — owned | stranger | unknown + who answered
# The YAML service lookup is a deliberately narrow block/flow reader for the
# ONE shape that matters (\`<svc>:\` under top-level \`services:\`, mapping tokens
# on the service line or in its \`ports:\` list). An undeterminable service is
# NOT an error: the caller keeps the YAML host port and the attribution verdict
# below still decides whether a pass may be awarded.
qa_compose_service_for_mapping() { # <mapping token> -> service name ('' when undeterminable)
  local qs_m="\$1" qs_f qs_svc
  # Fail closed on an empty token: \`index(\$0, "")\` is 1 on EVERY line, so an
  # empty token would "match" the first service in the file and hand the caller
  # a WRONG service — whose container port may map to a different host port than
  # the mapping the cell is probing.
  [ -n "\$qs_m" ] || return 0
  for qs_f in \$COMPOSE_FILES; do
    [ -f "\$qs_f" ] || continue
    qs_svc="\$(awk -v tok="\$qs_m" '
      /^services:[[:space:]]*$/ { insvc=1; next }
      insvc && /^[^[:space:]#]/ { insvc=0 }
      insvc && /^  [A-Za-z0-9_.-]+:/ {
        s=\$1; sub(/:.*/, "", s)
        if (index(\$0, tok) > 0) { print s; exit }
        svc=s; next
      }
      insvc && svc != "" && index(\$0, tok) > 0 { print svc; exit }
    ' "\$qs_f" 2>/dev/null | head -1)"
    [ -n "\$qs_svc" ] && { printf '%s' "\$qs_svc"; return 0; }
  done
  return 0
}
qa_port_owner() { # <port> -> "pid=<pid> cmd=<cmdline>" | "pid=hidden" | "pid=none"
  # Three outcomes matter, and collapsing them would be a lie: a listening
  # socket whose OWNER this (usually non-root) user may not see is NOT the same
  # as no listener at all. Measured on a real compose publish (docker 29,
  # hermes-canopy 2026-11-16): \`ss -ltnpH "sport = :5437"\` prints the LISTEN
  # line with NO users:(...) field for uid 1000, while \`ss -ltnH\` shows it.
  local qo_p="\$1" qo_pid="" qo_cmd="" qo_line=""
  if command -v ss >/dev/null 2>&1; then
    qo_line="\$(ss -ltnH "sport = :\$qo_p" 2>/dev/null | head -1)"
    qo_pid="\$(ss -ltnpH "sport = :\$qo_p" 2>/dev/null | grep -o 'pid=[0-9][0-9]*' | head -1 | cut -d= -f2)"
  fi
  if [ -z "\$qo_pid" ] && command -v lsof >/dev/null 2>&1; then
    qo_pid="\$(lsof -ti "tcp:\$qo_p" -sTCP:LISTEN 2>/dev/null | head -1)"
    [ -z "\$qo_line" ] && [ -n "\$qo_pid" ] && qo_line="lsof"
  fi
  if [ -z "\$qo_pid" ]; then
    if [ -n "\$qo_line" ]; then printf 'pid=hidden'; else printf 'pid=none'; fi
    return 0
  fi
  qo_cmd="\$(tr '\000' ' ' 2>/dev/null < "/proc/\$qo_pid/cmdline" | tr '\n\t' ' ' | tr '"' "'" | sed 's/ *\$//' | cut -c1-80)"
  [ -n "\$qo_cmd" ] || qo_cmd="unreadable"
  printf 'pid=%s cmd=%s' "\$qo_pid" "\$qo_cmd"
}
qa_compose_published_ports() { # -> "5437 8767" host ports this compose project publishes ('' when unreadable)
  local qp_ports
  qp_ports="\$(docker compose ps --format json 2>/dev/null | grep -o '"PublishedPort":[[:space:]]*[0-9][0-9]*' | grep -o '[0-9][0-9]*\$' | sort -un | tr '\n' ' ')"
  printf '%s' "\${qp_ports% }"
}
qa_compose_container_pids() { # -> "123 456" State.Pid of this compose project's containers
  local qc_ids qc_pids
  qc_ids="\$(docker compose ps -q 2>/dev/null | tr -d '\r')"
  [ -n "\$qc_ids" ] || return 0
  qc_pids="\$(printf '%s\n' "\$qc_ids" | xargs docker inspect -f '{{.State.Pid}}' 2>/dev/null | sort -un | tr '\n' ' ')"
  printf '%s' "\${qc_pids% }"
}
qa_deploy_attribution() { # <port> -> "<owned|stranger|unknown>|<who answered, and why>"
  local qa_p="\$1" qa_who qa_pubs qa_pids qa_pid qa_hint
  qa_who="\$(qa_port_owner "\$qa_p")"
  qa_pid="\${qa_who#pid=}"; qa_pid="\${qa_pid%% *}"
  case "\$qa_pid" in
    hidden) qa_hint="; owner pid not visible to this user (non-root) — the LISTEN socket exists" ;;
    none)   qa_hint="; no local LISTEN socket visible on that port" ;;
    *)      qa_hint="" ;;
  esac
  qa_pubs="\$(qa_compose_published_ports)"; qa_pubs="\${qa_pubs# }"
  if [ -z "\$qa_pubs" ]; then
    printf 'unknown|%s%s; compose published-port set unreadable — port %s ownership UNVERIFIED' "\$qa_who" "\$qa_hint" "\$qa_p"
    return 0
  fi
  case " \$qa_pubs " in
    *" \$qa_p "*)
      qa_pids="\$(qa_compose_container_pids)"; qa_pids="\${qa_pids# }"
      case " \$qa_pids " in
        *" \$qa_pid "*) printf 'owned|%s — the compose container process itself answers host port %s (published by this compose project)' "\$qa_who" "\$qa_p" ;;
        *) printf 'owned|%s%s — host port %s is published by this compose project (answer arrives through docker published-port forwarding)' "\$qa_who" "\$qa_hint" "\$qa_p" ;;
      esac ;;
    *) printf 'stranger|%s%s — host port %s is NOT published by this compose project (published: %s)' "\$qa_who" "\$qa_hint" "\$qa_p" "\$qa_pubs" ;;
  esac
}
# QA-OFF-BY-ONE-15-R2: snapshot state candidates before any app-start cell.
( cd "\$QAREPO" || exit 1
find . -maxdepth 3 \\( -name '*.db' -o -name '*.sqlite' -o -name '*.sqlite3' \\) \\
  -not -path './.git/*' -not -path './node_modules/*' -not -path './.mypy_cache/*' \\
  -not -path './.pytest_cache/*' -not -path './.ruff_cache/*' -not -path './.vfs/*' \\
  -not -path './.venv/*' -not -path './venv/*' -not -path './qa-logs-*/*' 2>/dev/null | sort > "\$LOGD/state-snapshot.txt"
# QA-CRIER-8-R2: same snapshot for text/append-log state surfaces. Repos whose
# durable state is JSONL/directory-shaped (append logs, *.json under obvious
# state dirs) got a false chaos-corruption N/A because only *.db/*.sqlite was
# scanned. Same depth bound + tool-cache exclusions; its own snapshot file
# keeps the pre-existing vs created-mid-run symmetry per surface.
find . -maxdepth 3 \\( -name '*.jsonl' -o -name '*.ndjson' \\
  -o \\( -name '*.json' \\( -path './data/*' -o -path './state/*' \\
       -o -path './store/*' -o -path './db/*' -o -path './ledger/*' \\
       -o -path './sessions/*' -o -path './groups/*' -o -path './evidence/*' \\) \\) \\) \\
  -not -path './.git/*' -not -path './node_modules/*' -not -path './.mypy_cache/*' \\
  -not -path './.pytest_cache/*' -not -path './.ruff_cache/*' -not -path './.vfs/*' \\
  -not -path './.venv/*' -not -path './venv/*' \\
  -not -path './.coding-hermes/*' -not -path './.gitreins/*' \\
  -not -name 'qa-evidence.jsonl' -not -path './qa-logs-*/*' 2>/dev/null | sort > "\$LOGD/state-snapshot-text.txt"
)
# qa_have_pip — QA-BUNKER-57 (2026-10-04): a fresh JIT agent's ensurepip can
# fail (no sudo, broken venv), leaving NO pip anywhere; the old harness then
# cascaded rc=127 'pip: command not found' through fresh-install, upgrade and
# chaos-resource as FAIL/ENV-BLOCKED with zero repo signal. Every leg that
# invokes pip must call this first and grade UNVERIFIED instead.
qa_have_pip() { # 0 when pip is usable (PATH pip, python3 -m pip, or the venv interpreter)
  command -v pip >/dev/null 2>&1 && return 0
  python3 -m pip --version >/dev/null 2>&1 && return 0
  [ -x "\$HOME/tools/venv/bin/python3" ] && "\$HOME/tools/venv/bin/python3" -m pip --version >/dev/null 2>&1 && return 0
  return 1
}
# act_failure_context — act's '❌ Failure - Main <step> [Xs]' line names the step
# but never the cause; the step's own output is printed ABOVE the marker, so
# return the 18 lines preceding the first ❌ plus the marker itself, followed by test identities.
act_failure_context() { # <act log>
  local lf="\$1" n tests
  n=\$(grep -n '❌' "\$lf" 2>/dev/null | head -1 | cut -d: -f1)
  if [ -n "\$n" ]; then sed -n "\$(( n > 18 ? n - 18 : 1 )),\${n}p" "\$lf" | tr '\n' '|' | cut -c1-1400
  else tail -8 "\$lf" 2>/dev/null | tr '\n' '|' | cut -c1-1400; fi
  # QA-GUARD-008 leg-2 (2026-11-22): non-quiet act prefixes every step-output
  # line with "[<workflow>/<job>] " (measured live this tick), so test
  # identities are NOT at line start. Match them anywhere in the line instead:
  # the '--- FAIL:' go-test marker, and a package summary 'FAIL <module>' where
  # FAIL is a standalone token. Cap the appended segment so the detail stays
  # within the cell-detail budget.
  tests=\$( { grep -E -- '--- FAIL:' "\$lf" 2>/dev/null | head -8; grep -E -- '(^|[^A-Za-z])FAIL[[:space:]]' "\$lf" 2>/dev/null | head -8; } | tr '\n' '|' | cut -c1-600)
  [ -z "\$tests" ] || printf ' failing-tests: %s' "\$tests"
}
# build_env_failure — is this failure the AGENT's missing C toolchain instead of a
# repo defect? (QA-WARPFS-9, 2026-09-19.) rust links EVERY crate build script
# through the \`cc\` linker, so on a toolchain-bare agent (no cc/gcc/clang, no sudo)
# the first crate with a build script dies with
#   error: linker \`cc\` not found
#   error: could not compile \`libc\` (build script) due to 1 previous error   (rc=101)
# That is an ENVIRONMENT gap, not a finding — the pre-QA-WARPFS-9 harness graded it
# fresh-install FAIL ("repo defect"), chaos-resource FAIL ("proves nothing about the
# 3G cap") and chaos-disconnect OK "fails fast on disconnect" (a FALSE PASS: the
# network cut was never exercised, the build died first). A log that ALSO carries a
# genuine rustc diagnostic (error[E####]) is a real compile error and must keep its
# FAIL grade, so this returns 0 only for the bare toolchain shape.
build_env_failure() { # <logfile> — 0 when the log carries the toolchain signature only
  local bf="\$1"
  [ -f "\$bf" ] || return 1
  grep -qE 'linker \`cc\` not found|could not compile .*\(build script\)' "\$bf" 2>/dev/null || return 1
  ! grep -qE '^error\[E[0-9]{4}\]' "\$bf" 2>/dev/null
}
# build_sys_dep_failure — did a *-sys crate's build script fail to find a system
# library? (QA-WARPFS-9 rework 3, 2026-09-19.) The live round-2 shape, on the same
# bare agent once the zig leg had fixed the linker:
#   error: failed to run custom build command for \`openssl-sys v0.9.117\`
#   Could not find directory of OpenSSL installation ...
#   Make sure you also have the development packages of openssl installed.
# A *-sys crate is the binding layer for a C library, so its build script dying on
# a missing header / pkg-config file means a MISSING SYSTEM PACKAGE (libssl-dev,
# libfuse3-dev, pkg-config, make) — not a repo defect — and a bare agent has no
# sudo to install one. This predicate is the LOG half ONLY: the caller must ALSO
# require RUST_MISSING_SYS_DEPS (the probe above, which knows what this agent
# lacks) to be non-empty, so a *-sys failure on an agent that HAS the deps is
# still graded FAIL. And exactly as in build_env_failure(), a genuine rustc
# diagnostic (error[E####]) outranks it: code errors keep their FAIL grade.
build_sys_dep_failure() { # <logfile> — 0 when the log carries the missing-system-library shape
  local sf="\$1"
  [ -f "\$sf" ] || return 1
  grep -qE 'failed to run custom build command for [^ ]*-sys([ \`]|\$)|Make sure you also have the development packages' "\$sf" 2>/dev/null || return 1
  ! grep -qE '^error\[E[0-9]{4}\]' "\$sf" 2>/dev/null
}
# build_incomplete — did the build even FINISH? (QA-WARPFS-9 rework 2, 2026-09-19.)
# build_env_failure() above is deliberately NARROW (the bare-toolchain shape only,
# so a genuine rustc diagnostic keeps its FAIL). A build can also die BEFORE the
# chaos condition is reached, for a reason that IS the chaos condition's subject —
# observed live on the same agent: the \`ring\` crate's build script hands the RUST
# target triple straight to the C compiler as
#   --target=x86_64-unknown-linux-gnu
# and zig's target syntax carries no vendor segment, so cc dies with
#   error: unable to parse target query 'x86_64-unknown-linux-gnu': UnknownOperatingSystem
#   error: failed to run custom build command for \`ring v0.17.14\`
#   warning: build failed, waiting for other jobs to finish...          (rc=101)
# Neither shape is a network or memory finding, and neither reached the chaos
# condition, so chaos-disconnect must not grade OK "fails fast on disconnect" and
# chaos-resource must not grade FAIL "rc!=0 under cap" on either of them. This
# predicate is therefore BROAD by design: ANY incomplete build → the two chaos
# cells grade INFO UNVERIFIED / ENV-BLOCKED, whatever the cause (environment OR
# code). It is used ONLY by those two chaos cells; fresh-install keeps
# build_env_failure() so a real compile error stays a repo defect.
# build_incomplete_cause() is the detail-text companion — it prints the first line
# that proves the build never finished, so a cell never has to guess the cause
# from a noisy tail (and the pattern list lives in exactly ONE place). It also
# matches an explicit rustc diagnostic (^error[E####]) because that is the FIRST
# line a compile error prints: the detail then names the real defect instead of
# cargo's summary line further down.
build_incomplete_cause() { # <logfile> — print the line proving the build never finished
  grep -m1 -E 'linker \`cc\` not found|could not compile|failed to run custom build command|warning: build failed, waiting for other jobs|^error\[E[0-9]{4}\]' "\$1" 2>/dev/null | cut -c1-220
}
build_incomplete() { # <logfile> — 0 when the log shows the build never completed
  [ -n "\$(build_incomplete_cause "\$1")" ]
}
# go_suite_env_failure — is this go-suite FAIL the test HOST's missing build
# tool instead of a repo defect? (QA-CRIER-23/QA-CRIER-7, 2026-09-20; measured
# 2026-09-19 on bunker-las-02: cmd/server TestServerVersionCLIFlags "Makefile
# stamps the symbols the binary reads" shells to \`make -n build\`, the JIT
# agent's PATH has no make, and the suite dies with
#   --- FAIL: TestServerVersionCLIFlags ...
#   main_test.go:1358: make -n build: exec: "make": executable file not found in \$PATH
# while hosted CI is GREEN at that exact HEAD and the same test PASSES on any
# host with make. A tool-less host says NOTHING about the code, so the two
# chaos cells must not grade this shape and ci-pass must NAME what failed.)
go_suite_env_failure() { # <logfile> — 0 when a go-suite FAIL is explained by exec: "<tool>": executable file not found
  local gf="\$1"
  [ -f "\$gf" ] || return 1
  grep -qE 'exec: "[a-z][a-z-]*": executable file not found in [$]PATH' "\$gf" 2>/dev/null || return 1
  grep -qE -- '--- FAIL|^FAIL' "\$gf" 2>/dev/null || return 1
  true
}
# go_toolchain_oom — did the go TOOLCHAIN itself die building under the memory
# cap? (QA-HERMES-CANOPY-38, 2026-10-04.) On a 3G address-space cap the toolchain
# can fail before any test runs: \`runtime/cgo: SystemResources\` during tool
# bootstrap, or \`cannot allocate memory\` from the compiler. That is the CAP vs
# TOOLCHAIN interaction, not a repo memory finding — grading it FAIL rc!=0
# blamed the code for an environment ceiling.
go_toolchain_oom_cause() { # <logfile> - print the line proving the toolchain failed to build
  grep -m1 -E 'SystemResources|cannot allocate memory|out of memory \(Go toolchain\)|failed to initialize build cache.*address space' "\$1" 2>/dev/null | cut -c1-220
}
go_toolchain_oom() { [ -n "\$(go_toolchain_oom_cause "\$1")" ]; }
# go_panic_timeout — did go test hit its own 10m timeout and PANIC under the cap?
# (QA-HERMES-CANOPY-38.) internal/session on a 3G cap panics 'test timed out
# after 10m0s' instead of failing a package: the suite has NO clean failure mode
# at its worst-case memory ceiling. A real finding, but about the ceiling, not a
# package regression — grade INFO with the panic line as attribution.
go_panic_timeout_cause() { # <logfile> - print the panic-timeout line
  grep -m1 -E 'panic: test timed out' "\$1" 2>/dev/null | cut -c1-220
}
go_panic_timeout() { [ -n "\$(go_panic_timeout_cause "\$1")" ]; }
# capped_fail_summary — a capped-suite FAIL must NAME the failing package.
# (QA-HERMES-CANOPY-37, 2026-10-04.) The old verdict embedded blind tail -3 of
# the raw go-test log; a panic goroutine dump floods the tail and the verdict
# carried no '--- FAIL' / 'panic:' line, making post-destroy attribution
# impossible (the QA-36 lesson, now structural). Extract the FAIL/panic lines
# first; fall back to tail -3 only when the log has neither.
capped_fail_summary() { # <logfile> - FAIL/panic lines, else tail -3
  local s
  s=\$(grep -E -- '--- FAIL|^FAIL|panic: test timed out' "\$1" 2>/dev/null | head -5 | tr '\n' ' ' | cut -c1-500)
  if [ -n "\$s" ]; then printf '%s' "\$s"; else tail -3 "\$1" | tr '\n' ' ' | cut -c1-300; fi
}
# ── QA-CRIER-59 (2026-11-18) — chaos-resource ATTRIBUTION + EXEMPTION FLOOR ──
# Defect: the 3G cap can kill PART of the suite, and the cell used to collapse
# the whole run into one INFO line ("OOM under cap", heavy-suite wording) with
# no package and no test name, so a cap artifact and a real regression were
# indistinguishable (four cmd/server chat-truth tests dying under the cap were
# reported as "expected"). These helpers read the SAME
# \$LOGD/res.log the cell already captures and name WHAT failed: failing
# packages (go \`FAIL\t<pkg>\`, pytest \`FAILED <path>::<test>\`) and failing test
# ids (go \`--- FAIL: TestX\`, pytest \`FAILED path::test\`). The cell prints them
# in its reason AND writes them into the evidence row as machine-readable
# fields, so no verdict can be a bare tail again.
# They are pure log readers: nothing is re-run unless an operator explicitly
# declares a package exempt (cap_exempt_* below, default EMPTY).
cap_kill_cause() { # <logfile> - the line proving the suite died on memory
  grep -m1 -iE 'signal: killed|out of memory|memoryerror|cannot allocate memory' "\$1" 2>/dev/null | cut -c1-200
}
cap_kill_signal() { [ -n "\$(cap_kill_cause "\$1")" ]; }
cap_fail_packages() { # <logfile> - unique failing package/module names
  {
    grep -hoE '^FAIL[[:space:]]+[^[:space:]]+' "\$1" 2>/dev/null | awk '{print \$2}'
    grep -hoE '^FAILED[[:space:]]+[^:[:space:]]+' "\$1" 2>/dev/null | awk '{print \$2}'
  } | sed 's/[[:space:]]*\$//' | grep -v '^$' | awk '!seen[\$0]++'
}
cap_fail_tests() { # <logfile> - unique failing test ids (go and pytest)
  {
    grep -hoE -- '--- FAIL: [^[:space:]]+' "\$1" 2>/dev/null | sed 's/^--- FAIL: //'
    grep -hoE '^FAILED[[:space:]]+[^[:space:]]+' "\$1" 2>/dev/null | awk '{print \$2}'
  } | grep -v '^$' | awk '!seen[\$0]++'
}
cap_attr_note() { # <logfile> - one-line "what failed under the cap", never empty
  local pkgs tests
  pkgs=\$(cap_fail_packages "\$1" | head -8 | tr '\n' ',' | sed 's/,\$//; s/,/, /g' | cut -c1-300)
  tests=\$(cap_fail_tests "\$1" | head -8 | tr '\n' ',' | sed 's/,\$//; s/,/, /g' | cut -c1-300)
  if [ -n "\$pkgs" ] || [ -n "\$tests" ]; then
    printf 'what failed under the cap: packages=[%s] tests=[%s]' "\${pkgs:-none}" "\${tests:-none}"
  else
    printf 'no failing package/test name recoverable from the capped log (the cap killed the runner before it printed one)'
  fi
}
cap_attr_json() { # <logfile> - compact JSON row field: packages, tests, cap instrument
  local pkgs tests
  pkgs=\$(cap_fail_packages "\$1" | head -8 | tr -d '"' | awk 'BEGIN{printf "["} NR>1{printf ","} {printf "\"%s\"", \$0} END{printf "]"}')
  tests=\$(cap_fail_tests "\$1" | head -8 | tr -d '"' | awk 'BEGIN{printf "["} NR>1{printf ","} {printf "\"%s\"", \$0} END{printf "]"}')
  printf '{"failing_packages":%s,"failing_tests":%s,"cap":{"mechanism":"ulimit -v","requested_kb":%s,"effective_kb":"%s"}}' \
    "\$pkgs" "\$tests" "\${CAP_KB:-0}" "\${cap_seen:-NONE}"
}
# EXEMPTION FLOOR (QA-CRIER-59). BUNKER_QA_CAP_EXEMPT_PKGS takes `name=reason`
# entries SEPARATED BY ';' (so a reason may contain commas and spaces) and
# DEFAULTS TO EMPTY, so the live battery behaves exactly as before unless an
# operator opts in for this run. Two rules make an exemption honest: (a) an
# entry WITHOUT a reason is REFUSED — an unauditable exemption is just a way to
# hide a regression; (b) an exempt package is re-run UNCAPPED, and passing means
# the capped failure was a cap artifact while failing means a REAL defect that
# the exemption cannot save. The exemption gates the CAP, never the verdict.
CAP_EXEMPT_PKGS="\${BUNKER_QA_CAP_EXEMPT_PKGS:-\${CAP_EXEMPT_PKGS:-}}"
CAP_EXEMPT_TIMEOUT="\${BUNKER_QA_CAP_EXEMPT_TIMEOUT:-300}"
cap_exempt_lookup() { # <pkg> - prints "exempt:<reason>", "reasonless" or "none"
  local want="\$1" ent name reason
  while IFS= read -r ent; do
    ent=\$(printf '%s' "\$ent" | sed 's/^[[:space:]]*//; s/[[:space:]]*\$//')
    [ -n "\$ent" ] || continue
    case "\$ent" in
      *=*)
        name="\${ent%%=*}"; reason="\${ent#*=}"
        [ -n "\$name" ] || continue
        case "\$want" in
          "\$name"|"\$name"/*)
            if [ -n "\$reason" ]; then printf 'exempt:%s' "\$reason"; else printf 'reasonless'; fi
            return 0 ;;
        esac
        ;;
      *)
        case "\$want" in
          "\$ent"|"\$ent"/*) printf 'reasonless'; return 0 ;;
        esac
        ;;
    esac
  done <<CAPEXEMPTLIST
\$(printf '%s' "\${CAP_EXEMPT_PKGS:-}" | tr ';' '\\n')
CAPEXEMPTLIST
  printf 'none'
}
cap_exempt_rerun_cmd() { # <pkg> - the uncapped re-check command, if the runner is known
  local want="\$1"
  case "\${QA_NATIVE_CMD:-}" in
    *pytest*) printf 'python3 -m pytest %s -q' "\$want" ;;
    "go test"*|*" go test "*) printf 'go test -count=1 %s' "\$want" ;;
    *) return 1 ;;
  esac
}
cap_exempt_recheck() { # <pkg> - 0 passes uncapped, 1 fails uncapped, 2 not re-checkable
  local want="\$1" cmd rc
  cmd=\$(cap_exempt_rerun_cmd "\$want") || return 2
  [ -n "\$cmd" ] || return 2
  mkdir -p "\$LOGD" 2>/dev/null || true
  if command -v timeout >/dev/null 2>&1; then
    timeout -k 15 "\$CAP_EXEMPT_TIMEOUT" bash -c "\$cmd" >>"\$LOGD/cap-exempt.log" 2>&1
  else
    bash -c "\$cmd" >>"\$LOGD/cap-exempt.log" 2>&1
  fi
  rc=\$?
  [ "\$rc" -eq 0 ] && return 0
  return 1
}
# native_runner_missing_cause - did the suite fail to start because the TEST
# RUNNER ITSELF is absent? (QA-TERMINAL-JAIL-9, 2026-09-25.) The harness picks
# native_cmd by repo shape (pytest for pyproject.toml) but cannot guarantee the
# binary exists on the agent: a pyproject repo whose pytest lives in a PEP-735
# dependency-group gets rc=127 'pytest: command not found' from EVERY leg.
# That is the harness's environment gap, not a repo result - the same class as
# build_env_failure/suite_deps_missing: an infra refusal upstream of the suite
# is never a product verdict (terminal-jail 09-23 battery: ci-pass graded FAIL
# on it and chaos cells burned UNVERIFIED rows across 5 ledger cycles).
native_runner_missing_cause() { # <logfile> - print the line proving the runner was absent
  # QA-FOREMAN-2026-09-26: python module-missing form added — a pytest.ini-only
  # repo on a bare agent dies \`/usr/bin/python3: No module named pytest\`, which
  # the command-not-found regex never matched (suite NEVER RAN, must grade
  # UNVERIFIED, not FAIL).
  grep -m1 -E "^(bash: )?(line [0-9]+: )?(pytest|python3?|npm|pnpm|yarn|node|go|cargo|make): (command )?not found|command not found: (pytest|python3?|npm|pnpm|yarn|node|go|cargo|make)|No module named (pytest|nose|unittest2)" "\$1" 2>/dev/null | cut -c1-220
}
native_runner_missing() { # <logfile> - 0 when the log shows the runner never started
  [ -n "\$(native_runner_missing_cause "\$1")" ]
}
# suite_deps_missing — is this suite rc a MISSING-TEST-DEPS refusal instead of a
# product result? (QA-9ROUTER-26, 2026-09-21.) 9router's own \`npm test\` entry
# runs a preflight (scripts/check-test-deps.mjs) that exits 1 with
#   9router: tests/node_modules is missing — vitest cannot be resolved.
# when the independent tests/ package was never installed (tests/package.json
# pins vitest and has its OWN dependency tree). Before the two-step install
# detection (detect_cmds, QA-9ROUTER-26) every repo of that shape hit exactly
# this on a fresh agent, and chaos-disconnect graded the resulting rc=1 as
# OK "fails fast on disconnect" — a FALSE PASS on a suite that NEVER RAN, the
# same class build_incomplete/go_suite_env_failure already handle: an infra
# refusal upstream of the chaos condition is never a product verdict.
suite_deps_missing_cause() { # <logfile> — print the line proving deps were missing
  # FIX (QA-9ROUTER-28 follow-up, 2026-09-22): the old pattern also matched npm's
# own COMMAND-ECHO line ("> node scripts/check-test-deps.mjs && cd tests && ...")
# that npm prints before ANY failure - so EVERY rc=1 npm-suite run graded
# UNVERIFIED "missing test dependencies" and the real failure text never
# reached the verdict. Require a genuine refusal line and exclude the echo.
grep -m1 -E '(tests?/node_modules is missing|vitest cannot be resolved|Cannot find module|npm error)' "\$1" 2>/dev/null | grep -v '^> ' | cut -c1-220
}
suite_deps_missing() { # <logfile> — 0 when the log carries the missing-test-deps signature
  [ -n "\$(suite_deps_missing_cause "\$1")" ]
}
# vacuous_native_suite — did the native leg run ANY suite at all?
# (QA-BUNKER-29, 2026-09-30.) Repos matching no shape fall back to the
# placeholder \`native_cmd="echo no-test-path"\` (detect_cmds): the log holds
# ONLY the echo output, the command exits 0, and BOTH consumers of that
# success — ci-pass ("native suite PASS") and chaos-resource ("suite survives
# 3G memory cap") — graded a suite that NEVER RAN as a product result, six
# ledger cycles in a row. Same class as build_incomplete/suite_deps_missing:
# an infra refusal upstream of the suite is never a product verdict. The log
# is vacuous when it carries the marker itself, or has zero non-whitespace
# content besides the cap-probe lines (PARENT_CAP=/SUBSHELL_CAP=/CAP_EFFECTIVE=)
# that the chaos-resource wrapper adds around the command.
vacuous_native_suite() { # <logfile> -> 0 when the log proves no suite ran
  local f="\$1"
  [ -f "\$f" ] || return 0
  if grep -q 'no-test-path' "\$f"; then return 0; fi
  local rest
  rest=\$(grep -vE '^[[:space:]]*\$|^(PARENT_CAP|SUBSHELL_CAP|CAP_EFFECTIVE)=' "\$f")
  [ -z "\$rest" ]
}
# ep_banner_only — true only when every non-blank line is CLI help text.
ep_banner_only() { # <logfile>
  local logfile="\$1" line seen=no
  [ -s "\$logfile" ] || return 1
  while IFS= read -r line || [ -n "\$line" ]; do
    [ -n "\$(printf '%s' "\$line" | tr -d '[:space:]')" ] || continue
    seen=yes
    if printf '%s\\n' "\$line" | grep -qiE '^[[:space:]]*(usage:|usge:)|^[[:space:]]*-{1,2}[[:alnum:]]|^[[:space:]]{2,}[^[:space:]-].*'; then
      continue
    fi
    case "\$line" in "\$(printf '\\t')"*) continue ;; esac
    return 1
  done < "\$logfile"
  [ "\$seen" = yes ]
}
# corr_grade — pure chaos-corruption decision. The caller owns truncation,
# restart, and restoration; this function only grades the observed evidence.
corr_grade() { # <rc> <logfile> <state_file> <ref_note> <tracked_yes_no> [<verb_ing> [<verb_ed> [<silent_ok_is_fail>]]]
  local rc="\$1" logfile="\$2" state_file="\$3" ref_note="\$4" tracked_yes_no="\$5" crash refusal
  # QA-CRIER-8-R2: optional damage phrasing for non-truncation controls
  # (the chaos-corruption torn-line/malformed-line arms). Defaults keep
  # the *.db path output byte-identical.
  local v_ing="\${6:-truncating}" v_ed="\${7:-truncated}"
  # QA-CRIER-8-R2 rework: the text/append-log caller passes silent_ok_is_fail=yes
  # — rc=0 there means the product STARTED on damaged durable state and accepted
  # it (a silent wrong-success), which grades FAIL. Without the flag (the *.db
  # truncation path) rc=0 keeps its pre-existing OK behavior.
  local silent_ok_is_fail="\${8:-no}"
  if [ "\$tracked_yes_no" != yes ] && printf '%s' "\$ref_note" | grep -qF 'not referenced by any source file'; then
    printf '%s\t%s\n' INFO "candidate \$state_file is untracked and referenced by no source file — not identifiable as a state store; state-restart behavior UNVERIFIED"
  elif grep -qiE 'panic|traceback \\(most recent|segmentation fault|core dumped|fatal error' "\$logfile"; then
    printf '%s\t%s\n' FAIL "crash on the next start after \$v_ing \$state_file (\$ref_note): \$(grep -m1 -iE 'panic|traceback|segmentation fault|core dumped|fatal error' "\$logfile")"
  elif [ "\$rc" -eq 124 ]; then
    printf '%s\\t%s\\n' FAIL "next start HANGS (>20s) after \$v_ing \$state_file (\$ref_note): \$(head -2 "\$logfile" | tr '\\n' ' ')"
  elif ep_banner_only "\$logfile"; then
    printf '%s\\t%s\\n' INFO "probe invoked CLI-help arm; output did not exercise the product: \$(awk 'NF { print; n++; if (n==2) exit }' "\$logfile" | tr '\\n' ' ') — restart behavior UNVERIFIED"
  elif [ "\$rc" -eq 0 ] && [ "\$silent_ok_is_fail" = yes ]; then
    printf '%s\\t%s\\n' FAIL "next start silently accepted damaged state after \$v_ing \$state_file (rc=0, \$ref_note) — corrupted durable state went undetected (silent wrong-success)"
  elif [ "\$rc" -eq 0 ]; then
    printf '%s\\t%s\\n' OK "next start unaffected by a \$v_ed \$state_file (rc=0, \$ref_note) — state restored"
  elif grep -qiE 'corrupt|truncat|checksum|malformed|not a valid|unexpected (EOF|end of)' "\$logfile"; then
    printf '%s\\t%s\\n' OK "clean error on the next start after \$v_ing \$state_file (rc=\$rc, \$ref_note): \$(head -2 "\$logfile" | tr '\\n' ' ')"
  else
    printf '%s\\t%s\\n' INFO "\$v_ed \$state_file (\$ref_note): next start exited rc=\$rc but the log never mentions corruption — restart behavior UNVERIFIED, likely an unrelated failure: \$(head -2 "\$logfile" | tr '\\n' ' ')"
  fi
}
# ep_grade — pure chaos-errorpath decision. probe_started=yes is required for
# a non-zero exit to be a product result; build/toolchain refusals stay INFO.
ep_grade() { # <rc> <logfile> <probe_started_yes_no>
  local rc="\$1" logfile="\$2" probe_started_yes_no="\$3" refusal
  if [ "\$probe_started_yes_no" = na ]; then
    printf '%s\t%s\n' N/A 'no start command was detected'
  elif grep -qiE '^.*panic|traceback \\(most recent|segmentation fault|core dumped' "\$logfile"; then
    printf '%s\t%s\n' FAIL "crash on the missing-config probe: \$(grep -m1 -iE 'panic|traceback|segmentation fault|core dumped' "\$logfile")"
  elif refusal=\$(grep -m1 -iE 'go\\.mod file not found|cannot find main module|no Go files|not a valid module|build constraints exclude|cannot find package|build failed|fatal error' "\$logfile"); [ -n "\$refusal" ]; then
    printf '%s\t%s\n' INFO "start probe did not run the application (refusal: \$refusal) — missing-config behavior UNVERIFIED"
  elif [ "\$rc" -eq 124 ]; then
    printf '%s\t%s\n' INFO "missing-config start probe timed out (rc=124) — error-path behavior UNVERIFIED: \$(head -2 "\$logfile" | tr '\\n' ' ')"
  elif [ "\$probe_started_yes_no" != yes ]; then
    printf '%s\\t%s\\n' INFO "start probe did not run the application (probe_started=\$probe_started_yes_no) — missing-config behavior UNVERIFIED: \$(head -2 "\$logfile" | tr '\\n' ' ')"
  elif ep_banner_only "\$logfile"; then
    printf '%s\\t%s\\n' INFO "probe invoked CLI-help arm; output did not exercise the product: \$(awk 'NF { print; n++; if (n==2) exit }' "\$logfile" | tr '\\n' ' ') — missing-config behavior UNVERIFIED"
  elif [ "\$rc" -gt 0 ]; then
    printf '%s\t%s\n' OK "clean error on missing config (rc=\$rc)"
  else
    printf '%s\t%s\n' INFO "unexpected: application started but exited cleanly on missing config (rc=\$rc)"
  fi
}
# qa_start_in_dir — shared build/run mechanics for start probes.
qa_start_in_dir() { # <bin> <run_dir> <logfile> <build_log> <timeout>
  local bin="\$1" run_dir="\$2" logfile="\$3" build_log="\$4" run_timeout="\$5" rc started=no pkg
  mkdir -p "\$run_dir"
  case "\$bin" in
    "go run "*)
      pkg="\${bin#go run }"
      ( go build -o "\$run_dir/app" "\$pkg" ) >"\$build_log" 2>&1; rc=\$?
      if [ \$rc -eq 0 ] && [ -x "\$run_dir/app" ]; then
        ( cd "\$run_dir" && timeout "\$run_timeout" "\$run_dir/app" ) >"\$logfile" 2>&1
        rc=\$?; started=yes
      else cp "\$build_log" "\$logfile" 2>/dev/null || :; fi
      ;;
    *)
      ( cd "\$run_dir" && timeout "\$run_timeout" \$bin ) >"\$logfile" 2>&1
      rc=\$?
      if [ \$rc -ne 127 ] && ! grep -qiE 'go\\.mod file not found|cannot find main module|no Go files|not a valid module|build constraints exclude|cannot find package|build failed|fatal error|cannot find module|module not found|no such file or directory' "\$logfile"; then started=yes; fi
      ;;
  esac
  printf '%s\\t%s\\n' "\$started" "\$rc"
}
# ep_probe — run the errorpath probe and report whether the application itself ran.
ep_probe() { # <bin> <ep_dir> <logdir> -> <started>\t<rc>
  local bin="\$1" ep_dir="\$2" logdir="\$3" result
  if [ "\$bin" = "npm start" ] && [ -f package.json ]; then
    printf '%s\\n' '{"name":"bunker-ep-probe","scripts":{"start":"node server.js"}}' > "\$ep_dir/package.json"
    printf '%s\\n' 'require("http").createServer((_, res) => res.end("ok")).listen(0)' > "\$ep_dir/server.js"
  fi
  result=\$(qa_start_in_dir "\$bin" "\$ep_dir" "\$logdir/ep.log" "\$logdir/ep-build.log" 15)
  printf '%s\\n' "\$result"
}
cd ~/qa-$proj || { echo "no repo dir"; exit 1; }

# 0 · toolchain bootstrap (2026-08-31): temp agents are BARE — no go/node,
#    no sudo (password required), but the home is writable and the agent
#    has internet. Install the toolchain the repo declares into ~/tools
#    (user-space tarballs) BEFORE the cells, so fresh-install tests the
#    project's own install step on a genuinely fresh system.
mkdir -p ~/tools
# QA-MISCHIEF-003 (2026-10-15): the old gate installed ~/tools/go ONLY when the
# agent had NO go on PATH. An agent with a distro go BELOW the repo's go.mod
# floor (e.g. /usr/bin/go 1.22.2 vs 'go 1.24') kept that go for every leg —
# the upgrade cell's streamed-tree build died 'go1.24: toolchain not
# available' and the agent has no GOTOOLCHAIN=auto net path. New gate: install
# (or refresh) the user-space toolchain whenever ~/tools/go is missing OR its
# version is below the go.mod floor; the unconditional PATH prepend below then
# shadows the distro go for all cells.
# QA-GUARD-005 (2026-10-20): the pinned go1.26.5 tarball sits BELOW current
# go.mod floors already shipping in fleet repos (go 1.26.9), so an
# above-floor repo got a provisioned toolchain that its own go.mod refuses
# — every GOTOOLCHAIN=local leg (chaos-disconnect is offline by design)
# died before a single test. The bootstrap now tracks the FLOOR: resolve the
# newest patch of the requested minor (go.dev/dl/?mode=json), prefer it, and
# fall back when discovery fails.
# DF-CRIER-499 (2026-11-05): the fallback itself was still a hard-coded pin
# (go1.26.5) — BELOW crier's go 1.26.10 floor — so QA-GUARD-005's exact
# failure came back whenever the discovery call failed or the image's distro
# go was simply below floor: measured on bunker-las-03 (2026-11-03 battery),
# the fresh agent provisioned go1.26.5 against go.mod 'go 1.26.10' and the
# offline cut died before a single test with
#   go: go.mod requires go >= 1.26.10 (running go 1.26.5; GOTOOLCHAIN=local)
# Now the install target is DERIVED from go.mod: a discovered version below
# the floor is demoted to the floor version; discovery failure falls back to
# the floor version itself (a full x.y.z floor IS a published release, at or
# above the floor by construction); the legacy pin survives only with no
# usable floor. And the gate no longer trusts PRESENCE: ver_ge is
# patch-padded ("1.26" no longer counts as >= "1.26.10"), the ambient distro
# go is captured BEFORE any install (evidence), and the preflight further
# down judges the first go on PATH with GOTOOLCHAIN=local — the honest
# installed answer — failing THIS bootstrap loudly when it is below floor.
ver_pad3() { # <v> — print v with missing trailing dot-components filled with 0 ("1.26" -> "1.26.0")
  local old=\$IFS
  IFS=.
  set -- \$1
  IFS=\$old
  printf '%s.%s.%s' "\${1:-0}" "\${2:-0}" "\${3:-0}"
}
ver_ge() { # <a> <b> — rc 0 when numeric-dotted version a >= b (patch-padded; malformed -> not >=)
  [ "\$1" = "\$2" ] && return 0
  case "\${1}\${2}" in *[!0-9.]*) return 1 ;; esac
  local a b mn
  a=\$(ver_pad3 "\$1")
  b=\$(ver_pad3 "\$2")
  mn="\$(printf '%s\n%s\n' "\$a" "\$b" | sort -t. -k1,1n -k2,2n -k3,3n | head -1)"
  [ "\$mn" != "\$a" ] || [ "\$mn" = "\$b" ]
}
GO_FLOOR=""
[ -f go.mod ] && GO_FLOOR="\$(sed -n 's/^go \\([0-9][0-9.]*\\).*/\\1/p' go.mod | head -1)"
GO_AMBIENT_PATH=""; GO_AMBIENT_V=""
if command -v go >/dev/null 2>&1; then
  GO_AMBIENT_PATH="\$(command -v go)"
  GO_AMBIENT_V="\$( GOTOOLCHAIN=local "\$GO_AMBIENT_PATH" version 2>/dev/null | sed 's/.*go\\([0-9][0-9.]*\\).*/\\1/' )"
fi
TOOLS_GO_V=""
[ -x ~/tools/go/bin/go ] && TOOLS_GO_V="\$( ~/tools/go/bin/go version 2>/dev/null | sed 's/.*go\\([0-9][0-9.]*\\).*/\\1/' )"
GO_NEED_INSTALL=0
if [ ! -x ~/tools/go/bin/go ]; then
  GO_NEED_INSTALL=1
elif [ -n "\$GO_FLOOR" ] && ! ver_ge "\$TOOLS_GO_V" "\$GO_FLOOR"; then
  GO_NEED_INSTALL=1
fi
if [ "\$GO_NEED_INSTALL" = "1" ]; then
  printf 'go bootstrap: floor=%s ambient(before)=%s at %s tools(before)=%s\n' "\${GO_FLOOR:-none}" "\${GO_AMBIENT_V:-absent}" "\${GO_AMBIENT_PATH:-none}" "\${TOOLS_GO_V:-absent}" >\$LOGD/toolchain-before.log
  GO_BOOT_V="\$(curl -s --max-time 15 'https://go.dev/dl/?mode=json' 2>/dev/null | grep -oE 'go[0-9]+\\.[0-9]+(\\.[0-9]+)?' | head -1 | sed 's/^go//')"
  case "\$GO_BOOT_V" in *[!0-9.]*|"") GO_BOOT_V="" ;; esac
  case "\$GO_BOOT_V" in *.*.*) ;; *) GO_BOOT_V="" ;; esac
  GO_BOOT_SRC=discovered
  if [ -z "\$GO_BOOT_V" ] || { [ -n "\$GO_FLOOR" ] && ! ver_ge "\$GO_BOOT_V" "\$GO_FLOOR"; }; then
    case "\$GO_FLOOR" in
      *.*.*) GO_BOOT_V="\$GO_FLOOR"; GO_BOOT_SRC=floor-derived ;;
      *)     GO_BOOT_V="1.26.5"; GO_BOOT_SRC=legacy-pin ;;
    esac
  fi
  if ( curl -sL -o ~/tools/go.tgz "https://go.dev/dl/go\${GO_BOOT_V}.linux-amd64.tar.gz" && rm -rf ~/tools/go && tar -C ~/tools -xzf ~/tools/go.tgz && rm ~/tools/go.tgz ) >\$LOGD/toolchain.log 2>&1; then
    TOOLS_GO_V="\$( ~/tools/go/bin/go version 2>/dev/null | sed 's/.*go\\([0-9][0-9.]*\\).*/\\1/' )"
    if [ -n "\$GO_FLOOR" ] && ! ver_ge "\$TOOLS_GO_V" "\$GO_FLOOR"; then
      cell toolchain-bootstrap FAIL "installed go\${TOOLS_GO_V:-unknown} (target \$GO_BOOT_V/\$GO_BOOT_SRC) is BELOW the go.mod floor \$GO_FLOOR — the offline cut will refuse: go: go.mod requires go >= \$GO_FLOOR (DF-CRIER-499 preflight)"
    else
      cell toolchain-bootstrap OK "go \$GO_BOOT_V installed (\$GO_BOOT_SRC; ~/tools/go; floor=\${GO_FLOOR:-none} ambient=\${GO_AMBIENT_V:-absent} installed=\${TOOLS_GO_V:-absent})"
    fi
  else
    cell toolchain-bootstrap FAIL "\$(tail -2 \$LOGD/toolchain.log 2>/dev/null) — go \$GO_BOOT_V (\$GO_BOOT_SRC) install failed; floor=\${GO_FLOOR:-none} ambient=\${GO_AMBIENT_V:-absent}"
  fi
fi
if [ -f package.json ] && ! command -v node >/dev/null 2>&1 && [ ! -x ~/tools/node/bin/node ]; then
  ( curl -sL -o ~/tools/node.tar.xz https://nodejs.org/dist/v22.22.3/node-v22.22.3-linux-x64.tar.xz && tar -C ~/tools -xf ~/tools/node.tar.xz && mv ~/tools/node-v22.22.3-linux-x64 ~/tools/node && rm ~/tools/node.tar.xz ) >\$LOGD/toolchain.log 2>&1 \
    && cell toolchain-bootstrap OK "node v22.22.3 installed (~/tools/node)" \
    || cell toolchain-bootstrap FAIL "\$(tail -2 \$LOGD/toolchain.log)"
fi
if [ -f pyproject.toml ] && [ ! -x ~/tools/venv/bin/python ]; then
  # QA-BUNKER-57 (2026-10-04): a fresh JIT agent's ensurepip can fail (broken
  # venv, no sudo to fix it), leaving NO pip in the venv — the old chain then
  # died at the first \`pip install\` and four battery cells cascaded rc=127
  # 'pip: command not found' as FAIL/ENV-BLOCKED with zero signal. Verify pip
  # after venv creation and recover (ensurepip retry, then get-pip.py), logging
  # which path was used to venv.log. If pip is still absent the venv itself is
  # still graded honestly (toolchain-bootstrap FAIL names the ensurepip failure)
  # and every pip-dependent cell grades UNVERIFIED via qa_have_pip below.
  if ( python3 -m venv ~/tools/venv ) >\$LOGD/venv.log 2>&1; then
    if "\$HOME/tools/venv/bin/python3" -m pip --version >>\$LOGD/venv.log 2>&1; then
      echo "pip already present in venv (ensurepip path OK)" >>\$LOGD/venv.log
    elif "\$HOME/tools/venv/bin/python3" -m ensurepip --upgrade >>\$LOGD/venv.log 2>&1; then
      echo "pip recovered via python3 -m ensurepip" >>\$LOGD/venv.log
    elif curl -sS https://bootstrap.pypa.io/get-pip.py | "\$HOME/tools/venv/bin/python3" >>\$LOGD/venv.log 2>&1; then
      echo "pip recovered via bootstrap.pypa.io/get-pip.py" >>\$LOGD/venv.log
    else
      echo "pip recovery FAILED (ensurepip + get-pip.py both failed) — pip-dependent cells will grade UNVERIFIED" >>\$LOGD/venv.log
    fi
    if ( "\$HOME/tools/venv/bin/python3" -m pip install --upgrade pip setuptools wheel && "\$HOME/tools/venv/bin/python3" -m pip install pytest ) >>\$LOGD/venv.log 2>&1; then
      cell toolchain-bootstrap OK "python venv ready + pytest (~/tools/venv)"
    else
      cell toolchain-bootstrap FAIL "\$(tail -2 \$LOGD/venv.log)"
    fi
  else
    cell toolchain-bootstrap FAIL "\$(tail -2 \$LOGD/venv.log)"
  fi
fi
# QA-TERMINAL-JAIL-9 (2026-09-25): the harness's own runner detection picks
# pytest -x -q for every pyproject repo, but a pip install -e . install
# never provisions it when the repo declares pytest in a PEP-735
# dependency-groups dev block (pip ignores those) - the native and chaos
# legs then die rc=127 'pytest: command not found' and carry NO repo signal
# (terminal-jail 09-19 + 09-23 batteries). Best-effort top-up for venvs
# created before this fix or on agents where the fresh install could not
# reach the network: offline agents log a WARN and the native-runner guard
# in the ci-pass cell grades the affected legs UNVERIFIED.
# QA-BUNKER-26 (2026-10-09): detection also selects pytest.ini/conftest.py-only
# repos (QA-FOREMAN-2026-09-26), so the top-up guard must arm for those too —
# a venv created before that fix or offline at venv-build time left such repos
# with no pytest at all and every suite leg died 'No module named pytest'
# (auger chaos-resource UNVERIFIED 2026-09-27).
if { [ -f pyproject.toml ] || [ -f pytest.ini ] || [ -f conftest.py ]; } \
   && [ -x ~/tools/venv/bin/python ] && [ ! -x ~/tools/venv/bin/pytest ]; then
  ( ~/tools/venv/bin/pip install pytest ) >\$LOGD/venv-pytest.log 2>&1 \
    && cell toolchain-bootstrap OK "pytest topped up into ~/tools/venv (QA-TERMINAL-JAIL-9)" \
    || echo "WARN: pytest top-up failed (offline agent?) - native/chaos legs will grade UNVERIFIED 'runner missing': \$(tail -1 \$LOGD/venv-pytest.log 2>/dev/null)" >&2
fi
if [ -f Cargo.toml ] && ! command -v cargo >/dev/null 2>&1 && [ ! -x ~/tools/cargo/bin/cargo ]; then
  ( export CARGO_HOME=~/tools/cargo RUSTUP_HOME=~/tools/rustup; curl -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable --profile minimal --no-modify-path ) >\$LOGD/rustup.log 2>&1 \
    && cell toolchain-bootstrap OK "rust stable installed (~/tools/cargo + ~/tools/rustup)" \
    || cell toolchain-bootstrap FAIL "\$(tail -2 \$LOGD/rustup.log)"
fi
[ -x ~/tools/go/bin/go ] && export PATH="\$HOME/tools/go/bin:\$PATH"
[ -x ~/tools/node/bin/node ] && export PATH="\$HOME/tools/node/bin:\$PATH"
[ -x ~/tools/venv/bin/python ] && export PATH="\$HOME/tools/venv/bin:\$PATH"
[ -x ~/tools/cargo/bin/cargo ] && export CARGO_HOME="\$HOME/tools/cargo" RUSTUP_HOME="\$HOME/tools/rustup" && export PATH="\$HOME/tools/cargo/bin:\$PATH"
# C toolchain (QA-WARPFS-9, 2026-09-19; UNCONDITIONAL since QA-H3-14 v2): a user-space C toolchain serves
# BOTH consumers — rust crate build scripts AND the GNU make bootstrap below — so it now runs for every repo,
# not just Cargo.toml ones. Zig ships a self-contained clang + linker and unpacks into ~/tools with no root;
# if the install cannot be done, cells that need a C compiler grade ENV-BLOCKED via build_env_failure()
# instead of blaming the repo.
  if [ ! -x ~/tools/zig/zig ]; then
    ( cd ~/tools && curl -sL -o zig.tar.xz https://ziglang.org/download/0.15.2/zig-x86_64-linux-0.15.2.tar.xz && tar -xJf zig.tar.xz && rm -f zig.tar.xz && { [ -e zig ] || mv zig-x86_64-linux-0.15.2 zig; } ) >\$LOGD/zig.log 2>&1
  fi
  ZIGB=\$(ls -d ~/tools/zig/zig ~/tools/zig*/zig 2>/dev/null | head -1)
  if [ -n "\$ZIGB" ] && [ -x "\$ZIGB" ]; then
    # MCP-008 (2026-10-03): prefer a real gcc/g++ when present — zig-cc cannot
    # link C++ cgo deps (go-duckdb libduckdb.a needs GNU libstdc++; zig ships
    # libc++ and ld.lld rejects it with undefined std::__cxx11/vtable symbols).
    if command -v g++ >/dev/null 2>&1 && command -v gcc >/dev/null 2>&1; then
      mkdir -p ~/tools/bin
      for zt in cc c++ ld ar ranlib; do
        case "\$zt" in
          cc) printf '#!/bin/sh\nexec gcc "\$@"\n' > ~/tools/bin/cc ;;
          c++) printf '#!/bin/sh\nexec g++ "\$@"\n' > ~/tools/bin/c++ ;;
          *) printf '#!/bin/sh\nexec %s "\$@"\n' "\$(command -v \$zt)" > ~/tools/bin/"\$zt" ;;
        esac
        chmod +x ~/tools/bin/"\$zt"
      done
      export PATH="\$HOME/tools/bin:\$PATH"
      export CC=cc CXX=c++
      cell toolchain-bootstrap OK "system gcc/g++ toolchain (~/tools/bin wrappers -> gcc/g++) — preferred over zig-cc for C++ cgo deps (MCP-008)"
    else
    mkdir -p ~/tools/bin
    for zt in cc c++ ld ar ranlib; do
      case "\$zt" in
        cc|c++)
          # QA-WARPFS-9 rework 2 (2026-09-19): cargo/cc-rs hands the RUST target
          # triple to the C compiler as --target=x86_64-unknown-linux-gnu, and
          # zig's target syntax has NO "-unknown-" vendor segment — it answers
          #   error: unable to parse target query 'x86_64-unknown-linux-gnu':
          #          UnknownOperatingSystem
          # so the ring crate's build script dies before the repo builds at all.
          # Translate the --target VALUE only (drop the vendor segment; gnu and
          # musl both), leaving every other argument byte-identical: rotate the
          # positional params one at a time (shift + append) so no argument is
          # ever re-quoted or word-split. Only the joined "--target=<triple>"
          # spelling is handled, because that is what cc-rs emits for a
          # clang-family compiler (the live argv quoted above is verbatim
          # cc-rs output) — and it is the only spelling that CAN be fixed here:
          # measured against real zig 0.15.2, the split form is rejected at the
          # FLAG level ("error: Unknown Clang option: '--target'"), so rewriting
          # the value alone could not rescue it. A stray "--target=..." with a
          # non-gnu/non-musl target is passed through untouched (the sed only
          # matches the "-unknown-linux-" prefix).
          printf '#!/bin/sh\nn=\$#\ni=0\nwhile [ \$i -lt \$n ]; do\n  a=\$1; shift\n  case "\$a" in\n    --target=*) a=\$(printf "%%s" "\$a" | sed "s/-unknown-linux-/-linux-/") ;;\n  esac\n  set -- "\$@" "\$a"\n  i=\$((i+1))\ndone\nexec "%s" %s "\$@"\n' "\$ZIGB" "\$zt" > ~/tools/bin/"\$zt" ;;
        ld)
          # QA-H3-14 v3 (2026-09-21, battery 23ae94ab): bare agents lack binutils
          # entirely and GNU make's ./configure aborts with "no acceptable ld
          # found in \$PATH" — ld is NOT a zig subcommand, so it cannot ride the
          # plain-forward *) branch. zig serves lld as \`zig ld.lld\`. Live-proven
          # on the kept battery agent: with this wrapper configure passes,
          # build.sh produces GNU Make 4.4.1, and a toy target runs (TOY_OK).
          printf '#!/bin/sh\nexec "%s" ld.lld "\$@"\n' "\$ZIGB" > ~/tools/bin/"\$zt" ;;
        *)
          # ar/ranlib take no target triple — forwarded verbatim as before.
          printf '#!/bin/sh\nexec "%s" %s "\$@"\n' "\$ZIGB" "\$zt" > ~/tools/bin/"\$zt" ;;
      esac
      chmod +x ~/tools/bin/"\$zt"
    done
    export PATH="\$HOME/tools/bin:\$PATH"
    export CC=cc CXX=c++
    cell toolchain-bootstrap OK "zig 0.15.2 C toolchain installed (~/tools/bin: cc/c++/ld/ar/ranlib wrappers -> ~/tools/zig/zig) — C toolchain for make bootstrap + rust build scripts (EXPERIMENTAL for C++ cgo deps — see MCP-008)"
    fi
  else
    export RUST_NO_CC=1
    cell toolchain-bootstrap INFO "no C toolchain on agent (no sudo) and zig install failed - C-toolchain-dependent cells (make bootstrap, rust build scripts) grade ENV-BLOCKED (\$(tail -2 \$LOGD/zig.log))"
  fi
# QA-H3-14 v2 (2026-09-21, tick h3-2026-09-21-11-07-15): battery 8ff078b2 re-run FALSIFIED v1 — the make
# bootstrap ran BEFORE the zig C-toolchain leg and defaulted CC=\${CC:-cc}; on an agent with NEITHER make NOR cc
# configure died instantly and make.log stayed EMPTY (silent). v2: the zig leg moves ABOVE the make bootstrap
# and becomes UNCONDITIONAL (a user-space C toolchain serves make configure AND rust build scripts; re-verified
# locally with cc masked: zig 0.15.2 bootstraps, make 4.4.1 builds a toy target). The make subshell drops its
# CC=\${CC:-cc} default — CC arrives from the zig export or the cell grades ENV-BLOCKED with the real cause.
# v3 (same tick, battery 23ae94ab kept-agent autopsy): configure failed on bare agents with "no acceptable ld
# found in \$PATH" (no binutils) — the zig loop now also emits an ld wrapper (zig ld.lld), and configure/build.sh
# output is captured into make.log (the inner >/dev/null redirects made every failure an EMPTY, undiagnosable log).
# v4 (same tick, battery 7561ba71): configure then died on "Something went wrong bootstrapping makefile fragments
# for automatic dependency tracking" — configure wants an already-working make; the make-4.4.1 bootstrap DOES NOT
# need one (build.sh is self-contained, proven locally: make built + toy target OK). So: --disable-dependency-tracking
# plus an exit-code-tolerant configure so build.sh always runs, with configure's rc echoed into make.log.
MAKE_BIN=""
if ! command -v make >/dev/null 2>&1; then
  if [ ! -x ~/tools/make/bin/make ]; then
    mkdir -p ~/tools/make/build
    ( cd ~/tools/make/build && curl -sL -o make.tar.gz '$MAKE_URL' && tar -xzf make.tar.gz && cd make-4.4.1 && { bash ./configure --disable-nls --disable-dependency-tracking || echo "configure rc=\$? — GNU make has no make yet to bootstrap its dependency-tracking fragments; build.sh below does the real bootstrap"; } && bash ./build.sh && mkdir -p ~/tools/make/bin && cp make ~/tools/make/bin/make ) >\$LOGD/make.log 2>&1
  fi
  if [ -x ~/tools/make/bin/make ]; then
    export PATH="\$HOME/tools/make/bin:\$PATH"
    MAKE_BIN=~/tools/make/bin/make
  fi
fi
if command -v make >/dev/null 2>&1; then
  cell toolchain-bootstrap OK "make available (\${MAKE_BIN:+bootstrapped GNU make}\${MAKE_BIN:-preinstalled}) — \$(make --version 2>/dev/null | head -1)"
elif [ -f Makefile ]; then
  cell toolchain-bootstrap INFO "no make on agent and user-space bootstrap failed — make-based cells will grade ENV-BLOCKED (\$(tail -2 \$LOGD/make.log 2>/dev/null | tr '\n' ' '))"
fi
# ─── QA-ASCE-11 (2026-11-25): golangci-lint bootstrap for the declared lint gate ──
# The mandatory lint cell selects \`make lint\` for repos whose Makefile declares
# a lint target, and many such targets invoke golangci-lint directly. A fresh
# JIT agent ships neither golangci-lint nor a way to get it, so the cell died
#   make: golangci-lint: No such file or directory
# and graded the REPO FAIL on an environment gap (the declared-skip classifier
# qa_lint_skipped_declared_golangci keyed on the Makefile's own "not installed,
# skipping" echo — the make-level missing-binary shape slipped past it).
# Provision the pinned binary BEFORE the cells, only when the repo actually
# declares a golangci gate (.golangci.yml/.yaml present, a Makefile lint target
# invoking golangci-lint, or a workflow referencing golangci/golangci-lint):
# the version pins the QA CI image (golangci/golangci-lint:v2.12.2-alpine),
# and a repo that never mentions golangci pays nothing. A failed install
# grades the bootstrap cell FAIL with the env-gap detail and leaves the lint
# cell to grade UNVERIFIED via the classifier — env gap, never a repo defect.
QA_GOLANGCI_V="2.12.2"
qa_declares_golangci_gate() { # 0 = the repo under test declares a golangci lint gate
  if [ -f .golangci.yml ] || [ -f .golangci.yaml ]; then return 0; fi
  if [ -f Makefile ] && grep -qE '^lint:' Makefile 2>/dev/null && grep -q 'golangci-lint' Makefile 2>/dev/null; then return 0; fi
  if find .github/workflows -maxdepth 1 -type f -exec grep -lE 'golangci-lint|golangci/golangci-lint-action' {} + 2>/dev/null | grep -q .; then return 0; fi
  return 1
}
if qa_declares_golangci_gate && ! command -v golangci-lint >/dev/null 2>&1; then
  mkdir -p ~/tools/bin
  if [ -x ~/tools/bin/golangci-lint ]; then
    export PATH="\$HOME/tools/bin:\$PATH"
    cell toolchain-bootstrap INFO "golangci-lint v\${QA_GOLANGCI_V} reused from an earlier battery (~/tools/bin; QA-ASCE-11)"
  elif ( curl -sL -o ~/tools/golangci-lint.tar.gz "https://github.com/golangci/golangci-lint/releases/download/v\${QA_GOLANGCI_V}/golangci-lint-\${QA_GOLANGCI_V}-linux-amd64.tar.gz" && tar -C ~/tools -xzf ~/tools/golangci-lint.tar.gz && mv ~/tools/golangci-lint-\${QA_GOLANGCI_V}-linux-amd64/golangci-lint ~/tools/bin/golangci-lint && rm -rf ~/tools/golangci-lint.tar.gz ~/tools/golangci-lint-\${QA_GOLANGCI_V}-linux-amd64 && chmod +x ~/tools/bin/golangci-lint ) >\$LOGD/golangci.log 2>&1; then
    export PATH="\$HOME/tools/bin:\$PATH"
    cell toolchain-bootstrap OK "golangci-lint v\${QA_GOLANGCI_V} installed (~/tools/bin; CI image pin golangci/golangci-lint:v\${QA_GOLANGCI_V}-alpine) — the declared lint gate runs the real binary (QA-ASCE-11)"
  else
    cell toolchain-bootstrap FAIL "golangci-lint v\${QA_GOLANGCI_V} install failed (agent env gap, not a repo defect) — declared lint gate grades UNVERIFIED: \$(tail -2 \$LOGD/golangci.log 2>/dev/null)"
  fi
fi
# ─── QA-MUSTER-13-R2 (2026-11-21): native build prerequisites for trees that
# link libseccomp ────────────────────────────────────────────────────────────
# WHY: the fresh-install and upgrade cells compile the repo's cgo dependency
# github.com/seccomp/libseccomp-golang (its cgo line is \`pkg-config: libseccomp\`).
# A clean JIT agent ships NO libseccomp development files, so those builds died on
# a HARNESS-ENV gap and graded the repo FAIL:
#   upgrade FAIL "previous release v0.1.0 would not build (streamed tree):
#     ... exec: \"pkg-config\": executable file not found in \$PATH"
#   upgrade FAIL "... Package libseccomp was not found in the pkg-config search path"
# (muster QA-MUSTER-13 + this recurrence; controller repro: with pkg-config and
# libseccomp.pc present the SAME streamed tree builds rc=0, so the whole mechanism
# is battery-side provisioning and no product file changes). Provision BEFORE any
# build cell — and derive the need from the trees about to be built (this tree's
# go.mod/go.sum and the host-streamed previous-release tree), so a repo that does
# not link libseccomp pays nothing and installs nothing:
#   1 already present   -> one INFO line, no install attempt (idempotent)
#   2 root              -> distro package manager installs pkg-config + libseccomp-dev
#   3 no root (agents)  -> user-space sysroot in ~/tools/sysroot: \`apt-get download\`
#                          or \`apk fetch\` unprivileged, \`dpkg-deb -x\`/\`tar\` extract,
#                          rewrite each .pc prefix onto the sysroot, export
#                          PKG_CONFIG_PATH/CGO_CFLAGS/CGO_LDFLAGS/LIBRARY_PATH so
#                          pkg-config AND the C linker resolve the library there.
#                          A sysroot left by an earlier battery on a kept agent is
#                          reused instead of re-downloaded.
#   4 cannot provision  -> QA_NATIVE_SYSDEPS_BLOCKED=<reason>, and the build cells
#                          grade ENV-BLOCKED naming it instead of grading the repo
#                          FAIL on a prerequisite the agent never had.
QA_NATIVE_SYSDEPS_BLOCKED=""
qa_needs_seccomp_dev() { # 0 = a tree we are about to build links libseccomp
  local f
  for f in go.mod go.sum "\$HOME/qa-up-prev/go.mod" "\$HOME/qa-up-prev/go.sum"; do
    [ -f "\$f" ] && grep -qi 'libseccomp' "\$f" 2>/dev/null && return 0
  done
  return 1
}
qa_seccomp_dev_ready() { # 0 = pkg-config answers for libseccomp
  command -v pkg-config >/dev/null 2>&1 || return 1
  pkg-config --exists libseccomp >/dev/null 2>&1
}
qa_native_prereq_failure() { # <log> — 0 = log carries a native-prereq signature
  grep -qiE 'exec: "pkg-config"|pkg-config: (executable file )?not found|pkg-config search path|Package libseccomp was not found|seccomp\.h: (No such file|not found)|fatal error: seccomp\.h' "\$1" 2>/dev/null
}
qa_seccomp_sysroot_export() { # <sysroot> — export the sysroot into pkg-config + cgo
  local sr="\$1" pcdir libdir
  pcdir="\$(find "\$sr" -name 'libseccomp.pc' -exec dirname {} \; 2>/dev/null | head -1)"
  libdir="\$(find "\$sr" -name 'libseccomp.so' -exec dirname {} \; 2>/dev/null | head -1)"
  [ -z "\$libdir" ] && libdir="\$(find "\$sr" -name 'libseccomp.so.*' -exec dirname {} \; 2>/dev/null | head -1)"
  [ -n "\$pcdir" ] && export PKG_CONFIG_PATH="\$pcdir\${PKG_CONFIG_PATH:+:\$PKG_CONFIG_PATH}"
  [ -n "\$libdir" ] && export LIBRARY_PATH="\$libdir\${LIBRARY_PATH:+:\$LIBRARY_PATH}"
  [ -n "\$libdir" ] && export LD_LIBRARY_PATH="\$libdir\${LD_LIBRARY_PATH:+:\$LD_LIBRARY_PATH}"
  [ -d "\$sr/usr/include" ] && export CGO_CFLAGS="\${CGO_CFLAGS:-} -I\$sr/usr/include"
  [ -n "\$libdir" ] && export CGO_LDFLAGS="\${CGO_LDFLAGS:-} -L\$libdir"
  return 0
}
if qa_needs_seccomp_dev; then
  if qa_seccomp_dev_ready; then
    cell toolchain-bootstrap INFO "native build prereq already present: pkg-config + libseccomp.pc \$(pkg-config --modversion libseccomp 2>/dev/null) — nothing installed (QA-MUSTER-13-R2)"
  else
    QA_SYSROOT="\$HOME/tools/sysroot"
    QA_PM=""
    for qa_c in apt-get dnf yum apk; do command -v "\$qa_c" >/dev/null 2>&1 && { QA_PM="\$qa_c"; break; }; done
    mkdir -p "\$LOGD" 2>/dev/null || true
    [ -f "\$LOGD/native-sysdeps.log" ] || : >"\$LOGD/native-sysdeps.log" 2>/dev/null || true
    if [ "\$(id -u)" = "0" ] && [ -n "\$QA_PM" ]; then
      case "\$QA_PM" in
        apt-get) apt-get install -y --no-install-recommends pkg-config libseccomp-dev >>"\$LOGD/native-sysdeps.log" 2>&1 || true ;;
        dnf|yum) "\$QA_PM" install -y pkgconf-pkg-config libseccomp-devel >>"\$LOGD/native-sysdeps.log" 2>&1 || true ;;
        apk) apk add --no-cache pkgconf libseccomp-dev >>"\$LOGD/native-sysdeps.log" 2>&1 || true ;;
      esac
    fi
    if ! qa_seccomp_dev_ready; then
      # No sudo on bunker agents (\`sudo -n\` is password-gated), and apt-get download
      # needs no privilege off the image's own apt lists.
      mkdir -p "\$QA_SYSROOT" "\$HOME/tools/bin" 2>/dev/null || true
      qa_reused=""
      if [ -n "\$(find "\$QA_SYSROOT" -name 'libseccomp.pc' 2>/dev/null | head -1)" ]; then
        qa_reused="reused sysroot from an earlier battery"
      else
        qa_dl="\$(mktemp -d "\$HOME/tools/native-dl.XXXXXX" 2>/dev/null || true)"
        if [ -n "\$qa_dl" ]; then
          if [ "\$QA_PM" = "apt-get" ] && command -v dpkg-deb >/dev/null 2>&1; then
            for qa_pkg in libseccomp-dev libseccomp2 pkgconf-bin pkgconf pkg-config; do
              ( cd "\$qa_dl" && apt-get download "\$qa_pkg" ) >>"\$LOGD/native-sysdeps.log" 2>&1 || true
            done
            for qa_deb in "\$qa_dl"/*.deb; do
              [ -f "\$qa_deb" ] && { dpkg-deb -x "\$qa_deb" "\$QA_SYSROOT" >>"\$LOGD/native-sysdeps.log" 2>&1 || true; }
            done
          elif [ "\$QA_PM" = "apk" ]; then
            for qa_pkg in libseccomp-dev libseccomp pkgconf; do
              ( cd "\$qa_dl" && apk fetch --allow-untrusted -o . "\$qa_pkg" ) >>"\$LOGD/native-sysdeps.log" 2>&1 || true
            done
            for qa_apk in "\$qa_dl"/*.apk; do
              [ -f "\$qa_apk" ] && { tar -xzf "\$qa_apk" -C "\$QA_SYSROOT" >>"\$LOGD/native-sysdeps.log" 2>&1 || true; }
            done
          fi
          # Distro .pc files hard-code prefix=/usr, which points the compiler at the
          # agent's REAL /usr (no dev files there) — relocate each onto the sysroot.
          find "\$QA_SYSROOT" -name '*.pc' -print 2>/dev/null | while IFS= read -r qa_pc; do
            sed -i "s|^prefix=.*|prefix=\$QA_SYSROOT/usr|" "\$qa_pc" 2>/dev/null || true
          done
          qa_seccomp_sysroot_export "\$QA_SYSROOT"
          # The thinnest agents have no pkg-config at all: expose the extracted
          # pkgconf under that name on the qa bin dir.
          if ! command -v pkg-config >/dev/null 2>&1; then
            for qa_pcbin in "\$QA_SYSROOT/usr/bin/pkg-config" "\$QA_SYSROOT/usr/bin/pkgconf"; do
              [ -x "\$qa_pcbin" ] && { ln -sf "\$qa_pcbin" "\$HOME/tools/bin/pkg-config" 2>/dev/null || true; break; }
            done
            command -v pkg-config >/dev/null 2>&1 || export PATH="\$HOME/tools/bin:\$PATH"
          fi
        fi
      fi
      qa_seccomp_sysroot_export "\$QA_SYSROOT"
      if [ -n "\$qa_reused" ]; then
        cell toolchain-bootstrap INFO "\$qa_reused: pkg-config + libseccomp.pc from \$QA_SYSROOT (no download needed) — QA-MUSTER-13-R2"
      fi
    fi
    if qa_seccomp_dev_ready; then
      cell toolchain-bootstrap OK "native build prereq provisioned for libseccomp-linked trees: pkg-config=\$(command -v pkg-config), libseccomp \$(pkg-config --modversion libseccomp 2>/dev/null) from user-space sysroot \$QA_SYSROOT (no sudo) — QA-MUSTER-13-R2"
    else
      QA_NATIVE_SYSDEPS_BLOCKED="pkg-config/libseccomp-dev unavailable on this agent (pm=\${QA_PM:-none}, uid=\$(id -u), sysroot=\$QA_SYSROOT) — see \$LOGD/native-sysdeps.log"
      cell toolchain-bootstrap INFO "ENV-BLOCKED: \$QA_NATIVE_SYSDEPS_BLOCKED — libseccomp-linked trees cannot compile here; build cells grade ENV-BLOCKED instead of FAIL"
    fi
  fi
fi
# ─── QA-MUSTER-13-R2 (2026-11-21): honor the toolchain the module documents when
# the agent's newest go refuses a PREBUILT archive ─────────────────────────────
# WHY: go1.26.11/1.27.4+ implement the CVE-2026-97038 cgo hardening — the go
# command scans the -L dirs of #cgo LDFLAGS and rejects archives carrying LTO
# bitcode (isDisallowedLTOSection / .llvmbc in cmd/go/internal/work/security.go).
# muster v0.1.0 vendors wasmtime-go v8's prebuilt libwasmtime.a, which carries
# .llvmbc, so on a newest-go agent the streamed previous tree died with
#   github.com/bytecodealliance/wasmtime-go/v8: disallowed LTO section ".llvmbc"
#   in #cgo LDFLAGS: .../libwasmtime.a
# even with libseccomp.pc provisioned — a second missing native-build
# prerequisite, and NOT a repo defect (the module documents its own floor:
# \`go 1.26.1\`, a toolchain that predates the check). The agent's newest-go
# selection is QA-MUSTER-051's business and is untouched here; this is a single,
# bounded retry that fires ONLY on that exact signature, uses the toolchain the
# module documents, and writes both attempts into the same cell log.
QA_TOOLCHAIN_FALLBACK=""
qa_go_module_floor() { # <dir> -> the \`go\` directive of that dir's go.mod
  sed -n 's/^go[[:space:]]\{1,\}\([0-9][0-9.]*\).*/\1/p' "\$1/go.mod" 2>/dev/null | head -1
}
qa_toolchain_lto_rejection() { # <log> — 0 = the go command refused a prebuilt LTO archive
  grep -qiE 'disallowed LTO (section|segment)|disallowed LLVM LTO section' "\$1" 2>/dev/null
}
qa_retry_with_documented_go() { # <log> <dir> <cmd> [timeout-s] — one bounded retry
  local log="\$1" dir="\$2" cmd="\$3" tmo="\${4:-}" floor gov rc
  floor="\$(qa_go_module_floor "\$dir")"
  [ -n "\$floor" ] || return 1
  gov="\$(go version 2>/dev/null | sed 's/^go version go\([^ ]*\).*/\1/')"
  {
    printf '\n=== QA-MUSTER-13-R2: this agent go (%s) rejects a prebuilt archive that carries LLVM bitcode (CVE-2026-97038 cgo LTO check) — not a repo defect.\n' "\${gov:-unknown}"
    printf '=== retrying ONCE with the toolchain the module documents (go.mod: go %s) via GOTOOLCHAIN=go%s\n' "\$floor" "\$floor"
  } >> "\$log"
  if [ -n "\$tmo" ]; then
    ( cd "\$dir" && GOTOOLCHAIN="go\$floor" timeout "\$tmo" bash -c "\$cmd" ) >> "\$log" 2>&1
  else
    ( cd "\$dir" && GOTOOLCHAIN="go\$floor" bash -c "\$cmd" ) >> "\$log" 2>&1
  fi
  rc=\$?
  printf 'TOOLCHAIN-FALLBACK GOTOOLCHAIN=go%s rc=%s\n' "\$floor" "\$rc" >> "\$log"
  [ "\$rc" -eq 0 ] && QA_TOOLCHAIN_FALLBACK="go\$floor"
  return "\$rc"
}
# QA-CODING-HERMES-TOOLS-6 (2026-10-24): jq is a hard prerequisite of the
# target repos' own documented batteries (README "jq without root", Makefile
# verify jq guard, probe scripts asserting through jq -e), but the bootstrap
# below provisioned go/make/gcc/node and NOT jq — so on a fresh agent every
# probe leg died "jq: command not found" (bash 127) and ci-pass graded a bare
# native rc=1 with seven red tests that are green on a box with jq (agent
# 1d4fd817/bunker-mvp, 2026-10-23). Install a STATIC jq user-space (no sudo)
# when none is on PATH, into the existing ~/tools/bin qa bin dir. QA_JQ_PATH
# feeds the ci-pass cell's detail so a jq-less red is attributable at the cell.
# NOTE: the curl carries -L on purpose — releases/latest/download is a 302
# redirect and -o WITHOUT -L writes the empty redirect body rc=0, which then
# passes [ -x ] as a 0-byte "jq" (false-OK install). The OK grade requires a
# real --version string from the binary itself, never mere file presence.
export QA_JQ_PATH=""
if ! command -v jq >/dev/null 2>&1; then
  if ! { [ -x ~/tools/bin/jq ] && [ -n "\$( ~/tools/bin/jq --version 2>/dev/null | head -1 )" ]; }; then
    mkdir -p ~/tools/bin
    ( curl -fsSLo ~/tools/bin/jq https://github.com/stedolan/jq/releases/latest/download/jq-linux64 && chmod +x ~/tools/bin/jq ) >\$LOGD/jq.log 2>&1
  fi
  JQV="\$( ~/tools/bin/jq --version 2>/dev/null | head -1 )"
  if [ -n "\$JQV" ]; then
    export PATH="\$HOME/tools/bin:\$PATH"
    export QA_JQ_PATH="\$HOME/tools/bin/jq"
    cell toolchain-bootstrap OK "jq installed (static jq-linux64 -> \$JQV at \$QA_JQ_PATH)"
  else
    cell toolchain-bootstrap FAIL "\$(tail -2 \$LOGD/jq.log 2>/dev/null) — jq absent and static install failed; probe legs will die jq: command not found (QA-CODING-HERMES-TOOLS-6)"
  fi
else
  export QA_JQ_PATH="\$(command -v jq)"
  cell toolchain-bootstrap OK "jq present (\$QA_JQ_PATH)"
fi
# FIX 1 · system-dep probe (QA-WARPFS-9 rework 3, 2026-09-19): the zig leg above
# supplies a C toolchain, but a rust repo ALSO links against system libraries
# whose DEVELOPMENT files ship in separate packages — and nothing in user space
# substitutes for a missing system package. Observed live on the round-2 agent
# (bare Debian 13, no sudo) once the ring/zig failure was fixed, the build died
# at the next crate that needs headers:
#   error: failed to run custom build command for \`openssl-sys v0.9.117\`
#   Could not find directory of OpenSSL installation ...
#   Make sure you also have the development packages of openssl installed.
# (openssl reaches this repo through git2; hilo-fuse needs libfuse3-dev; both are
# README-documented.) Measured on that agent: make=NO perl=yes pkg-config=NO
# cc=NO gcc=NO. A fully bare agent therefore CANNOT build this class of project,
# so the harness STOPS CHASING and REPORTS: probe the known-required deps, export
# the missing ones, and grade the cells that die on them ENV-BLOCKED with the
# precise list (build_sys_dep_failure() + the fresh-install branch below). This
# list is CONTEXT, never a verdict on its own — the ENV-BLOCKED grade still needs
# an actual *-sys build failure in the log (fuser probes fuse3 first and happily
# falls back to libfuse2, so a missing fuse3 alone proves nothing broke).
RUST_MISSING_SYS_DEPS=""
if [ -f Cargo.toml ]; then
  for sd in make pkg-config; do
    command -v "\$sd" >/dev/null 2>&1 || RUST_MISSING_SYS_DEPS="\${RUST_MISSING_SYS_DEPS:+\$RUST_MISSING_SYS_DEPS }\$sd"
  done
  # openssl/fuse3 are only observable THROUGH pkg-config, so probe them only when
  # the tool itself is present — otherwise the list already says pkg-config, and a
  # missing probe tool must not be reported as a missing library.
  if command -v pkg-config >/dev/null 2>&1; then
    pkg-config --exists openssl >/dev/null 2>&1 || RUST_MISSING_SYS_DEPS="\${RUST_MISSING_SYS_DEPS:+\$RUST_MISSING_SYS_DEPS }openssl(libssl-dev)"
    pkg-config --exists fuse3 >/dev/null 2>&1 || RUST_MISSING_SYS_DEPS="\${RUST_MISSING_SYS_DEPS:+\$RUST_MISSING_SYS_DEPS }fuse3(libfuse3-dev)"
  fi
  if [ -n "\$RUST_MISSING_SYS_DEPS" ]; then
    cell toolchain-bootstrap INFO "bare agent missing system deps: \$RUST_MISSING_SYS_DEPS — rust build cells graded ENV-BLOCKED when they fail on these (no sudo to apt install)"
  fi
fi
export RUST_MISSING_SYS_DEPS
# DF-CRIER-499 preflight (2026-11-05): judge the toolchain the legs will
# ACTUALLY run — the first go on PATH after bootstrap, probed with
# GOTOOLCHAIN=local (under auto, 'go version' can report a toolchain Go just
# downloaded, masking the shortfall) — never mere presence. A bootstrap that
# leaves a below-floor or absent go first on PATH fails HERE, naming the
# floor, the found version and the exact refusal the offline legs would hit,
# instead of leaving chaos-disconnect to discover it (and grade UNVERIFIED).
GO_EFFECTIVE_PATH=""; GO_EFFECTIVE_V=""
if command -v go >/dev/null 2>&1; then
  GO_EFFECTIVE_PATH="\$(command -v go)"
  GO_EFFECTIVE_V="\$( GOTOOLCHAIN=local "\$GO_EFFECTIVE_PATH" version 2>/dev/null | sed 's/.*go\\([0-9][0-9.]*\\).*/\\1/' )"
fi
if [ -f go.mod ]; then
  if [ -z "\$GO_EFFECTIVE_V" ]; then
    cell toolchain-bootstrap FAIL "no runnable go first on PATH after bootstrap (ambient(before)=\${GO_AMBIENT_V:-absent} at \${GO_AMBIENT_PATH:-none}; ~/tools/go=\${TOOLS_GO_V:-absent}) and go.mod declares floor \${GO_FLOOR:-unknown} — go legs die 127 and GOTOOLCHAIN=local legs cannot download a toolchain (DF-CRIER-499 preflight)"
  elif [ -n "\$GO_FLOOR" ] && ! ver_ge "\$GO_EFFECTIVE_V" "\$GO_FLOOR"; then
    cell toolchain-bootstrap FAIL "go \$GO_EFFECTIVE_V first on PATH (\$GO_EFFECTIVE_PATH) is BELOW the go.mod floor \$GO_FLOOR — offline legs will refuse: go: go.mod requires go >= \$GO_FLOOR (running go \$GO_EFFECTIVE_V; GOTOOLCHAIN=local) (DF-CRIER-499 preflight)"
  elif command -v node >/dev/null 2>&1; then
    cell toolchain-bootstrap OK "go+node ready (go \$GO_EFFECTIVE_V at \$GO_EFFECTIVE_PATH, probed GOTOOLCHAIN=local; floor=\${GO_FLOOR:-none} ambient(before)=\${GO_AMBIENT_V:-absent})"
  fi
else
  command -v go >/dev/null 2>&1 && command -v node >/dev/null 2>&1 && cell toolchain-bootstrap OK "go+node ready"
fi

# QA-BUNKER-078 (2026-10-30): the fresh-install artifact expectation is DERIVED
# from the install leg, never from a literal tool name.  Three couplings to
# toolsd survived QA-BUNKER-81: a toolsd-named install command forced the
# requirement, a PRE-EXISTING toolsd in PATH satisfied it (so a leg that
# installed nothing passed), and artifact_check read the install command from
# a shell variable this generated script never defines — it was empty,
# artifact_required was always 0, and the check could not fire at all.
# Now: the generator bakes ARTIFACT_EXPECT/ARTIFACT_CMD (see
# artifact_expectation), the scan also covers GOPATH/bin and the repo-local
# ./bin a Makefile build writes to, and QA_EXPECTED_ARTIFACT=<name> opts a repo
# into a named-artifact assertion.  A compile/dependency-install leg grades OK
# with a NAMED "no artifact expected" reason instead of failing on a binary it
# never promised — the acceptance shape is a Go repo (cmd/ = bunker, bunkerd,
# docs-drift) whose install is 'go build ./...'.
install_artifact_dirs() {
  local p gobin
  IFS=: read -r -a install_path_dirs <<< "\$PATH"
  gobin=""
  command -v go >/dev/null 2>&1 && gobin="\$(go env GOPATH 2>/dev/null)/bin"
  for p in "\${install_path_dirs[@]}" "\$HOME/bin" "\$HOME/.local/bin" "\$gobin" "\$PWD/bin"; do
    [ -n "\$p" ] || continue
    [ -d "\$p" ] || continue
    # Every PATH/bin directory is eligible: the before snapshot excludes the
    # harness' pre-existing tools, while a newly placed executable anywhere in
    # PATH — or in GOPATH/bin, or in the repo's own ./bin — is the install
    # leg's artifact regardless of its name or prefix.
    printf '%s\\n' "\$p"
  done | sort -u
}
install_artifact_snapshot() {
  local p
  while IFS= read -r p; do
    find "\$p" -maxdepth 1 -type f -perm -u+x -print 2>/dev/null
  done < <(install_artifact_dirs)
}
artifact_check() { # <before-snapshot> <after-snapshot> <log>
  local before="\$1" after="\$2" log="\$3"
  local install_artifacts expect expected_artifact
  # LC_ALL=C on BOTH snapshots: comm(1) only reports correctly when the two
  # inputs share a collation, and a UTF-8 agent locale silently produced
  # "not in sorted order" here.
  install_artifact_snapshot | LC_ALL=C sort -u > "\$after"
  install_artifacts="\$(comm -13 "\$before" "\$after" | tr '\\n' ' ' | sed 's/[[:space:]]*\$//' )"
  # A runtime QA_EXPECTED_ARTIFACT (agent-side override) wins over the
  # generator's derivation so an operator can assert a named binary without
  # editing the harness.
  expect="\$ARTIFACT_EXPECT"
  [ -n "\${QA_EXPECTED_ARTIFACT:-}" ] && expect="name:\$QA_EXPECTED_ARTIFACT"
  case "\$expect" in
    name:*)
      expected_artifact="\${expect#name:}"
      if printf '%s\\n' "\$install_artifacts" | tr ' ' '\\n' | sed 's#.*/##' | grep -qx "\$expected_artifact"; then
        cell fresh-install OK "\$(tail -1 "\$log"); artifact: \$expected_artifact (QA_EXPECTED_ARTIFACT asserted, installed by this leg)"
      else
        cell fresh-install FAIL "rc=1: install rc=0 but no artifact found — QA_EXPECTED_ARTIFACT=\$expected_artifact was not installed into PATH/bin, \$HOME/bin, \$HOME/.local/bin, GOPATH/bin or ./bin"
      fi ;;
    binary)
      if [ -n "\$install_artifacts" ]; then
        cell fresh-install OK "\$(tail -1 "\$log"); artifact(s): \$install_artifacts"
      else
        cell fresh-install FAIL "rc=1: install rc=0 but no artifact found — the install leg [\$ARTIFACT_CMD] is a packaging build/install and must leave a NEW executable in PATH/bin, \$HOME/bin, \$HOME/.local/bin, GOPATH/bin or ./bin (set QA_EXPECTED_ARTIFACT=<name> to assert one by name)"
      fi ;;
    *)
      cell fresh-install OK "\$(tail -1 "\$log"); no artifact expected for [\$ARTIFACT_CMD] — a compile/dependency-install leg ships code, not binaries (set QA_EXPECTED_ARTIFACT=<name> to assert one)\${install_artifacts:+; artifact(s): \$install_artifacts}"
      ;;
  esac
}
INSTALL_ARTIFACT_BEFORE="\$LOGD/install-artifacts.before"
INSTALL_ARTIFACT_AFTER="\$LOGD/install-artifacts.after"
install_artifact_snapshot | LC_ALL=C sort -u > "\$INSTALL_ARTIFACT_BEFORE"

# 1 · fresh-install — REAL rc through a log file
# QA-BUNKER-57 (2026-10-04): a pyproject repo's DETECT_INSTALL is pip; on an
# agent where ensurepip failed there is no pip at all and the leg would die
# rc=127 as a false repo FAIL. Grade UNVERIFIED before running anything.
# (QA_ECOSYSTEM is only assigned later, in the upgrade block — test the
# ecosystem here the same way the installer is picked, from $install_cmd.)
if printf '%s' "$install_cmd" | grep -q pip && ! qa_have_pip; then
  cell fresh-install UNVERIFIED "pip absent on agent (ensurepip failed; no sudo) — the install step was never run, so the repo is untested by this cell"
else
# QA-BUNKER-60 (2026-10-07): the install leg is bounded by a host-tunable
# ceiling (BUNKER_QA_INSTALL_TIMEOUT_S, default 3600) instead of running
# unbounded — a heavy workspace (wasmtime + arrow + tree-sitter C parsers) on
# the 2-CPU default slice measured 2h+ on fresh-install, so the battery TTL
# expired before later cells could write and the run was salvaged UNVERIFIED.
# rc=124 grades SKIP (UNVERIFIED upstream), never OK/FAIL: a timeout is a
# slice/window outcome, not a repo verdict. bash -c (not a bare eval) keeps the
# compound installer a single killable child; the agent has bash by definition
# (qa-run.sh itself runs under it), and coreutils timeout is already a
# dependency of the chaos cells below.
INST_TIMEOUT_S="\${BUNKER_QA_INSTALL_TIMEOUT_S:-3600}"
( timeout "\$INST_TIMEOUT_S" bash -c '$install_cmd' ) >\$LOGD/inst.log 2>&1; inst_rc=\$?
# QA-MUSTER-13-R2: a newest-go agent rejects the module's prebuilt LTO archives
# (CVE-2026-97038 cgo check) — retry once with the toolchain go.mod documents.
if [ \$inst_rc -ne 0 ] && qa_toolchain_lto_rejection \$LOGD/inst.log; then
  qa_retry_with_documented_go \$LOGD/inst.log . '$install_cmd' "\$INST_TIMEOUT_S" && inst_rc=0 || inst_rc=\$?
fi
# FIX 2 / QA-WARPFS-9 rework 3 (2026-09-19): the condition above catches the bare
# C toolchain. The OTHER environment failure the live agent produced is a rust
# repo whose crates link a system library (openssl via git2, fuse3 via hilo-fuse):
# a bare agent has no sudo to apt-install libssl-dev/libfuse3-dev/pkg-config, so
# the build dies inside a *-sys build script long after the toolchain is fine.
# ENV-BLOCKED fires only when BOTH halves hold — the probe found missing system
# deps (RUST_MISSING_SYS_DEPS) AND the log carries the *-sys build-script shape —
# and the INFO detail names the missing list so the row is actionable.
# rc=124 = timeout(1)'s own exit code — grade BEFORE the OK branch so a ceiling
# hit can never fall through to OK/FAIL (QA-BUNKER-60).
if [ \$inst_rc -eq 124 ]; then cell fresh-install SKIP "install exceeded \${INST_TIMEOUT_S}s timeout (slice/cpu too small for this workspace or genuine hang) — grade UNVERIFIED upstream"
elif [ \$inst_rc -eq 0 ]; then
  # QA-BUNKER-078: the install command and its derived expectation are baked by
  # the generator (ARTIFACT_EXPECT/ARTIFACT_CMD) — this generated script has no
  # install_cmd variable, which is why the pre-QA-BUNKER-078 call could never
  # fire.  Compare against the pre-install snapshot so bootstrap tools cannot
  # masquerade as project artifacts.
  artifact_check "\$INSTALL_ARTIFACT_BEFORE" "\$INSTALL_ARTIFACT_AFTER" "\$LOGD/inst.log"
elif [ \$inst_rc -eq 127 ] || grep -qi 'command not found' \$LOGD/inst.log; then cell fresh-install INFO "ENV-BLOCKED: the agent lacks a build tool the install step calls (\$(grep -m1 -oE '[a-zA-Z0-9_.-]+: command not found' \$LOGD/inst.log || echo rc=\$inst_rc)) and has no sudo to install it — harness env, not a repo defect: \$(tail -1 \$LOGD/inst.log)"
elif build_env_failure \$LOGD/inst.log; then cell fresh-install INFO "ENV-BLOCKED: agent has no C toolchain (build-script link failure) — not a repo defect; README documents build-essential"
elif [ -n "\$RUST_MISSING_SYS_DEPS" ] && build_sys_dep_failure \$LOGD/inst.log; then cell fresh-install INFO "ENV-BLOCKED: agent is missing system deps [\$RUST_MISSING_SYS_DEPS] and the build died in a *-sys build script — no sudo to apt install, not a repo defect; README documents the full dependency set: \$( { grep -m1 -E 'failed to run custom build command' \$LOGD/inst.log 2>/dev/null || grep -m1 'development packages' \$LOGD/inst.log 2>/dev/null; } | cut -c1-200 )"
elif qa_toolchain_lto_rejection \$LOGD/inst.log; then cell fresh-install INFO "ENV-BLOCKED: the agent's go rejected the module's prebuilt LLVM-bitcode archive (CVE-2026-97038 cgo check) and the go.mod-documented-toolchain retry did not recover — agent toolchain selection, not a repo defect: \$(fail_detail \$inst_rc \$LOGD/inst.log $install_cmd)"
elif qa_native_prereq_failure \$LOGD/inst.log; then cell fresh-install INFO "ENV-BLOCKED: install died on a missing native build prerequisite (pkg-config / libseccomp.pc) — agent env, not a repo defect\${QA_NATIVE_SYSDEPS_BLOCKED:+ [\$QA_NATIVE_SYSDEPS_BLOCKED]}: \$(fail_detail \$inst_rc \$LOGD/inst.log $install_cmd)"
else cell fresh-install FAIL "rc=\$inst_rc: \$(tail -2 \$LOGD/inst.log)"; fi
fi # QA-BUNKER-57 pip-absent gate

# Shared "start the project" command — used by chaos-corruption and
# chaos-errorpath. QA-GITREINS-POC-6/004 (2026-09-17): the old inline detection
# knew only node + go, so a Python CLI — the shape both of those cells care
# about — reported N/A "no single-binary entrypoint" and the corruption probe
# had nothing to start. A console script declared in [project.scripts] IS that
# entrypoint. ⚠️ This block must stay AFTER cell 1: on a fresh agent the console
# script does not exist until the project's own install ran, so detecting
# earlier dropped the value and chaos-corruption reported "no start command was
# detected" on the first live run (bunker-las-02, 2026-09-17). The interpreter
# must also be resolvable, so callers say "not observable" instead of failing
# on a 127.
BIN=""
# QA-9ROUTER-22 (2026-09-21): the old first arm guessed BIN="node src/index.js"
# for EVERY repo with a root package.json, unconditionally — 9router has no
# src/index.js, so chaos-corruption and chaos-errorpath both started
# "Error: Cannot find module .../src/index.js" and graded the refusal as the
# app's verdict (vacuous: it asserts nothing about the app). Detection is now
# OBSERVABLE: a start command is claimed only when the file it names exists in
# the tree (the project's own install has already run at this point), with
# custom-server.js > server.js > start.sh > package.json .scripts.start >
# src/index.js (last resort, only if present) > empty. Empty = "not
# observable", the state the chaos cells already grade INFO/N/A instead of a
# product verdict.
if [ -f package.json ]; then
  if [ -f custom-server.js ]; then BIN="node custom-server.js"
  elif [ -f server.js ]; then BIN="node server.js"
  elif [ -f start.sh ] && [ -x start.sh ]; then BIN="sh start.sh"
  else
    # package.json .scripts.start is a real start command only when it is not
    # an npm-lifecycle no-op (echo/exit/:). A script that is literally
    # "node server.js" is kept in the canonical "node server.js" form the
    # server.js arm above already produces (one form, one interpreter guard).
    BIN=\$(node -e 'const s=(require("./package.json").scripts||{}).start||""; process.exit(s && !/^(echo|exit)\\b|^:\\s*\$/.test(s.trim()) ? 0 : 1)' 2>/dev/null && printf npm_start || true)
    if [ "\$BIN" = "npm_start" ]; then
      if [ "\$(node -e 'process.stdout.write(((require("./package.json").scripts||{}).start||"").trim())' 2>/dev/null)" = "node server.js" ]; then
        BIN="node server.js"
      else
        BIN="npm start"
      fi
    else
      BIN=""
    fi
    # LAST resort: src/index.js only when the file actually exists.
    if [ -z "\$BIN" ] && [ -f src/index.js ]; then BIN="node src/index.js"; fi
  fi
elif [ -f go.mod ]; then
  # QA-OFF-BY-ONE-15 (2026-09-17): the old detection hardcoded BIN="go run ." for
  # any go.mod repo — off-by-one has NO root main package (entrypoint cmd/…), so
  # every start-probe died with "no Go files" and the chaos cells scored the
  # toolchain refusal as the app's verdict. cmd/ wins over a root main because
  # root .go files can exist yet be build-tag-excluded (release-engineer
  # 2026-09-20: "build constraints exclude all Go files" for a root go run).
  gofirst=""
  gomod_base=\$(awk '/^module[[:space:]]+/ {print \$2; exit}' go.mod 2>/dev/null | awk -F/ '{print \$NF}')
  if [ -d cmd ]; then
    # QA-OFF-BY-ONE-15-R2 (2026-11-03): prefer the module-named product main.
    goqueue=\$(grep -rlsE '^package main' cmd --include='*.go' 2>/dev/null | xargs -r -n1 dirname 2>/dev/null | sort -u)
    for godir in \$goqueue; do
      if [ "\$(basename "\$godir")" = "\$gomod_base" ]; then gofirst="\$godir"; break; fi
    done
    [ -n "\$gofirst" ] || gofirst=\$(printf '%s\\n' "\$goqueue" | sed -n '1p')
  fi
  if [ -n "\$gofirst" ]; then BIN="go run ./\$gofirst"
  elif ls ./*.go >/dev/null 2>&1 && grep -qsE '^package main' ./*.go; then BIN="go run ."
  fi
elif [ -f pyproject.toml ]; then
  BIN=\$(grep -A6 '^\[project\.scripts\]' pyproject.toml 2>/dev/null | grep -oE '^[A-Za-z0-9_.-]+[[:space:]]*=' | head -1 | tr -d ' =')
fi
if [ -n "\$BIN" ] && ! command -v \${BIN%% *} >/dev/null 2>&1; then BIN=""; fi

# Mandatory stage cells (QA-BUNKER-31): keep the direct battery's evidence
# contract aligned with the retired QA path. These cells are deliberately
# emitted in a fixed order before ci-pass: lint, tests, docker_build,
# compose_config. A missing artifact is N/A; an unavailable runner is INFO so
# the evidence distinguishes an environment gap from a repository result.
# The trigger scans are bounded to the synced tree and avoid dependency dirs.
#
# 1 · lint — use the repository's declared linter when present, otherwise the
#     standard tool for the detected language.
LINT_CMD=""
if [ -f .golangci.yml ] || [ -f .golangci.yaml ]; then LINT_CMD="golangci-lint run"
elif [ -f Makefile ] && grep -qE '^lint:' Makefile 2>/dev/null; then LINT_CMD="make lint"
elif [ -f package.json ] && command -v node >/dev/null 2>&1 && node -e 'const p=require("./package.json"); process.exit(p.scripts && p.scripts.lint ? 0 : 1)' 2>/dev/null; then LINT_CMD="npm run lint"
elif [ -f pyproject.toml ] && command -v ruff >/dev/null 2>&1; then LINT_CMD="ruff check ."
elif find . -maxdepth 4 -type f -name '*.go' -not -path './.git/*' -not -path './node_modules/*' -print -quit 2>/dev/null | grep -q .; then LINT_CMD="go vet ./..."
fi
if [ -n "\$LINT_CMD" ]; then
  if ! command -v "\${LINT_CMD%% *}" >/dev/null 2>&1; then
    cell lint INFO "lint runner unavailable on agent: \${LINT_CMD%% *} — lint was not run"
  else
    ( \$LINT_CMD ) >\$LOGD/lint.log 2>&1; lint_rc=\$?
    if qa_lint_skipped_declared_golangci "\$LINT_CMD" "\$PWD" "\$LOGD/lint.log"; then
      cell lint UNVERIFIED "golangci-lint not installed on agent — the repo's declared lint gate did not run"
    elif [ \$lint_rc -eq 127 ]; then
      # QA-ASCE-11 backstop: rc=127 is shell "command not found" — an agent env
      # gap, never a repo lint result; grade it UNVERIFIED (declared-skip).
      cell lint UNVERIFIED "lint runner missing on agent (rc=127): \$LINT_CMD — the lint gate did not run"
    elif [ \$lint_rc -eq 0 ]; then cell lint OK "\$LINT_CMD (rc=0)"
    else cell lint FAIL "\$(fail_detail \$lint_rc \$LOGD/lint.log \$LINT_CMD)"; fi
  fi
else
  cell lint N/A "no supported lint trigger (declared linter, Makefile lint target, package lint script, ruff, or Go files)"
fi

# 2 · tests — run the same detected native suite used by ci-pass. This is a
#     dedicated evidence cell; ci-pass retains its existing act/native fallback
#     behavior below so the two cells remain independently attributable.
TEST_RC=skip
if [ "\$native_cmd" = "echo no-test-path" ]; then
  cell tests N/A "no native test command detected"
elif printf '%s' "\$native_cmd" | grep -q pytest && ! qa_have_pip; then
  cell tests UNVERIFIED "pip absent on agent — the detected pytest suite was not run"
else
  # QA-WARPFS-040 (2026-11-11): this cell had NO deadline — a suite that hangs
  # (warpfs: cargo test past 3h on a fresh JIT agent) ran until the agent TTL and
  # took the whole battery with it, so the tick produced zero product coverage.
  # term+kill enforcement, ported from the tracked mirror's ci-pass native leg
  # (QA-HIVEMIND-WORK-18(c)): TERM at BUNKER_QA_NATIVE_TEST_TIMEOUT (default
  # 5400s), KILL 30s later. rc=124 grades UNVERIFIED below — a battery deadline
  # is a harness limit, never a product verdict.
  QA_TESTS_CMD="$native_cmd"
  ( timeout -k 30 \${BUNKER_QA_NATIVE_TEST_TIMEOUT:-5400} bash -c "\$QA_TESTS_CMD" ) >\$LOGD/tests.log 2>&1; TEST_RC=\$?
  if [ \$TEST_RC -eq 0 ] && ! vacuous_native_suite \$LOGD/tests.log; then
    cell tests OK "\$QA_TESTS_CMD (rc=0)"
  elif [ \$TEST_RC -eq 0 ]; then
    cell tests UNVERIFIED "detected native command produced no test result (vacuous suite)"
  elif [ \$TEST_RC -eq 124 ]; then
    cell tests UNVERIFIED "native suite exceeded the battery deadline (\${BUNKER_QA_NATIVE_TEST_TIMEOUT:-5400}s TERM, +30s KILL) — the suite did NOT finish, so this is a harness time-budget limit and NOT a product verdict (QA-WARPFS-040); last output: \$(tail -3 \$LOGD/tests.log 2>/dev/null | tr '\n' '|')"
  elif native_runner_missing \$LOGD/tests.log; then
    cell tests UNVERIFIED "native test runner unavailable — suite never ran: \$(native_runner_missing_cause \$LOGD/tests.log)"
  else
    cell tests FAIL "\$(tests_fail_detail \$TEST_RC \$LOGD/tests.log \$QA_TESTS_CMD)"
  fi
fi

# 3 · docker_build — build the first repository Dockerfile when one exists.
# DF-CRIER-498 (2026-11-03 bunker-las-03 evidence): this cell raced the rootless
# daemon on fresh agents — bare \`docker build\` fell back to the
# /run/user/<uid>/docker.sock guess and graded FAIL as a closed-pipe tar abort
# before any daemon was up. Now: resolve + WAIT for an answering docker endpoint
# (DOCKER_HOST -> bunker agent socket -> /run/user/<uid> -> /var/run/docker.sock)
# BEFORE building; a daemon that never answers grades a NAMED harness gap (INFO),
# not an unattributable build failure. The OK/FAIL detail records the builder in
# use (buildx vs legacy) and the exact build-context size (du -sb bytes).
DOCKERFILE_PATH=\$(find . -maxdepth 4 -type f -name 'Dockerfile*' \
  -not -path './.git/*' -not -path './node_modules/*' -not -path './.venv/*' \
  -not -path './vendor/*' 2>/dev/null | sort | head -1)
if [ -n "\$DOCKERFILE_PATH" ]; then
  if ! command -v docker >/dev/null 2>&1; then
    cell docker_build INFO "docker unavailable on agent — Dockerfile \$DOCKERFILE_PATH was not built"
  elif ! qa_docker_endpoint_wait; then
    cell docker_build INFO "harness gap: no answering docker daemon — \$qa_docker_endpoint_note; Dockerfile \$DOCKERFILE_PATH not built on this fresh agent (environment gap, not a repo defect)"
  else
    # QA-HERMES-CANOPY-51: the context is the REPO ROOT (this script's cwd --
    # qa-run.sh cd's to ~/qa-<proj>), never the Dockerfile's dirname. A repo
    # whose Dockerfile lives at deploy/Dockerfile builds with the repo root as
    # context (hermes-canopy Makefile:179 and .github/workflows/build.yml:142
    # both run "-f deploy/Dockerfile ."), so the dirname context ran the
    # equivalent of "-f deploy/Dockerfile deploy" and graded a VALID Dockerfile
    # FAIL (legacy builder rc=1: the subdir context lacks the Dockerfile's
    # root-relative COPY sources; 2026-11-20 battery, row QA-HERMES-CANOPY-55).
    # DOCKER_BUILD_CONTEXT overrides the default -- set it agent-side, or
    # BUNKER_QA_DOCKER_CONTEXT at launch to bake it into this script.
    QA_DOCKER_CONTEXT_DEFAULT="\${BUNKER_QA_DOCKER_CONTEXT:-}"
    DOCKER_CONTEXT="\${DOCKER_BUILD_CONTEXT:-\${QA_DOCKER_CONTEXT_DEFAULT:-.}}"
    DOCKER_CTX_BYTES=\$(du -sb "\$DOCKER_CONTEXT" 2>/dev/null | cut -f1)
    # QA-ASCE-12 (2026-11-25 JIT-bunker battery): pin the build path to the
    # compose leg's resolution BEFORE any docker call — the agent's own
    # rootless daemon socket, baked from the harness env at render time (the
    # same export the compose leg makes). The endpoint wait above stays the
    # build gate and the gap note, but its candidate pick can be the
    # ANSWERING-but-wrong /run/user user-socket guess: socket activation
    # accepts on contact and answers a version probe while the real daemon is
    # still booting, and the build then died with an unattributable
    # failed-to-connect error against that guess. Export the agent's own
    # socket unconditionally, and record the exported endpoint as ONE
    # grep-able DOCKER_HOST=<value> line at the head of the cell's build log.
    export DOCKER_HOST="unix:///run/bunker/$agent/docker.sock"
    if docker buildx version >/dev/null 2>&1; then DOCKER_BUILDER=buildx; else DOCKER_BUILDER=legacy; fi
    { echo "DOCKER_HOST=\${DOCKER_HOST:-unset}"; docker build -f "\$DOCKERFILE_PATH" "\$DOCKER_CONTEXT"; } >\$LOGD/docker-build.log 2>&1; docker_build_rc=\$?
    if [ \$docker_build_rc -eq 0 ]; then
      cell docker_build OK "docker build -f \$DOCKERFILE_PATH \$DOCKER_CONTEXT (rc=0, builder=\$DOCKER_BUILDER, context=\${DOCKER_CTX_BYTES:-unknown}B, endpoint=\$DOCKER_HOST)"
    elif grep -v '^DOCKER_HOST=' \$LOGD/docker-build.log 2>/dev/null | grep -qE 'Cannot connect to the Docker daemon|Is the docker daemon running|docker\.sock|broken pipe|unexpected EOF'; then
      cell docker_build FAIL "docker daemon connection lost during build (builder=\$DOCKER_BUILDER, context=\${DOCKER_CTX_BYTES:-unknown}B, endpoint=\${DOCKER_HOST:-default}) — named transport failure: \$(grep -v '^DOCKER_HOST=' \$LOGD/docker-build.log 2>/dev/null | grep -m1 -E 'Cannot connect to the Docker daemon|Is the docker daemon running|docker\.sock|broken pipe|unexpected EOF' | cut -c1-160)"
    else
      cell docker_build FAIL "\$(fail_detail \$docker_build_rc \$LOGD/docker-build.log docker build -f \$DOCKERFILE_PATH \$DOCKER_CONTEXT) (builder=\$DOCKER_BUILDER, context=\${DOCKER_CTX_BYTES:-unknown}B)"
    fi
  fi
else
  cell docker_build N/A "no Dockerfile trigger"
fi

# 4 · compose_config — validate the first compose file without starting it.
# QA-CRIER-067 (2026-11-17): this cell used to probe the compose capability
# with \`docker compose version\` BEFORE toolchain-bootstrap installs the
# compose plugin (~/.docker/cli-plugins/docker-compose — FIX 1 · QA-WARPFS-11,
# later in this same run), so a fresh agent graded
#   cell compose_config INFO "compose runner unavailable on agent — ..."
# in a run whose HARNESS-COMPOSE probe then proved the capability present and
# whose docker-deploy cell built and started the stack. Fix WITHOUT moving the
# cell (fixed order contract: lint, tests, docker_build, compose_config before
# ci-pass): resolve the runner ON DEMAND — the user-space plugin when it is
# executable, then \`docker compose\`, then legacy \`docker-compose\` — and
# make the resolve itself the probe, so a plugin installed later in the run is
# picked up here. Grading stays honest: a compose-file-absent run is N/A
# (unchanged); a run where nothing resolves AND docker itself is unusable
# stays INFO/ENV-BLOCKED, but the detail names the probe command, its exit
# code, and the plugin path that was checked.
COMPOSE_FILE_PATH=\$(find . -maxdepth 4 -type f \( -name 'docker-compose*.yml' -o -name 'docker-compose*.yaml' -o -name 'compose*.yml' -o -name 'compose*.yaml' \) \
  -not -path './.git/*' -not -path './node_modules/*' -not -path './.venv/*' \
  -not -path './vendor/*' 2>/dev/null | sort | head -1)
if [ -n "\$COMPOSE_FILE_PATH" ]; then
  compose_plugin_bin="\$HOME/.docker/cli-plugins/docker-compose"
  compose_bin=""; compose_bin_kind=""; compose_probe_cmd=""; compose_probe_rc=""
  if [ -x "\$compose_plugin_bin" ]; then
    compose_bin="\$compose_plugin_bin"; compose_bin_kind="user-space cli-plugin"
  elif command -v docker >/dev/null 2>&1 && docker compose version >/dev/null 2>&1; then
    compose_bin="docker compose"; compose_bin_kind="docker cli plugin"
  elif command -v docker-compose >/dev/null 2>&1; then
    compose_bin="docker-compose"; compose_bin_kind="legacy standalone"
  else
    # name the probe that failed so the ENV-BLOCKED grade is attributable
    if command -v docker >/dev/null 2>&1; then
      compose_probe_cmd="docker compose version"
      docker compose version >/dev/null 2>&1; compose_probe_rc=\$?
    else
      compose_probe_cmd="command -v docker"; compose_probe_rc=1
    fi
  fi
  if [ -n "\$compose_bin" ]; then
    ( \$compose_bin -f "\$COMPOSE_FILE_PATH" config ) >\$LOGD/compose-config.log 2>&1; compose_config_rc=\$?
    compose_config_cmd="\$compose_bin -f \$COMPOSE_FILE_PATH config"
    if [ "\$compose_config_rc" = "0" ]; then
      cell compose_config OK "\$compose_config_cmd (rc=0, runner=\$compose_bin_kind)"
    else
      cell compose_config FAIL "\$(fail_detail \$compose_config_rc \$LOGD/compose-config.log \$compose_config_cmd) (runner=\$compose_bin_kind)"
    fi
  else
    cell compose_config INFO "compose runner unavailable on agent (ENV-BLOCKED, not a repo defect) — probe \$compose_probe_cmd rc=\$compose_probe_rc; plugin path checked: \$compose_plugin_bin (executable: no); compose file \$COMPOSE_FILE_PATH was not validated"
    compose_config_rc=skip; compose_config_cmd=""
  fi
else
  cell compose_config N/A "no compose file trigger"
fi

# 5 · ci-pass — act first (simulated GH runner); NATIVE suite is the authoritative
#    fallback (act + rootless dockerd = fatal EOF observed 2026-08-27 on las-03)
#
# QA-9ROUTER-19 (2026-09-23) — TWO false-verdict classes in this cell, both
# recorded as board rows in the graded repo:
#   (1) act ran workflows that CANNOT trigger on the event being simulated. The
#       host now selects only triggerable ones (QA_CI_SELECT) and this cell
#       stages them into an EXTERNAL directory (~/qa-act-wf, outside the synced
#       tree — the tree is the audit payload, so it gains no entry), because act
#       does NOT merge repeated \`-W <file>\` targets: the last one wins and a
#       partial selection would silently drop the workflow that can regress
#       (measured 2026-09-23; a single DIRECTORY target recurses and merges).
#       Nothing triggerable ⇒ act is skipped for the native suite, and
#       QA_ACT_NOTE says why.
#   (2) a step failure inside act caused by the WORKFLOW's own registry/docker
#       coordinates (docker/login-action with no docker in the container, a
#       \`docker pull\` of a private image, a registry 401/403) is not a
#       branch-push regression. Such steps are CLASSIFIED from the log alone
#       (ci_only_failure): the cell leaves the red FAIL band. A workflow that
#       fails for any other reason — a real test failure, a parse error, a
#       shell variable act's own parser rejects — keeps the FAIL band.
command -v ~/bin/act >/dev/null 2>&1 || (mkdir -p ~/bin && cd ~ && curl -sL -o act.tar.gz '$ACT_URL' && tar -xzf act.tar.gz -C ~/bin && rm act.tar.gz)
# Pre-configure act to avoid interactive image selection prompt on first run
mkdir -p ~/.config/act && [ ! -f ~/.config/act/actrc ] && echo "-P ubuntu-latest=catthehacker/ubuntu:act-latest" > ~/.config/act/actrc
# FIX 2 · QA-WARPFS-2-3 (2026-09-19): this pull used to be a single curl —
# no retry, no alternate source — so one external-DNS blip hard-failed the
# bootstrap and the battery graded a transient network failure as if the
# repo were broken (same class as hermes-canopy 2026-09-05: exit 6 "Could
# not resolve host" on the rootless-installer download). Now a logged
# ladder: 3 attempts on the pinned static tarball (backoff 5s/15s), then
# ONE fallback to the docker-rootless-extras tarball on download.docker.com
# — a different artifact that vendors the rootless runtime (rootlesskit,
# vpnkit, dockerd-rootless-setuptool.sh) the docker cells exercise. No
# --resolve / --dns-servers IP pinning by design: the ladder must outlive a
# resolver blip, not depend on a hand-pinned address.
if ! [ -x ~/bin/docker ]; then
  mkdir -p ~/bin
  : > \$LOGD/docker-cli.log
  DOCKER_DL_OK=0
  for att in 1 2 3; do
    echo "== attempt \$att/3: docker-28.5.2.tgz (download.docker.com)" >> \$LOGD/docker-cli.log
    if curl -sSL -o ~/bin/docker.tgz https://download.docker.com/linux/static/stable/x86_64/docker-28.5.2.tgz >> \$LOGD/docker-cli.log 2>&1 && tar -xzf ~/bin/docker.tgz -C ~/bin --strip-components=1 docker/docker >> \$LOGD/docker-cli.log 2>&1; then
      rm -f ~/bin/docker.tgz
      DOCKER_DL_OK=1
      break
    fi
    echo "attempt \$att failed" >> \$LOGD/docker-cli.log
    case \$att in 1) sleep 5 ;; 2) sleep 15 ;; esac
  done
  if [ \$DOCKER_DL_OK -eq 0 ]; then
    echo "== fallback: docker-rootless-extras-28.5.2.tgz (alternate artifact, download.docker.com)" >> \$LOGD/docker-cli.log
    if curl -sSL -o ~/bin/rootless-extras.tgz https://download.docker.com/linux/static/stable/x86_64/docker-rootless-extras-28.5.2.tgz >> \$LOGD/docker-cli.log 2>&1 && tar -xzf ~/bin/rootless-extras.tgz -C ~/bin --strip-components=1 >> \$LOGD/docker-cli.log 2>&1; then
      rm -f ~/bin/rootless-extras.tgz
      chmod +x ~/bin/rootlesskit ~/bin/rootlesskit-docker-proxy ~/bin/vpnkit ~/bin/dockerd-rootless-setuptool.sh 2>/dev/null || true
      echo "fallback extras tarball extracted (rootless runtime vendored; docker CLI itself still absent)" >> \$LOGD/docker-cli.log
    else
      echo "fallback also failed" >> \$LOGD/docker-cli.log
    fi
  fi
  if [ -x ~/bin/docker ]; then
    cell toolchain-bootstrap OK "docker cli installed (~/bin/docker)"
  else
    cell toolchain-bootstrap FAIL "docker toolchain unavailable after 3 attempts + rootless-extras fallback — external download unreachable (DNS/network environment), not a repo defect: \$(tail -2 \$LOGD/docker-cli.log | tr '\n' ' ')"
  fi
fi
# FIX 1 · compose plugin (QA-WARPFS-11, 2026-09-19): the static tarball above
# ships ONLY the docker CLI — the compose plugin is a separate binary — so
# 'docker compose up -d' died rc=125 "unknown shorthand flag: 'd'" on every
# JIT agent and docker-deploy + chaos-shutdown graded FAIL for an environment
# gap instead of a repo defect. Install the plugin user-space into the CLI's
# default discovery dir (~/.docker/cli-plugins), best-effort: an offline
# agent logs a WARNING and continues, it must not hard-fail the bootstrap.
mkdir -p ~/.docker/cli-plugins
if ! [ -x ~/.docker/cli-plugins/docker-compose ]; then
  if curl -fsSL -o ~/.docker/cli-plugins/docker-compose https://github.com/docker/compose/releases/latest/download/docker-compose-linux-x86_64 >\$LOGD/compose.log 2>&1 && head -c 4 ~/.docker/cli-plugins/docker-compose | grep -q ELF && chmod +x ~/.docker/cli-plugins/docker-compose >> \$LOGD/compose.log 2>&1; then
    cell toolchain-bootstrap OK "compose plugin installed (~/.docker/cli-plugins/docker-compose)"
  else
    echo "WARN: compose plugin install failed (offline agent?) — docker compose cells will fail rc=125 on this environment gap: \$(tail -1 \$LOGD/compose.log 2>/dev/null)" >&2
  fi
fi
# FIX 2 · buildx plugin (QA-CHIMERA-V2-32, 2026-09-21): compose v5.5.1's build
# path REQUIRES buildx >= 0.17 — 'docker compose up -d --build' died rc=1
# "compose build requires buildx 0.17.0 or later" on every JIT agent because the
# static docker-28.5.2.tgz ships NEITHER compose NOR buildx (FIX 1 above covers
# compose only). Same best-effort user-space pattern as FIX 1: the plugin goes
# into ~/.docker/cli-plugins (the CLI's default discovery dir); an offline
# agent logs a WARN and continues — the build cells then grade the environment
# gap, not a repo defect.
if ! [ -x ~/.docker/cli-plugins/docker-buildx ]; then
  # Asset name is VERSION-PREFIXED (buildx-vX.Y.Z.linux-amd64) — unlike compose,
  # buildx publishes NO versionless latest/download artifact: that URL 404s with
  # the body "Not Found", and a bare curl -sSL silently saved that body as the
  # plugin (graded OK, compose build then died rc=1 "exec format error" —
  # QA-CHIMERA-V2-32 relaunch, 2026-09-21). Resolve the tag via the GitHub API,
  # curl -f so an HTTP error never lands in the file, and verify the ELF magic
  # before grading the cell OK.
  BX_TAG=\$(curl -fsSL --max-time 20 https://api.github.com/repos/docker/buildx/releases/latest | grep -o '"tag_name": *"[^"]*"' | head -1 | cut -d'"' -f4)
  if [ -n "\$BX_TAG" ] && curl -fsSL -o ~/.docker/cli-plugins/docker-buildx "https://github.com/docker/buildx/releases/download/\$BX_TAG/buildx-\$BX_TAG.linux-amd64" >\$LOGD/buildx.log 2>&1 && head -c 4 ~/.docker/cli-plugins/docker-buildx | grep -q ELF && chmod +x ~/.docker/cli-plugins/docker-buildx >> \$LOGD/buildx.log 2>&1; then
    cell toolchain-bootstrap OK "buildx plugin installed (\$(~/.docker/cli-plugins/docker-buildx version 2>/dev/null | head -1 || echo 'version n/a'))"
  else
    echo "WARN: buildx plugin install failed (offline agent?) — compose build cells will fail rc=1 'requires buildx 0.17.0 or later' on this environment gap: \$(tail -1 \$LOGD/buildx.log 2>/dev/null)" >&2
  fi
fi
# FIX 3 · node+npm toolchain bootstrap (QA-HERMES-CANOPY-32, 2026-09-24):
# the JIT agent image ships NO node/npm, so the ui-probe frontend/ arm
# (setsid npm run dev) dies "No such file or directory" on every repo that
# only serves a frontend/ Vite/npm surface. Install user-space Node LTS
# v22.15.0 (proven resolving 2026-09-24) into ~/tools/node, same best-effort
# pattern as FIX 1/FIX 2: offline agents log a WARN and continue.
if ! command -v node npm >/dev/null 2>&1; then
  mkdir -p ~/tools
  if curl -fsSL -o /tmp/node-v22.15.0-linux-x64.tar.xz https://nodejs.org/dist/v22.15.0/node-v22.15.0-linux-x64.tar.xz >\$LOGD/node.log 2>&1 && tar -xJf /tmp/node-v22.15.0-linux-x64.tar.xz -C ~/tools >\$LOGD/node.log 2>&1 && mv ~/tools/node-v22.15.0-linux-x64 ~/tools/node && head -c 4 ~/tools/node/bin/node | grep -q ELF; then
    export PATH="\$HOME/tools/node/bin:\$PATH"
    cell toolchain-bootstrap OK "node+npm installed (\$(node --version 2>/dev/null || echo version n/a))"
  else
    echo "WARN: node+npm install failed (offline agent?) — ui-probe frontend/ arm will grade ENV-BLOCKED: \$(tail -1 \$LOGD/node.log 2>/dev/null)" >&2
  fi
fi
# Bootstrap-end verification (QA-WARPFS-11): a client-side 'docker compose
# version' proves CLI + plugin are discovered together. HARNESS-COMPOSE=ok/missing
# is printed for the run log and recorded as a cell so the evidence shows
# whether a docker gap belongs to the harness or the agent.
HARNESS_COMPOSE=missing
if [ -x ~/bin/docker ] && ~/bin/docker compose version >/dev/null 2>&1; then HARNESS_COMPOSE=ok; fi
echo "HARNESS-COMPOSE=\$HARNESS_COMPOSE"
if [ "\$HARNESS_COMPOSE" = ok ]; then
  cell toolchain-bootstrap OK "HARNESS-COMPOSE=ok (docker compose version passes)"
else
  cell toolchain-bootstrap INFO "HARNESS-COMPOSE=missing — docker compose unavailable (CLI or plugin install failed); docker-deploy/chaos-shutdown will fail on this environment gap, not a repo defect"
fi
# Node+npm bootstrap verification (QA-HERMES-CANOPY-32): confirms the ui-probe
# frontend/ arm can execute. HARNESS_NODE=ok/missing is printed for the run log.
HARNESS_NODE=missing
if command -v node >/dev/null 2>&1 && command -v npm >/dev/null 2>&1; then HARNESS_NODE=ok; fi
echo "HARNESS_NODE=\$HARNESS_NODE"
if [ "\$HARNESS_NODE" = ok ]; then
  cell toolchain-bootstrap OK "HARNESS_NODE=ok (node \$(node --version 2>/dev/null || echo 'n/a'), npm \$(npm --version 2>/dev/null || echo 'n/a'))"
else
  cell toolchain-bootstrap INFO "HARNESS_NODE=missing — node/npm unavailable (install failed or offline); ui-probe frontend/ arm will grade ENV-BLOCKED on this environment gap, not a repo defect"
fi
# QA-MAFIA-AI-BENCHMARK-14 (2026-09-29): pnpm-lock repos rely on \`corepack enable\`
# inside the repo's own install step, but corepack has failed silently on several
# agents (4 consecutive mafia-ai-benchmark cycles: fresh-install/ci-pass native/
# chaos-resource all rc=127 'pnpm: command not found' while HARNESS_NODE=ok).
# Best-effort fallback: npm-install pnpm into the same toolchain prefix npm lives in.
if [ -f pnpm-lock.yaml ] && ! command -v pnpm >/dev/null 2>&1 && command -v npm >/dev/null 2>&1; then
  if ( npm install -g pnpm --no-audit --no-fund ) >\$LOGD/pnpm.log 2>&1 && command -v pnpm >/dev/null 2>&1; then
    cell toolchain-bootstrap OK "pnpm bootstrapped via npm -g (corepack enable absent/failed)"
  else
    echo "WARN: pnpm bootstrap failed (offline agent?) — pnpm repos will grade ENV-BLOCKED rc=127: \$(tail -1 \$LOGD/pnpm.log 2>/dev/null)" >&2
  fi
fi
# Point docker at the agent's own rootless daemon — bare 'docker' defaults to
# /var/run/docker.sock (rootful, permission-denied for the agent uid) or the
# user-socket guess /run/user/\$UID/docker.sock (proven chimera-v2 run 09-01).
[ -x ~/bin/docker ] && export DOCKER_HOST="unix:///run/bunker/$agent/docker.sock"
for i in \$(seq 1 20); do [ -S /run/bunker/$agent/docker.sock ] && break; sleep 2; done
# CI-only failure classification (QA-9ROUTER-19 class 2). Pure log predicate:
# 0 ⇒ every failure act reported is the workflow's own registry/package
# coordinates (a private image login/pull outside a real runner), i.e. an
# artifact of running the workflow where it cannot really run — never a
# branch-push regression. A plain \`exit 7\`, a parse error, a missing file, a real
# test failure or ANY ❌ block the shape does not cover keeps the red grade.
# The shape pattern lives in ONE place (CI_ARTIFACT_RE); a ❌ line is qualified
# by its own LINE BLOCK (the 8 lines before and 6 after it) because act/docker
# print the reason on either side of the marker: the GHCR login failure puts
# "Unable to locate executable file: docker" BEFORE the ❌, a registry denial
# prints "denied: ..." AFTER it. Both windows are anchored on the ❌ itself, so
# an unrelated artifact-shaped string elsewhere in the log cannot qualify a
# genuine failure.
CI_ARTIFACT_RE="docker/login-action|denied: requested access to the resource is denied|no basic auth credentials|pull access denied|authentication required|not found: manifest|manifest (unknown|not found)|toomanyrequests|Unable to locate executable file: docker|Cannot connect to the Docker daemon|docker daemon is not running|(401 Unauthorized|403 Forbidden)"
ci_only_failure() { # <act log>
  local cf="\$1" n blk from
  [ -f "\$cf" ] || return 1
  n=\$(grep -c '❌' "\$cf" 2>/dev/null || true)
  [ "\${n:-0}" -gt 0 ] || return 1
  while IFS=: read -r lineno _rest; do
    [ -n "\$lineno" ] || continue
    from=\$(( lineno > 8 ? lineno - 8 : 1 ))
    blk=\$(sed -n "\${from},\$((lineno + 6))p" "\$cf" 2>/dev/null)
    printf '%s' "\$blk" | grep -qE "\$CI_ARTIFACT_RE" || return 1
  done < <(grep -n '❌' "\$cf" 2>/dev/null)
  true
}
# QA-OFF-BY-ONE-62 (2026-11-25): act runs ALL jobs of a multi-job workflow in
# parallel, and concurrent setup-go actions race on the same Go toolcache
# extraction (measured battery off-by-one-qa-2026-11-04 at 6546b59e, agent
# cf73b3aa: 'Go 1.26' died "Failed to download version 1.26: ENOENT ... copyfile
# /tmp/<uuid>/go/src/archive/tar/testdata/writer.tar", a second job died ENOTEMPTY
# rmdir of /opt/hostedtoolcache/go/1.26.10/x64, and the seed-probe/deploy-gate
# jobs died "version: not found" inside their setup step). A job whose SETUP step
# died never reached a product step, so its failure carries NO product signal —
# the same SHA was SUCCESS on hosted CI. setup_toolcache_race() returns 0 ONLY
# for that shape: the log carries at least one explicit toolcache/setup-go death
# signature AND every ❌ is a checkout/setup-step death (its step name is a
# setup step, or its own line block carries the signature). A genuine product
# failure (build/test/golangci steps) and the checkout-token sandbox gap
# (failing step actions/checkout but NO signature anywhere) both fall through —
# the FAIL arm in the ci-pass cell stays authoritative for them.
SETUP_STEP_RE="actions/setup-|actions/checkout|^Set up |^Setup |^Checkout"
SETUP_RACE_SIG_RE="Failed to download version|no such file or directory, copyfile|hostedtoolcache.*ENOTEMPTY|version: not found"
setup_toolcache_race() { # <act log> - 0 when EVERY failing job died inside its setup step
  local cf="\$1" ln step blk from
  [ -f "\$cf" ] || return 1
  grep -qE "\$SETUP_RACE_SIG_RE" "\$cf" 2>/dev/null || return 1
  grep -q '❌' "\$cf" 2>/dev/null || return 1
  # Every ❌ act reported must be a setup-step death. A failing step whose name
  # is a checkout/setup action qualifies on the name; any other failing step is
  # qualified ONLY by the toolcache death signature inside its own line block
  # (8 before / 6 after, the ci_only_failure window), so a corrupt step name
  # from the race itself cannot sink the classification while a real product
  # failure (no signature near it) still keeps the red grade.
  while IFS=: read -r ln _rest; do
    [ -n "\$ln" ] || continue
    from=\$(( ln > 8 ? ln - 8 : 1 ))
    step=\$(sed -n "\${ln}p" "\$cf" 2>/dev/null | sed -E 's/.*Failure - Main //; s/ \[[-0-9a-zA-Z.]+\]$//')
    printf '%s' "\$step" | grep -qE "\$SETUP_STEP_RE" && continue
    blk=\$(sed -n "\${from},\$((ln + 6))p" "\$cf" 2>/dev/null)
    printf '%s' "\$blk" | grep -qE "\$SETUP_RACE_SIG_RE" || return 1
  done < <(grep -n '❌' "\$cf" 2>/dev/null)
  true
}
setup_race_context() { # <act log> — one-line attribution: failing step + first death signature
  printf 'failing-step: %s | sig: %s' "\$(grep -m1 -E '❌[[:space:]]+Failure - Main ' "\$1" 2>/dev/null | sed -E 's/.*Failure - Main //; s/ \[[-0-9a-zA-Z.]+\]$//' | cut -c1-100)" "\$(grep -m1 -E "\$SETUP_RACE_SIG_RE" "\$1" 2>/dev/null | cut -c1-180)"
}
# QA-FOREMAN-2026-09-26 FIX (use-before-assignment): QA_CI_SELECT/QA_ACT_NOTE
# MUST be assigned BEFORE the staging block below. The generated script
# previously assigned them at the END of the config section, so this loop read
# an UNSET variable, ACT_WF_COUNT was always 0, ci_rc was always "skip", and
# act NEVER RAN for any ci.yml repo — the ci-pass cell graded
# "no triggerable workflow — native suite PASS" vacuously (measured on
# logsey + auger batteries, agents a334d717/c9a0e122, 2026-09-26; corroborated
# by heading + dexdat-memory runs the same day).
QA_CI_SELECT='$DETECT_CI_FILES'
QA_ACT_NOTE='$DETECT_ACT_NOTE'
# Stage the host-selected triggerable workflows into an EXTERNAL staging dir.
# The dir must live OUTSIDE the synced tree (the tree is the payload under audit
# and gains no entries) and hold real FILES, not a dir symlink: \`-W <dir>\` does
# recurse a directory, but act resolves a workflow only when the entry is a file
# it can open (measured 2026-09-23 — a symlinked .github/workflows DIRECTORY
# yielded zero jobs). Symlinked files are fine and act runs the repo's own
# checkout as cwd regardless of where -W points.
ACT_WF_DIR=~/qa-act-wf
rm -rf \$ACT_WF_DIR; mkdir -p \$ACT_WF_DIR
for wf in \$QA_CI_SELECT; do
  [ -f "\$wf" ] && ln -sf "\$PWD/\$wf" "\$ACT_WF_DIR/\$(basename "\$wf")"
done
ACT_WF_COUNT=\$(ls -1 \$ACT_WF_DIR 2>/dev/null | wc -l)
QA_CI_CMD="$ci_cmd"
if [ "\$ACT_WF_COUNT" -gt 0 ]; then QA_CI_CMD="\$QA_CI_CMD -W \$ACT_WF_DIR"; fi
if [ "\$ACT_WF_COUNT" -gt 0 ]; then
# QA-6 (2026-11-22): stale .venv from a prior battery/cell collides with the workflow uv venv step
if [ -n "\$QAREPO" ]; then rm -rf "\$QAREPO/.venv"; fi
# QA-6 addendum (2026-11-22, foreman): the rm above clears the SYNCED TREE, but act REUSES a
# long-lived job container whose workspace the checkout step populates by docker cp MERGE (no
# delete) — so a venv left inside the container by an earlier cell/battery survives a clean
# host tree and re-triggers the same collision. UV_VENV_CLEAR=1 is uv's own sanctioned hint
# (it is printed verbatim in the collision output) and restores the clean-workspace semantics
# a real runner has; product failures still fail at lint/pytest. Proven live: replay v4f
# (evidence qa6-fix-20261122T202417Z) — venv step Success, Ruff steps green, Pytest reached.
QA_CI_CMD="\$QA_CI_CMD --env UV_VENV_CLEAR=1"
( echo "QA-6 hygiene: removed stale agent-workspace venv (\$QAREPO/.venv) before act replay"; timeout \${BUNKER_QA_ACT_TIMEOUT:-2400} bash -c "\$QA_CI_CMD" ) >\$LOGD/ci.log 2>&1; ci_rc=\$?
else
: > \$LOGD/ci.log
ci_rc=skip   # no triggerable workflow: act never ran, so it has no verdict
fi
#QA-CELL:ci-pass:start
# QA-BUNKER-41 (2026-10-30): the act leg's OWN result is a GRADED participant,
# not decoration. ci_rc is raw and sometimes NON-NUMERIC (the literal "skip"
# when no workflow can fire), so normalize it ONCE into act_result —
# pass | skip | timeout | fail — and let the cell grade on that token.
# Pre-fix the act leg reached the grade only as free-text detail on a cell
# whose OK/FAIL the NATIVE suite decided: battery 2026-09-30, JIT agent
# 67928b30 @ bunker-las-03 HEAD 47377c3, ci-pass graded with "act failed (rc=1:
# [CI/gitreins-guard] Run Complete job|Cleaning up container for job
# gitreins-)" + "native suite PASS" — so the workflow that gates every bunker
# push was never verified end-to-end from the clean box, and the graded leg was
# the native go suite only. The rail now:
#   pass    -> ci-pass OK on the act leg itself (the native suite never needed);
#   skip    -> no triggerable workflow: act has no verdict, native decides;
#   timeout -> ci-pass FAIL naming the BUNKER_QA_ACT_TIMEOUT budget (a harness
#              budget, not a repo defect — but never a green either);
#   fail    -> ci-pass FAIL; a passing native suite is DETAIL ONLY.
# Every detail below names act_result AND its rc so the deciding leg is never
# ambiguous. The regression guard for this wiring is
# .hermes/scripts/test_bunker_qa_act_grade.sh (guard: act_rc1_fails_grade) — it
# renders the real generated script, drives THIS block with act rc=1 and
# requires the battery's graded summary (qa_run_summary) to come back non-zero.
# QA-CODING-HERMES-TOOLS-6-R2: every ci-pass detail names the jq the suite ran
# through (bootstrap-provisioned static binary or distro jq) or jq=MISSING, so a
# jq-less red is attributable at the cell instead of reading as a product FAIL.
JQCTX=" jq=\${QA_JQ_PATH:-MISSING}"
case "\$ci_rc" in
  0)    act_result=pass ;;
  skip) act_result=skip ;;
  124)  act_result=timeout ;;   # timeout(1)'s own rc — the act leg hit its wall budget
  *)    act_result=fail ;;
esac
# NOTE: the test is a STRING compare on purpose — act_result is the literal
# "pass" only when act exited 0, and \`[ skip -eq 0 ]\` would make bash print
# "integer expression expected" and take the wrong branch.
if [ "\$act_result" = "pass" ]; then
  cell ci-pass OK "act: \$(grep -cE 'Job succeeded|✅ Success' \$LOGD/ci.log || true) jobs green — act_result=pass rc=0 (\$ACT_WF_COUNT triggerable workflow(s))\$JQCTX"
else
  suite_start=\$(date +%s)
  # QA-WARPFS-040: same missing-deadline defect as the tests cell — without this
  # the ci-pass native fallback re-wedges every battery the tests cell no longer
  # eats. Mirrors the tracked mirror's wrapper (QA-HIVEMIND-WORK-18(c)).
  QA_NATIVE_CMD="$native_cmd"
  ( timeout -k 30 \${BUNKER_QA_NATIVE_TEST_TIMEOUT:-5400} bash -c "\$QA_NATIVE_CMD" ) >\$LOGD/native.log 2>&1; nat_rc=\$?
  suite_end=\$(date +%s)
  suite_dur=\$(( suite_end - suite_start ))
  if [ \$nat_rc -eq 124 ]; then
    cell ci-pass UNVERIFIED "native suite exceeded the battery deadline (\${BUNKER_QA_NATIVE_TEST_TIMEOUT:-5400}s TERM, +30s KILL) — act leg rc=\$ci_rc, suite did NOT finish; harness time-budget limit, NOT a product verdict (QA-WARPFS-040); last output: \$(tail -3 \$LOGD/native.log 2>/dev/null | tr '\n' '|')\$JQCTX"
  elif [ \$nat_rc -eq 0 ]; then
    ACTCTXOK=""; grep -q 'Input required and not supplied: token' \$LOGD/ci.log 2>/dev/null && ACTCTXOK=" (act sandbox has no GITHUB_TOKEN — checkout/setup steps cannot run in act; act leg not repo evidence, hosted CI is authoritative)"
    # QA-BUNKER-29 (2026-09-30): rc=0 from the \`echo no-test-path\` placeholder
    # (or any other empty suite output) is NOT a suite result — nothing ran.
    # Grade UNVERIFIED before the OK, never a false green on a suite that
    # never ran. Non-vacuous rc=0 path is unchanged.
    if vacuous_native_suite \$LOGD/native.log; then
      cell ci-pass UNVERIFIED "native suite NEVER RAN (vacuous no-test-path placeholder) — no repo signal; act_result=\$act_result rc=\$ci_rc\$JQCTX"
    elif [ "\$act_result" = "skip" ]; then
      cell ci-pass OK "act: no triggerable workflow\$QA_ACT_NOTE (act_result=skip, act never ran so it carries no verdict) — native suite PASS\$JQCTX"
    elif [ "\$act_result" = "fail" ] && setup_toolcache_race "\$LOGD/ci.log"; then
      # QA-OFF-BY-ONE-62 (2026-11-25): every failing job died INSIDE its setup
      # step (checkout / Set up Go / actions/setup-*) — act's parallel jobs race
      # on the setup-go toolcache extraction — and no product step ran, so the
      # act leg carries no product signal and must NOT grade the repo red (the
      # same SHA was SUCCESS on hosted CI). Grade UNVERIFIED naming the cause;
      # hosted CI stays authoritative for the workflow verdict, and its verdict
      # must be recorded at the tested SHA beside this row so product CI is not
      # read as red. Genuine product failures (no toolcache signature anywhere)
      # and the checkout-token gap both fall through to the FAIL arm below —
      # this arm never raises the cell's threshold and never disables the cell.
      cell ci-pass UNVERIFIED "act setup-step death (setup-go toolcache race): every failing job stopped inside its setup step and no product step ran — \$(setup_race_context \$LOGD/ci.log) — act_result=\$act_result rc=\$ci_rc; setup_toolcache_race matched, NOT a product verdict; hosted CI is authoritative for the workflow verdict — record its verdict at the tested SHA beside this row\$JQCTX"
      cell ci-act UNVERIFIED "act setup-step death (setup-go toolcache race) rc=\$ci_rc: \$(setup_race_context \$LOGD/ci.log) — failing jobs never reached a product step; hosted CI is authoritative for the workflow verdict"
    else
      # QA-CHIMERA-V2-39 (2026-10-04) + QA-BUNKER-B1 (2026-10-06): an act leg
      # that FAILED must NOT be folded into a single OK cell. The 10-04 change
      # split the leg out as ci-act, but still graded ci-pass OK "native suite
      # PASS (see ci-act ...)" — so a CI simulation that died rc=1
      # (level=fatal msg=EOF, las-03 2026-08-31; recurred on batteries since)
      # read OK against its own ci.log. act is this cell's PRIMARY check: a
      # non-zero act rc is a FAIL, and the native suite (which DID run) is
      # carried as detail only — never a status flipper. act SKIPPED entirely
      # (no triggerable workflow) is not a failed act and keeps the
      # native-suite OK. The ci-act row below keeps the act leg's own
      # UNVERIFIED detail; it is never graded OK either.
      # QA-BUNKER-41: act_result is the rail now, so the skip arm is decided
      # ABOVE — the old inner re-test for it was unreachable dead code and is
      # gone. Reaching here means act_result=fail|timeout, and the native leg
      # (which DID run) is detail only, never a status flipper.
      cell ci-pass FAIL "act rc=\$ci_rc: \$(act_failure_context \$LOGD/ci.log)\$ACTCTXOK — act CI simulation FAILED (act_result=\$act_result; native suite PASS is detail only)\$JQCTX"
      cell ci-act UNVERIFIED "act failed rc=\$ci_rc act_result=\$act_result: \$(act_failure_context \$LOGD/ci.log)\$ACTCTXOK — a failed act leg is never graded OK; hosted CI is authoritative for the workflow verdict"
    fi
  else
    NCTX=""; build_env_failure \$LOGD/native.log && NCTX=" (environment: no C toolchain)"
    NFAIL="\$(grep -v '^[[:space:]]*\$' \$LOGD/native.log 2>/dev/null | grep -E -- '^(--- FAIL|FAIL|ok  )' | tail -8 | tr '\n' '|')"
    [ -n "\$NFAIL" ] || NFAIL="\$(grep -v '^[[:space:]]*\$' \$LOGD/native.log 2>/dev/null | tail -4 | tr '\n' '|')"
    GOCTX=""; go_suite_env_failure \$LOGD/native.log && GOCTX=" (environment: missing build tool on the test host — not a code finding; FAIL lines below name the real failures)"
    # QA-H3-15 (2026-09-21): act inside the sandbox has NO GITHUB_TOKEN, so
    # actions/checkout@v4 (and setup-*) die with "Input required and not
    # supplied: token" BEFORE the suite runs — the act leg then says nothing
    # about the repo (hosted CI on the same HEAD is green; h3 battery 24dcbb04:
    # act rc=1 checkout-token + native rc=127 make-missing, both harness env).
    # Name that context in the FAIL detail so nobody files it as a repo defect.
    ACTCTX=""; grep -q 'Input required and not supplied: token' \$LOGD/ci.log 2>/dev/null && ACTCTX=" (act sandbox has no GITHUB_TOKEN — checkout/setup steps cannot run in act; act leg not repo evidence, hosted CI is authoritative)"
    if native_runner_missing \$LOGD/native.log; then
      # QA-TERMINAL-JAIL-9 (2026-09-25): rc=127 '<runner>: command not found' -
      # the suite NEVER RAN, so this leg carries no repo signal. The harness
      # picked the runner by repo shape but could not provision it (PEP-735
      # dependency-group repos); grade the environment gap, not a repo defect.
      cell ci-pass UNVERIFIED "native runner missing (rc=\$nat_rc) - the suite NEVER RAN, no repo signal; INFRA-FAIL, not a result: \$(native_runner_missing_cause \$LOGD/native.log)\$JQCTX"
    elif [ "\$act_result" = "skip" ]; then
      cell ci-pass FAIL "no triggerable workflow\$QA_ACT_NOTE (act_result=skip, act never ran so it carries no verdict) — native rc=\$nat_rc: \$NFAIL\$NCTX\$GOCTX\$JQCTX"
    elif ci_only_failure \$LOGD/ci.log; then
      # QA-9ROUTER-19 class 2: the act leg's ONLY failures are the workflow's own
      # registry/package coordinates (a private image login/pull outside a real
      # runner) — never a branch-push regression. Grade it INFO with the reason
      # named, so the row is informational instead of a false product FAIL.
      cell ci-pass INFO "act's failures are the workflow's own registry/package coordinates, not a branch-push regression (act_result=\$act_result rc=\$ci_rc: \$(act_failure_context \$LOGD/ci.log)) — native rc=\$nat_rc: \$NFAIL\$NCTX\$GOCTX\$ACTCTX\$JQCTX"
    else
      cell ci-pass FAIL "native rc=\$nat_rc: \$NFAIL\$NCTX\$GOCTX\$ACTCTX (act leg act_result=\$act_result rc=\$ci_rc: \$(act_failure_context \$LOGD/ci.log))\$JQCTX"
      # QA-GUARD-008 (2026-11-22): the native-fail branch previously wrote ONLY
      # the ci-pass row, so when the product test fails BOTH legs (the
      # red-prove battery flips one assertion — native rc=1 and act rc=1) the
      # evidence carried NO ci-act row at all and the act context (now naming
      # the failing test via act_failure_context's failing-tests segment) was
      # unreachable. Emit the ci-act row beside it whenever the act leg itself
      # failed or timed out, mirroring the act-fail/native-pass branch above.
      if [ "\$act_result" = "fail" ] || [ "\$act_result" = "timeout" ]; then
        cell ci-act UNVERIFIED "act failed rc=\$ci_rc act_result=\$act_result: \$(act_failure_context \$LOGD/ci.log)\$ACTCTX — a failed act leg is never graded OK; hosted CI is authoritative for the workflow verdict"
      fi
    fi
  fi
fi
#QA-CELL:ci-pass:end

# QA-DEXDAT-CORE-15 (2026-10-04): act compose legs leak services that bind
# PUBLISHED host ports (e.g. a repo's CI stack binding 0.0.0.0:5435->5432).
# Every later compose leg (docker-deploy, ui-probe, chaos-shutdown) then dies
# 'Bind for 127.0.0.1:5435 failed: port is already allocated' — an inherited
# harness root cause graded as product FAILs (proven dexdat-core agent
# f960e4c7 @ 51a376b: act container held 5435 while dexdat-postgres tried to
# bind). Teardown AFTER the ci-pass leg, BEFORE upgrade/docker-deploy/chaos:
# stop+rm the act-stamped containers and any network it created. Scoped to the
# act runner's labels (com.docker.compose.project=act-*, and any container
# whose name starts with 'act-') so a repo's own freshly-upped stack is never
# touched; best-effort — a teardown failure logs and continues.
if [ -x \$HOME/bin/docker ] && [ -n "\${DOCKER_HOST:-}" ]; then
  # QA-DEXDAT-CORE-16 (2026-10-04): act CI legs leak containers that have NO
  # compose label (act names them act-<Job>-<id>) but still PUBLISH host ports
  # (e.g. 127.0.0.1:6379 from an act redis) - the label-only sweep missed them
  # and the docker-deploy leg died 'Bind for 127.0.0.1:6379 failed: port is
  # already allocated' (agent 5e0f55e0 @ 854726d, dc.log:3020). Sweep BOTH
  # classes: label-bearing compose leftovers AND anything named act-*,
  # running or exited, before the deploy legs start.
  ACT_LEFT=\$( { \$HOME/bin/docker ps -aq --filter 'label=com.docker.compose.project' 2>/dev/null;
                  \$HOME/bin/docker ps -aq --filter 'name=^act-' 2>/dev/null; } \
    | sort -u \
    | while IFS= read -r cid; do
        [ -n "\$cid" ] || continue
        if \$HOME/bin/docker rm -f "\$cid" >/dev/null 2>&1; then echo "teardown: rm battery container \$cid"; fi
      done)
  if [ -n "\$ACT_LEFT" ]; then
    echo "QA-DEXDAT-CORE-15 teardown: removed compose leftovers before the docker legs:"
    echo "\$ACT_LEFT"
  fi
  ACT_NETS=\$(\$HOME/bin/docker network ls --format '{{.Name}}' 2>/dev/null | grep -vE '^(bridge|host|none)$' || true)
  for net in \$ACT_NETS; do \$HOME/bin/docker network rm "\$net" >/dev/null 2>&1 || true; done
fi

# 3 · upgrade — previous release → HEAD reinstall
# QA-GITREINS-POC-004: the synced tree carries no .git history (sync_repo
# excludes .git and re-inits one synthetic commit), so an in-cell 'git tag' is
# ALWAYS empty and the old cell reported N/A "no release tags in repo" for repos
# with 40 tags. Tags are detected on the HOST (detect_upgrade_inputs) and baked
# in below; the cell then installs the previous release and re-installs HEAD over
# it. If no previous release can be installed the cell FAILs with the reason —
# never a silent N/A.
QA_TAG_COUNT='$DETECT_TAG_COUNT'
QA_PREV_TAG='$DETECT_PREV_TAG'
QA_PREV_VERSION='$DETECT_PREV_VERSION'
QA_PKG_NAME='$DETECT_PKG_NAME'
QA_ECOSYSTEM='$DETECT_PKG_ECOSYSTEM'
# QA-HEADING-009: non-empty for non-publishable npm repos -> the upgrade cell
# uses the streamed previous-tag tree instead of the npm registry arm.
QA_UP_PREV_DIR='$DETECT_UP_PREV_DIR'
QA_GO_URL='$DETECT_GO_URL'
# QA-HARNESS-DOCKERGATE-001: the compose lifecycle opt-in + controller veto are
# baked into the emitted battery so an agent cannot run destructive compose
# commands on inheritance alone. Both compose cells call this and grade SKIPPED
# with the returned reason; empty output (rc=1) means the cell may run.
QA_DOCKER_LIFECYCLE_ENABLED='$qa_docker_lifecycle_enabled'
QA_DOCKER_LIFECYCLE_HOST_BLOCK='$qa_docker_lifecycle_host_block'
qa_docker_lifecycle_block_reason() {
  if [ "\$QA_DOCKER_LIFECYCLE_HOST_BLOCK" = "1" ]; then
    printf '%s' 'controller is the live Hermes host; Compose lifecycle cells are forced off'
    return 0
  fi
  if [ "\$QA_DOCKER_LIFECYCLE_ENABLED" != "1" ]; then
    printf '%s' 'disabled by default; opt in only on a disposable QA target with BUNKER_QA_ENABLE_DOCKER_LIFECYCLE=1'
    return 0
  fi
  if command -v systemctl >/dev/null 2>&1 && systemctl --user is-active --quiet hermes-gateway.service 2>/dev/null; then
    printf '%s' 'active hermes-gateway.service detected; refusing Docker lifecycle test on a running Hermes system'
    return 0
  fi
  if [ -e "\$HOME/.hermes/state.db" ]; then
    for _compose_file in docker-compose*.yml compose*.yml; do
      [ -f "\$_compose_file" ] || continue
      if grep -Fq '~/.hermes:/opt/data' "\$_compose_file" 2>/dev/null || grep -Fq "\$HOME/.hermes:/opt/data" "\$_compose_file" 2>/dev/null; then
        printf 'compose file %s binds persistent Hermes storage to /opt/data' "\$_compose_file"
        return 0
      fi
    done
  fi
  return 1
}
# QA-9ROUTER-19: workflows that CAN fire on a push to the branch this checkout
# sits on (host-selected by on:-block triggerability, repo-relative, may be
# empty = "no branch-push CI here"). QA_ACT_NOTE carries the reason when the
# selection is empty and act is therefore skipped; the ci-pass cell classifies
# act failures from the LOG alone (no network call, no baked credentials).
# (QA_CI_SELECT/QA_ACT_NOTE now assigned ABOVE the staging block — use-before-
# assignment fix QA-FOREMAN-2026-09-26; the duplicate assignment that used to
# sit here landed AFTER the loop consumed them.)
TREE_TAG=\$(git tag 2>/dev/null | sort -V | tail -2 | head -1)
# QA-OFF-BY-ONE-22: materialize the previous release's tree for Go-binary
# repos — the HOST streams it (ship_prev_tag_tree -> ~/qa-up-prev); if that
# is missing, try a clone of the baked origin URL (works only for public
# URLs — bunker agents carry no clone auth).
UP_PREV=""
if [ "\$QA_TAG_COUNT" != "0" ] && [ "\$QA_ECOSYSTEM" = "go" ] && [ -n "\$QA_PREV_TAG" ]; then
  if [ -f ~/qa-up-prev/go.mod ]; then UP_PREV=~/qa-up-prev
  elif [ -n "\$QA_GO_URL" ] && git clone -q --no-checkout "\$QA_GO_URL" ~/qa-up-prev-clone 2>/dev/null && git -C ~/qa-up-prev-clone checkout -q --detach "\$QA_PREV_TAG" 2>/dev/null; then
    mv ~/qa-up-prev-clone ~/qa-up-prev && UP_PREV=~/qa-up-prev
  else
    rm -rf ~/qa-up-prev-clone 2>/dev/null
  fi
elif [ "\$QA_TAG_COUNT" != "0" ] && [ "\$QA_ECOSYSTEM" = "rust" ] && [ -n "\$QA_PREV_TAG" ]; then
  # QA-WARPFS-13 (2026-09-26): ship_prev_tag_tree streams the rust arm
  # (~/qa-up-prev, verified by Cargo.toml) but this cell only consumed it for
  # go/npm — every tagged rust repo fell through to the generic "no
  # installable previous release" FAIL. Consume the streamed tree (cargo has
  # no installable index package; the tree-stream is the only real
  # previous->HEAD upgrade path for rust).
  if [ -f "\$HOME/qa-up-prev/Cargo.toml" ]; then UP_PREV="\$HOME/qa-up-prev"; fi
elif [ "\$QA_TAG_COUNT" != "0" ] && [ "\$QA_ECOSYSTEM" = "pip" ] && [ -n "\$QA_UP_PREV_DIR" ] && [ -n "\$QA_PREV_TAG" ]; then
  # QA-TERMINAL-JAIL-19: host-streamed previous-tag tree (~/qa-up-prev-pip) for
  # pip packages NOT published to PyPI — verified by pyproject.toml, no clone
  # fallback (bunker agents carry no forge auth; the host stream is the only
  # source). Same shape as the QA-HEADING-009 npm arm.
  if [ -f "\$HOME/qa-up-prev-pip/pyproject.toml" ]; then UP_PREV="\$HOME/qa-up-prev-pip"; fi
elif [ "\$QA_TAG_COUNT" != "0" ] && [ "\$QA_ECOSYSTEM" = "npm" ] && [ -n "\$QA_UP_PREV_DIR" ] && [ -n "\$QA_PREV_TAG" ]; then
  # QA-HEADING-009: host-streamed previous-tag tree (~/qa-up-prev-npm) for
  # non-publishable npm repos — verified by package.json, no clone fallback
  # (bunker agents carry no forge auth; the host stream is the only source).
  if [ -f "\$HOME/qa-up-prev-npm/package.json" ]; then UP_PREV="\$HOME/qa-up-prev-npm"; fi
fi
if [ -n "\$TREE_TAG" ]; then
  git checkout -q --detach "\$TREE_TAG" 2>/dev/null && ( $install_cmd ) >\$LOGD/up1.log 2>&1 && git checkout -q --detach HEAD 2>/dev/null && ( $install_cmd ) >\$LOGD/up2.log 2>&1 && cell upgrade OK "tag \$TREE_TAG → HEAD reinstall clean (in-tree history)" || cell upgrade FAIL "\$(tail -2 \$LOGD/up1.log \$LOGD/up2.log | head -3)"
elif [ "\$QA_TAG_COUNT" = "0" ]; then cell upgrade N/A "no release tags in repo"
elif [ -n "\$UP_PREV" ]; then
  # Go-binary upgrade: install the previous release's tree, then reinstall
  # HEAD over it — a real previous->HEAD upgrade of the working tree.
  cp -a "\$UP_PREV" ~/qa-up-prev.bak 2>/dev/null || true
  ( cd "\$UP_PREV" && $install_cmd ) >\$LOGD/up1.log 2>&1; up1_rc=\$?
  # QA-MUSTER-13-R2: newest go rejects the module's prebuilt LTO archives
  # (CVE-2026-97038 cgo check) — retry once with the toolchain go.mod documents.
  if [ \$up1_rc -ne 0 ] && qa_toolchain_lto_rejection \$LOGD/up1.log; then
    qa_retry_with_documented_go \$LOGD/up1.log "\$UP_PREV" '$install_cmd' && up1_rc=0 || up1_rc=\$?
  fi
  ( $install_cmd ) >\$LOGD/up2.log 2>&1; up2_rc=\$?
  if [ \$up2_rc -ne 0 ] && qa_toolchain_lto_rejection \$LOGD/up2.log; then
    qa_retry_with_documented_go \$LOGD/up2.log . '$install_cmd' && up2_rc=0 || up2_rc=\$?
  fi
  rm -rf ~/qa-up-prev ~/qa-up-prev.bak ~/qa-up-prev-clone ~/qa-up-prev-npm ~/qa-up-prev-npm.bak 2>/dev/null
  if [ \$up1_rc -eq 0 ] && [ \$up2_rc -eq 0 ]; then cell upgrade OK "previous release \$QA_PREV_TAG (tree via git archive) → HEAD reinstall clean\${QA_TOOLCHAIN_FALLBACK:+ [built with the go.mod-documented toolchain \$QA_TOOLCHAIN_FALLBACK: this agent's newest go rejected the module's prebuilt LLVM-bitcode archive — CVE-2026-97038 cgo check]}"
  elif qa_toolchain_lto_rejection \$LOGD/up1.log; then cell upgrade INFO "ENV-BLOCKED: previous release \$QA_PREV_TAG (streamed tree) tripped the CVE-2026-97038 cgo check — the go command rejected the module's prebuilt LLVM-bitcode archive and the go.mod-documented-toolchain retry did not recover; agent toolchain selection is QA-MUSTER-051, not a repo defect: \$(fail_detail \$up1_rc \$LOGD/up1.log $install_cmd)"
  elif qa_native_prereq_failure \$LOGD/up1.log; then cell upgrade INFO "ENV-BLOCKED: previous release \$QA_PREV_TAG (streamed tree) build hit a missing NATIVE build prerequisite on this agent (pkg-config / libseccomp.pc) — harness env, not a repo defect\${QA_NATIVE_SYSDEPS_BLOCKED:+ [\$QA_NATIVE_SYSDEPS_BLOCKED]}: \$(fail_detail \$up1_rc \$LOGD/up1.log $install_cmd)"
  elif [ \$up1_rc -ne 0 ]; then cell upgrade FAIL "previous release \$QA_PREV_TAG would not build (streamed tree): \$(fail_detail \$up1_rc \$LOGD/up1.log "$install_cmd")"
  elif qa_toolchain_lto_rejection \$LOGD/up2.log; then cell upgrade INFO "ENV-BLOCKED: the HEAD reinstall after \$QA_PREV_TAG tripped the CVE-2026-97038 cgo check — the go command rejected the module's prebuilt LLVM-bitcode archive and the go.mod-documented-toolchain retry did not recover; agent toolchain selection is QA-MUSTER-051, not a repo defect: \$(fail_detail \$up2_rc \$LOGD/up2.log $install_cmd)"
  elif qa_native_prereq_failure \$LOGD/up2.log; then cell upgrade INFO "ENV-BLOCKED: HEAD reinstall after \$QA_PREV_TAG (streamed tree) hit a missing NATIVE build prerequisite on this agent (pkg-config / libseccomp.pc) — harness env, not a repo defect\${QA_NATIVE_SYSDEPS_BLOCKED:+ [\$QA_NATIVE_SYSDEPS_BLOCKED]}: \$(fail_detail \$up2_rc \$LOGD/up2.log $install_cmd)"
  else cell upgrade FAIL "upgrade from \$QA_PREV_TAG (streamed tree) to HEAD failed: \$(fail_detail \$up2_rc \$LOGD/up2.log "$install_cmd")"; fi
elif [ "\$QA_ECOSYSTEM" = "go" ]; then
  cell upgrade FAIL "upgrade path UNVERIFIED: repo has \$QA_TAG_COUNT release tag(s), previous \$QA_PREV_TAG, but the host's streamed previous-release tree is missing (~/qa-up-prev) and \$QA_GO_URL is not cloneable from the agent (bunker agents carry no clone auth) — re-run the battery so ship_prev_tag_tree can stream it"
elif [ "\$QA_ECOSYSTEM" = "pip" ] && [ -n "\$QA_PKG_NAME" ] && [ -n "\$QA_PREV_VERSION" ]; then
  # QA-BUNKER-57 (2026-10-04): no pip on the agent ⇒ the upgrade leg would die
  # rc=127 'pip: command not found' and grade FAIL against the repo. UNVERIFIED.
  if ! qa_have_pip; then
    cell upgrade UNVERIFIED "pip absent on agent (ensurepip failed; no sudo) — previous-release install \$QA_PKG_NAME==\$QA_PREV_VERSION never ran, so the upgrade path is untested by this cell"
  else
  ( pip install "\$QA_PKG_NAME==\$QA_PREV_VERSION" ) >\$LOGD/up1.log 2>&1; up1_rc=\$?
  ( $install_cmd ) >\$LOGD/up2.log 2>&1; up2_rc=\$?
  if [ \$up1_rc -eq 0 ] && [ \$up2_rc -eq 0 ]; then cell upgrade OK "pip \$QA_PKG_NAME==\$QA_PREV_VERSION (tag \$QA_PREV_TAG, the previous release) → HEAD install clean"
  elif [ \$up1_rc -ne 0 ]; then cell upgrade FAIL "previous release \$QA_PKG_NAME==\$QA_PREV_VERSION would not install (tag \$QA_PREV_TAG): \$(fail_detail \$up1_rc \$LOGD/up1.log "pip install \$QA_PKG_NAME==\$QA_PREV_VERSION")"
  else cell upgrade FAIL "upgrade install from \$QA_PKG_NAME==\$QA_PREV_VERSION to HEAD failed: \$(fail_detail \$up2_rc \$LOGD/up2.log "$install_cmd")"; fi
  fi
elif [ "\$QA_ECOSYSTEM" = "npm" ] && [ -n "\$QA_PKG_NAME" ] && [ -n "\$QA_PREV_VERSION" ]; then
  ( npm install -g "\$QA_PKG_NAME@\$QA_PREV_VERSION" ) >\$LOGD/up1.log 2>&1; up1_rc=\$?
  ( $install_cmd ) >\$LOGD/up2.log 2>&1; up2_rc=\$?
  if [ \$up1_rc -eq 0 ] && [ \$up2_rc -eq 0 ]; then cell upgrade OK "npm -g \$QA_PKG_NAME@\$QA_PREV_VERSION (tag \$QA_PREV_TAG, the previous release) → HEAD install clean"
  elif [ \$up1_rc -ne 0 ]; then cell upgrade FAIL "previous release \$QA_PKG_NAME@\$QA_PREV_VERSION would not install (tag \$QA_PREV_TAG): \$(fail_detail \$up1_rc \$LOGD/up1.log "npm install -g \$QA_PKG_NAME@\$QA_PREV_VERSION")"
  else cell upgrade FAIL "upgrade install from \$QA_PKG_NAME@\$QA_PREV_VERSION to HEAD failed: \$(fail_detail \$up2_rc \$LOGD/up2.log "$install_cmd")"; fi
else cell upgrade FAIL "upgrade path UNVERIFIED: the repo has \$QA_TAG_COUNT release tag(s) (previous \$QA_PREV_TAG) but the synced tree carries no history to check out and no installable previous release was detected (ecosystem='\$QA_ECOSYSTEM' package='\$QA_PKG_NAME') — treat the cell as untested, not as not-applicable"; fi

# 4 · docker-deploy — compose up + probe + down
# ACTIONABLE-FAILURE (QA-CHIMERA-V2-8, 2026-09-14): the FAIL branch used to emit
# 'tail -3 dc.log', which for a docker CLI failure is its generic footer
# ("For more help on how to use Docker, head to https://docs.docker.com/go/guides/")
# — docker prints the REAL error FIRST and the footer LAST, so the cell read FAIL
# with no diagnosis and the deployment stayed unverified. FAIL now names the
# command, its rc, and the log's leading lines via fail_detail().
# QA-BUNKER-38 (2026-10-30): root-only ls missed nested compose files
# (stack/docker-compose.yml) — compose_config already used find, align here.
COMPOSE_FILES=\$(find . -maxdepth 4 -type f \( -name 'docker-compose*.yml' -o -name 'docker-compose*.yaml' -o -name 'compose*.yml' -o -name 'compose*.yaml' \) 2>/dev/null | head -5)
docker_lifecycle_reason=\$(qa_docker_lifecycle_block_reason || true)
if [ -n "\$docker_lifecycle_reason" ]; then
  cell docker-deploy SKIPPED "safety gate: \$docker_lifecycle_reason"
elif [ -n "\$COMPOSE_FILES" ]; then
  DC_CMD="docker compose up -d --build"
  ( \$DC_CMD ) >\$LOGD/dc.log 2>&1; dc_rc=\$?
  if [ \$dc_rc -eq 0 ]; then
    # QA-HERMES-CANOPY-31 (2026-09-24 evidence: single-shot probe read 000
    # while the server was booting; deploy was actually GOOD). Poll each mapped
    # host port for up to \${BUNKER_QA_DEPLOY_PROBE_TIMEOUT:-60}s, first
    # non-000 answer wins.
    HP=""
    # QA-HEADING-011 part 2 (2026-09-25, measured on this repo): the deadline
    # was computed ONCE for all ports, and docker-compose*.yml globs in the
    # PROD file too (prod's :3000 leads alphabetically) — a dead first port
    # burned the whole 60s before the live api :4000 was ever probed, and the
    # healthy deploy still graded 'no HTTP response'. Allocate the FULL window
    # PER PORT (reset inside the loop); the OK path finds a live port in
    # seconds, the worst case is bounded at 3x the window.
    # QA-BUNKER-27 (2026-10-29): the old two-pattern extraction (quote-adjacent
    # bare digits:digits, whitespace-adjacent bare digits:digits) matched NEITHER
    # arm of a bind-address-qualified mapping ("127.0.0.1:31299:80") — zero ports
    # probed, healthy deploys graded 'no HTTP response' (duckbrain 2026-09-27).
    # ONE alternation now consumes each whole mapping (optional quote, optional
    # dotted-quad host, host:container); leftmost-longest stops the bare arm from
    # re-biting inside a consumed mapping. The dotted host survives dedupe and is
    # normalized to host/port per token below (bare tokens probe 127.0.0.1; the
    # numeric guard skips non-numeric noise — e.g. an [ipv6]-bracket leftover —
    # while still probing its host port). A zero-probed-port run grades
    # UNVERIFIED, never a deploy success.
    # Generator escaping (unquoted heredoc): \$0 in the awk is BACKSLASHED — a
    # bare \$0 here is generation-expanded to THIS script's path in the emitted
    # bytes (a seen[<host-script-path>] contamination of the generated script).
    # QA-BUNKER-38: iterate over found compose files, not root-only glob.
    # DF-CRIER-498 / QA-CRIER-REVIEW-7 (2026-11-03..05 crier evidence): the old
    # alternation matched only literal digits:digits, so env-var interpolated
    # mappings ("\${VAR:-8767}:8767") yielded ZERO ports (the closing brace broke
    # the match) and healthy deploys graded UNVERIFIED. Two new arms carry
    # interpolated mappings through to the loop; qa_resolve_port_expr resolves
    # them (environment, then repo .env, then the :- default). The bare arm now
    # takes the HOST side — the old arm passed the whole a:b token, which the
    # numeric guard then skipped, so bare mappings were never probed either.
    probed_n=0; probed_ports=" "
    # QA-CRIER-REVIEW-7-R3 (2026-11-16): the port cap is now head -6 (was head -3) so
    # a multi-service stack whose postgres mapping orders ahead of its HTTP mapping
    # still gets the serving port probed. The "3x the window" bound stated above is
    # SUPERSEDED: the bound is now 6x. Per-port window allocation is retained — there
    # is still NO shared deadline.
    # Per-port evidence (same fix): probe_win is the readiness window actually used
    # for each port, probe_trace records "<host>:<port>=<final status>" for every
    # probed mapping, probe_windows records the seconds each port consumed, and
    # probe_total is the whole probing phase — the non-2xx detail below is built
    # from them, so an unanswered probe can never be graded with a bare status.
    probe_win="\${BUNKER_QA_DEPLOY_PROBE_TIMEOUT:-60}"
    probe_t0=\$(date +%s)
    probe_trace=""; probe_windows=""
    for m in \$( { for f in \$COMPOSE_FILES; do grep -hoE '"?([0-9]{1,3}\.){3}[0-9]+:[0-9]+:[0-9]+"?|"?[0-9]+:[0-9]+"?|[$][{][^}]+[}]:[0-9]+|[$][A-Za-z_][A-Za-z0-9_]*:[0-9]+' "\$f" 2>/dev/null; done; } | grep -oE '([0-9]{1,3}\.){3}[0-9]+:[0-9]+|[$][{][^}]+[}]:[0-9]+|[$][A-Za-z_][A-Za-z0-9_]*:[0-9]+|[0-9]+:[0-9]+' | awk '!seen[\$0]++' | head -6 ); do
      case "\$m" in
        '\${'*) hp_host=127.0.0.1; hp_port=\$(qa_resolve_port_expr "\${m%:*}") ;;
        '\$'*) hp_host=127.0.0.1; hp_port=\$(qa_resolve_port_expr "\${m%:*}") ;;
        *.*:*) hp_host=\${m%%:*}; hp_port=\${m#*:} ;;
        *) hp_host=127.0.0.1; hp_port=\${m%%:*} ;;
      esac
      case "\$hp_port" in *[!0-9]*|"") continue ;; esac
      # QA-CRIER-REVIEW-7-R4 (2026-11-16): the YAML mapping is only a CLAIM
      # about which host port the deploy publishes. Resolve the port the
      # CONTAINER actually owns first — \`docker compose port <svc> <cport>\`
      # reads the CLI's own binding table (0.0.0.0/:: normalized to 127.0.0.1)
      # — and keep the YAML value only as the fallback when the service cannot
      # be derived or the CLI cannot resolve it. One call per candidate mapping,
      # i.e. part of target RESOLUTION like the probe itself, not the lazily
      # built ps/log payload below.
      hp_via="yaml mapping"
      dc_svc="\$(qa_compose_service_for_mapping "\$m")"
      if [ -n "\$dc_svc" ]; then
        dc_pub="\$(docker compose port "\$dc_svc" "\${m##*:}" 2>/dev/null | head -1 | tr -d '\r')"
        case "\$dc_pub" in
          *:[0-9]*)
            dc_hp="\${dc_pub##*:}"; dc_hh="\${dc_pub%:*}"
            case "\$dc_hh" in 0.0.0.0|'') dc_hh=127.0.0.1 ;; *[!0-9.]*) dc_hh=127.0.0.1 ;; esac
            case "\$dc_hp" in
              ''|*[!0-9]*) : ;;
              *) hp_host="\$dc_hh"; hp_port="\$dc_hp"
                 hp_via="docker compose port \$dc_svc \${m##*:}" ;;
            esac ;;
        esac
      fi
      case "\$probed_ports" in *" \$hp_port "*) continue ;; esac
      probed_ports="\$probed_ports\$hp_port "
      probed_n=\$((\$probed_n + 1))
      p_t0=\$(date +%s)
      DEADLINE=\$((p_t0 + probe_win))
      while [ \$(date +%s) -lt \$DEADLINE ]; do
        HP=\$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 "http://\$hp_host:\$hp_port/" 2>/dev/null)
        [ "\$HP" != "000" ] && break
        sleep 3
      done
      [ -n "\$HP" ] || HP=000
      probe_trace="\$probe_trace \$hp_host:\$hp_port=\$HP"
      probe_windows="\$probe_windows \$hp_host:\$hp_port=\$(( \$(date +%s) - p_t0 ))s"
      [ "\$HP" != "000" ] && break
    done
    probe_total=\$(( \$(date +%s) - probe_t0 ))
    # QA-CRIER-REVIEW-7-R4 (2026-11-16): ATTRIBUTION of the answer. An HTTP
    # status on a host port is only evidence about the deploy if THIS compose
    # project publishes that port; the loop above used to credit any answer to
    # the deploy, so a leftover native binary or a previous container holding
    # the port produced an OK cell for a dead stack. hp_own is
    # owned | stranger | unknown and hp_who names the listening pid, its
    # cmdline and the basis of the verdict (see qa_deploy_attribution). These
    # lookups run only when a port ANSWERED — an all-000 probe pays nothing —
    # and they are verdict evidence, not the lazily-built ps/log payload.
    hp_own="unprobed"; hp_who=""
    if [ "\$HP" != "000" ]; then
      qa_attr="\$(qa_deploy_attribution "\$hp_port")"
      hp_own="\${qa_attr%%|*}"; hp_who="\${qa_attr#*|}"
    fi
    if [ "\$probed_n" -eq 0 ]; then
      cell docker-deploy UNVERIFIED "compose up OK but no probed host port (no parseable or resolvable host:container mapping in compose files) — serving state UNVERIFIED, not a deploy success"
    elif [ "\$hp_own" = "stranger" ]; then
      # Named failure, never a pass: the port answered, but not from this
      # deploy. The payload records the owning pid/cmdline and the published
      # set the verdict was based on, so the finding is actionable.
      cell docker-deploy FAIL "compose up OK but \$hp_host:\$hp_port answered \$HP from a NON-COMPOSE process: \$hp_who — a leftover native binary or a previous container holds the port, so this deploy is UNVERIFIED (probed via \$hp_via; window \${probe_win}s/port [\$(printf '%s' "\$probe_windows" | sed 's/^ *//; s/ *\$//')], total \${probe_total}s)"
    else
      # QA-CRIER-REVIEW-7-R3 (2026-11-16; tick crier-qa-2026-11-15-10-07-44, agent
      # fcacb544): the non-2xx arm emitted a bare success-shaped sentence that quoted
      # nothing but the raw probe code — 000 matches [0-9]*, so an UNANSWERED probe
      # was graded with that sentence, naming no host, no port, no readiness window
      # and no container state, and a stack whose image booted and crashed looked
      # like a healthy one still starting. Both non-2xx arms now carry ONE evidence
      # line built from the per-port records above: every probed host:port with its
      # final status, the readiness window used per port and the total, the compose
      # service states, and the container log tail (or the leading lines of dc.log,
      # fail_detail style, when the tail is empty). The line is kept single-line and
      # free of double quotes so it survives the JSONL detail field intact.
      # QA-CRIER-REVIEW-7-R4 (2026-11-16): that payload costs two docker calls
      # (\`compose ps\`, \`compose logs\`) and a 2xx deploy never printed it, so it
      # is built INSIDE the non-2xx arm only — the acceptance for a pass no
      # longer pays for evidence nobody reads. The attribution lines above are
      # NOT part of this payload: they are the verdict's own evidence and run
      # only when a port answered.
      case "\$HP" in
        200|301|302)
          cell docker-deploy OK "compose up + probe \$HP on \$hp_host:\$hp_port — answered by \$hp_who (probed via \$hp_via)" ;;
        *)
          DP_EV="probed \$(printf '%s' "\$probe_trace" | sed 's/^ *//; s/ *\$//')"
          DP_EV="\$DP_EV; window \${probe_win}s/port [\$(printf '%s' "\$probe_windows" | sed 's/^ *//; s/ *\$//')], total \${probe_total}s"
          DP_PS=\$(docker compose ps --format '{{.Name}}/{{.State}}/{{.Health}}' 2>/dev/null | tr -d '\r' | paste -sd',' - | cut -c1-300)
          [ -n "\$DP_PS" ] || DP_PS="unavailable"
          DP_LOG=\$(docker compose logs --tail=20 2>&1 | tr -d '\r' | tr '"' "'" | paste -sd'|' - | sed 's/|/ | /g' | cut -c1-400)
          [ -n "\$DP_LOG" ] || DP_LOG=\$(grep -v '^[[:space:]]*\$' "\$LOGD/dc.log" 2>/dev/null | head -3 | tr '\n' '|' | tr '"' "'" | cut -c1-400)
          [ -n "\$DP_LOG" ] || DP_LOG="no container log captured"
          DP_EV="\$DP_EV; ps [\$DP_PS]; logs [\$DP_LOG]"
          [ -z "\$hp_who" ] || DP_EV="\$DP_EV; answered by \$hp_who"
          case "\$HP" in
            [0-9]*) cell docker-deploy INFO "compose up OK, no 2xx/3xx answer (final probe \$HP on \$hp_host:\$hp_port): \$DP_EV" ;;
            *) cell docker-deploy INFO "compose up OK, no HTTP response within \${probe_win}s (probe deadline exhausted): \$DP_EV" ;;
          esac ;;
      esac
    fi
    docker compose down >/dev/null 2>&1
  else cell docker-deploy FAIL "\$(fail_detail \$dc_rc \$LOGD/dc.log \$DC_CMD)"; fi
else cell docker-deploy N/A "no compose file"; fi

# 5 · ui-probe
# FIX · ui-probe Go-served HTML (QA-CRIER-19, 2026-09-21): the gate keyed only on a
# package.json dev/start script, so a Go repo serving an HTML docs surface (crier:
# /docs on :8767) was graded N/A "no web UI detected" on every cycle — a false
# negative: the artifact exists, the gate could not see it. Now: no npm UI detected
# -> start the repo's own \$BIN (detected above) and probe a port list for 200
# text/html before N/A is accepted (\${BUNKER_QA_UI_PORTS:-3000 5173 8000 8080 8081
# 8767 9000}). Measured on crier 2026-09-21: the upstream cmd/ scan resolves BIN to
# go run ./cmd/crier-mcp (alphabetically first; a stdio server that exits on stdin
# EOF), NOT ./cmd/server — so when the detected BIN exits before any port answers
# and further cmd/ main packages exist, the arm retries each of them once before it
# accepts not-a-server; and it polls /docs before / because crier's / is 404 JSON.
# Teardown kills the whole process GROUP (setsid): go run compiles and runs a
# child binary, and killing the wrapper alone orphans the real listener.
# SHARED-BOX GUARD (measured 2026-09-21): the fleet box already serves HTML on
# Vite's default :5173 (canopy-vite), so ports occupied BEFORE the start are
# excluded from attribution AND from fuser teardown — a first-HTML-wins poll
# credited the foreign server to the repo under test, and a bare fuser -k on
# an answering port kills unrelated socket-holders (measured: it killed a
# process that merely HELD A CONNECTION to :5173).
if [ -f package.json ] && grep -qE '"dev"|"start"' package.json; then
  # QA-9ROUTER-21 (2026-09-21): the old probe curled / with NO -L and accepted
  # only 200, so any redirect-first UI graded a guaranteed false FAIL —
  # 9router serves / -> 307 /dashboard -> 307 /login -> 200 (auth-guard
  # redirect-first routing is the app's normal shape) and the cell recorded
  # ui-probe FAIL "UI not serving (http=307)" while the UI was up the whole
  # time. Now: follow the redirect chain (-L), accept ANY 2xx (a served page
  # is a served page; the code is recorded), and keep the real negative —
  # 4xx/5xx/000 still FAIL, naming the code AND the landing path.
  # Teardown fix in the same cell: the old bare \`pkill -f 'npm run dev'\`
  # matched by command line (it once killed an UNRELATED process whose argv
  # merely contained the pattern — the frontend/ arm below documents the live
  # incident) and still LEAKED the node listener. Replaced with the arm's own
  # PID + process-GROUP kill (custom-server style wrappers fork a child, so
  # the group is what dies together), with the fuser sweep as the catch-all.
  ( npm run dev -- --port 3111 >\$LOGD/ui.log 2>&1 & ); sleep 5
  UI_NPM_PID=\$(pgrep -f 'npm run dev' | head -1)
  # QA-HEADING-015 (2026-10-04): the old single-shot curl after sleep 15 lost
  # the race against next dev's first compile (~6-9s warm-up) — the probe
  # fired before the listener was bound and graded http=000 while ui.log
  # proved the server answered GET / 200 shortly after. Now: poll up to 30s
  # (matching the go-native arm's 20-iteration pattern) before accepting 000.
  UP="000"; LAND=""
  for _ui_i in \$(seq 1 30); do
    kill -0 "\$UI_NPM_PID" 2>/dev/null || break
    UP=\$(curl -sL -o /dev/null -w '%{http_code}' --max-time 3 http://127.0.0.1:3111/ 2>/dev/null)
    [ "\$UP" != "000" ] && break
    sleep 1
  done
  LAND=\$(curl -sL -o /dev/null -w '%{url_effective}' --max-time 5 http://127.0.0.1:3111/ 2>/dev/null)
  UI_NPM_PGID=\$(ps -o pgid= -p \$UI_NPM_PID 2>/dev/null | tr -d ' ')
  if [ -n "\$UI_NPM_PGID" ] && [ "\$UI_NPM_PGID" = "\$UI_NPM_PID" ]; then
    kill -- -\$UI_NPM_PID 2>/dev/null || true; sleep 1; kill -9 -- -\$UI_NPM_PID 2>/dev/null || true
  fi
  kill \$UI_NPM_PID 2>/dev/null || true; sleep 1; kill -9 \$UI_NPM_PID 2>/dev/null || true
  fuser -k 3111/tcp >/dev/null 2>&1 || true
  case "\$UP" in
    2??) cell ui-probe OK "UI serves \$UP on :3111 (landed: \${LAND:-/})" ;;
    *) cell ui-probe FAIL "UI not serving (http=\$UP\${LAND:+, landed: \$LAND}): \$(tail -2 \$LOGD/ui.log)" ;;
  esac
elif [ -f frontend/package.json ] && grep -qE '"dev"|"start"' frontend/package.json; then
  # FIX · ui-probe frontend/ (QA-HERMES-CANOPY-9, 2026-09-21): a repo whose UI
  # is a Vite/npm app under frontend/ (NO root package.json) was graded N/A
  # "no web UI detected" on every cycle — the shipped user surface never probed
  # (hermes-canopy: 4 consecutive cycles, frontend/package.json + vite present,
  # canopy-vite serving 200 on :5173 the whole time). Mirrors the root-npm arm
  # but rooted at frontend/. Teardown is setsid + PROCESS-GROUP kill, measured
  # on this box 2026-09-21: the root arm's bare pkill -f 'npm run dev' LEAKS
  # the node listener (probe still 200 after teardown), and a blanket
  # a pkill -f 'node .*vite' safety net is worse — it killed the UNRELATED
  # canopy-vite dev server on :5173 (argv merely contains "vite"). Group kill
  # guard: only kill -PGID when pgid == pid (the setsid leader case); the
  # fuser sweep on the probe port is the catch-all.
  # QA-HERMES-CANOPY-32 (2026-09-24 evidence: JIT agent image ships NO node/npm;
  # frontend arm died "No such file or directory" while the repo was fine).
  # Availability gate: when npm is absent the arm grades ENV-BLOCKED and skips
  # execution — when npm IS present but the UI does not serve, FAIL stays as-is.
  if ! command -v npm >/dev/null 2>&1; then
    cell ui-probe INFO "ENV-BLOCKED: node/npm unavailable on agent — frontend arm skipped (install failed or offline)"
  else
    if [ ! -d frontend/node_modules ]; then
      npm ci --prefix frontend --ignore-scripts --no-audit --no-fund >>\$LOGD/ui.log 2>&1 || npm install --prefix frontend --ignore-scripts --no-audit --no-fund >>\$LOGD/ui.log 2>&1 || true
    fi
    ( cd frontend && setsid npm run dev -- --port 3111 >\$LOGD/ui.log 2>&1 & )
    sleep 5
    UI_NPM_PID=\$(pgrep -f 'npm run dev' | head -1)
    # QA-HEADING-015 (2026-10-04): same race as the root-npm arm — poll up to 30s
    UP="000"; LAND=""
    for _ui_i in \$(seq 1 30); do
      kill -0 "\$UI_NPM_PID" 2>/dev/null || break
      UP=\$(curl -sL -o /dev/null -w '%{http_code}' --max-time 3 http://127.0.0.1:3111/ 2>/dev/null)
      [ "\$UP" != "000" ] && break
      sleep 1
    done
    LAND=\$(curl -sL -o /dev/null -w '%{url_effective}' --max-time 5 http://127.0.0.1:3111/ 2>/dev/null)
    UI_NPM_PGID=\$(ps -o pgid= -p \$UI_NPM_PID 2>/dev/null | tr -d ' ')
    if [ -n "\$UI_NPM_PGID" ] && [ "\$UI_NPM_PGID" = "\$UI_NPM_PID" ]; then
      kill -- -\$UI_NPM_PID 2>/dev/null || true; sleep 1; kill -9 -- -\$UI_NPM_PID 2>/dev/null || true
    fi
    kill \$UI_NPM_PID 2>/dev/null || true; sleep 1; kill -9 \$UI_NPM_PID 2>/dev/null || true
    fuser -k 3111/tcp >/dev/null 2>&1 || true
    case "\$UP" in
      2??) cell ui-probe OK "UI serves \$UP on :3111 (frontend/, landed: \${LAND:-/})" ;;
      *) cell ui-probe FAIL "frontend/ UI not serving (http=\$UP\${LAND:+, landed: \$LAND}): \$(tail -2 \$LOGD/ui.log)" ;;
    esac
  fi
  # FIX · ui-probe Go-native gate (QA-BUNKER-33, 2026-11-01): the server-pattern
  # grep globbed ONLY root-level *.go, so a standard-layout repo (entrypoint
  # cmd/main.go, pkg/…, internal/…) matched nothing and fell through to N/A
  # "no web UI detected" — even though the arm below already resolves
  # go run ./cmd/<pkg> (BIN detection, cmd/ fallback queue). Now scans the tree
  # recursively, so HTTP idioms under cmd/ pkg/ internal/ enter the arm; root
  # level mains still match (backward compatible); .git/vendor/node_modules are
  # skipped so vendored server libraries cannot fake the trigger (mirrors the
  # bounded trigger scan of the lint cell above).
elif [ -f go.mod ] && grep -qrE 'http\.ListenAndServe|http\.Server|chi\.NewRouter|mux\.NewRouter|gin\.Default|echo\.New|gorilla/mux' --include='*.go' --exclude-dir=.git --exclude-dir=vendor --exclude-dir=node_modules . 2>/dev/null; then
  UI_PORTS=\${BUNKER_QA_UI_PORTS:-3000 5173 8000 8080 8081 8766 8767 9000}
  UI_BINS="\${BIN:-go run .}"
  case "\${BIN:-}" in
    "go run ./cmd/"*)
      # start-cmd fallback queue: when the detected cmd/ binary is not the HTTP
      # server (see comment above), the remaining cmd/ main packages get one
      # bounded try each before the cell accepts not-a-server.
      for c in \$(grep -rlsE '^package main' cmd --include='*.go' 2>/dev/null | sort | sed 's|/[^/]*\$||' | sort -u); do
        [ "go run ./\$c" = "\$BIN" ] || UI_BINS="\$UI_BINS|go run ./\$c"
      done
      ;;
  esac
  IFS='|' read -r -a UI_LIST <<< "\$UI_BINS"
  # Baseline: which probed ports answer BEFORE we start anything — those are
  # somebody else's and are skipped for both attribution and teardown below.
  UI_OCCUPIED=" "
  for p in \$UI_PORTS; do
    UI_C=\$(curl -s -o /dev/null -w '%{http_code}' --max-time 1 "http://127.0.0.1:\$p/" 2>/dev/null)
    [ "\$UI_C" = "000" ] && UI_C=\$(curl -s -o /dev/null -w '%{http_code}' --max-time 1 "http://127.0.0.1:\$p/docs" 2>/dev/null)
    if [ -n "\$UI_C" ] && [ "\$UI_C" != "000" ]; then UI_OCCUPIED="\$UI_OCCUPIED\$p "; fi
  done
  UI_HIT=""; UI_OTHER=""; UI_PROBED=" "
  for UI_B in "\${UI_LIST[@]}"; do
    ( setsid timeout 45 \$UI_B ) </dev/null >\$LOGD/ui-probe.log 2>&1 &
    UIPID=\$!
    UI_HIT=""; UI_OTHER=""
    for i in \$(seq 1 20); do
      kill -0 \$UIPID 2>/dev/null || break
      for p in \$UI_PORTS; do
        case "\$UI_OCCUPIED" in *" \$p "*) continue ;; esac
        UI_R=\$(curl -s -o /dev/null -w '%{http_code} %{content_type}' --max-time 2 "http://127.0.0.1:\$p/docs" 2>/dev/null)
        case "\$UI_R" in "200 text/html"*) UI_HIT=\$p; break 2 ;; 000*|"") : ;; *) case "\$UI_PROBED" in *" \$p "*) : ;; *) UI_PROBED="\$UI_PROBED\$p "; UI_OTHER="\$UI_OTHER \${p}=[\$UI_R]" ;; esac ;; esac
        UI_R=\$(curl -s -o /dev/null -w '%{http_code} %{content_type}' --max-time 2 "http://127.0.0.1:\$p/" 2>/dev/null)
        case "\$UI_R" in "200 text/html"*) UI_HIT=\$p; break 2 ;; 000*|"") : ;; *) case "\$UI_PROBED" in *" \$p "*) : ;; *) UI_PROBED="\$UI_PROBED\$p "; UI_OTHER="\$UI_OTHER \${p}=[\$UI_R]" ;; esac ;; esac
      done
      sleep 1
    done
    if [ -n "\$UI_HIT" ] || [ -n "\$UI_OTHER" ] || kill -0 \$UIPID 2>/dev/null; then break; fi
  done
  if [ -n "\$UI_HIT" ]; then
    cell ui-probe OK "go-native http server responded (pattern: \$UI_B, port \$UI_HIT)"
  elif [ -n "\$UI_OTHER" ]; then
    cell ui-probe INFO "go-native server serves but no 200 text/html surface found on probed ports [\$UI_PORTS]:\$UI_OTHER"
  elif ! kill -0 \$UIPID 2>/dev/null; then
    cell ui-probe INFO "go-native start command is not a long-running server (rc/exit in log) — no HTML surface to probe: \$(tail -2 \$LOGD/ui-probe.log)"
  else
    cell ui-probe INFO "go-native server ran 20s, no probed port answered [\$UI_PORTS] — surface may be on an unlisted port: \$(tail -2 \$LOGD/ui-probe.log)"
  fi
  kill -- -\$UIPID 2>/dev/null; sleep 1; kill -9 -- -\$UIPID 2>/dev/null
  kill \$UIPID 2>/dev/null; sleep 1; kill -9 \$UIPID 2>/dev/null
  for p in \$UI_PROBED; do fuser -k \$p/tcp >/dev/null 2>&1; done
  true
else cell ui-probe N/A "no web UI detected"; fi

# 6 · chaos-disconnect — network cut via dead proxy: clean fail or HANG?
# Window is sized from the NATIVE SUITE's observed duration (suite_dur, timed
# around the ci-pass native run above): 2x + 30s, with
# BUNKER_QA_DISCONNECT_TIMEOUT as the minimum floor. A fixed 240s window misread
# a 100s suite as a hang on a slower agent (QA-HERMES-CANOPY-21). The computed
# window is APPLIED to the timeout invocation below — not merely named.
disconnect_suite_counts() { # <log> — require evidence that tests actually ran
  grep -Eq '(^|[[:space:]])[1-9][0-9]* (passed|failed|error|errors)([[:space:]]|$)|^ok[[:space:]]+[^[:space:]]+[[:space:]]+[0-9]|test result:.*[1-9][0-9]* passed' "\$1" 2>/dev/null
}
disconnect_log_valid() { # <log> — cut marker AND non-vacuous test counts are required
  grep -q '^NETWORK_CUT_APPLIED$' "\$1" 2>/dev/null && disconnect_suite_counts "\$1"
}
disc_window=\$(( \${suite_dur:-0} * 2 + 30 ))
[ "\$disc_window" -lt \${BUNKER_QA_DISCONNECT_TIMEOUT:-240} ] && disc_window=\${BUNKER_QA_DISCONNECT_TIMEOUT:-240}
# QA-HERMES-DAGGER-13: GOPROXY=off makes module fetch fail fast instead of
# blocking on the dead proxy; with the warm cache from the native run the
# build succeeds offline, so the disconnect cut is exercised against a real
# build. GOTOOLCHAIN=local prevents a toolchain download attempt. These env
# vars are harmless for non-Go native_cmd values (npm/pytest/cargo ignore them).
{ echo NETWORK_CUT_APPLIED
  HTTP_PROXY=http://127.0.0.1:9 HTTPS_PROXY=http://127.0.0.1:9 ALL_PROXY=http://127.0.0.1:9 GOFLAGS=-mod=mod GOPROXY=off GOSUMDB=off GOTOOLCHAIN=local timeout \$disc_window bash -c "\${native_cmd:-$native_cmd}"
} >\$LOGD/disc.log 2>&1; disc_rc=\$?
# QA-BUNKER-56-R2: this whole ladder is AGENT-side — suite_dur/LOGD/disc_rc are
# assigned by the rendered script (above), so their refs stay escaped for the
# heredoc (36dbac06 un-escaped three of them and the generator's own set -u
# killed every render at "suite_dur: unbound variable" — 0-byte qa-run.sh).
# The bash -c payload stays GENERATOR-side (same style as the res leg): the
# render bakes the detected suite into an agent-side default guard, so the
# cut actually runs the suite. Pre-fix the leg shipped a bare agent-side
# native_cmd ref that nothing assigned: bash -c got an empty payload, exited
# 0 instantly, and disc.log stayed 0 bytes on every repo.
native_dur=\$suite_dur
# An empty subject is not a disconnect verdict: the probe may never have run.
if [ ! -s "\$LOGD/disc.log" ]; then
  cell chaos-disconnect UNVERIFIED "disc.log is EMPTY — the disconnect cut has no subject log; suite execution is unverified"
elif { [ \$disc_rc -eq 0 ] || [ \$disc_rc -eq 1 ]; } && ! disconnect_log_valid "\$LOGD/disc.log"; then
  cell chaos-disconnect UNVERIFIED "disconnect log lacks NETWORK_CUT_APPLIED or suite counts — the cut/result is unverified: \$(tail -3 \$LOGD/disc.log)"
elif [ \$disc_rc -eq 0 ]; then cell chaos-disconnect INFO "passes with network cut (no network dep)"
elif [ \$disc_rc -eq 124 ]; then cell chaos-disconnect FAIL "HANGS when network is cut (timeout \${disc_window}s, sized from the \${native_dur}s suite: 2x+30s; override floor BUNKER_QA_DISCONNECT_TIMEOUT=\${BUNKER_QA_DISCONNECT_TIMEOUT:-240}s) — \$(head -3 \$LOGD/disc.log)"
elif [ \$disc_rc -eq 127 ]; then cell chaos-disconnect UNVERIFIED "command not found (rc=127) — the suite NEVER RAN, so the network cut was never exercised; INFRA-FAIL, not a disconnect result: \$(tail -2 \$LOGD/disc.log)"
elif build_incomplete \$LOGD/disc.log; then cell chaos-disconnect INFO "disconnect UNVERIFIED: the build never completed, so the network cut was NEVER exercised — no disconnect finding either way (rc=\$disc_rc; environment or code, never network): \$(build_incomplete_cause \$LOGD/disc.log)"
elif go_suite_env_failure \$LOGD/disc.log; then cell chaos-disconnect INFO "ENV-BLOCKED: the go suite failed because the test host lacks a build tool (\`make\` on JIT agents, measured 2026-09-19) — the disconnect cut was exercised against a broken build, no disconnect finding (rc=\$disc_rc): \$(grep -m1 -E 'exec: .* executable file not found' \$LOGD/disc.log)"
elif suite_deps_missing \$LOGD/disc.log; then cell chaos-disconnect UNVERIFIED "missing test dependencies — the suite NEVER RAN, so the network cut was never exercised; INFRA-FAIL, not a disconnect result (rc=\$disc_rc): \$(suite_deps_missing_cause \$LOGD/disc.log)"
elif native_runner_missing \$LOGD/disc.log; then cell chaos-disconnect UNVERIFIED "native runner missing (rc=\$disc_rc) - the suite NEVER RAN, so the network cut was never exercised; INFRA-FAIL, not a disconnect result: \$(native_runner_missing_cause \$LOGD/disc.log)"
else cell chaos-disconnect OK "chaos-disconnect tests: fails fast on disconnect (rc=\$disc_rc): \$(head -2 \$LOGD/disc.log)"; fi

# 7 · chaos-shutdown — SIGTERM stop/restart + SIGKILL recovery (docker path)
# QA-BUNKER-38 (2026-10-30): root-only ls missed nested compose files — align
# with compose_config and docker-deploy using find.
COMPOSE_FILES=\$(find . -maxdepth 4 -type f \( -name 'docker-compose*.yml' -o -name 'docker-compose*.yaml' -o -name 'compose*.yml' -o -name 'compose*.yaml' \) 2>/dev/null | head -5)
docker_lifecycle_reason=\$(qa_docker_lifecycle_block_reason || true)
if [ -n "\$docker_lifecycle_reason" ]; then
  cell chaos-shutdown SKIPPED "safety gate: \$docker_lifecycle_reason"
elif [ -n "\$COMPOSE_FILES" ]; then
  # QA-HEADING-010 (2026-09-25): the && chain short-circuited BEFORE its echo
  # markers, so a first-verb failure left sd.log EMPTY and the cell graded
  # FAIL "rc=1" with no attribution. Run EVERY verb unconditionally, echo each
  # step's rc, and derive sd_rc as the FIRST failing step — the trace names
  # the failing verb; grading below still keys on the STOP=/KILLRECOVER= markers.
  up_rc=0; stop_rc=0; start1_rc=0; kill_rc=0; start2_rc=0; down_rc=0
  { docker compose up -d >/dev/null 2>&1; up_rc=\$?; echo UP=\$up_rc
    docker compose stop >/dev/null 2>&1; stop_rc=\$?; echo STOP=\$stop_rc
    [ \$stop_rc -eq 0 ] && sleep 4
    docker compose start >/dev/null 2>&1; start1_rc=\$?; echo RESTART=\$start1_rc
    docker compose kill >/dev/null 2>&1; kill_rc=\$?; echo KILL=\$kill_rc
    [ \$kill_rc -eq 0 ] && sleep 2
    docker compose start >/dev/null 2>&1; start2_rc=\$?; echo KILLRECOVER=\$start2_rc
    docker compose down >/dev/null 2>&1; down_rc=\$?; echo DOWN=\$down_rc
  } >\$LOGD/sd.log 2>&1
  sd_rc=\$up_rc
  [ "\$sd_rc" -eq 0 ] && sd_rc=\$stop_rc
  [ "\$sd_rc" -eq 0 ] && sd_rc=\$start1_rc
  [ "\$sd_rc" -eq 0 ] && sd_rc=\$kill_rc
  [ "\$sd_rc" -eq 0 ] && sd_rc=\$start2_rc
  [ "\$sd_rc" -eq 0 ] && sd_rc=\$down_rc
  if [ "\$up_rc" -ne 0 ]; then cell chaos-shutdown FAIL "compose up failed before the stop/kill chain — \$(fail_detail \$up_rc \$LOGD/sd.log 'docker compose up -d')"
  elif [ "\$stop_rc" -ne 0 ]; then cell chaos-shutdown FAIL "compose stop failed rc=\$stop_rc (chain rc=\$sd_rc) — \$(cat \$LOGD/sd.log)"
  elif [ "\$start1_rc" -ne 0 ]; then cell chaos-shutdown FAIL "compose start (post-stop) failed rc=\$start1_rc (chain rc=\$sd_rc) — \$(cat \$LOGD/sd.log)"
  elif [ "\$kill_rc" -ne 0 ]; then cell chaos-shutdown INFO "graceful ok, kill step failed rc=\$kill_rc (chain rc=\$sd_rc) — \$(cat \$LOGD/sd.log)"
  elif [ "\$start2_rc" -ne 0 ]; then cell chaos-shutdown FAIL "kill-recovery start failed rc=\$start2_rc (chain rc=\$sd_rc) — \$(cat \$LOGD/sd.log)"
  elif [ "\$down_rc" -ne 0 ]; then cell chaos-shutdown OK "SIGTERM + SIGKILL recovery clean (down rc=\$down_rc ignored)"
  elif grep -qE 'STOP=0' \$LOGD/sd.log && grep -qE 'KILLRECOVER=0' \$LOGD/sd.log; then cell chaos-shutdown OK "SIGTERM + SIGKILL recovery clean"
  elif grep -qE 'STOP=0' \$LOGD/sd.log; then cell chaos-shutdown INFO "graceful ok, kill-recovery issue: \$(cat \$LOGD/sd.log)"
  else cell chaos-shutdown FAIL "\$(fail_detail \$sd_rc \$LOGD/sd.log 'docker compose up -d; stop; start; kill; start; down')"; fi
else cell chaos-shutdown N/A "no compose file"; fi

# 8 · chaos-corruption — truncate a state file, OBSERVE the next start, restore
# QA-GITREINS-POC-6 (2026-09-17): the old cell truncated the first *.db that
# find returned and recorded INFO "state file truncated: \$SF — watch crash
# behavior on next start". No start was ever observed (that WAS the finding), the
# truncated file was left in place for the cells that run after it, and the cell
# could not tell a real state store from a stray — for gitreins-poc it picked
# ./dev.db, an untracked leftover that no source file in the tree references.
# Now: candidates exclude tool caches, a candidate whose basename appears in the
# project's own source wins, the next start IS run under a timeout, the outcome
# is classified, and ~/state.bak is restored either way.
# QA-CRIER-8-R2 (2026-11-17): repos whose durable state is JSONL/append-log or
# directory-shaped (no *.db/*.sqlite anywhere — e.g. append logs + evidence
# dirs) got a FALSE N/A here, skipping exactly the products a torn line can
# damage. The candidate scan now falls through to text/append-log surfaces
# (state-snapshot-text.txt) and runs BOTH a torn-line and a malformed-line
# control on disposable copies; the *.db path below is byte-identical.
# Project-probe hook (SDKTS-QA-H3-SDK-TYPESCRIPT-FOREMAN-7): a repo may own a
# REAL failure-mode probe at .qa/chaos-probes/corruption.sh (opt-in, generic —
# the harness never learns any project name; the probe exercises the project's
# own SDK behavior and self-grades). When present + executable it REPLACES the
# generic truncate/restart logic for this run: 0=OK (first stdout line in the
# detail), 1=FAIL (SDK misbehavior), 2=INFO (environment gap, probe skipped),
# 124=FAIL (probe HANGS), anything else=INFO (rc + output). When absent this
# block changes nothing — the generic cell logic below runs byte-identically.
( if cd "\$QAREPO"; then
if [ -x .qa/chaos-probes/corruption.sh ]; then
  pp_out=\$(timeout 120 .qa/chaos-probes/corruption.sh 2>&1); pp_rc=\$?
  pp_first=\$(printf '%s' "\$pp_out" | head -1 | cut -c1-300)
  pp_more=\$(printf '%s' "\$pp_out" | tail -n +2 | tr '\n' ' ' | cut -c1-500)
  case "\$pp_rc" in
    0)   cell chaos-corruption OK "project probe: \$pp_first \$pp_more" ;;
    1)   cell chaos-corruption FAIL "project probe reports SDK misbehavior: \$pp_first \$pp_more" ;;
    2)   cell chaos-corruption INFO "project probe: environment gap, probe skipped (\$pp_first \$pp_more)" ;;
    124) cell chaos-corruption FAIL "project probe HANGS (>120s): \$pp_first \$pp_more" ;;
    *)   cell chaos-corruption INFO "project probe rc=\$pp_rc: \$pp_first \$pp_more" ;;
  esac
else
CAND="\$(cat "\$LOGD/state-snapshot.txt" 2>/dev/null)"
LATECAND=\$(find . -maxdepth 3 \\( -name '*.db' -o -name '*.sqlite' -o -name '*.sqlite3' \\) \\
  -not -path './.git/*' -not -path './node_modules/*' -not -path './.mypy_cache/*' \\
  -not -path './.pytest_cache/*' -not -path './.ruff_cache/*' -not -path './.vfs/*' \\
  -not -path './.venv/*' -not -path './venv/*' -not -path './qa-logs-*/*' 2>/dev/null | sort | grep -Fvx -f "\$LOGD/state-snapshot.txt")
state_ref() { # <candidate> → first OTHER source file that mentions its basename
  local b; b=\$(basename "\$1")
  grep -rIl --exclude-dir=.git --exclude-dir=.venv --exclude-dir=node_modules \
    --exclude-dir=.mypy_cache --exclude-dir=.coding-hermes --exclude-dir=.gitreins \
    --include='*.py' --include='*.js' --include='*.ts' --include='*.go' --include='*.rs' \
    --include='*.rb' --include='*.java' --include='*.sh' --include='*.toml' \
    --include='*.yaml' --include='*.yml' -F "\$b" . 2>/dev/null | grep -vF "\$1" | head -1
}
SF=""; SF_REF=""; SF_KIND=db
for c in \$CAND; do r=\$(state_ref "\$c"); if [ -n "\$r" ]; then SF="\$c"; SF_REF="\$r"; break; fi; done
[ -z "\$SF" ] && [ -n "\$CAND" ] && SF=\$(printf '%s\n' "\$CAND" | head -1)
# QA-CRIER-8-R2: no db candidate — fall through to text/append-log state
# surfaces (state-snapshot-text.txt), same source-reference preference so a
# stray temp *.jsonl cannot win over a surface the project own code opens.
TCAND="\$(cat "\$LOGD/state-snapshot-text.txt" 2>/dev/null)"
TLATECAND=\$(find . -maxdepth 3 \\( -name '*.jsonl' -o -name '*.ndjson' \\
  -o \\( -name '*.json' \\( -path './data/*' -o -path './state/*' \\
       -o -path './store/*' -o -path './db/*' -o -path './ledger/*' \\
       -o -path './sessions/*' -o -path './groups/*' -o -path './evidence/*' \\) \\) \\) \\
  -not -path './.git/*' -not -path './node_modules/*' -not -path './.mypy_cache/*' \\
  -not -path './.pytest_cache/*' -not -path './.ruff_cache/*' -not -path './.vfs/*' \\
  -not -path './.venv/*' -not -path './venv/*' \\
  -not -path './.coding-hermes/*' -not -path './.gitreins/*' \\
  -not -name 'qa-evidence.jsonl' -not -path './qa-logs-*/*' 2>/dev/null | sort | grep -Fvx -f "\$LOGD/state-snapshot-text.txt")
if [ -z "\$SF" ] && [ -n "\$TCAND" ]; then
  SF_KIND=text
  for c in \$TCAND; do r=\$(state_ref "\$c"); if [ -n "\$r" ]; then SF="\$c"; SF_REF="\$r"; break; fi; done
  [ -z "\$SF" ] && SF=\$(printf '%s\n' "\$TCAND" | head -1)
fi
if [ -n "\$SF" ]; then
  REF="not referenced by any source file"
  [ -n "\$SF_REF" ] && REF="referenced by \$SF_REF"
  if [ -n "\$BIN" ]; then
    if [ "\$SF_KIND" = text ]; then
      # QA-CRIER-8-R2: JSONL/append-log surface — run BOTH damage controls on
      # DISPOSABLE copies under the scratch log dir (the repo tree is never
      # mutated). Each control starts the project under the same 20s bound the
      # *.db path uses and grades through corr_grade: torn-line keeps a prefix
      # so the last record is cut mid-line; malformed-line appends an invalid
      # record for the format ({not json). A clean refusal/crash-with-message
      # is OK, a silent wrong-success is FAIL, and the evidence names the state
      # path, its ref note, and each damaged-input result separately.
      corr_dir="\$LOGD/corr-torn"
      corr_mal_dir="\$LOGD/corr-mal"
      mkdir -p "\$corr_dir" "\$corr_mal_dir"
      corr_tracked=no
      git ls-files --error-unmatch -- "\$SF" >/dev/null 2>&1 && corr_tracked=yes
      text_torn_status=SKIP; text_torn_detail="could not copy the surface into the scratch dir"
      if mkdir -p "\$corr_dir/\$(dirname "\$SF")" && cp "\$SF" "\$corr_dir/\$SF" 2>/dev/null; then
        cbytes=\$(wc -c < "\$corr_dir/\$SF")
        if [ "\$cbytes" -gt 1 ]; then
          head -c \$((cbytes / 2)) "\$corr_dir/\$SF" > "\$corr_dir/torn-tmp" 2>/dev/null && mv "\$corr_dir/torn-tmp" "\$corr_dir/\$SF"
          text_run=\$(qa_start_in_dir "\$BIN" "\$corr_dir" "\$LOGD/corr-torn.log" "\$LOGD/corr-torn-build.log" 20)
          text_rc=\$(printf '%s' "\$text_run" | cut -f2)
          text_result=\$(corr_grade "\$text_rc" "\$LOGD/corr-torn.log" "\$SF" "\$REF" "\$corr_tracked" 'truncating' 'truncated' yes)
          text_torn_status=\$(printf '%s' "\$text_result" | cut -f1)
          text_torn_detail=\$(printf '%s' "\$text_result" | cut -f2-)
        else
          text_torn_status=INFO; text_torn_detail="surface file is a single byte; torn-line control cannot cut mid-line"
        fi
      fi
      text_mal_status=SKIP; text_mal_detail="could not copy the surface into the scratch dir"
      if mkdir -p "\$corr_mal_dir/\$(dirname "\$SF")" && cp "\$SF" "\$corr_mal_dir/\$SF" 2>/dev/null; then
        printf '{not json\n' >> "\$corr_mal_dir/\$SF"
        text_run2=\$(qa_start_in_dir "\$BIN" "\$corr_mal_dir" "\$LOGD/corr-mal.log" "\$LOGD/corr-mal-build.log" 20)
        text_rc2=\$(printf '%s' "\$text_run2" | cut -f2)
        text_result2=\$(corr_grade "\$text_rc2" "\$LOGD/corr-mal.log" "\$SF" "\$REF" "\$corr_tracked" 'writing a malformed record to' 'a malformed record written to' yes)
        text_mal_status=\$(printf '%s' "\$text_result2" | cut -f1)
        text_mal_detail=\$(printf '%s' "\$text_result2" | cut -f2-)
      fi
      if [ "\$text_torn_status" = FAIL ] || [ "\$text_mal_status" = FAIL ]; then text_overall=FAIL
      elif [ "\$text_torn_status" = OK ] && [ "\$text_mal_status" = OK ]; then text_overall=OK
      elif [ "\$text_torn_status" = SKIP ] && [ "\$text_mal_status" = SKIP ]; then text_overall=SKIP
      else text_overall=INFO; fi
      text_detail="text/append-log state \$SF (\$REF); torn-line control: \$text_torn_status — \$text_torn_detail; malformed-line control: \$text_mal_status — \$text_mal_detail"
      [ -n "\$TLATECAND" ] && text_detail="\$text_detail; skipped state files created during this run: \$(printf '%s' "\$TLATECAND" | tr '\\n' ' ')"
      cell chaos-corruption "\$text_overall" "\$text_detail"
    else
    corr_dir="\$LOGD/corr-start"
    corr_state="\$corr_dir/\$(basename "\$SF")"
    mkdir -p "\$corr_dir"
    if cp "\$SF" "\$corr_state" 2>/dev/null && head -c 64 "\$corr_state" > "\$corr_dir/trunc" 2>/dev/null && mv "\$corr_dir/trunc" "\$corr_state"; then
      corr_run=\$(qa_start_in_dir "\$BIN" "\$corr_dir" "\$LOGD/corr.log" "\$LOGD/corr-build.log" 20)
      corr_rc=\$(printf '%s' "\$corr_run" | cut -f2)
      corr_tracked=no
      git ls-files --error-unmatch -- "\$SF" >/dev/null 2>&1 && corr_tracked=yes
      corr_result=\$(corr_grade "\$corr_rc" "\$LOGD/corr.log" "\$SF" "\$REF" "\$corr_tracked")
      corr_status=\$(printf '%s' "\$corr_result" | cut -f1)
      corr_detail=\$(printf '%s' "\$corr_result" | cut -f2-)
      [ -n "\$LATECAND" ] && corr_detail="\$corr_detail; skipped state files created during this run: \$(printf '%s' "\$LATECAND" | tr '\\n' ' ')"
      cell chaos-corruption "\$corr_status" "\$corr_detail"
    else
      cell chaos-corruption FAIL "could not copy/truncate scratch copy of \$SF"
    fi
    fi  # QA-CRIER-8-R2 SF_KIND dispatch — the *.db path above is byte-identical
  else
    cell chaos-corruption UNVERIFIED "no start command detected — state-restart behavior UNVERIFIED (\$REF)"
  fi
else
  if [ -n "\$LATECAND" ] || [ -n "\$TLATECAND" ]; then cell chaos-corruption N/A "no pre-existing db/state files in repo; skipped state files created during this run: \$(printf '%s' "\$LATECAND \$TLATECAND" | tr '\\n' ' ')"
  else cell chaos-corruption N/A "no db/state files in repo (scanned: *.db *.sqlite *.sqlite3, plus *.jsonl *.ndjson and *.json under data/ state/ store/ db/ ledger/ sessions/ groups/ evidence/ at depth 3, tool caches excluded)"; fi
fi
fi  # end project-probe hook (corruption)
else
  cell chaos-corruption N/A "repository unavailable: \$QAREPO"
fi )

# 9 · chaos-resource — suite under 3G memory cap
# QA-TASK-ROUTER-3: a green/red result is VACUOUS unless the log PROVES the cap
# applied — the finding was that with the wrong PATH the wrapper was dropped and
# the suite ran uncapped while the cell still reported a result. Record the cap
# AND prove it inside the capped child (ulimit -v read back from the child, not
# from the parent), then require that evidence in the verdict.
CAP_KB=3145728
export CAP_KB   # the single-quoted probe expands CAP_KB inside \`bash -c\`, so it must be in the child env
# Single-quoted on purpose: the \$(ulimit -v) must expand INSIDE the capped
# child, not at assignment time in the uncapped parent. The old double-quoted
# form froze "CAP_EFFECTIVE=unlimited" into the probe text before the cap was
# set, so every run reported "cap NOT applied" regardless of the real limit
# (warpfs 09-19, off-by-one 09-20 x2 — probe artifact, not a real defect;
# the subshell probe in res.log proves the ulimit itself applies).
cap_probe='echo CAP_EFFECTIVE=\$(ulimit -v) CAP_REQUESTED=\$CAP_KB'
# QA-OFF-BY-ONE-11 / warpfs 09-19 / off-by-one 09-20 (3 runs): the child kept
# reporting CAP_EFFECTIVE=unlimited even though the subshell sets ulimit -v
# first. Probe EVERY layer so the next run names where the cap is lost:
# parent shell -> subshell right after ulimit -> the capped child itself.
echo PARENT_CAP=\$(ulimit -v) >\$LOGD/res.log
# QA-BUNKER-57 (2026-10-04): the pytest leg invokes pip-installed tooling; on an
# agent where ensurepip failed there is no pip and the leg would die rc=127
# 'pip: command not found' under the cap — vacuous noise graded FAIL. Grade
# UNVERIFIED before running anything. (Go/npm legs are unaffected: pip absent
# is irrelevant to them and qa_have_pip only gates the pip-native runner.)
if echo "$native_cmd" | grep -q pytest && ! qa_have_pip; then
  cell chaos-resource UNVERIFIED "pip absent on agent (ensurepip failed; no sudo) — the pytest suite never ran under the cap, so no memory finding either way (\$cap_note)"
else
( ulimit -v \$CAP_KB; echo SUBSHELL_CAP=\$(ulimit -v); bash -c "\$cap_probe; $native_cmd" ) >>\$LOGD/res.log 2>&1; res_rc=\$?
# QA-H3-16 (2026-09-21): the child's cap_probe echoes CAP_EFFECTIVE and
# CAP_REQUESTED on ONE line, so the bare 's/^CAP_EFFECTIVE=//p' capture pulled
# the whole "3145728 3145728" string into cap_seen, which then never equaled
# CAP_KB and forced the UNVERIFIED "cap NOT applied" branch on every run with a
# WORKING cap (warpfs 09-19 + off-by-one 09-20 + h3 09-21 misread the same way).
# Extract only the FIRST field — the value the child actually reported for
# ulimit -v.
cap_seen=\$(sed -n 's/^CAP_EFFECTIVE=//p' \$LOGD/res.log | head -1 | cut -d' ' -f1)
sub_seen=\$(sed -n 's/^SUBSHELL_CAP=//p' \$LOGD/res.log | head -1 | cut -d' ' -f1)
par_seen=\$(sed -n 's/^PARENT_CAP=//p' \$LOGD/res.log | head -1 | cut -d' ' -f1)
cap_note="cap mechanism=ulimit -v CAP_REQUESTED=\${CAP_KB}KB CAP_EFFECTIVE=\${cap_seen:-NONE} SUBSHELL_CAP=\${sub_seen:-NONE} PARENT_CAP=\${par_seen:-NONE} (cap=\${CAP_KB}KB child_saw=\${cap_seen:-NONE} subshell_saw=\${sub_seen:-NONE} parent_saw=\${par_seen:-NONE})"
# ── QA-CRIER-59: ATTRIBUTION + EXEMPTION FLOOR, computed ONCE per run ────────
# cap_attr_note/cap_attr_json name every failing package and test from the log
# this cell already owns; they are attached to every non-PASS chaos-resource
# verdict (reason + machine-readable row fields). The exemption block only runs
# when the suite did not pass AND an operator declared BUNKER_QA_CAP_EXEMPT_PKGS
# (`name=reason` entries); it re-runs each exempt failing package UNCAPPED so a
# real defect can never ride an exemption (exemption gates the CAP, not the
# verdict), and a reasonless entry is refused outright.
cap_attr_note="\$(cap_attr_note \$LOGD/res.log)"
cap_attr_json="\$(cap_attr_json \$LOGD/res.log)"
cap_exempt_note=""
cap_exempt_kept=0
cap_exempt_floored=0
if [ "\$res_rc" -ne 0 ] && [ -n "\${CAP_EXEMPT_PKGS:-}" ]; then
  for cap_pkg in \$(cap_fail_packages \$LOGD/res.log | head -8); do
    cap_look=\$(cap_exempt_lookup "\$cap_pkg")
    case "\$cap_look" in
      exempt:*)
        cap_reason="\${cap_look#exempt:}"
        cap_exempt_recheck "\$cap_pkg"; cap_rr=\$?
        case "\$cap_rr" in
          0) cap_exempt_floored=\$((cap_exempt_floored + 1))
             cap_exempt_note="\${cap_exempt_note}\${cap_pkg} exempt (\${cap_reason}) and PASSES uncapped => its capped failure is a cap artifact; " ;;
          1) cap_exempt_kept=\$((cap_exempt_kept + 1))
             cap_exempt_note="\${cap_exempt_note}\${cap_pkg} exempt (\${cap_reason}) but FAILS uncapped too => REAL defect, the exemption gates the CAP only; " ;;
          *) cap_exempt_kept=\$((cap_exempt_kept + 1))
             cap_exempt_note="\${cap_exempt_note}\${cap_pkg} exempt (\${cap_reason}) but the uncapped re-check could not run (unknown runner) => exemption refused; " ;;
        esac
        ;;
      reasonless)
        cap_exempt_kept=\$((cap_exempt_kept + 1))
        cap_exempt_note="\${cap_exempt_note}\${cap_pkg} declared exempt WITHOUT a reason => refused, normal verdict stands; "
        ;;
    esac
  done
fi
if [ "\$cap_seen" != "\$CAP_KB" ]; then
  # the child did not see the cap: the wrapper was dropped (PATH/shape problem).
  # A result from this run says NOTHING about memory behaviour.
  cell chaos-resource UNVERIFIED "cap NOT applied in the child (\$cap_note) — the suite ran UNCAPPED, so no memory finding either way (harness defect, not a repo result): rc=\$res_rc"
elif [ \$res_rc -eq 0 ]; then
  # QA-BUNKER-29 (2026-09-30): rc=0 from the vacuous \`echo no-test-path\`
  # placeholder is NOT a cap-survival result — no test ever exercised the cap.
  # Grade UNVERIFIED, never PASS on a suite that never ran. Non-vacuous rc=0
  # path unchanged.
  if vacuous_native_suite \$LOGD/res.log; then
    cell chaos-resource UNVERIFIED "suite NEVER RAN under the cap (vacuous no-test-path) — the cap was never exercised by any test (\$cap_note)"
  else
    cell chaos-resource PASS "suite survives 3G memory cap (\$cap_note)"
  fi
elif [ \$res_rc -eq 127 ]; then cell chaos-resource UNVERIFIED "command not found under cap (rc=127, \$cap_note) — the suite NEVER RAN; INFRA-FAIL, not a result: \$(tail -2 \$LOGD/res.log)"
elif cap_kill_signal \$LOGD/res.log; then
  # QA-CRIER-59: a cap kill NAMES what died instead of collapsing the whole run
  # into one heavy-suite INFO line. The verdict stays UNVERIFIED — a
  # memory kill under a 3G cap is not a statement about the code — unless a
  # declared-cap-exempt package was re-proven broken UNCAPPED, in which case the
  # exemption floor turns it into a loud FAIL.
  cap_kill_line=\$(cap_kill_cause \$LOGD/res.log)
  cap_build_line=""
  build_incomplete \$LOGD/res.log && cap_build_line=" and the build never completed under the cap (\$(build_incomplete_cause \$LOGD/res.log)) so no suite result exists either way;"
  if [ "\$cap_exempt_kept" -gt 0 ]; then
    cell chaos-resource FAIL "cap KILLED part of the suite under the 3G memory cap (ulimit -v) AND a declared-cap-exempt package still fails uncapped — the exemption gates the CAP, never the verdict: \$cap_exempt_note\$cap_attr_note; kill=\$cap_kill_line\$cap_build_line \$cap_note" "\$cap_attr_json"
  elif [ -n "\$cap_exempt_note" ]; then
    cell chaos-resource UNVERIFIED "cap artifact (3G memory cap via ulimit -v), NOT a repo verdict: the cap killed the suite and every declared-exempt failure was re-proven uncapped and PASSES: \$cap_exempt_note\$cap_attr_note; kill=\$cap_kill_line\$cap_build_line \$cap_note" "\$cap_attr_json"
  else
    cell chaos-resource UNVERIFIED "cap artifact (3G memory cap via ulimit -v), NOT a repo verdict: the cap killed the suite, so these are the packages/tests LOST under the cap (re-run them uncapped to separate a regression from the cap): \$cap_attr_note; kill=\$cap_kill_line\$cap_build_line \$cap_note" "\$cap_attr_json"
  fi
elif build_incomplete \$LOGD/res.log; then cell chaos-resource INFO "ENV-BLOCKED: the build never completed under the 3G cap, so the cap was NEVER exercised (rc=\$res_rc, \$cap_note; environment or code, never memory) — not a memory finding: \$(build_incomplete_cause \$LOGD/res.log)"
elif go_suite_env_failure \$LOGD/res.log; then cell chaos-resource INFO "ENV-BLOCKED: the suite died because the test host lacks a build tool — cap WAS applied, but the failure is the missing tool, not memory (\$cap_note, rc=\$res_rc): \$(grep -m1 -E 'exec: .* executable file not found' \$LOGD/res.log)"
elif suite_deps_missing \$LOGD/res.log; then cell chaos-resource UNVERIFIED "missing test dependencies — the suite NEVER RAN under the cap, so no memory finding either way (rc=\$res_rc, \$cap_note): \$(suite_deps_missing_cause \$LOGD/res.log)"
elif native_runner_missing \$LOGD/res.log; then cell chaos-resource UNVERIFIED "native runner missing under cap (rc=\$res_rc, \$cap_note) - the suite NEVER RAN, so the cap was never exercised by any test; INFRA-FAIL, not a result: \$(native_runner_missing_cause \$LOGD/res.log)"
elif go_toolchain_oom \$LOGD/res.log; then cell chaos-resource INFO "ENV-BLOCKED: the go toolchain itself failed to build under the 3G cap (SystemResources/address-space) — no suite result either way, the cap-vs-toolchain interaction is not a memory verdict about the code (\$cap_note, rc=\$res_rc): \$(go_toolchain_oom_cause \$LOGD/res.log)"
elif go_panic_timeout \$LOGD/res.log; then cell chaos-resource INFO "SUITE-PANIC: go test hit its own 10m timeout and panicked under the cap — the suite has NO clean failure mode at its worst-case memory ceiling (QA-HERMES-CANOPY-38): \$(go_panic_timeout_cause \$LOGD/res.log) | \$cap_attr_note | \$cap_note | failing: \$(capped_fail_summary \$LOGD/res.log)" "\$cap_attr_json"
else cell chaos-resource FAIL "rc=\$res_rc under the 3G cap with NO kill/OOM signature in the log (so the cap did not kill the runner — this is a suite result, not a cap artifact): \$cap_attr_note; \$cap_exempt_note\$cap_note; failing: \$(capped_fail_summary \$LOGD/res.log)" "\$cap_attr_json"; fi
fi # QA-BUNKER-57 pip-absent gate (pytest legs only)

# 10 · chaos-errorpath — missing config: clean usage or panic?
# Project-probe hook (SDKTS-QA-H3-SDK-TYPESCRIPT-FOREMAN-7): same opt-in, fully
# generic contract as the chaos-corruption cell — a repo-owned
# .qa/chaos-probes/errorpath.sh REPLACES the generic missing-config BIN probe
# for this run (0=OK, 1=FAIL SDK misbehavior, 2=INFO environment gap, 124=FAIL
# HANGS, other=INFO rc). Absent probe → byte-identical generic behavior.
if [ -x .qa/chaos-probes/errorpath.sh ]; then
  pp_out=\$(timeout 120 .qa/chaos-probes/errorpath.sh 2>&1); pp_rc=\$?
  pp_first=\$(printf '%s' "\$pp_out" | head -1 | cut -c1-300)
  pp_more=\$(printf '%s' "\$pp_out" | tail -n +2 | tr '\n' ' ' | cut -c1-500)
  case "\$pp_rc" in
    0)   cell chaos-errorpath OK "project probe: \$pp_first \$pp_more" ;;
    1)   cell chaos-errorpath FAIL "project probe reports SDK misbehavior: \$pp_first \$pp_more" ;;
    2)   cell chaos-errorpath INFO "project probe: environment gap, probe skipped (\$pp_first \$pp_more)" ;;
    124) cell chaos-errorpath FAIL "project probe HANGS (>120s): \$pp_first \$pp_more" ;;
    *)   cell chaos-errorpath INFO "project probe rc=\$pp_rc: \$pp_first \$pp_more" ;;
  esac
elif [ -n "\$BIN" ]; then
  EP_DIR=~/qa-noconfig-\$\$
  ep_out=\$(ep_probe "\$BIN" "\$EP_DIR" "\$LOGD")
  EP_STARTED=\$(printf '%s' "\$ep_out" | cut -f1)
  ep_rc=\$(printf '%s' "\$ep_out" | cut -f2)
  ep_result=\$(ep_grade "\$ep_rc" "\$LOGD/ep.log" "\$EP_STARTED")
  ep_status=\$(printf '%s' "\$ep_result" | cut -f1)
  ep_detail=\$(printf '%s' "\$ep_result" | cut -f2-)
  cell chaos-errorpath "\$ep_status" "\$ep_detail"
else
  # QA-9ROUTER-22: empty BIN = no start command detected / entrypoint not
  # observable. Never a product verdict — the missing-config probe never ran.
  cell chaos-errorpath INFO "no start command detected / entrypoint not observable — missing-config behavior UNVERIFIED"
fi

echo CELLS-DONE
touch ~/qa-run.finished
EOF
}

# ─── QA-CRIER-62 (2026-11-17): TARGET BINDING — the project identity comes from
# the RESOLVED REPOSITORY, never from the checkout directory name ───
# The defect (crier-qa-2026-11-12-10-57-46): the battery was launched for crier
# from a clone whose directory is `src`, and the launch metadata plus EVERY
# evidence row carried project=src, because identity was `basename(repo)`. No
# part of the harness compared the identity claims, so a whole battery graded an
# unnamed project silently and its findings could not be attributed to crier —
# fail-open identity, which is worse than no battery at all.
#
# FOUR FIELDS, compared BEFORE any cell is graded:
#   target    scheduler target   — CODING_HERMES_QA_TARGET (the QA foreman lane's
#                                  documented scope field) or BUNKER_QA_TARGET
#                                  (the operator spelling; same field)
#   runner    runner label       — CODING_HERMES_PROJECT (e.g. `crier-qa`); lane
#                                  suffixes -qa/-pm/-sync/-dogfood/-docs/-readme/
#                                  -releng/-review/-foreman/-ops are stripped
#                                  before comparison, case-insensitively
#   repo      resolved identity  — git remote URL → go.mod module → pyproject
#                                  name → Cargo.toml package → package.json name.
#                                  The checkout BASENAME is never an identity.
#   evidence  the project value this run stamps on .meta and on every row. It is
#             SET FROM the resolved identity by the same call, so the two cannot
#             diverge — there is no second derivation to forget.
#
# VERDICTS (printed as four `  field=value` lines + a `  verdict=` line):
#   bound          every present claim agrees with the resolved identity →
#                  grading proceeds; ONE `target-binding` OK row records
#                  target/runner/repo/source/remote/HEAD for the audit trail
#                  (a wrapper cell: qa_run_summary never counts it as signal)
#   bound-warn     nothing to bind: no repository identity AND no claim at all
#                  (a local checkout with no remote and no manifest). The
#                  basename is then used LOUDLY — stderr WARN + the row says
#                  source=basename-fallback — never silently.
#   target-invalid ANY disagreement → the battery is marked target-invalid, NO
#                  product cell is graded, no product finding is filed, the full
#                  report is retained at $EVIDENCE.target-invalid with the
#                  harness logs, and the caller exits rc=4.
#
# BUNKER_QA_PROJECT_IDENTITY=<project> is the documented explicit scope field: it
# DECLARES what the checkout is, so an identity-less checkout (no remote, no
# manifest) can be bound deliberately instead of guessed — it must still agree
# with a resolved identity when one exists.
qa_target_generic_name() { # <token> — 0 when the token is a checkout/transport name
  # QA-CRIER-62: the name list is INLINE on purpose. The acceptance harness
  # extracts FUNCTION BODIES ONLY (sed from `name() {` to the closing `}`) and
  # sources them under `set -u`, so a reference to a top-level variable here is
  # an "unbound variable" death at the exact moment a bound launch must decide —
  # the old top-level QA_TARGET_GENERIC_NAMES assignment did exactly that (the
  # gate then read the dead check as a refusal carrying an EMPTY report, which
  # stamped the checkout basename onto the target-invalid row with no detail).
  # Keep the list inside the function; never hoist it back out.
  local n; n=$(printf '%s' "$1" | tr 'A-Z' 'a-z')
  case " src source repo repos checkout clone worktree tree work tmp tmpdir temp build head main master product " in
    *" $n "*) return 0 ;;
  esac
  return 1
}

qa_identity_from_git_url() { # <url> — last path segment with .git stripped
  local u="$1" tail_
  u="${u%/}"
  case "$u" in *://*) u="${u#*://}" ;; esac     # scheme
  case "$u" in *:*) u="${u#*:}" ;; esac         # user@host: or host:port
  u="${u%/}"
  tail_="${u##*/}"
  tail_="${tail_%.git}"
  printf '%s' "$tail_"
}

qa_project_identity() { # <repo-dir> — stdout: "<source><TAB><identity>"; identity "" = unresolved
  # The SOURCE travels with the identity so callers never guess how it was
  # derived (`origin-remote`, `go-module`, `pyproject`, `cargo`,
  # `package-json`) and a basename can never masquerade as one of them.
  local repo="$1" url remote name
  url=$(git -C "$repo" remote get-url origin 2>/dev/null || true)
  if [ -z "$url" ]; then
    remote=$(git -C "$repo" remote 2>/dev/null | head -1 || true)
    [ -n "$remote" ] && url=$(git -C "$repo" remote get-url "$remote" 2>/dev/null || true)
  fi
  if [ -n "$url" ]; then
    name=$(qa_identity_from_git_url "$url")
    if [ -n "$name" ]; then printf 'origin-remote\t%s\n' "$name"; return 0; fi
  fi
  if [ -f "$repo/go.mod" ]; then
    name=$(sed -n 's/^module[[:space:]][[:space:]]*\([^[:space:]]*\).*/\1/p' "$repo/go.mod" 2>/dev/null | head -1)
    # a module path's last segment is the name; a major-version suffix (/v2) is
    # not part of it
    case "$name" in */v[0-9]|*/v[0-9][0-9]) name="${name%/*}" ;; esac
    name="${name##*/}"
    [ -n "$name" ] && { printf 'go-module\t%s\n' "$name"; return 0; }
  fi
  if [ -f "$repo/pyproject.toml" ]; then
    name=$(sed -n 's/^[[:space:]]*name[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' "$repo/pyproject.toml" 2>/dev/null | head -1)
    [ -z "$name" ] && name=$(sed -n "s/^[[:space:]]*name[[:space:]]*=[[:space:]]*'\([^']*\)'.*/\1/p" "$repo/pyproject.toml" 2>/dev/null | head -1)
    [ -n "$name" ] && { printf 'pyproject\t%s\n' "$name"; return 0; }
  fi
  if [ -f "$repo/Cargo.toml" ]; then
    name=$(sed -n 's/^name[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' "$repo/Cargo.toml" 2>/dev/null | head -1)
    [ -n "$name" ] && { printf 'cargo\t%s\n' "$name"; return 0; }
  fi
  if [ -f "$repo/package.json" ]; then
    name=$(sed -n 's/^[[:space:]]*"name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$repo/package.json" 2>/dev/null | head -1)
    [ -n "$name" ] && { printf 'package-json\t%s\n' "$name"; return 0; }
  fi
  printf 'unresolved\t\n'
  return 0
}

qa_claim_norm() { # <claim> — lowercase, fleet lane suffixes stripped (comparison only)
  local c s
  c=$(printf '%s' "$1" | tr 'A-Z' 'a-z')
  for s in -qa -pm -sync -dogfood -docs -readme -releng -review -foreman -ops; do
    case "$c" in *"$s") c="${c%"$s"}" ;; esac
  done
  printf '%s' "$c"
}

qa_proj_slug() { # <identity> — filesystem-safe token for the remote ~/qa-<slug> dir
  printf '%s' "$1" | tr 'A-Z' 'a-z' \
    | sed -e 's/[^a-z0-9._-]/-/g' -e 's/^[-.]*//' -e 's/[-.]*$//'
}

qa_target_binding_check() { # <repo-dir> — stdout: the report; rc 0 bound, rc 3 target-invalid
  local repo="$1" base target runner declared resolved source reason="" verdict=bound rn
  base=$(basename "$repo")
  target="${CODING_HERMES_QA_TARGET:-${BUNKER_QA_TARGET:-}}"
  runner="${CODING_HERMES_PROJECT:-}"
  declared="${BUNKER_QA_PROJECT_IDENTITY:-}"
  local pair
  pair=$(qa_project_identity "$repo")
  source=$(printf '%s' "$pair" | cut -f1)
  resolved=$(printf '%s' "$pair" | cut -f2)
  # exported for qa_launch_meta_write (additive identity_source= key)
  QA_IDENTITY_SOURCE="$source"
  if [ -n "$declared" ]; then
    if [ -n "$resolved" ]; then
      if [ "$(qa_claim_norm "$declared")" != "$(qa_claim_norm "$resolved")" ]; then
        reason="declared identity BUNKER_QA_PROJECT_IDENTITY='$declared' != resolved repository identity '$resolved' (source=$source, repo=$repo)"
      fi
    else
      resolved="$declared"; source=declared; QA_IDENTITY_SOURCE=declared
    fi
  fi
  rn=$(qa_claim_norm "$resolved")
  if [ -z "$reason" ] && [ -z "$resolved" ]; then
    # No repository identity. The basename may still be used — but ONLY loudly,
    # and ONLY when it is not a transport name and every present claim agrees
    # with it. Any claim that cannot be reconciled with the checkout is a
    # target-invalid: that is the fail-closed half.
    local claims_consistent=1 c
    for c in "$target" "$runner"; do
      [ -n "$c" ] || continue
      [ "$(qa_claim_norm "$c")" = "$(qa_claim_norm "$base")" ] || claims_consistent=0
    done
    if qa_target_generic_name "$base"; then
      reason="checkout basename '$base' is a transport/clone name, not a project identity, and the repository resolves to no identity (checked: git remote, go.mod module, pyproject.toml name, Cargo.toml package, package.json name); claims target=${target:-<unset>} runner=${runner:-<unset>} cannot bind to it"
    elif [ "$claims_consistent" -ne 1 ]; then
      reason="no resolved repository identity for $repo (checked: git remote, go.mod module, pyproject.toml name, Cargo.toml package, package.json name) and the claims disagree with the checkout basename '$base': target=${target:-<unset>} runner=${runner:-<unset>}; declare it with BUNKER_QA_PROJECT_IDENTITY=<project>"
    else
      resolved="$base"; source=basename-fallback; verdict=bound-warn; rn=$(qa_claim_norm "$resolved")
      QA_IDENTITY_SOURCE=basename-fallback
      echo "WARN: no repository identity for $repo (no remote, no go.mod/pyproject/Cargo.toml/package.json) — using the checkout basename '$base' as the project identity (claims agree with it); declare BUNKER_QA_PROJECT_IDENTITY=<project> to bind it explicitly" >&2
    fi
  fi
  if [ -z "$reason" ] && [ -n "$target" ] && [ "$(qa_claim_norm "$target")" != "$rn" ]; then
    reason="scheduler target '$target' != resolved repository identity '$resolved' (source=$source, repo=$repo)"
  fi
  if [ -z "$reason" ] && [ -n "$runner" ] && [ "$(qa_claim_norm "$runner")" != "$rn" ]; then
    reason="runner label '$runner' != resolved repository identity '$resolved' (source=$source, repo=$repo)"
  fi
  if [ -z "$reason" ] && qa_target_generic_name "$resolved"; then
    reason="resolved identity '$resolved' is a transport/clone name, not a project identity (source=$source, repo=$repo)"
  fi
  printf 'TARGET-BINDING repo=%s\n' "$repo"
  printf '  target=%s\n' "${target:-<unset>}"
  printf '  runner=%s\n' "${runner:-<unset>}"
  printf '  repo-identity=%s (source=%s)\n' "${resolved:-<unresolved>}" "$source"
  printf '  evidence-project=%s\n' "${resolved:-<unresolved>}"
  if [ -n "$reason" ]; then
    printf '  verdict=target-invalid\n'
    printf '  MISMATCH: %s\n' "$reason"
    return 3
  fi
  printf '  verdict=%s\n' "$verdict"
  return 0
}

qa_target_binding_gate() { # <repo-dir> <phase> — sets PROJ + QA_PROJ_SLUG; rc 0 ok, rc 4 target-invalid
  local repo="$1" phase="$2" report rc label detail head_sha remote_url
  report=$(qa_target_binding_check "$repo"); rc=$?
  if [ "$rc" -ne 0 ]; then
    label=$(printf '%s\n' "$report" | sed -n 's/^  repo-identity=\([^ ]*\) .*/\1/p' | head -1)
    if [ -z "$label" ] || [ "$label" = '<unresolved>' ]; then label=$(basename "$repo"); fi
    printf '%s\n' "$report"
    # Retained harness evidence: the report + the phase that refused. collect()
    # reads this to state TARGET-INVALID instead of a crash story.
    if [ -n "${EVIDENCE:-}" ]; then
      { printf '%s\n' "$report"
        printf 'phase=%s\nrepo=%s\nevidence=%s\nts=%s\n' "$phase" "$repo" "$EVIDENCE" "$(date -u +%FT%TZ)"
      } > "${EVIDENCE}.target-invalid"
      printf '{"project":"%s","cell":"target-binding","status":"target-invalid","detail":"%s","ts":"%s"}\n' \
        "$label" "$(printf '%s' "$report" | tr '\n' ' ' | sed "s/\"/'/g" | cut -c1-600)" "$(date -u +%FT%TZ)" >> "$EVIDENCE"
    fi
    echo "TARGET-INVALID: $(printf '%s' "$report" | sed -n 's/^  MISMATCH: //p')" >&2
    echo "TARGET-INVALID: no product cell was graded and no product finding was filed; report retained at ${EVIDENCE}.target-invalid" >&2
    return 4
  fi
  PROJ=$(printf '%s\n' "$report" | sed -n 's/^  evidence-project=//p' | head -1)
  # QA-CRIER-62: qa_target_binding_check ran inside a command substitution, so
  # the QA_IDENTITY_SOURCE it set died with that subshell — reading it here
  # aborted the OK-row detail under `set -u` and left every launch record
  # identity_source=unresolved. Re-derive it from the report itself: the
  # repo-identity line always carries the EFFECTIVE source (origin-remote,
  # go-module, pyproject, cargo, package-json, declared, basename-fallback).
  QA_IDENTITY_SOURCE=$(printf '%s\n' "$report" | sed -n 's/^  repo-identity=[^ ]* (source=\([^)]*\)).*/\1/p' | head -1)
  QA_PROJ_SLUG=$(qa_proj_slug "$PROJ")
  printf '%s\n' "$report"
  if [ -n "${EVIDENCE:-}" ]; then
    head_sha=$(git -C "$repo" rev-parse HEAD 2>/dev/null || true)
    remote_url=$(git -C "$repo" remote get-url origin 2>/dev/null || true)
    detail=$(printf 'target=%s runner=%s repo=%s identity_source=%s remote=%s head=%s evidence_project=%s' \
      "${CODING_HERMES_QA_TARGET:-${BUNKER_QA_TARGET:-<unset>}}" "${CODING_HERMES_PROJECT:-<unset>}" \
      "$PROJ" "$QA_IDENTITY_SOURCE" "${remote_url:-<none>}" "${head_sha:-<none>}" "$PROJ" \
      | tr '\n' ' ' | sed "s/\"/'/g" | cut -c1-600)
    printf '{"project":"%s","cell":"target-binding","status":"OK","detail":"%s","ts":"%s"}\n' \
      "$PROJ" "$detail" "$(date -u +%FT%TZ)" >> "$EVIDENCE"
  fi
  return 0
}

# ─── QA-BUNKER-REVIEW-3 (2026-11-02): repo sanity + product-root resolution ───
# The QA cell hit: /home/kara/.hermes/stand-in/review/bunker is a SUBDIRECTORY
# of the /home/kara home meta-repo — pre-guard behavior synced the WHOLE parent
# and graded the wrong product. The fleet copy has carried the refuse-unless-
# BUNKER_QA_SUBDIR guard since QA-HARNESS-SCOPE-20261004; this port adds the
# missing half: a stand-in dir documents the product it stands in for — its
# .coding-hermes/board SYMLINKS into the real product repo (scheduler
# review-namespace contract) — so when that symlink resolves into a DIFFERENT
# git repo, resolve and use that repo's root instead of refusing.
# Contract (run() and launch() call this AFTER truncate+traps, so a refusal
# still records its row — QA-GITREINS-POC-QA-1):
#   $1 repo-dir   $2 phase ("run" | "launch" | "probe"; evidence detail prefix)
#   stdout: the EFFECTIVE repo dir to sync/grade (one line)
#   refusal: named ERROR on stderr + ONE FAIL row in $EVIDENCE, rc=1
#   Precedence: explicit BUNKER_QA_SUBDIR > board-symlink resolution > refusal.
qa_repo_sanity() {
  local repo="$1" phase="$2"
  if [ -d "$repo/.git" ]; then
    printf '%s\n' "$repo"; return 0
  fi
  local git_top
  git_top=$(git -C "$repo" rev-parse --show-toplevel 2>/dev/null || true)
  # QA-HARNESS-SCOPE-20261004 (fleet parity): an explicit subdirectory scope
  # ALWAYS wins — over stand-in resolution and over both refusals below.
  if [ -n "${BUNKER_QA_SUBDIR:-}" ]; then
    repo="$repo/${BUNKER_QA_SUBDIR%/}"
    printf '%s\n' "$repo"; return 0
  fi
  # Stand-in product-root resolution: <repo>/.coding-hermes/board is a symlink
  # into a DIFFERENT git repo -> that repo is the product. Same-parent or
  # non-repo targets fall through to the refusal (no bogus resolution).
  local board_link resolved_target product_top product_check
  board_link="$repo/.coding-hermes/board"
  if [ -L "$board_link" ]; then
    resolved_target=$(readlink -f "$board_link" 2>/dev/null || true)
    if [ -n "$resolved_target" ]; then
      # git -C needs a DIRECTORY and the board link resolves to the board file
      # itself — probe the repo from the target's directory (or the target when
      # it is a dir symlink).
      local target_dir
      if [ -d "$resolved_target" ]; then target_dir="$resolved_target"; else target_dir=$(dirname "$resolved_target"); fi
      product_top=$(git -C "$target_dir" rev-parse --show-toplevel 2>/dev/null || true)
      # Verify the resolved root is a REAL git toplevel before trusting it.
      if [ -n "$product_top" ]; then
        product_check=$(git -C "$product_top" rev-parse --show-toplevel 2>/dev/null || true)
        if [ "$product_check" = "$product_top" ] && [ "$product_top" != "$git_top" ]; then
          echo "NOTE: $repo is a stand-in; resolving product root $product_top (board symlink -> $resolved_target)" >&2
          printf '%s\n' "$product_top"; return 0
        fi
      fi
    fi
  fi
  if [ -n "$git_top" ] && [ "$git_top" != "$(cd "$repo" && pwd)" ]; then
    echo "ERROR: $repo is a SUBDIRECTORY of git repo $git_top — bunker-qa.sh would sync the whole parent repo and grade the wrong product. Set BUNKER_QA_SUBDIR=<subdir-relative-to-repo> (e.g. BUNKER_QA_SUBDIR=monitoring/fleet-monitoring) or dispatch against the real product git root." >&2
    printf '{"cell":"run_battery","status":"FAIL","detail":"%s refused: %s is a subdirectory of git repo %s — syncing the parent would grade the wrong product (project=%s). Set BUNKER_QA_SUBDIR=<relative subdir> or use the product git root","ts":"%s"}\n' \
      "$phase" "$repo" "$git_top" "$(basename "$repo")" "$(date -u +%FT%TZ)" >> "$EVIDENCE"
    return 1
  fi
  echo "ERROR: $repo is not a git repo (git resolves toplevel: ${git_top:-none}) — dispatch against the primary repo workdir" >&2
  printf '{"cell":"run_battery","status":"FAIL","detail":"%s refused: %s is not a git repo (git resolves toplevel: %s) — a role-lane workdir was dispatched instead of the primary repo; re-dispatch against the real workdir","ts":"%s"}\n' \
    "$phase" "$repo" "${git_top:-none}" "$(date -u +%FT%TZ)" >> "$EVIDENCE"
  return 1
}

run() {
  local repo="${1:?usage: bunker-qa.sh run <repo-dir> [--keep]}"
  shift
  local keep=0
  for a in "$@"; do [ "$a" = "--keep" ] && keep=1; done

  # QA-CRIER-62: PROJ is NOT derived from the checkout dir here — the
  # qa_target_binding_gate() below sets it from the RESOLVED repository identity
  # (git remote / module path), never from the clone basename. The empty
  # initialiser keeps `set -u` safe on the truncate/trap path that precedes it.
  local PROJ="" QA_PROJ_SLUG=""
  : > "$EVIDENCE"

  # Timeout/empty-evidence traps (2026-09-07, QA-DEXDAT-CORE-1): a tool-level
  # SIGTERM (Hermes terminal cap) or a sync-fail exit kills the battery mid-run
  # leaving a 0-byte evidence file — parse_cells then sees cells:[] and the DAG
  # reports UNVERIFIED silently, indistinguishable from "nothing to check".
  # write_fail_if_empty() (top-level, shared with launch()) appends exactly one
  # FAIL cell — idempotent: TERM + EXIT traps firing together produce one line.
  # Repo sanity runs AFTER truncate+traps (QA-GITREINS-POC-QA-1): a stand-in
  # workdir (no .git) must yield an actionable FAIL row, not a silent exit.
  trap 'write_fail_if_empty "battery terminated by SIGTERM (tool timeout) before any cell recorded"; exit 124' TERM
  trap 'write_fail_if_empty "battery interrupted by SIGINT before any cell recorded"; exit 130' INT
  trap 'write_fail_if_empty "battery exited rc=$? before any cell recorded"' EXIT

  # QA-BUNKER-REVIEW-3: repo sanity + stand-in product-root resolution — shared
  # with launch() via qa_repo_sanity (fleet parity with QA-HARNESS-SCOPE-20261004:
  # refuse subdirectory-of-parent targets unless BUNKER_QA_SUBDIR opts in, and
  # resolve a stand-in dir whose .coding-hermes/board symlinks into a different
  # product repo). Traps precede this: a refusal still records its row.
  repo=$(qa_repo_sanity "$repo" run) || exit 1
  # QA-CRIER-62 (fail-closed target binding): compare the scheduler target, the
  # RESOLVED repository identity, the runner label and the evidence project
  # BEFORE any cell is graded. rc=4 = target-invalid — the row is written, the
  # report is retained at $EVIDENCE.target-invalid, nothing is spawned, and no
  # product finding can exist because no product cell ever ran.
  qa_target_binding_gate "$repo" run || exit $?

  log "QA project: $PROJ — fresh-system pass on $SERVER (ttl $TTL)"

  # Deterministic-failure preflights (config / ssh / capacity) — SHARED with
  # launch(); see preflights() for the record-one-FAIL-row + rc=2 contract.
  preflights
  # QA-BUNKER-75: reclaim agents whose detached controller died before collect.
  # This runs before spawn so an abandoned slot cannot block the new battery.
  # QA-MUSTER-046: the sweep is scoped to the server THIS battery targets — a
  # lock recorded against another host is skipped, never listed and never
  # destroyed (an unbounded foreign destroy is what wedged launches).
  qa_cleanup_orphan_agents "$SERVER"
  # QA-BUNKER-60 (2026-10-07): repo-weight preflight — WARN (stderr only; no
  # evidence file is open here yet) when the workspace is heavy AND the
  # resolved slice is still the 2-CPU default, BEFORE a spawn burns a TTL on it.
  qa_preflight_repo_weight "$repo"

  local agent key spawn_err
  spawn_err=$(mktemp)
  agent=$(spawn_agent 2>"$spawn_err") || {
    # QA-2 (2026-09-03): hard-fail loudly — record a FAIL cell so the DAG's
    # parse_cells never interprets an empty evidence file as "nothing to
    # check". UNVERIFIED must be distinguishable from a clean battery.
    # The REAL spawn stderr (e.g. "port range allocation: no free port
    # ranges available") is captured into the cell detail so interpreters
    # never have to re-diagnose the failure manually.
    local err_detail
    err_detail=$(tail -3 "$spawn_err" | tr '\n' ' ' | cut -c1-300)
    rm -f "$spawn_err"
    echo "ERROR: spawn failed on $SERVER: $err_detail" >&2
    printf '{"cell":"run_battery","status":"FAIL","detail":"spawn failed on %s: %s","ts":"%s"}\n' \
      "$SERVER" "$err_detail" "$(date -u +%FT%TZ)" >> "$EVIDENCE"
    exit 1
  }
  rm -f "$spawn_err"
  key="$HOME/.bunker/keys/$agent"
  BUNKER_QA_AGENT="$agent"
  # QA-BUNKER-19 b+c (2026-09-21): cleanup destroy failures are SURFACED, not
  # swallowed — the old `|| true` defeated the destroy-failure escalation
  # contract (a failed destroy left agent 230abb5b running, invisible to the
  # run log). qa_destroy_agent() emits "destroy FAILED"/"STILL PRESENT AFTER
  # DESTROY" on stderr + a FAIL evidence row; the evidence path is the $EVIDENCE
  # global so the EXIT trap needs nothing captured at definition time.
  cleanup() { log "destroying temp agent $BUNKER_QA_AGENT"; qa_destroy_agent "$BUNKER_QA_AGENT" "$EVIDENCE"; qa_remove_agent_lock "$BUNKER_QA_AGENT" >/dev/null 2>&1 || true; }
  [ "$keep" = 1 ] || trap cleanup EXIT
  # The synchronous path owns the whole tick, so its normal EXIT cleanup above
  # also removes the watchdog lock. Detached launch leaves the lock to collect.
  log "agent=$agent @ $SERVER (tailscale)"

  # Pre-flight hygiene (2026-08-31): temp-agent homes PERSIST across runs
  # (spawn is idempotent, no userdel), so a previous project's
  # ~/qa-evidence.jsonl, ~/qa-run.sh and /tmp/*.log (owned by the old
  # agent's uid) survive into this run. That caused (a) stale evidence
  # cells from the prior project to be appended to this run's evidence
  # file, and (b) "Permission denied" on /tmp/inst.log etc. because the
  # fresh agent uid can't overwrite the old agent's files. Clear them
  # before shipping anything.
  agent_ssh "rm -f ~/qa-run.sh ~/qa-up-prev ~/qa-up-prev.absent ~/qa-evidence.jsonl /tmp/inst.log /tmp/ci.log /tmp/native.log /tmp/disc.log /tmp/ep.log /tmp/sd.log /tmp/res.log" >/dev/null 2>&1 || true

  # detect tooling LOCALLY (one place, no quoting layers) — SHARED with launch()
  # (BUNKER_QA_INSTALL_CMD / BUNKER_QA_NATIVE_CMD escape hatches live in detect_cmds)
  detect_cmds "$repo" "$agent"
  local install_cmd="$DETECT_INSTALL" ci_cmd="$DETECT_CI" native_cmd="$DETECT_NATIVE"

  log "CELL fresh-install: sync repo → ~/qa-$QA_PROJ_SLUG"
  # Sync verdict/logic lives in sync_repo() (shared with launch(); see its
  # comment for why the REMOTE's SYNC-OK echo is the truth, not tar's rc).
  if ! sync_repo "$repo" "$QA_PROJ_SLUG"; then
    echo "ERROR: repo sync failed — $SYNC_ERR"
    exit 1
  fi

  # QA-OFF-BY-ONE-22: stream the previous release's tree for the upgrade cell
  ship_prev_tag_tree "$repo" "$QA_PROJ_SLUG"

  # ship the remote script via ssh STDIN (QA-BUNKER-40, 2026-10-05): the old
  # `echo '$b64' | base64 -d` embedded the whole script in one ssh argv word —
  # past ~131KB base64 that exceeds the kernel MAX_ARG_STRLEN (E2BIG:
  # "Argument list too long"). stdin is quoting-safe AND argv-unbounded.
  build_remote_script "$PROJ" "$install_cmd" "$ci_cmd" "$native_cmd" \
    | agent_ssh "cat > ~/qa-run.sh && bash ~/qa-run.sh" | tail -1

  # pull evidence back
  agent_ssh "cat ~/qa-evidence.jsonl 2>/dev/null" >> "$EVIDENCE" || true

  # QA-BUNKER-B20: the run ends with an HONEST verdict line — wrapper steps
  # (spawn/sync/launch/collect) never counted as audit signal, so the old
  # "4 wrapper steps ok" shape could read as SUCCESS over a run that audited
  # nothing. Zero verdict-bearing cells ⇒ the summary carries "NOTHING
  # AUDITED" and run() exits nonzero (rc=3 = verdicts verdict, not a refusal
  # class like preflight's rc=2).
  local summary
  summary=$(qa_run_summary "$EVIDENCE")
  qa_run_summary_rc=$?
  echo "$summary"
  [ "$qa_run_summary_rc" -eq 0 ] || exit 3
  log "QA pass complete — evidence: $EVIDENCE"
  echo "EVIDENCE=$EVIDENCE"
  # QA-CRIER-62: the evidence digest is part of the target-binding proof — a run
  # whose identity was bound is cited by (project, tested HEAD, evidence sha256).
  if command -v sha256sum >/dev/null 2>&1; then echo "EVIDENCE_SHA256=$(sha256sum "$EVIDENCE" | awk '{print $1}')"; fi
}

# ─── QA-BUNKER-47 (2026-10-30): launch-record (.meta) staging ───
# $EVIDENCE.meta is collect()'s ONLY pointer to the spawned agent, and two
# conflicting requirements decide WHEN it may exist:
#   * TR-085: a launch killed mid-flight (tool cap, SIGTERM, crash) must leave a
#     record behind, or collect falls back to whatever STALE record the path
#     already held and probes a stranger's agent id.
#   * QA-BUNKER-47: a run refused BEFORE spawn (config/ssh/reachability rc=2)
#     must leave NO launch record. The old prologue wrote one unconditionally,
#     so a follow-up collect graded a healthy refusal as "launch was killed
#     before the agent id was recorded" — a crash story for a run that never
#     spawned anything, and exactly the shape TR-085 warns about.
# Resolution: reset the path first (kills the stale record), then write the
# record only AFTER preflights pass, stamped with a phase= header so collect can
# tell a spawn-time kill (phase=spawning, agent= still empty) from a completed
# spawn. Phase values: spawning | running | launched.
qa_launch_meta_reset() { # <meta> — drop a PREVIOUS run's record at this path
  rm -f "${1:?qa_launch_meta_reset: meta path required}"
}

qa_launch_meta_write() { # <meta> <evidence> <phase> <agent> <server> <keep> <project> [launched] [repo]
  local meta="${1:?qa_launch_meta_write: meta path required}" evidence="${2:-}" phase="${3:-}"
  local agent="${4:-}" server="${5:-}" keep="${6:-0}" project="${7:-}"
  local launched="${8:-$(date -u +%FT%TZ)}"
  # QA-CRIER-066-R2 (C): collect() must persist the merged evidence INSIDE the
  # repo under test, and the launch phase is the only place that knows which
  # checkout was graded (collect only sees the evidence path). Additive key —
  # every existing `sed -n 's/^key=//p'` consumer is unaffected.
  local repo="${9:-}"
  # QA-CRIER-62: the record now carries the BINDING, not just the project name —
  # a reader can see WHICH claim bound this run (target=<scheduler target>,
  # identity_source=<origin-remote|go-module|pyproject|cargo|package-json|
  # declared|basename-fallback>) without re-reading the evidence file. Additive
  # keys: every existing `sed -n 's/^key=//p'` consumer is unaffected.
  local bind_target="${CODING_HERMES_QA_TARGET:-${BUNKER_QA_TARGET:-}}"
  local bind_source="${QA_IDENTITY_SOURCE:-unresolved}"
  local bind_runner="${CODING_HERMES_PROJECT:-}"
  printf 'agent=%s\nserver=%s\nevidence=%s\nlaunched=%s\nkeep=%s\nproject=%s\nphase=%s\ntarget=%s\nrunner=%s\nidentity_source=%s\nrepo=%s\n' \
    "$agent" "$server" "$evidence" "$launched" "$keep" "$project" "$phase" \
    "$bind_target" "$bind_runner" "$bind_source" "$repo" > "$meta"
}

# ─── launch — PHASE A: preflights + spawn + sync + START the battery DETACHED ───
# Returns as soon as `qa-run.sh` is running on the agent — it NEVER waits on a
# cell. This is what keeps every Hermes tool call far under the ~420s terminal
# cap that killed the synchronous battery (QA-HERMES-CANOPY-8).
# Side effects: spawns the temp agent (it OUTLIVES this call by design — collect
# or its TTL tears it down), syncs the repo, writes $EVIDENCE.meta (agent=,
# server=, evidence=, launched=, keep=, project=, phase=) and the ONE launch
# cell that makes a 0-byte evidence file impossible. The record is written only
# once preflights pass — a pre-spawn refusal leaves none (QA-BUNKER-47).
launch() {
  local repo="${1:?usage: bunker-qa.sh launch <repo-dir> [--keep]}"
  shift
  local keep=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --keep) keep=1; shift ;;
      --evidence|-e)
        [ $# -ge 2 ] || { echo "ERROR: --evidence requires a path" >&2; exit 2; }
        EVIDENCE="$2"; shift 2 ;;
      --evidence=*) EVIDENCE="${1#--evidence=}"; shift ;;
      *) shift ;;
    esac
  done

  local PROJ="" QA_PROJ_SLUG=""
  : > "$EVIDENCE"

  # TR-085: a launch killed before it finished (tool cap, SIGTERM, crash) used to
  # leave NO record at all — the meta file was written only on the success path,
  # so `collect` fell back to the shared default evidence path and probed whatever
  # agent id that STALE meta named (dogfood 2026-09-20: collect probed a 2-day-old
  # agent while the real one ran on unrecorded).
  # QA-BUNKER-47: the record is now staged — RESET here (a previous run's record
  # at this path must never survive into this one) and WRITTEN only after
  # preflights pass, so a pre-spawn refusal (config/ssh/reachability rc=2) leaves
  # no launch record at all instead of an empty-agent= one that collect graded
  # "launch was killed before the agent id was recorded".
  local meta="$EVIDENCE.meta"
  qa_launch_meta_reset "$meta"

  # Traps + evidence truncate MUST precede the repo sanity check: a
  # stand-in-workdir dispatch (no .git — QA-GITREINS-POC-QA-1, 2026-09-17)
  # used to exit here silently, leaving a 0-byte evidence file and no FAIL
  # row, which collect then read as "launch phase never executed".
  trap 'write_fail_if_empty "launch terminated by SIGTERM (tool timeout) before the launch cell was recorded"; exit 124' TERM
  trap 'write_fail_if_empty "launch interrupted by SIGINT before the launch cell was recorded"; exit 130' INT
  trap 'write_fail_if_empty "launch exited rc=$? before the launch cell was recorded"' EXIT

  # QA-BUNKER-REVIEW-3: repo sanity + stand-in product-root resolution — shared
  # with run() via qa_repo_sanity (fleet parity with QA-HARNESS-SCOPE-20261004:
  # refuse subdirectory-of-parent targets unless BUNKER_QA_SUBDIR opts in, and
  # resolve a stand-in dir whose .coding-hermes/board symlinks into a different
  # product repo). Traps precede this: a refusal still records its row.
  repo=$(qa_repo_sanity "$repo" launch) || exit 1
  # QA-CRIER-62 (fail-closed target binding): BEFORE preflights, before .meta and
  # before any spawn. rc=4 = target-invalid — one target-invalid row, the report
  # retained at $EVIDENCE.target-invalid, NO launch record (QA-BUNKER-47: a
  # refusal must leave collect nothing to probe) and no product finding.
  qa_target_binding_gate "$repo" launch || exit $?

  log "QA LAUNCH project: $PROJ — detached battery on $SERVER (ttl $TTL)"
  preflights
  # QA-BUNKER-75: reclaim agents whose detached controller died before collect.
  # This runs before spawn so an abandoned slot cannot block the new battery.
  # QA-MUSTER-046: the sweep is scoped to the server THIS battery targets — a
  # lock recorded against another host is skipped, never listed and never
  # destroyed (an unbounded foreign destroy is what wedged launches).
  qa_cleanup_orphan_agents "$SERVER"
  # QA-BUNKER-60 (2026-10-07): repo-weight preflight — WARN (stderr only; no
  # evidence file is open here yet) when the workspace is heavy AND the
  # resolved slice is still the 2-CPU default, BEFORE a spawn burns a TTL on it.
  qa_preflight_repo_weight "$repo"

  # QA-BUNKER-47: preflights PASSED — this is the first point where a spawn can
  # happen, so record the attempt now (phase=spawning, agent= still empty) and
  # keep it current as the id becomes known. A kill inside spawn_agent therefore
  # still leaves collect a record it can trust (TR-085), while a preflight
  # refusal above left none.
  qa_launch_meta_write "$meta" "$EVIDENCE" spawning "" "$SERVER" "$keep" "$PROJ" "" "$repo"

  local spawn_err
  spawn_err=$(mktemp)
  agent=$(spawn_agent 2>"$spawn_err") || {
    # Same contract as run(): hard-fail loudly with ONE actionable FAIL cell
    # (the real spawn stderr) so parse_cells can never read an empty evidence
    # file as "nothing to check".
    local err_detail
    err_detail=$(tail -3 "$spawn_err" | tr '\n' ' ' | cut -c1-300)
    rm -f "$spawn_err"
    echo "ERROR: spawn failed on $SERVER: $err_detail" >&2
    printf '{"cell":"run_battery","status":"FAIL","detail":"spawn failed on %s: %s","ts":"%s"}\n' \
      "$SERVER" "$err_detail" "$(date -u +%FT%TZ)" >> "$EVIDENCE"
    exit 1
  }
  rm -f "$spawn_err"
  key="$HOME/.bunker/keys/$agent"
  BUNKER_QA_AGENT="$agent"
  cleanup() {
    local exit_rc=$?
    if [ -n "${BUNKER_QA_AGENT:-}" ]; then
      log "destroying temp agent $BUNKER_QA_AGENT"
      qa_destroy_agent "$BUNKER_QA_AGENT" "$EVIDENCE" || true
      qa_remove_agent_lock "$BUNKER_QA_AGENT" >/dev/null 2>&1 || true
    fi
    write_fail_if_empty "launch exited rc=$exit_rc before the launch cell was recorded"
  }
  trap cleanup EXIT
  # TR-085: record the real agent id the moment it is known, so a kill anywhere
  # after this point leaves collect() a CORRECT id to poll (or destroy).
  qa_launch_meta_write "$meta" "$EVIDENCE" running "$agent" "$SERVER" "$keep" "$PROJ" "" "$repo"
  # The agent must outlive this call after the detached battery starts; until
  # then the EXIT trap reclaims it on every failure path.
  log "agent=$agent @ $SERVER (tailscale)"

  # Pre-flight hygiene (2026-08-31): temp-agent homes PERSIST across runs, so a
  # previous project's script/evidence/marker/logs survive into this run.
  # Clearing the finish marker matters here: a stale one would make collect()
  # read "finished" while this run's battery is barely started.
  agent_ssh "rm -f ~/qa-run.sh ~/qa-run.finished ~/qa-run.log ~/qa-up-prev ~/qa-up-prev.absent ~/qa-evidence.jsonl /tmp/inst.log /tmp/ci.log /tmp/native.log /tmp/disc.log /tmp/ep.log /tmp/sd.log /tmp/res.log" >/dev/null 2>&1 || true

  detect_cmds "$repo" "$agent"

  log "CELL fresh-install: sync repo → ~/qa-$QA_PROJ_SLUG"
  if ! sync_repo "$repo" "$QA_PROJ_SLUG"; then
    echo "ERROR: repo sync failed — $SYNC_ERR" >&2
    printf '{"cell":"run_battery","status":"FAIL","detail":"repo sync failed in launch phase (server=%s agent=%s): %s","ts":"%s"}\n' \
      "$SERVER" "$agent" "$(printf '%s' "$SYNC_ERR" | tr '\n' ' ' | cut -c1-300)" "$(date -u +%FT%TZ)" >> "$EVIDENCE"
    exit 1
  fi

  # QA-OFF-BY-ONE-22: stream the previous release's tree for the upgrade cell
  ship_prev_tag_tree "$repo" "$QA_PROJ_SLUG"

  # Ship the remote script base64 (the ONLY quoting-safe path through ssh) and
  # START it detached. Deviations from the naive one-liner, both deliberate:
  #  * the decode runs in the FOREGROUND (so a mangled b64 cannot print
  #    LAUNCHED over an empty ~/qa-run.sh), and `wc -c` records the shipped size;
  #  * the start is grouped `( ... & )` with </dev/null so the battery is fully
  #    orphaned (setsid + nohup + no stdin) and the ssh channel closes at once.
  #  * 2026-10-05 (QA-BUNKER-40): the script is piped over ssh via STDIN, not
  #    embedded in the ssh COMMAND LINE — the generated script has grown past
  #    ~97KB plain (~131KB base64), and a b64 that large as a single argv word
  #    exceeds the kernel per-argument limit MAX_ARG_STRLEN (131072, ~128KB),
  #    dying `/usr/bin/timeout: Argument list too long` (E2BIG) on the agent
  #    side for every repo whose DETECT_* block pushed the script over the
  #    line. stdin carries no argv-size limit and is still quoting-safe.
  local b64 launch_out launch_rc script_bytes
  script_bytes=$(build_remote_script "$PROJ" "$DETECT_INSTALL" "$DETECT_CI" "$DETECT_NATIVE" | wc -c)
  launch_out=$(build_remote_script "$PROJ" "$DETECT_INSTALL" "$DETECT_CI" "$DETECT_NATIVE" \
    | agent_ssh "cat > ~/qa-run.sh && echo SCRIPT_BYTES=\$(wc -c < ~/qa-run.sh) && ( nohup setsid bash ~/qa-run.sh </dev/null >~/qa-run.log 2>&1 & ) && echo LAUNCHED" 2>&1)
  launch_rc=$?
  if ! printf '%s' "$launch_out" | grep -q 'LAUNCHED'; then
    echo "ERROR: could not start the battery on agent=$agent ($SERVER): $(printf '%s' "$launch_out" | tail -1)" >&2
    printf '{"cell":"run_battery","status":"FAIL","detail":"qa-run.sh could not be started on agent=%s (%s) rc=%s: %s","ts":"%s"}\n' \
      "$agent" "$SERVER" "$launch_rc" "$(printf '%s' "$launch_out" | tr '\n' ' ' | cut -c1-300)" "$(date -u +%FT%TZ)" >> "$EVIDENCE"
    exit 1
  fi

  local launched meta script_bytes
  launched=$(date -u +%FT%TZ)
  script_bytes=$(printf '%s' "$launch_out" | sed -n 's/^SCRIPT_BYTES=//p' | tail -1)
  qa_launch_meta_write "$meta" "$EVIDENCE" launched "$agent" "$SERVER" "$keep" "$PROJ" "$launched" "$repo"
  # QA-BUNKER-60 (2026-10-07): the evidence names its slice — a 3h battery is
  # unreadable after the fact without knowing whether it ran on the 2-CPU
  # default or a bumped quota. agent= stays first (evidence contract).
  # QA-BUNKER-B20: summary computed AFTER the launch row is appended (the row
  # is wrapper bookkeeping and intentionally not audit signal).
  printf '{"project":"%s","cell":"launch","status":"OK","detail":"agent=%s server=%s ttl=%s cpu=%s memory=%s script_bytes=%s — battery started detached (qa-run.sh); phase B: bunker-qa.sh collect --evidence %s","ts":"%s"}\n' \
    "$PROJ" "$agent" "$SERVER" "$TTL" "${BUNKER_QA_CPUS:-$(qa_slice_cpus "$repo")}" "${BUNKER_QA_MEM:-default}" "${script_bytes:-unknown}" "$EVIDENCE" "$launched" >> "$EVIDENCE"
  trap - EXIT
  local summary
  summary=$(qa_run_summary "$EVIDENCE")
  log "QA launch complete — no cells waited on locally (phase B: collect --evidence $EVIDENCE)"
  # QA-BUNKER-B20: additive honest verdict line at the END of the log. Zero
  # verdict-bearing cells is the EXPECTED shape for a detached launch (the
  # battery runs on the agent; collect merges them later), so launch never
  # fails the run for it — the line names the count and the phase split.
  echo "$summary"
  echo "LAUNCHED agent=$agent evidence=$EVIDENCE"
  # QA-CRIER-62: the bound identity is what makes this run citable — project,
  # tested HEAD (in the target-binding row) and the evidence digest travel
  # together. Additive line; existing consumers read LAUNCHED.
  if command -v sha256sum >/dev/null 2>&1; then echo "TARGET-PROJECT=$PROJ"; echo "EVIDENCE_SHA256=$(sha256sum "$EVIDENCE" | awk '{print $1}')"; fi
}

# ─── collect — PHASE B: poll → sync → pull → destroy (idempotent) ───
# While the battery is still alive on the agent this prints RUNNING, exits 0 and
# DESTROYS NOTHING, so a short-poll loop can call it repeatedly until the
# 7-15 min battery finishes. QA-BUNKER-77: each RUNNING poll ALSO syncs the
# agent's ~/qa-evidence.jsonl rows into the local evidence file (merge-deduped,
# best-effort) — the agent user can be reaped server-side long before the 4h TTL
# (~35min post-launch observed on bunker-mvp), and synced rows are what lets a
# later collect grade the loss agent-gone instead of aborting. Once the battery
# is done: merge-dedupe ~/qa-evidence.jsonl, pull the per-cell log dir
# (~/qa-logs-*) to <evidence>.logs/ BEFORE the destroy — the only place they
# survive the user reap — then append ONE collect cell, destroy the temp agent,
# print COLLECTED. Failures (no launch record / unreachable agent with NOTHING
# synced / pull failed with nothing synced) record a collect FAIL plus an INFO
# harness-failure row, then abort immediately after that bounded attempt; a
# failed collect must not ride the battery wall-clock TTL. An unreachable agent
# whose rows WERE already synced is graded agent-gone (collect row
# status=agent-gone, stdout AGENT-GONE, rc=0): the run is not lost, only the
# per-cell logs are.
collect() {
  local evidence=""
  # QA-BUNKER-45: one collect invocation is one bounded harness attempt. Keep
  # the timing on the evidence row itself so a dead host is distinguishable
  # from a slow harness without reconstructing SSH history.
  local attempt_started_at attempt_started_ms
  attempt_started_at=$(date -u +%FT%T.%3NZ)
  attempt_started_ms=$(date +%s%3N)
  while [ $# -gt 0 ]; do
    case "$1" in
      --evidence|-e) evidence="${2:-}"; shift 2 ;;
      --evidence=*) evidence="${1#--evidence=}"; shift ;;
      -*) echo "ERROR: unknown collect flag: $1" >&2; exit 2 ;;
      *) evidence="$1"; shift ;;
    esac
  done
  [ -n "$evidence" ] || { echo "usage: bunker-qa.sh collect --evidence <path>" >&2; exit 2; }
  [ -f "$evidence" ] || : > "$evidence"
  local meta="$evidence.meta"
  # QA-HERMES-CANOPY-54: the launch recorded its per-agent spawn transcript at
  # <EVIDENCE>.agent-<id>.spawn in the LAUNCH process. collect is a separate
  # process whose global $EVIDENCE is an unrelated fresh default, so pin the
  # spawn-file base to the evidence path this collect was asked for — the same
  # base the launch wrote, and the one its meta record names. Without this an
  # adopted agent's port fell through to 2223 and a live agent on 22 read as
  # unreachable.
  QA_SPAWN_BASE="$evidence"

  # QA-CRIER-066-R2: the tick id names the evidence directory under the DURABLE
  # OUT-OF-TREE persist root (~/.hermes/qa/evidence/<project>/<tick>/;
  # LORE-HYGIENE-20261122 replaced the old in-repo path, which left 100-500K of
  # untracked residue per battery) so a closeout can cite a stable path beyond
  # /tmp. Caller-supplied via BUNKER_QA_TICK; otherwise a UTC
  # stamp. A tick id that could escape the directory (path separators, "..")
  # is refused rather than sanitised silently — a wrong path is worse than a
  # loud fallback.
  local tick_id="${BUNKER_QA_TICK:-}"
  if [ -z "$tick_id" ]; then
    tick_id="qa-$(date -u +%Y%m%dT%H%M%SZ)"
  else
    case "$tick_id" in
      *[!A-Za-z0-9._-]*|.|..)
        echo "WARN: BUNKER_QA_TICK=$tick_id is not a safe directory name — falling back to a UTC stamp" >&2
        tick_id="qa-$(date -u +%Y%m%dT%H%M%SZ)"
        ;;
    esac
  fi

  # QA-CRIER-62: a launch refused by the target-binding gate left a
  # target-invalid row and NO launch record on purpose. State that plainly
  # instead of the generic "launch phase never ran" crash story — and never
  # probe/destroy an agent for a battery that was never bound to its project.
  if evidence_has_cell "$evidence" target-binding target-invalid; then
    echo "TARGET-INVALID evidence=$evidence report=$evidence.target-invalid"
    exit 4
  fi

  append_collect_row() { # <status> <detail>
    local row_status="$1" row_detail="$2" duration_ms finished_at
    duration_ms=$(( $(date +%s%3N) - attempt_started_ms ))
    finished_at=$(date -u +%FT%T.%3NZ)
    # QA-HERMES-CANOPY-54: the detail is ESCAPED before interpolation. Details
    # carry diagnostics that legitimately contain quotes (collect_retry_note
    # embeds first_error="…", ssh stderr quotes the host/path), and a raw `"`
    # produced an unparseable row — jq died on the whole ledger, so the very
    # evidence naming the failed transport was unreadable. json_one_line() is
    # defined below but resolved at call time, which is all a function body
    # needs. Truncate BEFORE escaping so a 300-char cut can never split a \"
    # escape pair into invalid JSON.
    printf '{"cell":"collect","status":"%s","detail":"%s","host":"%s","collect_attempt":1,"attempt_started":"%s","attempt_finished":"%s","duration_ms":%s,"ts":"%s"}\n' \
      "$row_status" "$(json_one_line "$(printf '%s' "$row_detail" | tr '\n\r\t' '   ' | cut -c1-300)")" "$SERVER" \
      "$attempt_started_at" "$finished_at" "$duration_ms" "$(date -u +%FT%TZ)" >> "$evidence"
  }

  # ─── QA-CRIER-066-R2 (2026-11-18): try-once / record / retry-once ─────────
  # WHY: collect() used to fail closed on the FIRST transport hiccup, and a
  # collect that dies (or is aborted by a tool cap) drops its cells from the
  # ledger entirely — the 2026-11-15 dogfood tick merged its evidence JSONL +
  # ci.log into /tmp, both vanished, and board row DF-CRIER-497-R2 ended up
  # citing evidence that exists nowhere. Every fail-closed transport attempt
  # below now runs TWICE, and the FIRST error is written into the ledger BEFORE
  # the retry so it survives the agent destroy that may follow seconds later
  # (a retry logged only to stderr dies with the shell).
  local collect_retry_note="" collect_attempts=1 not_collected_done=0
  json_one_line() { # <text> — JSON-safe single line (for printf'd rows)
    printf '%s' "${1:-}" | tr '\n\r\t' '   ' | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
  }
  record_collect_retry() { # <stage> <first error, one line> — durable, PRE-retry
    local stage="${1:-unknown}" reason
    reason=$(json_one_line "${2:-first attempt failed with no diagnostic}" | cut -c1-240)
    collect_attempts=2
    collect_retry_note="retry stage=$stage attempts=2 first_error=\"$reason\""
    printf '{"cell":"collect","status":"INFO","detail":"COLLECT-RETRY attempt=1 stage=%s reason=\\"%s\\" — retrying once BEFORE any destroy/agent-release step","host":"%s","stage":"%s","retry_attempt":1,"attempts":2,"ts":"%s"}\n' \
      "$stage" "$reason" "$SERVER" "$stage" "$(date -u +%FT%TZ)" >> "$evidence"
    echo "COLLECT-RETRY attempt=1 stage=$stage reason=\"$reason\"" >&2
  }

  # QA-BUNKER-45: abort is the primary policy, not an unbounded retry or a
  # retarget claim. One failed collect records both the failed attempt timing
  # and an explicit INFO harness-failure attributed to the configured host.
  # The caller exits nonzero immediately; there is no second collect attempt.
  # QA-CRIER-066-R2: the retry happens INSIDE a stage (once per attempt), never
  # as a second collect — so every abort carries the retry evidence when the
  # stage it died in was already retried.
  abort_collect() { # <reason> — one failed collect terminates the harness
    local reason="$1" duration_ms finished_at
    [ -n "${collect_retry_note:-}" ] && reason="$reason; $collect_retry_note"
    duration_ms=$(( $(date +%s%3N) - attempt_started_ms ))
    finished_at=$(date -u +%FT%T.%3NZ)
    append_collect_row FAIL "$reason"
    # Same escaping contract as append_collect_row: the reason may carry quoted
    # diagnostics (retry note, ssh stderr) and an unescaped `"` makes the whole
    # ledger unparseable for every consumer (jq aborts on the file).
    printf '{"cell":"harness-failure","status":"INFO","detail":"harness abort after one failed collect: %s","attributed_host":"%s","host":"%s","collect_attempt":1,"attempt_started":"%s","attempt_finished":"%s","duration_ms":%s,"ts":"%s"}\n' \
      "$(json_one_line "$(printf '%s' "$reason" | tr '\n\r\t' '   ' | cut -c1-300)")" "$SERVER" "$SERVER" \
      "$attempt_started_at" "$finished_at" "$duration_ms" "$(date -u +%FT%TZ)" >> "$evidence"
    echo "COLLECT-ABORT host=$SERVER reason=$(printf '%s' "$reason" | tr '\n' ' ' | cut -c1-240)" >&2
    return 2
  }

  # QA-BUNKER-77 (2026-11-01): shared merge — used by the RUNNING incremental
  # sync and the FINISHED pull. Idempotent on the row "ts" field, atomic (temp
  # file + os.replace) so a crash mid-merge cannot truncate the evidence file.
  merge_agent_rows() { # <src> — merge-dedupe <src>'s rows into $evidence
    local src="$1"
    if [ -s "$src" ] && command -v python3 >/dev/null 2>&1; then
      python3 - "$evidence" "$src" <<'PY' || cat "$src" >> "$evidence"
import json, os, sys

dest, src = sys.argv[1], sys.argv[2]
seen, out = set(), []
for path in (dest, src):
    try:
        fh = open(path)
    except OSError:
        continue
    with fh:
        for line in fh:
            line = line.strip()
            if not line.startswith("{"):
                continue
            try:
                row = json.loads(line)
            except Exception:
                continue
            key = row.get("ts")
            if key in seen:
                continue
            seen.add(key)
            out.append(json.dumps(row))
tmp_dest = dest + ".merge.tmp"
with open(tmp_dest, "w") as fh:
    fh.write("\n".join(out) + ("\n" if out else ""))
os.replace(tmp_dest, dest)
PY
    elif [ -s "$src" ]; then
      cat "$src" >> "$evidence"   # no python3: a duplicate row beats an unpulled battery
    fi
  }

  # ─── QA-CRIER-066-R2 (B): no silent cell drops ────────────────────────────
  # The owed set is DERIVED from the battery's own cell() call sites — never a
  # hand-typed list that can drift. Priority: (1) the exact qa-run.sh the
  # battery ran (pulled while the agent is still alive), (2) the
  # build_remote_script() generator loaded in THIS process, (3) this harness
  # file's generated-script fence. Nothing derivable ⇒ one named WARN row,
  # never an invented cell name.
  local cells_src="" roster_from="" test_repo_cache=""
  prepare_cells_source() { # <agent|local> — sets cells_src/roster_from
    local mode="${1:-local}" cand tmp
    [ -n "$cells_src" ] && [ -f "$cells_src" ] && return 0
    tmp=$(mktemp "${TMPDIR:-/tmp}/qa-cells-src.XXXXXX") || return 1
    if [ "$mode" = agent ] && [ -n "${agent:-}" ]; then
      if BUNKER_QA_SSH_TIMEOUT="${ssh_to:-120}" agent_ssh "cat ~/qa-run.sh 2>/dev/null" > "$tmp" 2>/dev/null && grep -q 'cell ' "$tmp" 2>/dev/null; then
        cells_src="$tmp"; roster_from="agent:~/qa-run.sh"; return 0
      fi
    fi
    if declare -f build_remote_script >/dev/null 2>&1 && declare -f build_remote_script 2>/dev/null | grep -q 'cell '; then
      declare -f build_remote_script > "$tmp" 2>/dev/null
      cells_src="$tmp"; roster_from="generator:build_remote_script"; return 0
    fi
    cand="${BUNKER_QA_HARNESS_SRC:-${BASH_SOURCE[0]:-$0}}"
    if [ -n "$cand" ] && [ -f "$cand" ] && grep -q 'cell ' "$cand" 2>/dev/null; then
      cp "$cand" "$tmp" 2>/dev/null || : > "$tmp"
      cells_src="$tmp"; roster_from="harness:$cand"; return 0
    fi
    rm -f "$tmp"
    return 1
  }

  derive_owed_cells() { # <agent|local> — stdout: owed cell names; rc 1 = underivable
    prepare_cells_source "${1:-local}" || return 1
    # The file may BE the generated battery (no fence) or the generator source
    # (one `cat <<EOF … EOF` fence): take the fence body when it carries cell
    # calls, else the whole file.
    local body names
    body=$(mktemp "${TMPDIR:-/tmp}/qa-cells-body.XXXXXX") || return 1
    awk '/^[[:space:]]*cat <<EOF[[:space:]]*$/{i=1;next} i&&/^EOF[[:space:]]*$/{exit} i{print}' "$cells_src" > "$body" 2>/dev/null
    if ! grep -q 'cell ' "$body" 2>/dev/null; then cp "$cells_src" "$body" 2>/dev/null; fi
    # A cell CALL is a `cell <name>` token pair at a SHELL command position
    # (line start, after `;`/`(`/`{`/`|`/`&`, `then`/`else`/`do`, or a `case`
    # arm like `0)` / `*)`). Prose ("treat the cell as untested") and detail
    # strings are therefore not cells.
    names=$(awk '
      { if ($0 ~ /^[[:space:]]*#/) next
        n = split($0, t, /[[:space:]]+/)
        for (i = 1; i < n; i++) {
          if (t[i] != "cell") continue
          prev = (i == 1) ? "" : t[i-1]
          if (prev != "" && prev !~ /^[;({|&]+$/ && prev !~ /^[0-9*]+\)$/ && prev != "then" && prev != "else" && prev != "do") continue
          name = t[i+1]
          if (name ~ /^[a-z][a-z0-9_-]*$/) print name
        } }' "$body" 2>/dev/null | sort -u)
    # QA-LORE-8 (2026-11-23): failure-branch-only cells are never independently
    # owed. The battery emits ci-act only beside a FAILED ci-pass act leg, so a
    # green or skipped CI fire legitimately has no ci-act row; NOT-COLLECTED
    # accounting must not invent one. A genuinely dropped CI leg is still
    # covered by ci-pass itself (its absence still emits a NOT-COLLECTED row).
    names=$(printf '%s\n' "$names" | grep -vx 'ci-act' || true)
    rm -f "$body"
    [ -n "$names" ] || return 1
    printf '%s\n' "$names"
  }

  present_cells() { # stdout: " name name … " — cells that already HAVE a row
    printf ' %s ' "$(grep -oE '"cell"[[:space:]]*:[[:space:]]*"[^"]+"' "$evidence" 2>/dev/null |
      sed -E 's/.*"([^"]+)"$/\1/' | sort -u | tr '\n' ' ')"
  }

  # One explicit row per owed cell that has no row — the ledger must never read
  # as if a dropped cell was never owed.
  emit_not_collected() { # <reason> [agent|local]
    local reason="$1" mode="${2:-local}" owed name present
    [ "${not_collected_done:-0}" -eq 0 ] || return 0
    not_collected_done=1
    if ! owed=$(derive_owed_cells "$mode"); then
      printf '{"cell":"collect-cells","status":"WARN","detail":"could not derive the battery cell roster (agent ~/qa-run.sh, build_remote_script, or %s) — owed-cell accounting SKIPPED for tick %s: a dropped cell may be invisible in this ledger","host":"%s","ts":"%s"}\n' \
        "$(json_one_line "${BUNKER_QA_HARNESS_SRC:-$0}")" "$tick_id" "$SERVER" "$(date -u +%FT%TZ)" >> "$evidence"
      echo "COLLECT-CELLS underivable tick=$tick_id — no NOT-COLLECTED rows emitted" >&2
      return 0
    fi
    present=$(present_cells)
    local emitted=0
    while IFS= read -r name; do
      [ -n "$name" ] || continue
      case "$present" in *" $name "*) continue ;; esac
      printf '{"cell":"%s","verdict":"NOT-COLLECTED","status":"UNVERIFIED","reason":"%s","tick":"%s","host":"%s","ts":"%s"}\n' \
        "$name" "$(json_one_line "$reason" | cut -c1-240)" "$tick_id" "$SERVER" "$(date -u +%FT%TZ)" >> "$evidence"
      echo "COLLECT-CELL cell=$name verdict=NOT-COLLECTED tick=$tick_id" >&2
      emitted=$((emitted + 1))
    done <<< "$owed"
    [ "$emitted" -gt 0 ] || return 0
    log "recorded $emitted NOT-COLLECTED cell row(s) (roster source: $roster_from)"
    return 0
  }

  # ─── QA-CRIER-066-R2 (C): the evidence must land INSIDE the repo ──────────
  # /tmp is not a citation: the 2026-11-15 dogfood run left its merged ledger
  # and ci.log there and both were gone by closeout. The repo under test comes
  # from the launch record (repo=), else BUNKER_QA_TEST_REPO / BUNKER_QA_REPO_ROOT
  # (tests and deployed callers). Unresolvable ⇒ a named skip, never a guess.
  test_repo() { # stdout: the repo under test; rc 1 = unresolved
    if [ -n "$test_repo_cache" ]; then printf '%s\n' "$test_repo_cache"; return 0; fi
    local cand
    for cand in "${BUNKER_QA_TEST_REPO:-}" "$(sed -n 's/^repo=//p' "$meta" 2>/dev/null | head -1)" "${BUNKER_QA_REPO_ROOT:-}"; do
      [ -n "$cand" ] || continue
      [ -d "$cand" ] || continue
      test_repo_cache="$cand"
      printf '%s\n' "$cand"
      return 0
    done
    return 1
  }

  # QA-CRIER-066 (1)+(2): the MANIFEST that makes the persisted copy verifiable
  # later, and the ordering that makes it honest.
  # ORDERING IS LOAD-BEARING: the digest must cover the byte stream as it exists
  # after the LAST row collect() can write. Everything that appends happens
  # BEFORE persist_evidence in collect() (NOT-COLLECTED, the collect OK row, the
  # out-of-repo WARN), and the evidence-copy FAIL row is the one row appended
  # after a copy attempt — so the copy is REFRESHED here immediately before
  # hashing (a row that landed at/after the copy point is picked up, and the
  # refresh is recorded as copy_refreshed), and the hash is taken from the
  # PERSISTED file: the exact bytes `verify-evidence` will hash. A digest taken
  # before the last append is precisely the bug this row was filed on.
  write_evidence_manifest() { # <dest dir> -> 0 written; prints the ONE digest line
    local dest="$1" dst="$1/evidence.jsonl" src="$evidence" sha rows bytes
    local refreshed=false mf tmp proj tgt created logs_present=false
    [ -f "$dst" ] || return 1
    if ! cmp -s "$src" "$dst" 2>/dev/null; then
      cp -p "$src" "$dst" 2>/dev/null || return 1
      refreshed=true
    fi
    sha=$(qa_sha256 "$dst") || return 1
    rows=$(qa_evidence_rows "$dst")
    bytes=$(wc -c < "$dst" 2>/dev/null | tr -d '[:space:]')
    proj=$(sed -n 's/^project=//p' "$meta" 2>/dev/null | head -1)
    [ -n "$proj" ] || proj="${BUNKER_QA_PROJECT_IDENTITY:-}"
    tgt=$(sed -n 's/^target=//p' "$meta" 2>/dev/null | head -1)
    [ -n "$tgt" ] || tgt=$(sed -n 's/^repo=//p' "$meta" 2>/dev/null | head -1)
    created=$(date -u +%FT%TZ)
    [ -n "${logs_dir:-}" ] && [ -d "$logs_dir" ] && [ -n "$(ls -A "$logs_dir" 2>/dev/null)" ] && logs_present=true
    mf="$dest/manifest.json"
    tmp="$dest/.manifest.json.tmp.$$"
    # One JSON object, one line: a closeout can grep/cat it without a parser.
    if ! printf '{"schema":"qa-evidence-manifest/1","tick":"%s","project":"%s","target":"%s","source":"%s","evidence":"evidence.jsonl","evidence_sha256":"%s","evidence_rows":%s,"evidence_bytes":%s,"copy_refreshed":%s,"logs_present":%s,"created_at":"%s","harness":"bunker-qa.sh"}\n' \
      "$(json_one_line "$tick_id")" "$(json_one_line "$proj")" "$(json_one_line "$tgt")" \
      "$(json_one_line "$src")" "$sha" "$rows" "${bytes:-0}" "$refreshed" "$logs_present" \
      "$created" > "$tmp" 2>/dev/null; then
      rm -f "$tmp"
      return 1
    fi
    if ! mv -f "$tmp" "$mf" 2>/dev/null; then rm -f "$tmp"; return 1; fi
    # QA-CRIER-066 (3): exactly ONE stdlib-citable digest line for the closeout.
    echo "EVIDENCE-SHA256=$sha EVIDENCE-ROWS=$rows"
    if [ "$refreshed" = true ]; then
      echo "EVIDENCE-MANIFEST tick=$tick_id refreshed=true reason=\"a row landed after the copy — re-copied before hashing so the digest covers it\"" >&2
    fi
    return 0
  }

  persist_evidence() { # -> 0 when the ledger + per-cell logs are inside the repo
    local root dest abs rc=0
    if ! root=$(test_repo); then
      echo "EVIDENCE-COPY-SKIP tick=$tick_id reason=\"no repo-under-test resolved (launch record has no repo= line; set BUNKER_QA_TEST_REPO)\" evidence=$evidence" >&2
      return 1
    fi
    dest="$(qa_evidence_persist_root "$root" "$meta")/$tick_id"
    mkdir -p "$dest" 2>/dev/null || rc=1
    if [ "$rc" -eq 0 ]; then cp -p "$evidence" "$dest/evidence.jsonl" 2>/dev/null || rc=1; fi
    if [ "$rc" -eq 0 ] && [ -n "${logs_dir:-}" ] && [ -d "$logs_dir" ] && [ -n "$(ls -A "$logs_dir" 2>/dev/null)" ]; then
      mkdir -p "$dest/logs" 2>/dev/null && cp -a "$logs_dir/." "$dest/logs/" 2>/dev/null || rc=1
    fi
    if [ "$rc" -ne 0 ]; then
      printf '{"cell":"evidence-copy","status":"FAIL","detail":"could not persist the merged evidence into %s (source %s) — the run is still only at a deletable path","host":"%s","ts":"%s"}\n' \
        "$(json_one_line "$dest")" "$(json_one_line "$evidence")" "$SERVER" "$(date -u +%FT%TZ)" >> "$evidence"
      echo "EVIDENCE-COPY-FAIL dest=$dest evidence=$evidence" >&2
      # QA-CRIER-066 (2): this FAIL row was appended AFTER the copy attempt, so
      # refresh whatever did land and DROP any manifest — a manifest that does
      # not cover the ledger is the exact defect this row fixes.
      if [ -f "$dest/evidence.jsonl" ]; then
        [ "$(qa_sha256 "$dest/evidence.jsonl" 2>/dev/null)" = "$(qa_sha256 "$evidence" 2>/dev/null)" ] ||
          cp -p "$evidence" "$dest/evidence.jsonl" 2>/dev/null
      fi
      rm -f "$dest/manifest.json" 2>/dev/null
      return 1
    fi
    abs=$(CDPATH= cd -- "$dest" 2>/dev/null && pwd) || abs="$dest"
    echo "EVIDENCE-DIR=$abs"
    if [ -n "${logs_dir:-}" ] && [ -d "$logs_dir" ] && [ -n "$(ls -A "$logs_dir" 2>/dev/null)" ]; then
      echo "EVIDENCE-LOGS=$abs/logs" >&2
    else
      echo "EVIDENCE-LOGS-MISSING tick=$tick_id reason=\"${log_note:-per-cell logs were not pulled}\"" >&2
    fi
    # QA-CRIER-066: the copy is complete — certify the bytes that are actually on
    # disk. A manifest failure is a named stderr surface, never a silent pass and
    # never a regression of the copy itself (EVIDENCE-DIR was already printed).
    if ! write_evidence_manifest "$abs"; then
      echo "EVIDENCE-MANIFEST-FAIL dest=$abs reason=\"could not write manifest.json / compute the digest (no sha256 tool, unwritable dir, or a failed refresh) — the copy exists but is NOT verifiable\"" >&2
    fi
    return 0
  }

  # QA-BUNKER-77: persist the already-synced marker once rows from this agent
  # are on local disk. It is what makes a later unreachable collect grade
  # agent-gone (run preserved) instead of aborting (run lost).
  mark_rows_synced() { # <count>
    [ "${1:-0}" -gt 0 ] && printf 'synced_rows=%s ts=%s\n' "$1" "$(date -u +%FT%TZ)" > "$evidence.synced-$agent"
  }

  # QA-BUNKER-77: pull the agent's per-cell log dirs (~/qa-logs-*) to
  # <evidence>.logs/ BEFORE the destroy — after the agent user is reaped or
  # destroyed they are unrecoverable, and the evidence rows carry only 40-line
  # log tails. Sets $log_note (caller local) on every outcome.
  # QA-CRIER-066-R2 (A): the tar pull runs TWICE. The field loss this row fixes
  # (DF-CRIER-497-R2: ci.log harvested to /tmp, then gone) started with a single
  # failed tar — one retry, recorded in the ledger before the second attempt,
  # costs seconds and is the difference between a citable run and an empty one.
  pull_agent_logs_once() { # -> 0 when THIS attempt saved the logs
    local tarf
    tarf=$(mktemp)
    if BUNKER_QA_SSH_TIMEOUT="${ssh_to:-120}" agent_ssh "cd ~ && tar -czf - qa-logs-* 2>/dev/null" > "$tarf" 2>/dev/null && [ -s "$tarf" ]; then
      if mkdir -p "$logs_dir" && tar -xzf "$tarf" -C "$logs_dir" 2>/dev/null; then
        rm -f "$tarf"
        return 0
      fi
    fi
    rm -f "$tarf"
    return 1
  }
  pull_agent_logs() { # -> 0 when logs were saved
    local log_kb tarf
    log_kb=$(BUNKER_QA_SSH_TIMEOUT="$ssh_to" agent_ssh "du -sk ~/qa-logs-* 2>/dev/null | awk '{s+=\$1} END{print s+0}'" 2>/dev/null | tail -1)
    case "$log_kb" in ''|*[!0-9]*) log_note="no per-cell logs found on agent"; return 1 ;; esac
    if [ "$log_kb" -eq 0 ]; then log_note="no per-cell logs found on agent"; return 1; fi
    if [ "$log_kb" -gt "${BUNKER_QA_LOG_PULL_MAX_KB:-524288}" ]; then
      log_note="per-cell logs NOT pulled: ${log_kb}KB exceeds BUNKER_QA_LOG_PULL_MAX_KB=${BUNKER_QA_LOG_PULL_MAX_KB:-524288} cap"
      return 1
    fi
    if pull_agent_logs_once; then return 0; fi
    record_collect_retry logs "per-cell log tar pull from agent=$agent failed (${log_kb}KB on the agent, nothing extracted)"
    if pull_agent_logs_once; then
      log_note="per-cell logs pulled on retry (stage=logs attempts=2)"
      return 0
    fi
    log_note="per-cell logs could not be pulled from agent=$agent (tar pull failed on both attempts=2)"
    return 1
  }

  # QA-BUNKER-77: the named, non-fatal outcome for an agent that is
  # FINISHED/destroyed (or reaped ~35min post-launch in the field) before its
  # per-cell logs could be pulled, PROVIDED the battery's rows were already
  # synced into the local evidence file. The run is not lost: rows stay, the
  # collect row records status=agent-gone, stdout names AGENT-GONE, rc=0.
  emit_agent_gone() { # <reason>
    local reason="$1" synced_rows
    [ -n "${collect_retry_note:-}" ] && reason="$reason; $collect_retry_note"
    synced_rows=$(sed -n 's/^synced_rows=//p' "$evidence.synced-$agent" 2>/dev/null | tail -1)
    append_collect_row agent-gone "$reason"
    # QA-CRIER-066-R2: the run is preserved but PARTIAL — say which cells never
    # came back instead of leaving the ledger looking like a complete battery,
    # and put the preserved rows inside the repo before anything else can
    # delete them.
    emit_not_collected "row absent after the agent was lost before the final pull (only ${synced_rows:-0} incrementally-synced row(s) survived)" local
    persist_evidence || true
    qa_remove_agent_lock "$agent" >/dev/null 2>&1 || true
    echo "AGENT-GONE agent=$agent rows=${synced_rows:-0} evidence=$evidence"
    return 0
  }

  if [ ! -f "$meta" ]; then
    # QA-CRIER-066-R2 (A): try once, RECORD, retry once — the record is the only
    # pointer to the agent, so a transient miss (a writer mid-rename, a path
    # race with a sibling run) must not be graded as "launch never ran" on the
    # first look. Both attempts are in the ledger; the FAIL names attempts=2.
    record_collect_retry launch-record "no launch record at $meta (first look)"
    if [ ! -f "$meta" ]; then
      append_collect_row FAIL "no launch record at $meta — nothing to collect (launch phase never ran, or a different evidence path); attempts=2"
      echo "COLLECT-FAIL no-launch-record evidence=$evidence attempts=2"
      exit 1
    fi
    log "launch record $meta appeared on retry (stage=launch-record attempts=2)"
  fi
  # Idempotency: a successful collect already recorded its cell — re-calling is a
  # no-op instead of a spurious "unreachable agent" FAIL (the agent is destroyed
  # by then, so the probe below would be empty).
  if evidence_has_cell "$evidence" collect OK; then
    echo "COLLECTED already-collected"
    exit 0
  fi
  # QA-BUNKER-77: an agent-gone collect is likewise terminal — the agent user
  # is gone; re-probing can only append duplicate noise.
  if evidence_has_cell "$evidence" collect agent-gone; then
    echo "AGENT-GONE already-recorded"
    exit 0
  fi

  local agent="" server="" ev="" keep=0 phase=""
  agent=$(sed -n 's/^agent=//p' "$meta" | head -1)
  server=$(sed -n 's/^server=//p' "$meta" | head -1)
  ev=$(sed -n 's/^evidence=//p' "$meta" | head -1)
  phase=$(sed -n 's/^phase=//p' "$meta" | head -1)
  [ "$(sed -n 's/^keep=//p' "$meta" | head -1)" = "1" ] && keep=1
  [ -n "$server" ] && SERVER="$server"
  [ -n "$ev" ] && [ "$ev" != "$evidence" ] && echo "WARN: launch record names evidence=$ev but collect was asked for $evidence (using $evidence)" >&2
  if [ -z "$agent" ]; then
    # QA-BUNKER-47: an empty agent= is NOT one story. launch() writes the record
    # only after preflights pass and stamps the phase, so:
    #   phase=spawning  -> the run reached spawn and died there (TR-085 shape:
    #                      the tool cap killed spawn before the id was recorded);
    #   phase=preflight*-> defensive: a record stamped by a pre-spawn refusal —
    #                      no agent ever existed, so there is nothing to collect
    #                      and NOTHING was killed;
    #   no phase=       -> a legacy/foreign record; keep the historical wording.
    case "$phase" in
      spawning)
        abort_collect "launch record $meta is phase=spawning with no agent= line — the launch died INSIDE spawn, before the agent id was recorded; check \`bunker list --server $server\` for an orphan and destroy it"
        ;;
      preflight*)
        abort_collect "launch record $meta is phase=$phase — the run was REFUSED before spawn (no agent was ever created, nothing to collect); the verdict is the pre-spawn FAIL row in $evidence"
        ;;
      *)
        # QA-CRIER-066-R2 (A): try once, RECORD, retry once — re-read the record
        # before grading "launch did not record an agent id" (a writer may have
        # just stamped agent=). The FAIL states attempts=2.
        record_collect_retry launch-record "no-agent: launch record $meta has an empty agent= line"
        agent=$(sed -n 's/^agent=//p' "$meta" | head -1)
        [ -n "$agent" ] && log "agent id appeared in $meta on retry (stage=launch-record attempts=2)"
        ;;
    esac
    if [ -z "$agent" ]; then
      append_collect_row FAIL "no-agent: launch record $meta has an empty agent= line; launch did not record an agent id (attempts=2)"
      echo "COLLECT-FAIL no-agent evidence=$evidence attempts=2"
      exit 1
    fi
  fi
  # TR-085: the meta names an agent that is not OURS. A stale meta from an earlier
  # run (or a different evidence path) makes collect probe/destroy the wrong
  # machine while the real agent runs unrecorded. Refuse loudly instead.
  if [ -n "$ev" ] && [ "$ev" != "$evidence" ]; then
    abort_collect "launch record $meta belongs to a different run: it names evidence=$ev but collect was asked for $evidence (agent=$agent NOT probed or destroyed — verify with \`bunker list --server $server\`)"
    exit $?
  fi
  # An agent id only exists for runs that reached the spawn step. If the record
  # predates this collect by more than the TTL the id cannot be live any more.
  local rec_launched rec_age
  rec_launched=$(sed -n 's/^launched=//p' "$meta" | head -1)
  if [ -n "$rec_launched" ]; then
    rec_age=$(python3 - "$rec_launched" <<'PY' 2>/dev/null || echo ""
import sys, datetime
try:
    t = datetime.datetime.strptime(sys.argv[1], '%Y-%m-%dT%H:%M:%SZ').replace(tzinfo=datetime.timezone.utc)
    print(int((datetime.datetime.now(datetime.timezone.utc) - t).total_seconds()))
except Exception:
    print("")
PY
)
    if [ -n "$rec_age" ] && [ "$rec_age" -gt 86400 ]; then
      abort_collect "launch record $meta is ${rec_age}s old (>24h, TTL=$TTL) — agent=$agent cannot still be live; refusing to probe a stale id. Check \`bunker list --server $server\` and re-launch if the battery never ran"
      exit $?
    fi
  fi
  # QA-BUNKER-75: never communicate with an agent owned by a dead tick.
  # The lock is checked after all metadata validation but before SSH/poll/pull.
  # A dead tick is a harness failure, not a product battery result; destroy it
  # immediately and leave a FAIL row naming the stable reason.
  # QA-CRIER-REVIEW-4 (2026-11-04): state 3 (lock younger than
  # BUNKER_QA_ORPHAN_TTL) used to refuse the collect outright. launch ALWAYS
  # exits, so a battery started by process 1 was uncollectable by process 2 for
  # up to 2h — the field run had to destroy agent d871c7f8 and re-run the whole
  # battery inside one wrapper. State 3 now ADOPTS the dead owner's lock
  # (tick_pid -> this collector, adopted= stamped) and continues into the normal
  # RUNNING/GONE/FINISHED probe. Only the invalid lock (state 2) refuses.
  watchdog_state=0
  qa_tick_watchdog_state "$agent" || watchdog_state=$?
  case "$watchdog_state" in
    1)
      local orphan_lock orphan_server orphan_tick_pid orphan_evidence orphan_quarantine
      local orphan_qerr orphan_qrc orphan_qfail orphan_evidence_status orphan_destroy orphan_lock_detail orphan_fail_field
      orphan_lock=$(qa_agent_lock_path "$agent" 2>/dev/null || true)
      orphan_server=$(qa_lock_value "$orphan_lock" server 2>/dev/null || true)
      [ -n "$orphan_server" ] || orphan_server="$server"
      orphan_tick_pid=$(qa_lock_value "$orphan_lock" tick_pid 2>/dev/null || true)
      orphan_evidence=$(qa_lock_value "$orphan_lock" evidence 2>/dev/null || true)
      # QA-CRIER-REVIEW-4: evidence quarantine is best-effort. A dead agent's
      # SSH endpoint (or a vanished evidence file) fails it forever; refusing
      # the destroy over that turned an unreachable agent into a permanent leak
      # (lock + agent home) until the disk gate tripped. Name the failing
      # command, then reap anyway.
      orphan_qerr=$(mktemp)
      orphan_quarantine=$(qa_quarantine_orphan_evidence "$agent" "$orphan_server" "$orphan_evidence" 2>"$orphan_qerr") && orphan_qrc=0 || orphan_qrc=$?
      orphan_qfail=""
      if [ "$orphan_qrc" -eq 0 ] && [ -n "$orphan_quarantine" ]; then
        orphan_evidence_status="quarantined"
      else
        orphan_evidence_status="quarantine-failed"
        orphan_qfail=$(tail -1 "$orphan_qerr" 2>/dev/null | tr -d '\n')
        [ -n "$orphan_qfail" ] || orphan_qfail="quarantine-command-failed rc=$orphan_qrc"
        echo "COLLECT-ORPHAN agent=$agent quarantine_failed failure=\"$orphan_qfail\" — reaping anyway" >&2
      fi
      rm -f "$orphan_qerr"
      orphan_fail_field=""
      [ "$orphan_evidence_status" = "quarantine-failed" ] && orphan_fail_field=" quarantine_failure=\"$orphan_qfail\""
      orphan_destroy=0
      bunker destroy "$agent" --server "$orphan_server" >/dev/null 2>&1 || orphan_destroy=$?
      if [ "$orphan_destroy" -eq 0 ]; then
        qa_remove_agent_lock "$agent" >/dev/null 2>&1 || true
        orphan_lock_detail="lock removed after destroy"
        echo "COLLECT-ORPHAN orphan reaped agent=$agent destroy_rc=$orphan_destroy evidence=${orphan_quarantine:-none} evidence_status=$orphan_evidence_status$orphan_fail_field" >&2
      else
        orphan_lock_detail="lock retained after destroy failure"
        echo "COLLECT-ORPHAN orphan remains agent=$agent destroy_rc=$orphan_destroy evidence=${orphan_quarantine:-none} evidence_status=$orphan_evidence_status$orphan_fail_field — retaining lock" >&2
      fi
      abort_collect "tick-death-orphan: agent=$agent server=$orphan_server tick_pid=$orphan_tick_pid — evidence=${orphan_quarantine:-none} evidence_status=$orphan_evidence_status$orphan_fail_field; orphan handling requested destroy (rc=$orphan_destroy, $orphan_lock_detail); no agent communication attempted"
      exit $?
      ;;
    2)
      abort_collect "invalid tick watchdog lock for agent=$agent — refusing agent communication"
      exit $?
      ;;
    3)
      # QA-CRIER-REVIEW-4: adopt the dead owner's lock instead of quarantining
      # the collector. Only tick_pid changes; server/evidence/created survive.
      local adopt_rc=0 adopt_lock
      adopt_lock=$(qa_adopt_agent_lock "$agent" "$$" 2>/dev/null) || adopt_rc=$?
      if [ "$adopt_rc" -eq 0 ]; then
        echo "COLLECT-ADOPT reason=recent tick-death-orphan agent=$agent new_tick_pid=$$" >&2
      else
        # An unwritable lock must not resurrect the 2h refusal: this collect is
        # the only party that can still reap the battery, so continue and say
        # plainly that the ownership rewrite failed.
        echo "COLLECT-ADOPT reason=recent tick-death-orphan agent=$agent new_tick_pid=$$ adopt_rc=$adopt_rc adopt_status=lock-rewrite-failed" >&2
      fi
      ;;
  esac
  key="$HOME/.bunker/keys/$agent"
  # collect must stay SHORT: bound the agent ssh at BUNKER_QA_COLLECT_SSH_TIMEOUT
  # (120s) instead of agent_ssh's 1800s battery default, so a wedged host cannot
  # blow the tool cap again.
  local ssh_to="${BUNKER_QA_COLLECT_SSH_TIMEOUT:-120}"

  # QA-HERMES-CANOPY-54: an unreachable-agent outcome must name the transport
  # it actually tried — the resolved port and the ssh stderr — so a 2223/22
  # mismatch is diagnosable from the ledger instead of requiring a re-run.
  # Quote-free by construction: the detail stays human-readable in the ledger
  # (append_collect_row escapes as a last resort, but ssh stderr with raw `"`
  # would then read as `\"` in every consumer — strip it here instead).
  collect_ssh_detail() { # <port> <stderr-file|''> -> "port=<n> ssh_stderr=<one line|none>"
    local port="$1" errf="$2" err=""
    if [ -n "$errf" ] && [ -f "$errf" ]; then
      err=$(head -1 "$errf" 2>/dev/null | tr '\n\r\t' '   ' | tr -d '"\\' \
        | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' | cut -c1-200)
    fi
    printf 'port=%s ssh_stderr=%s' "$port" "${err:-none}"
  }

  # ONE cheap probe classifies the remote state. The pgrep pattern is
  # bracket-escaped ([q]a-run\.sh) so this PROBE's own shell argv — which
  # contains the pattern text — can never match itself and report RUNNING forever.
  # QA-CRIER-066-R2 (A): an empty probe is retried once (recorded in the ledger
  # first) before it is graded unreachable.
  local probe probe_errf
  probe_errf=$(mktemp)
  probe_probe() {
    : > "$probe_errf"
    probe=$(BUNKER_QA_SSH_TIMEOUT="$ssh_to" agent_ssh "if [ -f ~/qa-run.finished ]; then echo FINISHED; elif pgrep -f '[q]a-run\\.sh' >/dev/null 2>&1; then echo RUNNING; else echo GONE; fi" 2>"$probe_errf" | tail -1)
    case "$probe" in RUNNING|FINISHED|GONE) return 0 ;; esac
    return 1
  }
  if ! probe_probe; then
    record_collect_retry probe "state probe returned no state from agent=$agent ($SERVER)"
    probe_probe || true
  fi

  case "$probe" in
    RUNNING)
      rm -f "$probe_errf"
      # QA-BUNKER-77: incremental evidence sync while the battery runs. The
      # agent user can be reaped server-side long before the 4h TTL (~35min
      # post-launch observed), so waiting for FINISHED to pull is exactly the
      # window that lost the field logs. Best-effort: a failed sync never
      # fails the poll.
      local sync_tmp synced
      sync_tmp=$(mktemp)
      BUNKER_QA_SSH_TIMEOUT="$ssh_to" agent_ssh "cat ~/qa-evidence.jsonl 2>/dev/null" > "$sync_tmp" 2>/dev/null
      if [ -s "$sync_tmp" ]; then
        merge_agent_rows "$sync_tmp"
        synced=$(grep -c '^{' "$sync_tmp" 2>/dev/null || true)
        if [ "${synced:-0}" -gt 0 ]; then
          mark_rows_synced "$synced"
          log "synced ${synced} evidence row(s) from agent=$agent (battery still running)"
        fi
      fi
      rm -f "$sync_tmp"
      log "battery still running on agent=$agent ($SERVER) — agent left intact"
      echo "RUNNING agent=$agent evidence=$evidence"
      exit 0
      ;;
    FINISHED|GONE)
      rm -f "$probe_errf"
      : ;;  # marker present, or the process is gone → pull what it produced
    *)
      # QA-HERMES-CANOPY-54: name the port this collect dialed and the ssh
      # stderr — the two facts that turn "returned no state" into a diagnosis.
      local probe_detail
      probe_detail=$(collect_ssh_detail "$(agent_ssh_port "$agent")" "$probe_errf")
      rm -f "$probe_errf"
      # QA-BUNKER-77: an unreachable probe is a harness abort only when the run
      # would be lost. Rows already synced by the RUNNING polls ⇒ the run
      # survives: record the named agent-gone outcome with rc=0.
      if [ -s "$evidence.synced-$agent" ]; then
        emit_agent_gone "cannot reach agent=$agent on $SERVER (ssh probe returned no state; $probe_detail) — battery rows were already synced by incremental collect ($evidence.synced-$agent); per-cell logs lost with the agent user"
        exit 0
      fi
      abort_collect "cannot reach agent=$agent on $SERVER (ssh probe returned no state; $probe_detail) — agent left intact"
      exit $?
      ;;
  esac

  local tmp errf pull_rc pulled=0 agent_lines="" agent_count_rc=0 ledger_rc=0 ledger_fail="" ledger_retried=0 abort_rc=0
  tmp=$(mktemp); errf=$(mktemp)

  # QA-CRIER-066-R2 (A): the ledger stage is ONE unit — pull, merge-dedupe, and
  # the authoritative agent-side row count — so the single retry re-runs ALL of
  # it. A retry aimed only at the count gate would merge the same short payload
  # again and "succeed" while still losing rows.
  # rc: 0 complete | 2 zero-or-short pull | 3 agent unreachable, nothing pulled
  ledger_stage() {
    local agent_errf agent_lines_raw pull_err agent_err
    : > "$tmp"; : > "$errf"
    BUNKER_QA_SSH_TIMEOUT="$ssh_to" agent_ssh "cat ~/qa-evidence.jsonl 2>/dev/null" > "$tmp" 2>"$errf"
    pull_rc=$?
    if [ "$pull_rc" -ne 0 ] && [ ! -s "$tmp" ]; then
      ledger_fail="could not pull ~/qa-evidence.jsonl from agent=$agent ($SERVER) rc=$pull_rc: $(head -1 "$errf" 2>/dev/null | tr -d '\r')"
      return 3
    fi
    # Merge-dedupe on the row "ts" field: re-calling collect after a successful
    # pull adds nothing (QA-BUNKER-77: helper shared with the RUNNING sync).
    merge_agent_rows "$tmp"
    pulled=$(grep -c '^{' "$tmp" 2>/dev/null || true)
    # QA-CRIER-066-R3: the agent-side ledger is the authority on how many rows
    # exist. A transport that returns 0 bytes with rc=0 (empty/truncated ledger,
    # a stubbed probe step) used to be graded a SUCCESS — "pulled 0 evidence
    # row(s)" + COLLECTED + teardown — which is exactly how three field fires
    # lost evidence that an OK row claimed existed. Ask the agent for the
    # authoritative row count (awk NF tolerates a missing trailing newline and
    # blank lines), keep the pull's stderr until both errors are known, and fail
    # loudly on any zero or short pull: a count-match is the ONLY success.
    agent_errf=$(mktemp)
    agent_lines_raw=$(BUNKER_QA_SSH_TIMEOUT="$ssh_to" agent_ssh "awk 'NF{n++} END{print n+0}' < ~/qa-evidence.jsonl" 2>"$agent_errf")
    agent_count_rc=$?
    agent_lines=$(printf '%s' "$agent_lines_raw" | tr -d '[:space:]')
    case "$agent_lines" in ''|*[!0-9]*) agent_lines="" ;; esac
    if [ "${pulled:-0}" -lt 1 ] || [ -z "$agent_lines" ] || [ "$pulled" -ne "$agent_lines" ]; then
      pull_err=$(tr '\n' ' ' < "$errf" 2>/dev/null | sed 's/^ *//;s/ *$//')
      agent_err=$(tr '\n' ' ' < "$agent_errf" 2>/dev/null | sed 's/^ *//;s/ *$//')
      rm -f "$agent_errf"
      ledger_fail="zero-or-short ledger pull from agent=$agent ($SERVER): pulled=${pulled:-0} agent_lines=${agent_lines:-unknown}"
      [ -n "$pull_err" ] && ledger_fail="$ledger_fail; pull stderr: $pull_err"
      [ -n "$agent_err" ] && ledger_fail="$ledger_fail; agent count stderr: $agent_err"
      if [ -z "$pull_err" ] && [ -z "$agent_err" ]; then
        ledger_fail="$ledger_fail; no transport error (pull rc=$pull_rc, agent count rc=$agent_count_rc) — the ledger itself is empty or short"
      fi
      return 2
    fi
    rm -f "$agent_errf"
    return 0
  }

  ledger_stage; ledger_rc=$?
  if [ "$ledger_rc" -ne 0 ]; then
    record_collect_retry ledger "$ledger_fail"
    ledger_retried=1
    ledger_stage; ledger_rc=$?
  fi

  if [ "$ledger_rc" -eq 3 ]; then
    # QA-BUNKER-77: the agent vanished between the probe and the pull. Rows
    # already synced ⇒ the run survives as agent-gone (rc=0); nothing synced
    # ⇒ genuine loss — keep the QA-BUNKER-45 abort. QA-CRIER-066-R2: both
    # branches now name the retry, and the lost cells get explicit rows.
    # QA-HERMES-CANOPY-54: name the port the pull dialed as well; the ssh
    # stderr already rides $ledger_fail.
    local pull_detail
    pull_detail=$(collect_ssh_detail "$(agent_ssh_port "$agent")" "")
    if [ -s "$evidence.synced-$agent" ]; then
      rm -f "$tmp" "$errf"
      emit_agent_gone "agent=$agent ($SERVER) unreachable at the evidence pull ($pull_detail; attempts=2: $ledger_fail) — battery rows were already synced by incremental collect ($evidence.synced-$agent); per-cell logs lost with the agent user"
      exit 0
    fi
    rm -f "$tmp" "$errf"
    abort_collect "$ledger_fail; $pull_detail; attempts=2 (pull retried once after the first failure)"
    abort_rc=$?
    emit_not_collected "evidence pull failed after retry (stage=ledger attempts=2: $ledger_fail)" local
    persist_evidence || true
    exit $abort_rc
  fi

  if [ "$ledger_rc" -eq 2 ]; then
    local fail_detail
    rm -f "$errf"
    fail_detail="$ledger_fail; $(collect_ssh_detail "$(agent_ssh_port "$agent")" ""); attempts=2 (pull retried once after the first failure)"
    fail_detail="$fail_detail; recovery: bunker destroy $agent --server $SERVER"
    append_collect_row FAIL "$fail_detail"
    printf '{"cell":"harness-failure","status":"INFO","detail":"harness abort after failed collect count-match: %s","attributed_host":"%s","host":"%s","collect_attempt":1,"ts":"%s"}\n' \
      "$(json_one_line "$(printf '%s' "$fail_detail" | tr '\n\r\t' '   ' | cut -c1-300)")" "$SERVER" "$SERVER" \
      "$(date -u +%FT%TZ)" >> "$evidence"
    # QA-CRIER-066-R2 (B): the cells this run OWED must not disappear because the
    # pull failed — one explicit row each, then the ledger is preserved in-repo.
    emit_not_collected "evidence pull failed after retry (stage=ledger attempts=2: pulled=${pulled:-0} agent_lines=${agent_lines:-unknown})" local
    persist_evidence || true
    # Agent LEFT INTACT (no teardown, no logs pull): the ledger may still be
    # recoverable on the agent, so the recovery hint names the manual destroy.
    echo "COLLECT-FAIL rows=${pulled:-0} agent_lines=${agent_lines:-unknown} reason=$(printf '%s' "$fail_detail" | tr '\n' ' ' | cut -c1-240)" >&2
    echo "RECOVERY: agent=$agent LEFT INTACT — ledger may be recoverable on the agent; manual teardown when done: bunker destroy $agent --server $SERVER" >&2
    exit 2
  fi
  rm -f "$errf"
  # QA-BUNKER-77: the agent's rows are on local disk — persist the already-
  # synced marker so a later unreachable collect grades agent-gone, not abort.
  mark_rows_synced "${pulled:-0}"

  # QA-BUNKER-77: pull the per-cell logs BEFORE the destroy/keep decision —
  # after the agent user is gone they are unrecoverable (the field loss this
  # row fixes: ci.log/native.log/res.log/disc.log died with the user).
  local logs_dir="$evidence.logs" log_note=""
  if pull_agent_logs; then
    # QA-CRIER-066-R2: keep a retry note the pull itself recorded — the caller
    # must not overwrite "pulled on retry (attempts=2)" with the bland default.
    [ -n "$log_note" ] || log_note="per-cell logs saved to $logs_dir"
  fi
  local disconnect_artifact="${evidence}.chaos-disconnect.log" disconnect_source="" disconnect_detail
  disconnect_source=$(find "$logs_dir" -type f -name disc.log -print 2>/dev/null | sort | tail -1)
  if [ -n "$disconnect_source" ] && [ -s "$disconnect_source" ] && cp "$disconnect_source" "$disconnect_artifact"; then
    disconnect_detail="chaos-disconnect log captured at $disconnect_artifact ($(wc -c < "$disconnect_artifact") bytes)"
  else
    rm -f "$disconnect_artifact"
    disconnect_detail="chaos-disconnect log unavailable/empty at $disconnect_artifact"
  fi

  # QA-CRIER-066-R2 (B): cells this battery OWED that never came back get an
  # explicit NOT-COLLECTED row. The roster is DERIVED from the battery's own
  # cell() call sites (the ~/qa-run.sh that actually ran, else this generator's
  # script text) — never a hand-typed list that can drift. Runs BEFORE the
  # persistence copy, so the rows are inside the copied ledger.
  local nc_count=0
  emit_not_collected "row absent from the merged ledger after retry (pulled=${pulled:-0} agent_lines=${agent_lines:-unknown} stage=ledger attempts=$collect_attempts)" agent
  nc_count=$(grep -c '"verdict":"NOT-COLLECTED"' "$evidence" 2>/dev/null || true)

  # QA-CRIER-066-R3: the OK row carries BOTH counts (pulled=N agent_lines=M)
  # so a closeout can prove the pull was complete without re-reading the agent.
  local detail="agent=$agent ($SERVER) — pulled=${pulled:-0} agent_lines=${agent_lines:-unknown} evidence row(s), merge-deduped by ts"
  [ "${ledger_retried:-0}" -eq 1 ] && detail="$detail; ledger pull retried once (attempts=2)"
  [ "${nc_count:-0}" -gt 0 ] && detail="$detail; NOT-COLLECTED=${nc_count} cell(s)"
  # QA-CRIER-066-R2 (C): name the IN-REPO evidence directory (the path a closeout
  # must cite) EARLY — the row is cut at 300 chars, so a note placed after the
  # log/disconnect segments is silently lost.
  if test_repo >/dev/null 2>&1; then
    detail="$detail; evidence dir: $(qa_evidence_persist_root "$(test_repo)" "$meta")/$tick_id"
  else
    detail="$detail; evidence dir: UNRESOLVED (no repo= in the launch record)"
  fi
  # QA-CRIER-066-R3: record WHERE the evidence landed, relative to this
  # checkout — EARLY in the detail, before the long log/disconnect segments,
  # so the 300-char row cut cannot eat it. Inside the checkout the OK row
  # names the repo-relative path; outside it (/tmp, agent home, anything
  # else) the OK row says so AND a named WARN row is appended below, making a
  # closeout that cites a deletable path visible in the ledger. NOT a refusal
  # — dogfood flows legitimately collect into /tmp. BUNKER_QA_REPO_ROOT
  # overrides the checkout root (deployed copies live outside any checkout;
  # tests pin it explicitly).
  local ev_abs repo_root ev_outside=0
  ev_abs=$(CDPATH= cd -- "$(dirname -- "$evidence")" 2>/dev/null && pwd)/$(basename -- "$evidence")
  repo_root="${BUNKER_QA_REPO_ROOT:-$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)}"
  case "$ev_abs" in
    "$repo_root"/*)
      detail="$detail; evidence repo-relative: ${ev_abs#"$repo_root"/}"
      ;;
    *)
      ev_outside=1
      detail="$detail; evidence OUTSIDE the checkout: $ev_abs"
      ;;
  esac
  [ -n "$log_note" ] && detail="$detail; $log_note"
  detail="$detail; $disconnect_detail"
  if [ "$keep" = 1 ]; then
    detail="$detail; agent KEPT (launched with --keep) — destroy it manually"
  else
    # QA-BUNKER-19 b+c (2026-09-21): surfaced destroy + post-destroy absence
    # verify (qa_destroy_agent appends its own FAIL row to $evidence when the
    # destroy fails or the id still lists). Replaces the bare `|| true` swallow.
    # QA-BUNKER-39 (2026-09-30): qa_destroy_agent retries (3 attempts, backoff),
    # re-checks `bunker list` and reports TEARDOWN-GONE / TEARDOWN-RECOVERED
    # (destroy landed late) / TEARDOWN-LEAK. The collect summary line must
    # match reality — the old unconditional "temp agent destroyed" lied on
    # exactly the loaded-server path that leaked slot 7fb908b5 on las-02.
    local teardown
    teardown=$(qa_destroy_agent "$agent" "$evidence")
    case "$teardown" in
      TEARDOWN-GONE)        detail="$detail; temp agent destroyed" ;;
      TEARDOWN-RECOVERED)   detail="$detail; temp agent destroy reported failure but the agent is GONE from the server list — teardown recovered" ;;
      TEARDOWN-LEAK|*)      detail="$detail; TEMP AGENT LEAKED: destroy failed and agent=$agent still lists on $SERVER — slot holds until the ~4h TTL reap; manual recovery: bunker destroy $agent --server $SERVER" ;;
    esac
  fi
  append_collect_row OK "$detail"
  if [ "$ev_outside" -eq 1 ]; then
    # QA-CRIER-066-R3: the named WARN row for an out-of-checkout evidence
    # path — recorded AFTER the collect OK row so the ledger reads close
    # first, then the location warning.
    printf '{"cell":"evidence-outside-repo","status":"WARN","detail":"collect evidence %s resolves outside the checkout %s — a closeout citing it cites a deletable path","host":"%s","ts":"%s"}\n' \
      "$ev_abs" "$repo_root" "$SERVER" "$(date -u +%FT%TZ)" >> "$evidence"
  fi
  # QA-CRIER-066-R2 (C): copy the merged ledger AND every per-cell log into the
  # DURABLE OUT-OF-TREE root ~/.hermes/qa/evidence/<project>/<tick>/ (LORE-
  # HYGIENE-20261122: an in-repo persist dirtied the repo-under-test on every
  # run). Local file work only —
  # nothing here depends on the JIT agent still being alive — and it runs after
  # every row is written so the committed copy is complete. persist_evidence
  # prints the single citable `EVIDENCE-DIR=<abs path>` line, and — QA-CRIER-066
  # — certifies that exact copy with a manifest.json next to it plus ONE
  # `EVIDENCE-SHA256=<hex> EVIDENCE-ROWS=<n>` line a closeout can record verbatim
  # (read it back with `bunker-qa.sh verify-evidence <dir>`).
  persist_evidence || true
  qa_remove_agent_lock "$agent" >/dev/null 2>&1 || true
  log "QA collect complete — evidence: $evidence"
  echo "COLLECTED agent=$agent rows=${pulled:-0} evidence=$evidence"
}

fence_check() {
  awk '
    /^  cat <<EOF$/ { inside=1; start=NR; next }
    inside && /^EOF$/ { inside=0; end=NR; fences++; next }
    inside {
      line=$0
      for (i=1; i<=length(line); i++) {
        if (substr(line, i, 1) != "$") continue
        slashes=0
        for (j=i-1; j>0 && substr(line, j, 1) == "\\"; j--) slashes++
        if (slashes % 2 == 1) continue
        token=substr(line, i)
        if (token !~ /^\$[A-Za-z_{(]/) continue
        if (token ~ /^\$(proj|artifact_expect|artifact_cmd|native_cmd|MAKE_URL|ACT_URL|install_cmd|agent|ci_cmd|qa_docker_lifecycle_enabled|qa_docker_lifecycle_host_block)([^[:alnum:]_]|$)/ ||
            token ~ /^\$\{native_cmd:-\$native_cmd\}/ ||
            token ~ /^\$DETECT_[A-Z_]+([^[:alnum:]_]|$)/) continue
        printf "fence violation line=%d: unescaped %s\n", NR, token
        violations++
      }
    }
    END {
      if (fences != 1 || start == 0 || end <= start) {
        printf "fence violation: expected one cat <<EOF body, found %d\n", fences
        violations++
      }
      printf "violations=%d\n", violations
      exit violations != 0
    }
  ' "$0"
}

case "${1:-}" in
  __fence-check) fence_check ;;
  status) status ;;
  run) run "$2" "${@:3}" ;;
  launch) launch "$2" "${@:3}" ;;
  collect) collect "${@:2}" ;;
  # QA-CRIER-066: pure-local read-back of a persisted QA run — no ssh, no bunker
  # call, no repo checkout needed, so it still works long after the JIT agent is
  # destroyed. Exits 0 only when the recomputed digest matches the manifest
  # and/or --expect (and any --event JSON's evidence_sha256).
  verify-evidence) shift; verify_evidence "$@" ;;
  # QA-BUNKER-REVIEW-3 safe probe: print the product root qa_repo_sanity would
  # sync/grade for <repo-dir> (stand-in board-symlink resolution, explicit
  # BUNKER_QA_SUBDIR override, or the named refusal) and exit — NO server
  # contact, NO agent spawn, NO battery. rc=0 = would proceed with the printed
  # root; rc=1 = refused (named ERROR on stderr). The refusal's evidence row
  # goes to a throwaway file so a probe never touches the default evidence path.
  resolve) EVIDENCE="$(mktemp "${TMPDIR:-/tmp}/bunker-qa-resolve-probe.XXXXXX")"; qa_repo_sanity "${2:?usage: bunker-qa.sh resolve <repo-dir>}" probe ;;
  # test hook: print the generated script. `agent` is a placeholder here — the
  # real caller (run/launch) sets it before build_remote_script, and without a
  # default `set -u` aborts the heredoc expansion entirely (no output at all).
  # DETECT_BIN is defaulted to the same set even though the generated script
  # re-detects the start command on the agent (the agent-side ladder is the
  # authoritative runtime detection); the hook's default keeps the variable
  # contract complete for tests.
  __gen-remote) agent="${agent:-test-agent-0000}" DETECT_INSTALL=":" DETECT_CI=":" DETECT_NATIVE=":" DETECT_BIN="" DETECT_TAG_COUNT=0 DETECT_PREV_TAG="" DETECT_PREV_VERSION="" DETECT_PKG_NAME="" DETECT_PKG_ECOSYSTEM="" DETECT_GO_URL="" DETECT_CI_FILES="" DETECT_ACT_NOTE="" DETECT_UP_PREV_DIR="" build_remote_script "$2" "${3:-true}" "${4:-true}" "${5:-true}" ;;
  # QA-CRIER-20 test hook: detect_cmds is a pure function of the repo dir
  # (reads files, sets DETECT_* globals), so this is safe to run against any
  # directory. "$3" defaults to the same placeholder agent __gen-remote uses.
  # DETECT_BIN (QA-9ROUTER-22) is the host-side mirror of the generated
  # script's start-command ladder; empty = "not observable".
  #
  # BUNKER_QA_GEN_DETECT=1 (QA-9ROUTER-19/20, 2026-09-23): run the REAL
  # detection on the target dir before rendering, so the render carries the
  # actual QA_CI_SELECT / QA_ACT_NOTE / QA_PKG_NAME a battery run would ship.
  # Opt-in on purpose — the default hook stays a fixed-placeholder render so
  # existing callers keep byte-identical output.
  __detect-cmds) detect_cmds "$2" "${3:-test-agent-0000}"; printf 'DETECT_INSTALL=%s\nDETECT_NATIVE=%s\nDETECT_CI=%s\nDETECT_BIN=%s\nDETECT_PKG_NAME=%s\nDETECT_PKG_ECOSYSTEM=%s\nDETECT_CI_SELECT=%s\nDETECT_ACT_NOTE=%s\n' "$DETECT_INSTALL" "$DETECT_NATIVE" "$DETECT_CI" "$DETECT_BIN" "$DETECT_PKG_NAME" "$DETECT_PKG_ECOSYSTEM" "$DETECT_CI_FILES" "$DETECT_ACT_NOTE" ;;
  # QA-9ROUTER-19/20: render with the REAL detection for $2, so a test can
  # assert what a battery run would actually ship (see the hook's comment).
  __gen-remote-detected) agent="${agent:-test-agent-0000}"; detect_cmds "$2" "${3:-test-agent-0000}"; build_remote_script "$2" "$DETECT_INSTALL" "$DETECT_CI" "$DETECT_NATIVE" ;;
  # QA-CRIER-62 test hook: print the REAL target-binding report for <repo-dir>
  # (target/runner/repo-identity/evidence-project + verdict) so a selftest can
  # prove the identity ladder and the fail-closed comparison without a host, a
  # spawn or a network. rc mirrors the check: 0 bound, 3 target-invalid.
  __target-bind) qa_target_binding_check "${2:?usage: bunker-qa.sh __target-bind <repo-dir>}" ;;
  *) echo "usage: bunker-qa.sh status | run <repo-dir> [--keep] | launch <repo-dir> [--keep] | collect --evidence <path> | verify-evidence <dir|evidence.jsonl> [--expect <hex>] [--event <json-file>] | resolve <repo-dir>" ;;
esac
